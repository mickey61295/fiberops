          <value>SNo,System.Int32</value>
          <value>WorkComplDet,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>SizeDesc,System.String</value>
          <value>StyleDesc,System.String</value>
          <value>Partydcref,System.String</value>
          <value>PartyDCDate,System.DateTime</value>
          <value>BuyerName,System.String</value>
          <value>PartName,System.String</value>
          <value>Terms,System.String</value>
          <value>UserName,System.String</value>
          <value>Panelgrp,System.String</value>
          <value>PcsType,System.String</value>
          <value>Ordertype,System.String</value>
          <value>GatePass_SNo,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>PcsReceipt</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM(CAST(Trs_PcsGRN1.Docno AS varchar)) + '/' + Trs_PcsGRN1.Finyear AS DCNo, Trs_PcsGRN1.Dt, Trs_PcsGRN1.Bdl, 
                      Trs_PcsGRN1.WgtKg, Trs_PcsGRN1.Remark, RTRIM(CAST(OrderMas.Jobno AS varchar)) 
                      + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo AS OrderNo, dbo.Vue_Trs_pcsgrn2_grp.StyleNo, Mas_Exporter.ExporterName, 
                      Mas_Exporter.ExporterAddress, Mas_Exporter.Phone, Mas_Exporter.TIN, Mas_Exporter.CST, Mas_Party.Pname, Mas_Party.Paddress, 
                      Mas_Dept.GRNFormat, Mas_Party.Phone AS Expr2, Mas_Party.TIN AS Expr3, Mas_Party.CST AS Expr4, dbo.Vue_Trs_pcsgrn2_grp.RecPcs, 
                      Mas_Dept.Deptname, OrdSizeMas.SNo, Mas_JobWrkComp.WorkComplDet, Mas_Color.ColorDesc, Mas_Size.SizeDesc, Mas_StyleDesc.StyleDesc, 
                      Trs_PcsGRN1.Partydcref, Trs_PcsGRN1.PartyDCDate, Mas_Buyer.BuyerName, dbo.Mas_Part.PartName, dbo.Mas_Terms.Terms, 
                      dbo.Mas_User.UserName, dbo.Vue_Trs_pcsgrn2_grp.Panelgrp,Vue_Trs_pcsgrn2_grp.PcsType,Ordermas.Ordertype, ISNULL(GatePass_SNo,'') AS GatePass_SNo
 FROM         dbo.Mas_Part RIGHT OUTER JOIN
                      dbo.Mas_StyleDesc AS Mas_StyleDesc INNER JOIN
                     
                      dbo.Trs_PcsGrn1 AS Trs_PcsGRN1 INNER JOIN
                      dbo.Mas_Exporter AS Mas_Exporter ON Trs_PcsGRN1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.Mas_Party AS Mas_Party ON Trs_PcsGRN1.Party = Mas_Party.PID INNER JOIN
                      dbo.OrderMas AS OrderMas ON Trs_PcsGRN1.OrdJob = OrderMas.OrdId INNER JOIN
                      dbo.OrdSizeMas AS OrdSizeMas ON Trs_PcsGRN1.OrdJob = OrdSizeMas.OrdID inner join
					  dbo.Vue_Trs_pcsgrn2_grp on  dbo.Vue_Trs_pcsgrn2_grp.ID = Trs_PcsGRN1.ID AND 
                      dbo.Vue_Trs_pcsgrn2_grp.SizID = OrdSizeMas.SizeID and  dbo.Vue_Trs_pcsgrn2_grp.styleno= OrdSizeMas.StyleNo 
					    INNER JOIN
                      dbo.Mas_Color AS Mas_Color ON dbo.Vue_Trs_pcsgrn2_grp.ColID = Mas_Color.ColID INNER JOIN
                      dbo.Mas_Size AS Mas_Size ON dbo.Vue_Trs_pcsgrn2_grp.SizID = Mas_Size.SizeID ON 
                      Mas_StyleDesc.StyleID = dbo.Vue_Trs_pcsgrn2_grp.StyleID ON dbo.Mas_Part.PartID = dbo.Vue_Trs_pcsgrn2_grp.PARTID LEFT OUTER JOIN
                      dbo.Mas_JobWrkComp AS Mas_JobWrkComp ON isNull(Trs_PcsGRN1.TargetStageID,dept) = Mas_JobWrkComp.Id LEFT OUTER JOIN
                      dbo.Mas_Dept AS Mas_Dept ON Trs_PcsGRN1.Dept = Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Mas_Terms ON Mas_Dept.DC_TermCode = dbo.Mas_Terms.ID LEFT OUTER JOIN
                      dbo.Mas_Buyer AS Mas_Buyer ON OrderMas.BuyerID = Mas_Buyer.BuyerID LEFT OUTER JOIN
                      dbo.Mas_User ON Trs_PcsGRN1.PreparedBy = dbo.Mas_User.UserCode
WHERE     Trs_PcsGRN1.ID =?
ORDER BY OrdSizeMas.SNo</SqlCommand>
      </PcsReceipt>
    </DataSources>
