    <DataSources isList="true" count="1">
      <PcsReceipt Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>PcsReceipt</Alias>
        <Columns isList="true" count="35">
