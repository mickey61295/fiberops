        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>OrderSheet</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM(CAST(OrderMas.Jobno AS varchar)) + '/' + OrderMas.Finyear AS JobNo, OrderMas.BuyOrdNo, OrderMas.BuyordDt, OrderMas.DelDt, 
                      OrderMas.OrderQty, OrderMas.Gsm, Temp_OrderReg.StyleNo, OrderMas.OrderType, OrderMas.uom, OrderMas.ActDelDt, Mas_Buyer.BuyerName, 
                      Mas_Exporter.ExporterName, Mas_Merchandiser.MerchName, Mas_Season.SeasDesc, Mas_Fcy.FcyName, OrderMas.Remarks,Temp_OrderReg.StyleDesc, Temp_OrderReg.ColorDesc, OrderStyleImage.StyleImage, 
                      Temp_OrderReg.ExPer, Temp_OrderReg.SalesRate, Temp_OrderReg.DelDate, Temp_OrderReg.S1, Temp_OrderReg.S2, 
                      Temp_OrderReg.S3, Temp_OrderReg.S4, Temp_OrderReg.S5, Temp_OrderReg.S6, Temp_OrderReg.S7, Temp_OrderReg.S8, 
                      Temp_OrderReg.S9, Temp_OrderReg.S10, Temp_OrderReg.S11, Temp_OrderReg.S12, Temp_OrderReg.S13, 
                      Temp_OrderReg.S14, Temp_OrderReg.S15, Temp_OrderReg.Q1, Temp_OrderReg.Q2, Temp_OrderReg.Q3, 
                      Temp_OrderReg.Q4, Temp_OrderReg.Q5, Temp_OrderReg.Q6, Temp_OrderReg.Q7, Temp_OrderReg.Q8, Temp_OrderReg.Q9, 
                      Temp_OrderReg.Q10, Temp_OrderReg.Q11, Temp_OrderReg.Q12, Temp_OrderReg.Q13, Temp_OrderReg.Q14, 
                      Temp_OrderReg.Q15,(Temp_OrderReg.Q1+ Temp_OrderReg.Q2+ Temp_OrderReg.Q3+ 
                      Temp_OrderReg.Q4+ Temp_OrderReg.Q5+ Temp_OrderReg.Q6+ Temp_OrderReg.Q7+ Temp_OrderReg.Q8+ Temp_OrderReg.Q9+ 
                      Temp_OrderReg.Q10+ Temp_OrderReg.Q11+ Temp_OrderReg.Q12+ Temp_OrderReg.Q13+ Temp_OrderReg.Q14+ 
                      Temp_OrderReg.Q15) as Total, Mas_User.UserName
FROM         Mas_Buyer AS Mas_Buyer RIGHT OUTER JOIN
                      Mas_Fcy AS Mas_Fcy RIGHT OUTER JOIN
                      Mas_Season AS Mas_Season RIGHT OUTER JOIN
                      OrderMas AS OrderMas INNER JOIN
                      Mas_Exporter AS Mas_Exporter ON OrderMas.ExpID = Mas_Exporter.ExpID INNER JOIN
                      Temp_OrderReg ON OrderMas.OrdId = Temp_OrderReg.OrdId LEFT OUTER JOIN
                      OrderStyleImage ON Temp_OrderReg.OrdId = OrderStyleImage.OrdId AND 
                      Temp_OrderReg.StyleNo = OrderStyleImage.StyleNo LEFT OUTER JOIN
                      Mas_Merchandiser AS Mas_Merchandiser ON OrderMas.MerchID = Mas_Merchandiser.MerchID ON Mas_Season.SeasID = OrderMas.Season ON 
                      Mas_Fcy.ID = OrderMas.Fcy ON Mas_Buyer.BuyerID = OrderMas.BuyerID LEFT OUTER JOIN
MAS_User ON OrderMas.PreparedBy = Mas_User.Usercode
where Ordermas.OrdId=?</SqlCommand>
      </OrderSheet>
