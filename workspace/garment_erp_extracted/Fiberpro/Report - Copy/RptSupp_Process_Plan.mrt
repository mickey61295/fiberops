    <Databases isList="true" count="1">
      <Connection Ref="2" type="Stimulsoft.Report.Dictionary.StiOleDbDatabase" isKey="true">
        <Alias>Connection</Alias>
        <ConnectionString>Provider=SQLOLEDB.1;Persist Security Info=False;User ID=sa;Initial Catalog=JOMS;Data Source=MACHINE-14</ConnectionString>
        <Name>Connection</Name>
        <PromptUserNameAndPassword>False</PromptUserNameAndPassword>
      </Connection>
    </Databases>
    <DataSources isList="true" count="1">
      <DataSource1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="21">
          <value>SupNo,System.String</value>
          <value>OrdJOb,System.String</value>
          <value>OrdId,System.Int32</value>
          <value>SuppOrdId,System.Int32</value>
          <value>StyleNo,System.String</value>
          <value>wgt,System.Decimal</value>
          <value>Pname,System.String</value>
          <value>SuppNo,System.Int32</value>
          <value>ExporterName,System.String</value>
          <value>DelDate,System.DateTime</value>
          <value>Cost_EDate,System.DateTime</value>
          <value>Deptname,System.String</value>
          <value>S_OrdId,System.Int32</value>
          <value>DeptID,System.Int32</value>
          <value>PCSRate,System.Decimal</value>
          <value>Cost_Inc,System.String</value>
          <value>ReqQty,System.Decimal</value>
          <value>Descr,System.String</value>
          <value>ID,System.Int32</value>
          <value>Amount,System.Decimal</value>
          <value>Plan_EDate,System.DateTime</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="2">
          <value>_x0040_id,,3,0</value>
          <value>_x0040_Gbl_order,,200,100</value>
        </Parameters>
        <SqlCommand>SELECT RTRIM(dbo.SuppOrdMas.SuppNo) + '/' + dbo.SuppOrdMas.SuppFyr + ' -&gt; ' +
	dbo.SuppOrdMas.StyleNo AS SupNo, RTRIM(OrderMas.Jobno) + '/' +
	OrderMas.Finyear + ' -&gt; ' + OrderMas.BuyOrdNo AS OrdJOb, dbo.SuppOrdMas.OrdId,
	dbo.SuppOrdMas.SuppOrdId, dbo.SuppOrdMas.StyleNo, dbo.SuppOrdMas.wgt,
	dbo.Mas_Party.Pname, dbo.SuppOrdMas.SuppNo, dbo.Mas_Exporter.ExporterName,
	dbo.SuppOrdMas.DelDate, dbo.SuppOrdMas.Cost_EDate, dbo.Mas_Dept.Deptname,
	dbo.Supp_Process_Plan.S_OrdId, dbo.Supp_Process_Plan.DeptID,
	dbo.Supp_Process_Plan.PCSRate, dbo.Supp_Process_Plan.Cost_Inc,
	dbo.Supp_Process_Plan.ReqQty, dbo.Supp_Process_Plan.Descr,
	dbo.Supp_Process_Plan.ID, Supp_Process_Plan.ReqQty * Supp_Process_Plan.PCSRate
	AS Amount, dbo.SuppOrdMas.Plan_EDate
	FROM dbo.SuppOrdMas INNER JOIN
	dbo.Mas_Party ON dbo.SuppOrdMas.PId = dbo.Mas_Party.PID INNER JOIN
  dbo.Mas_Exporter ON dbo.SuppOrdMas.ExpID = dbo.Mas_Exporter.ExpID INNER JOIN
  dbo.Supp_Process_Plan ON dbo.SuppOrdMas.SuppOrdId =
    dbo.Supp_Process_Plan.S_OrdId INNER JOIN
  dbo.Mas_Dept ON dbo.Supp_Process_Plan.DeptID = dbo.Mas_Dept.DeptID INNER JOIN
  dbo.OrderMas ON dbo.SuppOrdMas.OrdId = dbo.OrderMas.OrdId
WHERE dbo.SuppOrdMas.SuppOrdId =?
</SqlCommand>
      </DataSource1>
    </DataSources>
