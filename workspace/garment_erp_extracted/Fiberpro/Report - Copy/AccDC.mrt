      <DataSource1 Ref="6" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="9">
          <value>Id,System.Double</value>
          <value>TaxableAmt,System.Double</value>
          <value>CGSTPer,System.Double</value>
          <value>SGSTPer,System.Double</value>
          <value>IGSTPer,System.Double</value>
          <value>CGSTAmt,System.Double</value>
          <value>SGSTAmt,System.Double</value>
          <value>IGSTAmt,System.Double</value>
          <value>HSNCode,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>Select Id,HSNCode,Sum(TaxableAmt) as TaxableAmt,CGSTPer,SGSTPer,IGSTPer,Sum(CGSTAmt) as CGSTAmt,Sum(SGSTAmt) as SGSTAmt,Sum(IGSTAmt) as IGSTAmt From (
 
Select   Y.Id,Atype,IsNull(Y.HSNCode,'') as HSNCode,(IsNull(Sum(Y.Amt),0)) as TaxableAmt,
	Case When IsNull(Y.Stateid,1)=IsNull(Y.Stateid,1) Then IsNull(Y.BPercH,0)/2  End as CGSTPer,
Case When IsNull(Y.Stateid,1)=IsNull(Y.Stateid,1) Then IsNull(Y.BPercH,0)/2 End as SGSTPer,
Case When IsNull(Y.Stateid,1)&lt;&gt;IsNull(Y.Stateid,1) Then IsNull(Y.BPercH,0) End as IGSTPer,  Case When IsNull(Y.stateid,1)=IsNull(Y.Stateid,1) Then  ((IsNull(Y.BPercH,0)/2)*Sum(IsNull(Y.Amt,0))/100) End   as CGSTAmt,Case When IsNull(Y.Stateid,1)=IsNull(Y.Stateid,1) Then   ((IsNull(Y.BPercH,0)/2)*Sum(IsNull(Y.Amt,0))/100)   End as SGSTAmt,Case When IsNull(Y.Stateid,1)&lt;&gt;IsNull(Y.Stateid,1)
 Then   ((IsNull(Y.BPercH,0))*Sum(IsNull(Y.Amt,0))/100) End   as IGSTAmt From
 
 (
 
Select Trs_Del2.Id,Mas_Hsn.HSNCode,Case when Trs_Del2.kg=0 then (Trs_Del2.mtr*Trs_Del2.Rate) Else (Trs_Del2.Kg*Trs_Del2.Rate) End As Amt,Mas_PArty.Stateid As StateId1,Mas_HSN.BPercH,Mas_Exporter.Stateid,Stocktable.AType From  trs_del1 INNER JOIN trs_del2 ON trs_del1.Id= trs_del2.ID INNER JOIN Mas_Exporter ON Mas_Exporter.ExpID=trs_del1.Coycode INNER JOIN Mas_Party ON Mas_Party.PID=trs_del1.Party inner join stocktable on stocktable.stockid=trs_del2.StockID INNER JOIN Mas_Acc ON Mas_Acc.ID=StockTable.AType inner join mas_hsn on mas_hsn.id=mas_acc.HSNID and ISNULL(Mas_Hsn.HSNCode,'')&lt;&gt;'' And Trtype=2 
 
 )Y  where y.id=? Group by Y.ID,Y.HSNCode,Y.BPercH,Y.Stateid,Y.stateid1,Atype


 ) X Group By Id,HSNCode,TaxableAmt,CGSTPer,SGSTPer,IGSTPer </SqlCommand>
      </DataSource1>
