        <Dictionary isRef="1" />
        <Name>AccDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT Tmp_AccDC.DcNo, Tmp_AccDC.Dt, Tmp_AccDC.TrType, Tmp_AccDC.remark,
	Tmp_AccDC.delwgt, Tmp_AccDC.ID, Tmp_AccDC.StockID, Tmp_AccDC.Kg,
	Tmp_AccDC.ExporterName, Tmp_AccDC.BuyerName, Tmp_AccDC.ExporterAddress,
	Tmp_AccDC.ExpPhone, Tmp_AccDC.ExpTIN, Tmp_AccDC.ExpCST, Tmp_AccDC.Deptname,
	Tmp_AccDC.dcformat, Tmp_AccDC.PartyDCref, Tmp_AccDC.OrderNo,
	Tmp_AccDC.StyleNo, Tmp_AccDC.DcPre, Tmp_AccDC.ColorDesc, Tmp_AccDC.Acc_Descr,
	Tmp_AccDC.AccDescription, Tmp_AccDC.Sno, Tmp_AccDC.SizeDesc, Tmp_AccDC.Uom,
	Tmp_AccDC.ItemDesc, Tmp_AccDC.HEADING, Tmp_AccDC.Pname, Tmp_AccDC.Padd,
	Tmp_AccDC.PPhone, Tmp_AccDC.LblTIN, Tmp_AccDC.LblCST, Tmp_AccDC.TIN,
	Tmp_AccDC.CST, Tmp_AccDC.gpno, Tmp_AccDC.GatePassFlg, Tmp_AccDC.TarDt,
	Tmp_AccDC.ColorCombo, Tmp_AccDC.PreparedByName, Tmp_AccDC.Rate,Tmp_AccDC.Rate1,Tmp_AccDC.Amount,Tmp_AccDC.expgstno,Tmp_AccDC.partygstno,
	Preprint.DcRateReqd
	FROM Tmp_AccDC CROSS JOIN
  Preprint
WHERE Preprint.Slno = 3
ORDER BY Tmp_AccDC.Acc_Descr, Tmp_AccDC.ColorDesc, Tmp_AccDC.SNo</SqlCommand>
      </AccDC>
      <AccProgram Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>AccProgram</Alias>
        <Columns isList="true" count="8">
          <value>ID,System.Int32</value>
          <value>Prog,System.Decimal</value>
          <value>IssueStockId,System.Int32</value>
          <value>StockID,System.Int32</value>
          <value>ColorDesc,System.String</value>
          <value>Acc_Descr,System.String</value>
          <value>AccDescription,System.String</value>
          <value>Uom,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>AccProgram</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT Trs_Del3.ID, Trs_Del3.Prog, Trs_Del3.IssueStockId,StockTable.StockID, IsNull(Mas_Color.ColorDesc,'') as ColorDesc,Acc_Descr ,AccDescription ,Mas_Uom.Uom
	FROM  Trs_Del3 AS Trs_Del3 LEFT OUTER JOIN
                      Mas_Color AS Mas_Color ON Trs_Del3.RetDesID = Mas_Color.ColID INNER JOIN
                      Trs_Del1 ON Trs_Del3.ID = Trs_Del1.ID inner join

                      StockTable on   Trs_Del3.IssueStockId = StockTable.StockID
					  inner join Mas_Acc on mas_acc.ID=StockTable.Atype inner join Mas_AccDes on Mas_AccDes.id=StockTable.Ades
					  CROSS JOIN
                      PrePrint 
left outer join Mas_dept on Trs_del1.Prs_dept=Mas_dept.deptid  Inner Join Mas_Uom on Mas_Uom.UomId=Mas_Acc.UomId
WHERE   (dbo.Mas_Dept.ProgReqPrn = 'Y') AND   (Trs_Del1.TrType = 10) AND (PrePrint.Slno = 3) and Trs_Del3.IssueStockId &gt; 0 and Trs_Del3.ID = ?</SqlCommand>
      </AccProgram>
