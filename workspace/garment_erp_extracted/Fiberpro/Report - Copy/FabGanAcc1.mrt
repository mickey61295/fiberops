          <value>LotNo,System.String</value>
          <value>Username,System.String</value>
          <value>DeptType,System.String</value>
          <value>RejBag,System.Int32</value>
          <value>RejKgs,System.Decimal</value>
          <value>RejMtr,System.Decimal</value>
          <value>AccBag,System.Int32</value>
          <value>AccKgs,System.Decimal</value>
          <value>AccMtr,System.Decimal</value>
          <value>Type,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabGRN</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT  Case when Isnull(srGrnId,0)=0  then  CASE WHEN len(rtrim(grnpre)) &lt; 1 THEN RTRIM(CAST(Trs_Grn1.DocNo AS varchar)) + '/' + Trs_Grn1.Finyear ELSE rtrim(grnpre) 
                      + '-' + RTRIM(CAST(Trs_Grn1.DocNo AS varchar)) + '/' + Trs_Grn1.Finyear END  else CASE WHEN len(rtrim(grnpre)) &lt; 1 THEN RTRIM(CAST(Trs_Grn11.DocNo AS varchar)) + '/' + Trs_Grn11.Finyear ELSE rtrim(grnpre) 
                      + '-' + RTRIM(CAST(Trs_Grn11.DocNo AS varchar)) + '/' + Trs_grn11.Finyear END  End AS GrnNo, 
                      CASE WHEN trs_grn1.POId &gt; 0 THEN RTRIM(CAST(Trs_Po1.DocNo AS varchar)) + '/' + Trs_Po1.Finyear ELSE rtrim(CAST(Trs_Del1.DocNo AS varchar)) 
                      + '/' + Trs_Del1.Finyear END AS RefNo, 
                      CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar)) 
                      + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, CASE WHEN Trs_Grn2.Recmtr &gt; 0 THEN Mas_Uom.Uom ELSE '' END AS UOM, 
                      CASE WHEN StockTable.ColID &gt; 0 THEN fabdesc + '/' + Countname + '/' + colordesc ELSE fabdesc + '/' + Countname END AS ItemDesc, 
                      CASE Trs_Grn1.Grntype WHEN 'Purchase' THEN 'GOODS RECEIVED NOTE' WHEN 'Process' THEN 'PROCESS RECEIPT' WHEN 'Process Return' THEN 'PROCESS RETURN' When 'DirectReceipt' Then 'FABRIC RECEIPT'  END
                       AS Heading,Case When SrgrnId=0 then Trs_Grn1.dt else Trs_grn11.Dt end As Dt, Case When SrGrnID=0 then Trs_Grn1.PartyDCref else Trs_grn11.PartyDCref End As PartyDCref,Case When SrgrnId=0 then  Trs_Grn1.PartyDcDate else Trs_grn11.PartyDcDate End As PartyDcDate, Case When SrgrnId=0 then Trs_Grn1.PoID Else Trs_Grn11.Poid End As PoID, Trs_Grn1.GRNType,Case When SrgrnId=0 then  Trs_Grn1.remark Else Trs_Grn11.remark End as remark,Case When SrgrnId=0 then  Trs_Grn1.grnwgt Else Trs_grn11.grnwgt end as grnwgt, Trs_GRN2.RBag, 
                      Trs_GRN2.RecKgs, Trs_GRN2.Recmtr,X.RejBag,X.RejKgs,X.RejMtr,Isnull(Trs_Grn2.RBag,0)-Isnull(X.Rejbag,0) as AccBag,Isnull(Trs_Grn2.Reckgs,0)-Isnull(X.Rejkgs,0) as AccKgs,Isnull(Trs_Grn2.Recmtr,0)-Isnull(X.Rejmtr,0) as AccMtr,  Case when Isnull(srGrnId,0)=0 then Mas_Party.Pname else Mas_Party1.Pname End As Pname, Case when Isnull(srGrnId,0)=0 then Mas_Party.Paddress else Mas_PArty1.Paddress End as Paddress, Case when Isnull(srGrnId,0)=0 Then Mas_Party.Phone else Mas_Party1.Phone End As Phone, Case when Isnull(srGrnId,0)=0 Then Mas_Party.TIN Else Mas_Party1.TIN End As TIN, Mas_Buyer.BuyerName, 
                       Case when Isnull(srGrnId,0)=0 Then Mas_Party.CST Else Mas_Party1.CST End As CST,Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN, 
                      Mas_Exporter.CST AS ExpCST, Case when Isnull(srGrnId,0)=0 Then Mas_Dept.Deptname Else Mas_Dept1.Deptname End as Deptname, StockTable.CntID, StockTable.ColID, 
					  Case When IsNull(Mas_Dept.DeptType,'G')='G' Then StockTable.Gsm Else StockTable.FinGsm End As Gsm, 
					  CASE Trs_Grn1.Grntype WHEN 'Purchase' THEN Mas_Dept.PurGrnFormat  WHEN 'Process' then  Mas_Dept.GRNFormat end as GRNFormat, Mas_Dept.RecMethod, 
                      StockTable.GG, StockTable.ll, Mas_Grp.GRNPre, Mas_Fabric.Fabdesc, 
					  Case When IsNull(Mas_Dept.DeptType,'G')='G' Then Mas_Dia.Dia Else Mas_Dia1.Dia End As Dia, 
					  Mas_Count.CountName, ISNULL(Mas_Design.DesignDesc, '') AS DesignDesc, 
                      Mas_Color.ColorDesc, 
                      CASE Trs_Grn1.Grntype WHEN 'Purchase:' THEN 'Our PO No:' WHEN 'Process:' THEN 'Our DC No:' WHEN 'Process Return:' THEN 'Our DC No:' END AS RefNoHeading, 
                      Mas_Fabric.Fabdesc + Mas_Count.CountName + RTRIM(CAST(StockTable.ColID AS varchar)) + RTRIM(CAST(StockTable.Gsm AS varchar)) 
                      + RTRIM(CAST(StockTable.GG AS varchar)) + RTRIM(CAST(StockTable.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) AS GrpHeader, StockTable.LotNo, 
                      Mas_User.Username,IsNull(Mas_Dept.DeptType,'G') As DeptType, Case When Isnull(SrGrnID,0)=0 Then 1 else 0 end as Type
FROM         Trs_Grn1 AS Trs_Grn1 INNER JOIN
                      Trs_GRN2 AS Trs_GRN2 ON Trs_Grn1.ID = Trs_GRN2.ID INNER JOIN
                      OrderMas AS OrderMas ON Trs_GRN2.ordid = OrderMas.OrdId INNER JOIN
                      Mas_Party AS Mas_Party ON Trs_Grn1.SuppID = Mas_Party.PID INNER JOIN
                      Mas_Exporter AS Mas_Exporter ON Trs_Grn1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      StockTable AS StockTable ON Trs_GRN2.StockID = StockTable.StockID 
					  INNER JOIN Mas_Dia AS Mas_Dia ON StockTable.DiaID = Mas_Dia.DiaID 
					  INNER JOIN Mas_Dia AS Mas_Dia1 ON StockTable.FinDiaID = Mas_Dia1.DiaID 
INNER JOIN Mas_Fabric AS Mas_Fabric ON StockTable.FabID = Mas_Fabric.FabID Inner Join (Select Grnid,Ordid,Stockid,Sum(Rejkgs) as RejKgs,sum(Rejbag) as rejBag,Sum(Rejmtr) as rejMtr,SrStockID,SrGrnid From Grn_Rejection group by  Grnid,Ordid,Stockid,SrStockID,SrGrnid)X On X.stockid=Trs_Grn2.Stockid And X.Ordid=Trs_Grn2.Ordid and X.Grnid=Trs_Grn1.ID LEFT OUTER JOIN
                      Mas_Design AS Mas_Design ON StockTable.PRINT_DESIGNID = Mas_Design.DesignId LEFT OUTER JOIN
                      Mas_Dept AS Mas_Dept ON Trs_Grn1.Dept = Mas_Dept.DeptID LEFT OUTER JOIN
                      Trs_Del1 AS Trs_Del1 ON Trs_Grn1.DCID = Trs_Del1.ID LEFT OUTER JOIN
                      Trs_Po1 AS Trs_Po1 ON Trs_Grn1.PoID = Trs_Po1.ID LEFT OUTER JOIN
                      Mas_Grp AS Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo LEFT OUTER JOIN
                      Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN
                      Mas_Count AS Mas_Count ON StockTable.CntID = Mas_Count.CountID LEFT OUTER JOIN
                      Mas_Uom AS Mas_Uom ON Mas_Fabric.SecUomID = Mas_Uom.UomID LEFT OUTER JOIN
                      Mas_Buyer AS Mas_Buyer ON OrderMas.BuyerID = Mas_Buyer.BuyerID 
					   LEFT OUTER JOIN Trs_Grn1 Trs_grn11 On Trs_Grn11.ID=X.SrGrnid LEFT OUTER JOIN Mas_Party Mas_Party1 On Mas_Party1.Pid=Trs_Grn11.SuppID LEFT OUTER JOIN Mas_Dept Mas_Dept1 On Mas_Dept1.DeptID=Trs_grn11.Dept
					   LEFT OUTER JOIN 
                      Mas_User ON Trs_Grn1.PreparedBy = Mas_User.UserCode
WHERE     (Trs_Grn1.ID = ?)
ORDER BY Mas_Fabric.Fabdesc + '/' + Mas_Count.CountName + '/' + Mas_Color.ColorDesc, StockTable.Gsm, StockTable.GG, StockTable.ll, Mas_Dia.Dia
</SqlCommand>
      </FabGRN>
    </DataSources>
