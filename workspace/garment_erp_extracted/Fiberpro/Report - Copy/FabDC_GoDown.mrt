          <value>LotNo,System.String</value>
          <value>ExpPhone,System.String</value>
          <value>ExpTIN,System.String</value>
          <value>ExpCST,System.String</value>
          <value>BgRl,System.Int32</value>
          <value>Kg,System.Decimal</value>
          <value>mtr,System.Decimal</value>
          <value>UOM,System.String</value>
          <value>GatePassFlg,System.String</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>ll,System.String</value>
          <value>Dia,System.String</value>
          <value>ItemDesc,System.String</value>
          <value>GodName,System.String</value>
          <value>GAddress,System.String</value>
          <value>Phone,System.String</value>
          <value>Username,System.String</value>
          <value>DesignDesc,System.String</value>
          <value>GSTNo,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM(dbo.Trs_Del1.DocNo) + '/' + dbo.Trs_Del1.Finyear AS DcNO, dbo.Trs_Del1.Dt, dbo.Mas_Dept.Deptname, 
	CASE dbo.OrderMas.Jobno WHEN 0 THEN CASE dbo.OrderMas.BuyOrdNo WHEN '' THEN 'GENERAL' ELSE 'GENERAL-&gt;' + dbo.OrderMas.BuyOrdNo END ELSE RTRIM(dbo.OrderMas.Jobno)
                       + '/' + RTRIM(dbo.OrderMas.Finyear) + '-&gt;' + RTRIM(dbo.OrderMas.BuyOrdNo) END AS ONo, dbo.Trs_Del1.remark, dbo.Mas_Buyer.ShortBuyer, 
                      dbo.Mas_Vehicle.VName, ISNULL(dbo.Trs_Del1.GPNo, 0) AS GpNo, Mas_Godown_2.GodName AS ToGoDownName, dbo.Mas_Exporter.ExporterName, 
                      dbo.Mas_Exporter.ExporterAddress, REPLACE(CAST(Mas_Godown_2.Address AS varchar(400)), CHAR(10), '') AS GodownAdd, 
                      REPLACE(CAST(Mas_Godown_2.Address AS varchar(400)), CHAR(10), '') AS ToGoDownAdd, Mas_Godown_2.Phone AS ToGoDownPh, dbo.StockTable.LotNo, 
                      dbo.Mas_Exporter.Phone AS ExpPhone, dbo.Mas_Exporter.TIN AS ExpTIN, dbo.Mas_Exporter.CST AS ExpCST, dbo.Trs_Del2.BgRl, dbo.Trs_Del2.Kg, 
                      dbo.Trs_Del2.mtr, CASE WHEN TRS_DEL2.MTR &gt; 0 THEN Mas_Uom.Uom ELSE '' END AS UOM, ISNULL(dbo.Options.GatePassFlg, 'N') AS GatePassFlg, 
                      dbo.StockTable.Gsm, dbo.StockTable.GG, dbo.StockTable.ll, dbo.Mas_Dia.Dia, dbo.Mas_Fabric.Fabdesc + ISNULL('-' + dbo.Mas_Count.CountName, '') 
                      + ISNULL('-' + dbo.Mas_Color.ColorDesc, '') AS ItemDesc, dbo.Mas_Godown.GodName, REPLACE(CAST(dbo.Mas_Godown.Address AS varchar(400)), CHAR(10), '') 
                      AS GAddress, dbo.Mas_Godown.Phone, dbo.Mas_User.Username, dbo.Mas_Design.DesignDesc,ISNULL(Mas_Exporter.GSTNo,'')GSTNo
FROM         dbo.Trs_Del1 INNER JOIN
                      dbo.Trs_Del2 ON dbo.Trs_Del1.ID = dbo.Trs_Del2.ID LEFT OUTER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Mas_Vehicle ON dbo.Trs_Del1.VehicleCode = dbo.Mas_Vehicle.Code INNER JOIN
                      dbo.OrderMas ON dbo.Trs_Del2.OrdId = dbo.OrderMas.OrdId INNER JOIN
                      dbo.Mas_Godown AS Mas_Godown_2 ON dbo.Trs_Del1.Party = Mas_Godown_2.GodID INNER JOIN
                      dbo.Mas_Exporter ON dbo.Trs_Del1.Coycode = dbo.Mas_Exporter.ExpID INNER JOIN
                      dbo.StockTable ON dbo.Trs_Del2.StockID = dbo.StockTable.StockID INNER JOIN
                      dbo.Mas_Fabric ON dbo.StockTable.FabID = dbo.Mas_Fabric.FabID INNER JOIN
                      dbo.Mas_Dia ON dbo.StockTable.DiaID = dbo.Mas_Dia.DiaID INNER JOIN
                      dbo.Mas_Uom ON dbo.Mas_Fabric.PriUomID = dbo.Mas_Uom.UomID INNER JOIN
                      dbo.Mas_Godown ON dbo.Trs_Del1.GodID = dbo.Mas_Godown.GodID LEFT OUTER JOIN
                      dbo.Mas_Design ON dbo.StockTable.PRINT_DESIGNID = dbo.Mas_Design.DesignId LEFT OUTER JOIN
                      dbo.Mas_Buyer ON dbo.OrderMas.BuyerID = dbo.Mas_Buyer.BuyerID LEFT OUTER JOIN
                      dbo.Mas_Count ON dbo.StockTable.CntID = dbo.Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_User ON dbo.Trs_Del1.PreparedBy = dbo.Mas_User.UserCode LEFT OUTER JOIN
                      dbo.Mas_Color ON dbo.StockTable.ColID = dbo.Mas_Color.ColID CROSS JOIN
                      dbo.Options
WHERE     (dbo.Trs_Del1.ID = ?)</SqlCommand>
      </FabDC>
    </DataSources>
