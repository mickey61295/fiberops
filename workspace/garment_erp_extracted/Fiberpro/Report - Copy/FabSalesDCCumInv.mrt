          <value>OutputType,System.String</value>
          <value>DCFormat,System.String</value>
          <value>BgRl,System.Int32</value>
          <value>Kg,System.Decimal</value>
          <value>Rate,System.Decimal</value>
          <value>mtr,System.Decimal</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>ShortBuyer,System.String</value>
          <value>ExpPhone,System.String</value>
          <value>ExpTIN,System.String</value>
          <value>ExpCST,System.String</value>
          <value>PartyDCref,System.String</value>
          <value>CntID,System.Int32</value>
          <value>ColID,System.Int32</value>
          <value>FinGsm,System.Decimal</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>ll,System.String</value>
          <value>DcPre,System.String</value>
          <value>Fabdesc,System.String</value>
          <value>Dia,System.String</value>
          <value>FDia,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>remark,System.String</value>
          <value>UOM,System.String</value>
          <value>ITEMDESC,System.String</value>
          <value>Heading,System.String</value>
          <value>VName,System.String</value>
          <value>GPNo,System.Int32</value>
          <value>GatePassFlg,System.String</value>
          <value>LotNo,System.String</value>
          <value>Username,System.String</value>
          <value>DesignDesc,System.String</value>
          <value>Pname,System.String</value>
          <value>Paddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT TOP 100 PERCENT Trs_Del1.ID, CASE WHEN len(rtrim(Mas_Grp.dcpre)) &lt; 1 THEN 
RTRIM(CAST(Trs_Del1.DocNo AS VARCHAR)) + '/' + Trs_Del1.Finyear ELSE rtrim(Mas_Grp.dcpre) + '-' + 
RTRIM(CAST(Trs_Del1.DocNo AS VARCHAR)) + '/' + Trs_Del1.Finyear END AS DcNo, Trs_Del1.Dt, Trs_Del1.TrType,
ISNULL(TRS_DEL1.dELADD,'A')
 as deladd, 
Trs_Del1.Prs_Dept, Trs_Del1.delwgt, CASE WHEN OrderMas.jobno = 0 THEN '&lt;General&gt;' ELSE 
RTRIM(CAST(OrderMas.Jobno AS VARCHAR)) + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, 
'' as StyleNo, Mas_Dept.Deptname, Mas_Dept.OutputType, Mas_Dept.DCFormat, Trs_Del2.BgRl, Trs_Del2.Kg, 
Trs_Del2.Rate,Trs_Del2.mtr, Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, dbo.Mas_Buyer.ShortBuyer, 
Mas_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN, Mas_Exporter.CST AS ExpCST, Trs_Grn1.PartyDCref, 
StockTable.CntID,StockTable.ColID,StockTable.FinGsm,StockTable.Gsm, StockTable.GG, StockTable.ll, Mas_Grp.DcPre, 
Mas_Fabric.Fabdesc, Mas_Dia.Dia,Mas_FDia.Dia As FDia, Mas_Color.ColorDesc, Mas_Count.CountName, Trs_Del1.remark,
CASE WHEN Trs_Del2.MTR &gt; 0 THEN Mas_Uom.Uom ELSE '' END AS UOM, 

CASE WHEN StockTable.ColID &gt; 0 then
case when StockTable.PRINT_DESIGNID &gt; 0 
 THEN Mas_Fabric.FABDESC + '/' + Mas_Count.COUNTNAME + '/' + 
Mas_Color.COLORDESC +'/'+ Mas_design.designdesc 
else
 Mas_Fabric.FABDESC + '/' + Mas_Count.COUNTNAME + '/' + 
Mas_Color.COLORDESC
end
ELSE
case when StockTable.PRINT_DESIGNID &gt; 0  then
Mas_Fabric.FABDESC + '/' + Mas_Count.COUNTNAME + '/'+  Mas_design.designdesc 
else
Mas_Fabric.FABDESC + '/' + Mas_Count.COUNTNAME
end 
 END AS ITEMDESC, 
CASE Trs_Del1.Trtype WHEN 1 THEN 'PROCESS DELIVERY' WHEN 4 THEN 'PURCHASE RETURN' WHEN 13 
THEN 'PARTY REJECTION RETURN ' when 2 then 'SALES DELIVERY CHALLAN'  END AS Heading,dbo.Mas_Vehicle.VName, 
Trs_Del1.GPNo,  ISNULL(dbo.Options.GatePassFlg, 'N') AS GatePassFlg, ISNULL(StockTable.LotNo, '') AS LotNo,  
dbo.Mas_User.Username, dbo.Mas_Design.DesignDesc,
case when trs_del1.party=0 then Mas_buyer.buyername else   mas_party.Pname end as Pname,
case when trs_del1.party=0 then Mas_buyer.buyeraddress else   mas_party.Pname end as Paddress, 
case when trs_del1.party=0 then Mas_buyer.phone else   mas_party.Phone end as Phone,
case when trs_del1.party=0 then ''  else    mas_party.TIN end as TIN,
case when trs_del1.party=0 then ''  else    mas_party.TIN end as CST
FROM dbo.Trs_Del1 AS Trs_Del1 
INNER JOIN dbo.Trs_Del2 AS Trs_Del2 ON Trs_Del1.ID = Trs_Del2.ID 
left outer JOIN dbo.Mas_Party AS mas_party ON Trs_Del1.Party = mas_party.PID 
INNER JOIN dbo.Mas_Exporter AS Mas_Exporter ON Trs_Del1.Coycode = Mas_Exporter.ExpID 
INNER JOIN dbo.OrderMas AS OrderMas ON Trs_Del2.OrdId = OrderMas.OrdId 
LEFT OUTER JOIN dbo.Trs_Grn1 AS Trs_Grn1 ON Trs_Del1.OurGRNID = Trs_Grn1.ID 
INNER JOIN dbo.StockTable AS StockTable ON Trs_Del2.StockID = StockTable.StockID 
LEFT OUTER JOIN dbo.Mas_Dept AS Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID 
INNER JOIN dbo.Mas_Grp AS Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo 
INNER JOIN dbo.Mas_Dia AS Mas_Dia ON StockTable.DiaID = Mas_Dia.DiaID 
INNER JOIN dbo.Mas_Dia AS Mas_FDia ON StockTable.FinDiaID = Mas_FDia.DiaID 
INNER JOIN dbo.Mas_Fabric AS Mas_Fabric ON StockTable.FabID = Mas_Fabric.FabID 
LEFT OUTER JOIN dbo.Mas_Design ON StockTable.PRINT_DESIGNID = dbo.Mas_Design.DesignId 
LEFT OUTER JOIN dbo.Mas_Buyer ON trs_del1.Buyer = dbo.Mas_Buyer.BuyerID 
LEFT OUTER JOIN dbo.Mas_Vehicle ON Trs_Del1.VehicleCode = dbo.Mas_Vehicle.Code 
LEFT OUTER JOIN dbo.Mas_Count AS Mas_Count ON StockTable.CntID = Mas_Count.CountID 
LEFT OUTER JOIN dbo.Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID 
LEFT OUTER JOIN dbo.Mas_Uom AS Mas_Uom ON Mas_Fabric.SecUomID = Mas_Uom.UomID 
LEFT OUTER JOIN dbo.Mas_User ON Trs_Del1.PreparedBy = dbo.Mas_User.UserCode 
CROSS JOIN dbo.Options
WHERE     (Trs_Del1.ID = ?)
ORDER BY Mas_Fabric.Fabdesc + '/' + Mas_Count.CountName + '/' + Mas_Color.ColorDesc, StockTable.Gsm, StockTable.GG, StockTable.ll, Mas_Dia.Dia</SqlCommand>
      </FabDC>
      <AddDed Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>AddDed</Alias>
        <Columns isList="true" count="3">
          <value>AddDedName,System.String</value>
          <value>Valu,System.Decimal</value>
          <value>Amount,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>AddDed</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>Select Mas_AddDed.AddDedName,Trs_SalInvAddDed.Valu,Trs_SalInvAddDed.Amount 
	From Trs_SalInvAddDed
	Inner Join Mas_AddDed On Trs_SalInvAddDed.AddDedCode=Mas_AddDed.AddDedCode
Inner Join Trs_Del1 On Trs_SalInvAddDed.Id=Trs_Del1.InvId
Where Trs_Del1.Id=? And Mas_AddDed.Grp=1
Order By Mas_AddDed.IndexCode</SqlCommand>
      </AddDed>
    </DataSources>
