<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.0" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <Databases isList="true" count="1">
      <Connection Ref="2" type="Stimulsoft.Report.Dictionary.StiOleDbDatabase" isKey="true">
        <Alias>Connection</Alias>
        <ConnectionString>Provider=SQLOLEDB.1;Persist Security Info=False;User ID=sa;Initial Catalog=JOMS;Data Source=MACHINE-14</ConnectionString>
        <Name>Connection</Name>
        <PromptUserNameAndPassword>False</PromptUserNameAndPassword>
      </Connection>
    </Databases>
    <DataSources isList="true" count="3">
      <FabricsubReport Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabricsubReport</Alias>
        <Columns isList="true" count="16">
          <value>ID,System.Int32</value>
          <value>Clr,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>LL,System.String</value>
          <value>prog,System.Decimal</value>
          <value>progMtr,System.Decimal</value>
          <value>Dia,System.String</value>
          <value>FinDiaID,System.Int32</value>
          <value>ItemDesc,System.String</value>
          <value>Uom,System.String</value>
          <value>Dcrate,System.Decimal</value>
          <value>Ratelbl,System.String</value>
          <value>DesignDesc,System.String</value>
          <value>Head,System.String</value>
          <value>OrderNo,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabricsubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Trs_Del3.ID, Trs_Del3.Clr, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, SUM(Trs_Del3.Prog) AS prog, SUM(Trs_Del3.ProgMtr) AS progMtr, Mas_Dia.Dia, Trs_Del3.FinDiaID,
	CASE WHEN Trs_Del3.Clr = 0 THEN Mas_Fabric.Fabdesc + '/' + Countname ELSE Mas_Fabric.Fabdesc + '/' + Countname + '/' + Mas_Color.ColorDesc END AS ItemDesc,
                       CASE WHEN SUM(Trs_Del3.ProgMtr) &gt; 0 THEN Mas_Uom.Uom ELSE '' END AS Uom, CASE Preprint.DcRateReqd WHEN 1 THEN CASE Isnull(Trs_Del1.processType, 
                      'P') WHEN 'P' THEN CASE WHEN SUM(jobno) &lt;&gt; 0 THEN CASE WHEN SUM(isnull(BudPodet.Rate, 0)) &lt;&gt; 0 THEN SUM(Trs_Del3.Prog * BudPoDet.rate) 
                      / SUM(Trs_Del3.Prog) ELSE SUM(Trs_Del3.Prog * isnull(Pro_ReqKnitt2.rate, 0)) / SUM(Trs_Del3.Prog) END ELSE SUM(Trs_Del3.Prog * isnull(Trs_del3.GeneralRate, 0)) 
                      / SUM(Trs_Del3.Prog) END ELSE 0 END ELSE 0 END AS Dcrate, CASE Preprint.DcRateReqd WHEN 1 THEN CASE Isnull(Trs_Del1.processType, 'P') 
                      WHEN 'P' THEN 'Rate' ELSE '' END ELSE '' END AS Ratelbl, CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar))
                       + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo ,dbo.Mas_Design.DesignDesc,'PROGRAM DETAILS' as Head
FROM         dbo.BudPoMas INNER JOIN
                      dbo.BudPodet ON dbo.BudPoMas.Id = dbo.BudPodet.Id RIGHT OUTER JOIN
                      dbo.Mas_Design RIGHT OUTER JOIN
                      dbo.Mas_Dept INNER JOIN
                      dbo.Trs_Del1 ON dbo.Mas_Dept.DeptID = dbo.Trs_Del1.Prs_Dept INNER JOIN
                      dbo.Trs_Del3 AS Trs_Del3 INNER JOIN
                      dbo.Mas_Fabric AS Mas_Fabric ON Trs_Del3.FabType = Mas_Fabric.FabID ON dbo.Trs_Del1.ID = Trs_Del3.ID ON 
                      dbo.Mas_Design.DesignId = Trs_Del3.Print_DesignId ON dbo.BudPoMas.DeptId = dbo.Trs_Del1.Prs_Dept AND dbo.BudPoMas.PartyId = dbo.Trs_Del1.Party AND 
                      dbo.BudPoMas.OrdId = Trs_Del3.OrdId AND dbo.BudPodet.DiaId = Trs_Del3.DiaID AND dbo.BudPodet.LL = Trs_Del3.LL AND dbo.BudPodet.GG = Trs_Del3.GG AND 
                      dbo.BudPodet.GSM = Trs_Del3.Gsm AND dbo.BudPodet.FabId = Trs_Del3.FabType AND dbo.BudPodet.ColId = Trs_Del3.Clr AND 
                      dbo.BudPodet.CntId = Trs_Del3.Cnt AND 
                      dbo.BudPodet.Findiaid = Trs_Del3.Findiaid AND 
                      dbo.BudPodet.fingsm= Trs_Del3.fingsm LEFT OUTER JOIN
                      dbo.Mas_Dia AS Mas_Dia ON Trs_Del3.DiaID = Mas_Dia.DiaID LEFT OUTER JOIN
                      dbo.Pro_ReqKnitt2 ON dbo.Trs_Del1.Prs_Dept = dbo.Pro_ReqKnitt2.DeptId AND Trs_Del3.OrdId = dbo.Pro_ReqKnitt2.OrdId AND 
                      Trs_Del3.FabType = dbo.Pro_ReqKnitt2.FabId AND Trs_Del3.Clr = dbo.Pro_ReqKnitt2.ColId AND Trs_Del3.Cnt = dbo.Pro_ReqKnitt2.CntID AND 
                      Trs_Del3.Gsm = dbo.Pro_ReqKnitt2.GSM AND Trs_Del3.GG = dbo.Pro_ReqKnitt2.GG AND Trs_Del3.LL = dbo.Pro_ReqKnitt2.LL AND 
                      Trs_Del3.DiaID = dbo.Pro_ReqKnitt2.DiaID AND Trs_Del3.FinDiaID = dbo.Pro_ReqKnitt2.FinDiaId AND Trs_Del3.FinGSm = dbo.Pro_ReqKnitt2.FinGSM AND 
                      Trs_Del3.DiaID = dbo.Pro_ReqKnitt2.DiaID LEFT OUTER JOIN
                      dbo.Mas_Count AS Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID LEFT OUTER JOIN
                      dbo.Mas_Uom AS Mas_Uom ON Mas_Fabric.PriUomID = Mas_Uom.UomID LEFT OUTER JOIN
                      dbo.OrderMas ON dbo.OrderMas.OrdId = Trs_Del3.OrdId CROSS JOIN
                      dbo.PrePrint
WHERE     (dbo.Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.FabType &gt; 0) AND (Trs_Del3.ID =?) AND (dbo.PrePrint.Slno = 2)
GROUP BY Mas_Fabric.Fabdesc, Mas_Count.CountName, Mas_Color.ColorDesc, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, Mas_Dia.Dia,Trs_Del3.FinDiaID, Trs_Del3.ID, Trs_Del3.Clr, 
                      Mas_Uom.Uom, dbo.PrePrint.DcRateReqd, dbo.Trs_Del1.ProcessType, dbo.Mas_Design.DesignDesc,dbo.OrderMas.Jobno,dbo.OrderMas.Finyear,dbo.OrderMas.BuyOrdNo</SqlCommand>
      </FabricsubReport>
      <YarnDC Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>YarnDC</Alias>
        <Columns isList="true" count="49">
          <value>ID,System.Int32</value>
          <value>DcNo,System.String</value>
          <value>Dt,System.DateTime</value>
          <value>TrType,System.Int32</value>
          <value>remark,System.String</value>
          <value>delwgt,System.Decimal</value>
          <value>OrderNo,System.String</value>
          <value>StyleNo,System.String</value>
          <value>Deptname,System.String</value>
          <value>OutputType,System.String</value>
          <value>DCFormat,System.String</value>
          <value>BgRl,System.Int32</value>
          <value>Kg,System.Decimal</value>
          <value>Pname,System.String</value>
          <value>BuyerName,System.String</value>
          <value>Paddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Expr2,System.String</value>
          <value>Expr3,System.String</value>
          <value>Expr4,System.String</value>
          <value>PAN,System.String</value>
          <value>PartyDCref,System.String</value>
          <value>grnwgt,System.Decimal</value>
          <value>DcPre,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>Mill,System.String</value>
          <value>Heading,System.String</value>
          <value>VName,System.String</value>
          <value>Terms,System.String</value>
          <value>Item,System.String</value>
          <value>GPNo,System.Int32</value>
          <value>GatePassFlg1,System.String</value>
          <value>TarDt,System.DateTime</value>
          <value>LotNo,System.String</value>
          <value>Username,System.String</value>
          <value>DcRate,System.Decimal</value>
          <value>Ratelbl,System.String</value>
          <value>GodName,System.String</value>
          <value>GSTNo,System.String</value>
          <value>PGSTNo,System.String</value>
          <value>HSNCode,System.String</value>
          <value>EwayBillNo,System.String</value>
          <value>EwayBillDt,System.DateTime</value>
          <value>Jobno,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Trs_Del1.ID, CASE WHEN len(rtrim(mas_grp.dcpre)) &lt; 1 THEN RTRIM(CAST(Trs_Del1.DocNo AS varchar)) 
                      + '/' + Trs_Del1.Finyear ELSE rtrim(mas_grp.dcpre) + '-' + RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear END AS DcNo, 
                      Trs_Del1.Dt, Trs_Del1.TrType, Trs_Del1.remark, Trs_Del1.delwgt, 
                      CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar))
                       + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, OrderMas2.StyleNo, Mas_Dept.Deptname, Mas_Dept.OutputType, 
                      Mas_Dept.DCFormat, Trs_Del2.BgRl, Trs_Del2.Kg, Mas_Party.Pname, Mas_Buyer.BuyerName, Mas_Party.Paddress, Mas_Party.Phone, 
                      Mas_Party.TIN, Mas_Party.CST, Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone AS Expr2, 
                      Mas_Exporter.TIN AS Expr3, Mas_Exporter.CST AS Expr4,Mas_Exporter.pan AS PAN, Trs_Grn1.PartyDCref, Trs_Grn1.grnwgt, Mas_Grp.DcPre, Mas_Color.ColorDesc, 
                      Mas_Count.CountName, Mas_Mill.Mill, RTRIM(CAST(OrderMas.Jobno AS varchar))
                       + '/' + OrderMas.Finyear as Jobno,
                      CASE Trtype WHEN 1 THEN 'PROCESS DELIVERY' WHEN 4 THEN 'PURCHASE RETURN' WHEN 13 THEN 'PARTY REJECTION RETURN' END AS Heading,
                       Mas_Vehicle.VName, Mas_Terms.Terms, CASE WHEN Mas_Color.ColorDesc IS NOT NULL AND Mas_Mill.Mill IS NOT NULL 
                      THEN Mas_Count.CountName + Mas_Color.ColorDesc + Mas_Mill.Mill WHEN Mas_Color.ColorDesc IS NULL AND Mas_Mill.Mill IS NULL 
                      THEN Mas_Count.CountName WHEN Mas_Color.ColorDesc IS NULL AND Mas_Mill.Mill IS NOT NULL 
                      THEN Mas_Count.CountName + Mas_Mill.Mill WHEN Mas_Color.ColorDesc IS NOT NULL AND Mas_Mill.Mill IS NULL 
                      THEN Mas_Count.CountName + Mas_Color.ColorDesc END AS Item, Trs_Del1.GPNo, ISNULL(Options.GatePassFlg, 'N') AS GatePassFlg1, 
                      Trs_Del1.TarDt, StockTable.LotNo, Mas_User.Username,  CASE Preprint.DcRateReqd WHEN 1 THEN CASE Isnull(Trs_Del1.ProcessType,'P') WHEN 'P' THEN  CASE Isnull(Mas_Dept.ProgFrm_Issue,'N') WHEN 'Y' then  CASE Ordermas.Jobno WHEN 0 THEN Trs_Del3.GeneralRate ELSE case Isnull(BudPodet.Rate,0) when 0 then Pro_ReqYarn2.Rate else BudPodet.Rate end  END  else 0 end else 0 end  ELSE 0 END AS DcRate ,CASE Preprint.DcRateReqd WHEN 1 THEN CASE Isnull(Trs_Del1.ProcessType,'P') WHEN 'P' THEN 'Rate'  else '' end  ELSE '' END AS Ratelbl,GodName
 ,IsNull(Mas_Exporter.GSTNo,'') As GSTNo,IsNull(Mas_Party.GSTNo,'') As PGSTNo,IsNull(Mas_HSN.HSNCode,'') As HSNCode,EwayBillNo,EwayBillDt
 FROM         Mas_User RIGHT OUTER JOIN
                      Trs_Del1 AS Trs_Del1 INNER JOIN
                      Mas_Dept AS Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID INNER JOIN
                      Trs_Del2 AS Trs_Del2 ON Trs_Del1.ID = Trs_Del2.ID INNER JOIN
                      Mas_Party AS Mas_Party ON Trs_Del1.Party = Mas_Party.PID INNER JOIN
                      Mas_Exporter AS Mas_Exporter ON Trs_Del1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      OrderMas AS OrderMas ON Trs_Del2.OrdId = OrderMas.OrdId INNER JOIN
                      OrderMas2 On OrderMas2.ordid=OrderMas.ordid LEFT OUTER JOIN
                      Trs_Grn1 AS Trs_Grn1 ON Trs_Del1.OurGRNID = Trs_Grn1.ID INNER JOIN
                      StockTable AS StockTable ON Trs_Del2.StockID = StockTable.StockID LEFT OUTER JOIN
                      Mas_Grp AS Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo LEFT OUTER JOIN
                      Mas_Buyer ON OrderMas.BuyerID = Mas_Buyer.BuyerID INNER JOIN
                      Mas_Count AS Mas_Count ON StockTable.CntID = Mas_Count.CountID LEFT OUTER JOIN
                      Trs_Del3 ON StockTable.PRINT_DESIGNID = Trs_Del3.Print_DesignId AND StockTable.PrgKnitDiaId = Trs_Del3.PrgKnitDiaId AND 
                      StockTable.PrgKnitGsm = Trs_Del3.PrgKnitGSM AND StockTable.FinDiaID = Trs_Del3.FinDiaID AND StockTable.FinGsm = Trs_Del3.FinGSm AND 
                      StockTable.ActDiaId = Trs_Del3.ActDiaId AND StockTable.ActGsm = Trs_Del3.ActGsm AND StockTable.DiaID = Trs_Del3.DiaID AND 
                      StockTable.ll = Trs_Del3.LL AND StockTable.GG = Trs_Del3.GG AND StockTable.Gsm = Trs_Del3.Gsm AND StockTable.FabID = Trs_Del3.FabType AND
                       StockTable.ColID = Trs_Del3.Clr AND StockTable.CntID = Trs_Del3.Cnt AND Trs_Del2.OrdId = Trs_Del3.OrdId AND 
                      Trs_Del1.ID = Trs_Del3.ID LEFT OUTER JOIN
                      BudPoMas INNER JOIN
                      BudPodet ON BudPoMas.Id = BudPodet.Id ON StockTable.ColID = BudPodet.ColId AND StockTable.CntID = BudPodet.CntId AND 
                      Trs_Del2.OrdId = BudPoMas.OrdId AND Trs_Del1.Party = BudPoMas.PartyId AND Trs_Del1.Prs_Dept = BudPoMas.DeptId and stocktable.millid=BudPoMas.millid LEFT OUTER JOIN
                      Pro_ReqYarn2 ON Trs_Del2.OrdId = Pro_ReqYarn2.OrdId AND Trs_Del1.Prs_Dept = Pro_ReqYarn2.DeptId AND 
                      StockTable.CntID = Pro_ReqYarn2.CountId AND StockTable.ColID = Pro_ReqYarn2.ColId 
					  LEFT OUTER JOIN
                      Pro_ReqYarn2 Pro_ReqYarn2_2 ON Trs_Del2.OrdId = Pro_ReqYarn2_2.OrdId AND StockTable.Dept = Pro_ReqYarn2_2.DeptId AND 
                      StockTable.CntID = Pro_ReqYarn2_2.CountId AND StockTable.ColID = Pro_ReqYarn2_2.ColId 
					  LEFT OUTER JOIN
                      Mas_Mill AS Mas_Mill ON StockTable.MillID = Mas_Mill.MillID LEFT OUTER JOIN
                      Mas_Vehicle ON Trs_Del1.VehicleCode = Mas_Vehicle.Code LEFT OUTER JOIN
                      Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID ON Mas_User.UserCode = Trs_Del1.PreparedBy LEFT OUTER JOIN
                      Mas_Terms AS Mas_Terms ON Mas_Dept.DC_TermCode = Mas_Terms.ID LEFT OUTER JOIN Mas_Godown ON Trs_Del1.GodId = Mas_Godown.GodID
					  Left Join Mas_HSN On Pro_ReqYarn2_2.HSNId=Mas_HSN.Id	
CROSS JOIN
                      PrePrint CROSS JOIN
                      Options
WHERE  trs_del1.id=? and PrePrint.Slno = 1</SqlCommand>
      </YarnDC>
      <YarnSubReport Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>YarnSubReport</Alias>
        <Columns isList="true" count="8">
          <value>Prog,System.Decimal</value>
          <value>ProgMtr,System.Decimal</value>
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>head,System.String</value>
          <value>Dcrate,System.Decimal</value>
          <value>RateLbl,System.String</value>
          <value>OrderNo,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnSubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     TOP 100 PERCENT SUM(Trs_Del3.Prog) AS Prog, SUM(Trs_Del3.ProgMtr) AS ProgMtr, CASE WHEN isnull(ShadeEntry.ShadeNo,'')='' then  Mas_Color.ColorDesc else RTRIM( Mas_Color.ColorDesc) +'/'+ ShadeEntry.ShadeNo end as ColorDesc , Mas_Count.CountName,'PROGRAM DETAILS' as head ,
case Preprint.DcRateReqd when 1 then case Isnull(Trs_Del1.ProcessType,'P') when 'P'then  CASE WHEN SUM(jobno) &lt;&gt; 0 THEN      CASE WHEN SUM(isnull(BudPodet.Rate, 0)) &lt;&gt; 0 THEN SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_Del3.Prog) ELSE SUM(Trs_Del3.Prog * isnull(Pro_ReqYarn2.rate, 0)) / SUM(Trs_Del3.Prog) END  ELSE SUM(Trs_Del3.Prog * isnull(GeneralRate,0)) / SUM(Trs_Del3.Prog) END else 0 end else 0 end  AS Dcrate ,
case Preprint.DcRateReqd when 1 then case Isnull(Trs_Del1.ProcessType,'P') when 'P'then  'Rate'  else '' end else '' end  AS RateLbl,
 CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar))
                       + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo 
FROM         dbo.Pro_ReqYarn2 RIGHT OUTER JOIN
                      dbo.Trs_Del3 AS Trs_Del3 INNER JOIN
                      dbo.Trs_Del1 ON Trs_Del3.ID = dbo.Trs_Del1.ID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID ON dbo.Pro_ReqYarn2.DeptId = dbo.Trs_Del1.Prs_Dept AND 
                      dbo.Pro_ReqYarn2.OrdId = Trs_Del3.OrdId AND dbo.Pro_ReqYarn2.CountId = Trs_Del3.Cnt AND 
                      dbo.Pro_ReqYarn2.ColId = Trs_Del3.Clr LEFT OUTER JOIN
                      dbo.BudPodet INNER JOIN
                      dbo.BudPoMas ON dbo.BudPodet.Id = dbo.BudPoMas.Id ON Trs_Del3.Clr = dbo.BudPodet.ColId AND Trs_Del3.Cnt = dbo.BudPodet.CntId AND 
                      Trs_Del3.OrdId = dbo.BudPoMas.OrdId AND dbo.Trs_Del1.Party = dbo.BudPoMas.PartyId AND dbo.Trs_Del1.Prs_Dept = dbo.BudPoMas.DeptId  LEFT OUTER JOIN
                      dbo.Mas_Count AS Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID
                      LEFT OUTER JOIN OrderMas on ordermas.ordid=trs_del3.ordid CROSS JOIN Preprint
					  left outer join ShadeEntry on trs_del3.ordid=ShadeEntry.OrdId and ShadeEntry.ColId=trs_del3.Clr and ShadeEntry.DeptId=trs_del1.Prs_Dept
WHERE     (dbo.Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.FabType = 0) AND (Trs_Del3.ID = ?) and Preprint.Slno=2 
GROUP BY Mas_Count.CountName, Mas_Color.ColorDesc,Preprint.DcRateReqd ,Trs_Del1.ProcessType,ShadeNo,OrderMas.Jobno,OrderMas.Finyear,OrderMas.BuyOrdNo
ORDER BY Mas_Count.CountName, Mas_Color.ColorDesc
</SqlCommand>
      </YarnSubReport>
    </DataSources>
    <Relations isList="true" count="0" />
    <Report isRef="0" />
    <Variables isList="true" count="8">
      <value>,Buyer,Buyer,System.String,,False,False</value>
