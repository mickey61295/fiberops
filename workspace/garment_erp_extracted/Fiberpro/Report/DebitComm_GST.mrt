        <Alias>Connection</Alias>
        <ConnectionString>Provider=SQLOLEDB.1;Persist Security Info=False;User ID=sa;Initial Catalog=Test;Data Source=MACHINE-29\MSSQL2012</ConnectionString>
        <Name>Connection</Name>
        <PromptUserNameAndPassword>False</PromptUserNameAndPassword>
      </Connection>
