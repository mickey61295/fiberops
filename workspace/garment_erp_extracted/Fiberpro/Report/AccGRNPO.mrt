        </Parameters>
        <SqlCommand>/*SELECT   case when len(rtrim(grnpre))&lt;1 then   RTRIM(CAST(Trs_Grn1.DocNo AS varchar)) + '/' + Trs_Grn1.Finyear else  rtrim(grnpre)+'-'+ RTRIM(CAST(Trs_Grn1.DocNo AS varchar)) + '/' + Trs_Grn1.Finyear end AS GRNNo, Trs_Grn1.dt, Trs_Grn1.PartyDCref, 
                      Trs_Grn1.GRNType, Trs_Grn1.remark, Trs_Grn1.grnwgt, Trs_Grn1.Buyer,Sum(Trs_GRN2.RecKgs) as RecKgs, OrderMas2.StyleNo,  
                      Mas_Party.TIN, Mas_Party.CST, Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone AS ExpPhone, 
                      Mas_Exporter.TIN AS ExpTIN, Mas_Exporter.CST AS ExpCST, Mas_Dept.Deptname,   
                      Mas_Grp.GRNPre, Mas_Color.ColorDesc, Mas_Buyer.BuyerName, Mas_Size.SizeDesc, OrdSizeMas.SNo, Mas_Acc.Acc_Descr, 
                      Mas_AccDes.AccDescription, Mas_Uom.Uom, RefNo = CASE WHEN Trs_Grn1.PoID &gt; 0 THEN rtrim(cast(Trs_Po1.DocNo AS varchar)) 
                      + '/' + Trs_Po1.Finyear ELSE rtrim(cast(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear END,
		      Pname =case when isnull(Trs_Grn1.buyer,0)&gt;0 then Mas_Buyer.BuyerName else Mas_Party.Pname end,
                      Padd =case when isnull(Trs_Grn1.buyer,0)&gt;0 then Mas_Buyer.BuyerAddress else Mas_Party.Paddress end,				 	
		      PPhone= case when isnull(Trs_Grn1.buyer,0)&gt;0 then Mas_Buyer.Phone else Mas_Party.Phone end,				 		
		      LblTIN = case when isnull(Trs_Grn1.buyer,0)&gt;0 then '' else 'TIN' end,				 		
		      LblCST = case when isnull(Trs_Grn1.buyer,0)&gt;0 then '' else 'CST' end,case grntype when 'Acc.Purch' then Mas_Dept.PurGrnFormat  when 'Acc.Proc.Receipt' then Mas_Dept.GRNFormat  end as GRNFormat ,
		      Heading=case grntype when 'Acc.Purch' then 'PURCHASE GOODS RECEIVED NOTE' when 'Acc.Direct' then 'DIRECT GOODS RECEIVED NOTE' when 'Acc.Iss.Ret' then 'ISSUE RETURN'
		      when 'Acc.Proc.Receipt' then 'PROCESS RECEIPT' when 'Acc.Proc.Return' then 'PROCESS RETURN' end,
              ItemDesc =case When isnull(Mas_AccDes.AccDescription,'')='' then Mas_Acc.Acc_Descr else Mas_Acc.Acc_Descr +'(' + Mas_AccDes.AccDescription +')' end ,ExcessQty,partydcdate, Mas_User.UserName,Mas_Exporter.IoNoCaption 
FROM         dbo.Trs_Grn1 Trs_Grn1 INNER JOIN
                      dbo.Trs_GRN2 Trs_GRN2 ON Trs_Grn1.ID = Trs_GRN2.ID INNER JOIN
		              dbo.OrderMas OrderMas ON Trs_Grn2.OrdID = OrderMas.OrdId 
INNER JOIN OrderMas2 ON OrderMas.Ordid = OrderMas2.ORdid
INNER JOIN
                      dbo.Mas_Exporter Mas_Exporter ON Trs_Grn1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.Mas_Dept Mas_Dept ON Trs_Grn1.Dept = Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Trs_Del1 Trs_Del1 ON Trs_Grn1.DCID = Trs_Del1.ID LEFT OUTER JOIN
                      dbo.Trs_Po1 Trs_Po1 ON Trs_Grn1.PoID = Trs_Po1.ID LEFT OUTER JOIN
                      dbo.Mas_Buyer Mas_Buyer ON OrderMas.BuyerID = Mas_Buyer.BuyerID LEFT OUTER JOIN
                      dbo.Mas_Party Mas_Party ON Trs_Grn1.SuppID = Mas_Party.PID INNER JOIN
                      dbo.StockTable StockTable ON Trs_GRN2.StockID = StockTable.StockID LEFT OUTER JOIN
                      dbo.Mas_Grp Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo LEFT OUTER JOIN
                      dbo.Mas_Size Mas_Size ON StockTable.Siz = Mas_Size.SizeID LEFT OUTER JOIN
                      dbo.OrdSizeMas OrdSizeMas ON StockTable.OrdID = OrdSizeMas.OrdID AND StockTable.Siz = OrdSizeMas.SizeID 
					  AND Trs_GRN2.StyleNo=OrdSizeMas.StyleNo	
LEFT OUTER JOIN
                      dbo.Mas_Acc Mas_Acc ON StockTable.Atype = Mas_Acc.ID LEFT OUTER JOIN
                      dbo.Mas_AccDes Mas_AccDes ON StockTable.Ades = Mas_AccDes.ID LEFT OUTER JOIN
                      dbo.Mas_Color Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN
Mas_User On Trs_Grn1.PreparedBy = Mas_User.UserCode  LEFT OUTER JOIN 
                      dbo.Mas_Uom Mas_Uom ON Mas_Acc.UomId = Mas_Uom.UomID
where Trs_Grn1.id=?
Group  By grnpre,Trs_Grn1.DocNo,Trs_Grn1.Finyear,Trs_Grn1.dt, Trs_Grn1.PartyDCref,Trs_Grn1.GRNType, Trs_Grn1.remark, Trs_Grn1.grnwgt, Trs_Grn1.Buyer,OrderMas2.StyleNo,Mas_Party.TIN, Mas_Party.CST, Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone,
Mas_Exporter.TIN , Mas_Exporter.CST ,Mas_Dept.Deptname,Mas_Grp.GRNPre, Mas_Color.ColorDesc, Mas_Buyer.BuyerName, Mas_Size.SizeDesc, OrdSizeMas.SNo, Mas_Acc.Acc_Descr,  Mas_AccDes.AccDescription, Mas_Uom.Uom,Trs_Grn1.PoID,Trs_Po1.DocNo,Trs_Po1.Finyear,Trs_Del1.DocNo,Trs_Del1.Finyear,Mas_Party.Pname,Mas_Buyer.BuyerName,
Mas_Buyer.BuyerAddress , Mas_Party.Paddress,Mas_Buyer.Phone,Mas_Party.Phone,Mas_Dept.PurGrnFormat,Mas_Dept.GRNFormat,Trs_GRN2.ExcessQty
,Trs_Grn1.PartyDcDate,partydcdate, Mas_User.UserName,Mas_Exporter.IoNoCaption 
ORDER BY Mas_Acc.Acc_Descr*/




SELECT   case when len(rtrim(grnpre))&lt;1 or isnull(  len(rtrim(grnpre)),'')='' then   RTRIM(CAST(Trs_Grn1.DocNo AS varchar))  + '/' + Trs_Grn1.Finyear else  rtrim(grnpre)+'-'+ RTRIM(CAST(Trs_Grn1.DocNo AS varchar)) + '/' + Trs_Grn1.Finyear end AS GRNNo, Trs_Grn1.dt, Trs_Grn1.PartyDCref, 
Trs_Grn1.GRNType, Trs_Grn1.remark, Trs_Grn1.grnwgt, Trs_Grn1.Buyer,Sum(Trs_GRN2.RecKgs) as RecKgs, OrderMas2.StyleNo,  
                      Mas_Party.TIN, Mas_Party.CST, Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone AS ExpPhone, 
                      Mas_Exporter.TIN AS ExpTIN, Mas_Exporter.CST AS ExpCST, Mas_Dept.Deptname,   
                      Mas_Grp.GRNPre, Mas_Color.ColorDesc, CASE  when OrderMas.jobno = 0 then ''else  mas_buyer.BuyerName end as BuyerName, Mas_Size.SizeDesc, OrdSizeMas.SNo, Mas_Acc.Acc_Descr, 
                      Mas_AccDes.AccDescription, Mas_Uom.Uom, RefNo = CASE WHEN Trs_Grn1.PoID &gt; 0 THEN rtrim(cast(Trs_Po1.DocNo AS varchar)) 
                      + '/' + Trs_Po1.Finyear ELSE rtrim(cast(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear END,
		      Pname =case when isnull(Trs_Grn1.buyer,0)&gt;0 then Mas_Buyer.BuyerName else Mas_Party.Pname end,
                      Padd =case when isnull(Trs_Grn1.buyer,0)&gt;0 then Mas_Buyer.BuyerAddress else Mas_Party.Paddress end,				 	
		      PPhone= case when isnull(Trs_Grn1.buyer,0)&gt;0 then Mas_Buyer.Phone else Mas_Party.Phone end,				 		
		      LblTIN = case when isnull(Trs_Grn1.buyer,0)&gt;0 then '' else 'TIN' end,				 		
		      LblCST = case when isnull(Trs_Grn1.buyer,0)&gt;0 then '' else 'CST' end,case grntype when 'Acc.Purch' then Mas_Dept.PurGrnFormat  when 'Acc.Proc.Receipt' then Mas_Dept.GRNFormat  end as GRNFormat ,
		      Heading=case grntype when 'Acc.Purch' then 'PURCHASE GOODS RECEIVED NOTE' when 'Acc.Direct' then 'DIRECT GOODS RECEIVED NOTE' when 'Acc.Iss.Ret' then 'ISSUE RETURN'
		      when 'Acc.Proc.Receipt' then 'PROCESS RECEIPT' when 'Acc.Proc.Return' then 'PROCESS RETURN' end,
              ItemDesc =case When isnull(Mas_AccDes.AccDescription,'')='' then Mas_Acc.Acc_Descr else Mas_Acc.Acc_Descr +'(' + Mas_AccDes.AccDescription +')' end ,ExcessQty,partydcdate, Mas_User.UserName,Mas_Exporter.IoNoCaption 
FROM         dbo.Trs_Grn1 Trs_Grn1 INNER JOIN
                      dbo.Trs_GRN2 Trs_GRN2 ON Trs_Grn1.ID = Trs_GRN2.ID INNER JOIN
		              dbo.OrderMas OrderMas ON Trs_Grn2.OrdID = OrderMas.OrdId 
INNER JOIN OrderMas2 ON OrderMas.Ordid = OrderMas2.ORdid
INNER JOIN
                      dbo.Mas_Exporter Mas_Exporter ON Trs_Grn1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.Mas_Dept Mas_Dept ON Trs_Grn1.Dept = Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Trs_Del1 Trs_Del1 ON Trs_Grn1.DCID = Trs_Del1.ID LEFT OUTER JOIN
                      dbo.Trs_Po1 Trs_Po1 ON Trs_Grn1.PoID = Trs_Po1.ID LEFT OUTER JOIN
                      dbo.Mas_Buyer Mas_Buyer ON OrderMas.BuyerID = Mas_Buyer.BuyerID LEFT OUTER JOIN
                      dbo.Mas_Party Mas_Party ON Trs_Grn1.SuppID = Mas_Party.PID INNER JOIN
                      dbo.StockTable StockTable ON Trs_GRN2.StockID = StockTable.StockID LEFT OUTER JOIN
                      dbo.Mas_Grp Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo LEFT OUTER JOIN
                      dbo.Mas_Size Mas_Size ON StockTable.Siz = Mas_Size.SizeID LEFT OUTER JOIN
                      dbo.OrdSizeMas OrdSizeMas ON StockTable.OrdID = OrdSizeMas.OrdID AND StockTable.Siz = OrdSizeMas.SizeID 
					  AND Trs_GRN2.StyleNo=OrdSizeMas.StyleNo	
LEFT OUTER JOIN
                      dbo.Mas_Acc Mas_Acc ON StockTable.Atype = Mas_Acc.ID LEFT OUTER JOIN
                      dbo.Mas_AccDes Mas_AccDes ON StockTable.Ades = Mas_AccDes.ID LEFT OUTER JOIN
                      dbo.Mas_Color Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN
Mas_User On Trs_Grn1.PreparedBy = Mas_User.UserCode  LEFT OUTER JOIN 
                      dbo.Mas_Uom Mas_Uom ON Mas_Acc.UomId = Mas_Uom.UomID
where Trs_Grn1.id=?
Group  By grnpre,Trs_Grn1.DocNo,Trs_Grn1.Finyear,Trs_Grn1.dt, Trs_Grn1.PartyDCref,Trs_Grn1.GRNType, Trs_Grn1.remark, Trs_Grn1.grnwgt, Trs_Grn1.Buyer,OrderMas2.StyleNo,Mas_Party.TIN, Mas_Party.CST, Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone,
Mas_Exporter.TIN , Mas_Exporter.CST ,Mas_Dept.Deptname,Mas_Grp.GRNPre, Mas_Color.ColorDesc, Mas_Buyer.BuyerName, Mas_Size.SizeDesc, OrdSizeMas.SNo, Mas_Acc.Acc_Descr,  Mas_AccDes.AccDescription, Mas_Uom.Uom,Trs_Grn1.PoID,Trs_Po1.DocNo,Trs_Po1.Finyear,Trs_Del1.DocNo,Trs_Del1.Finyear,Mas_Party.Pname,Mas_Buyer.BuyerName,
Mas_Buyer.BuyerAddress , Mas_Party.Paddress,Mas_Buyer.Phone,Mas_Party.Phone,Mas_Dept.PurGrnFormat,Mas_Dept.GRNFormat,Trs_GRN2.ExcessQty
,Trs_Grn1.PartyDcDate,partydcdate, Mas_User.UserName,Mas_Exporter.IoNoCaption,OrderMas.jobno
ORDER BY OrdSizeMas.SNo,Mas_Acc.Acc_Descr
</SqlCommand>
      </AccGRN>
