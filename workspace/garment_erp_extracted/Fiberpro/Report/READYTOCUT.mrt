    <DataSources isList="true" count="1">
      <READYTOCUT Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>READYTOCUT</Alias>
        <Columns isList="true" count="39">
          <value>ID,System.Int32</value>
          <value>docno,System.String</value>
          <value>Deptname,System.String</value>
          <value>DeptID,System.Int32</value>
