          <value>Kg,System.Decimal</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>ExpPhone,System.String</value>
          <value>ExpTIN,System.String</value>
          <value>ExpCST,System.String</value>
          <value>PAN,System.String</value>
          <value>GSTNo,System.String</value>
          <value>remark,System.String</value>
          <value>EwayBillNo,System.String</value>
          <value>EwayBillDt,System.DateTime</value>
          <value>Username,System.String</value>
          <value>DCFormat,System.String</value>
          <value>DesignDesc,System.String</value>
          <value>mtr,System.Decimal</value>
          <value>GrpHeader,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>READYTOCUT</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT Trs_ReadyToCut1.ID,rtrim (Trs_ReadyToCut1.DocNo)+'/' + rtrim (Trs_ReadyToCut1.Finyear) as  docno,Mas_Dept.Deptname,Mas_Dept.DeptID,
	rtrim (OrderMas.Jobno) +'/'+ rtrim  (OrderMas.Finyear) +'/'+ rtrim  (OrderMas.BuyOrdNo) AS ordno , CASE WHEN StockTable.ColID &gt; 0 
THEN FABDESC + '/' + COUNTNAME + '/' + COLORDESC ELSE FABDESC + '/' + COUNTNAME END AS ITEMDESC, CASE WHEN Trs_ReadyToCut2.MTR &gt; 0 THEN ordermas.Uom 
ELSE '' END AS saw, Mas_Fabric.Fabdesc,OrderMas.OrdId,Mas_Color.ColorDesc,Mas_Count.CountName,Mas_Fabric.FabID,Mas_Color.ColID,Mas_Count.CountID,
Trs_ReadyToCut1.Dt,StockTable.LotNo,StockTable.FinGsm,Mas_Dia.Dia,StockTable.Gsm,StockTable.GG,StockTable.ll,ordermas.uom,Trs_ReadyToCut2.BgRl,
Trs_ReadyToCut2.Kg,Mas_Exporter.ExporterName ,Mas_Exporter.ExporterAddress, Mas_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN,
 Mas_Exporter.CST AS ExpCST,Mas_Exporter.pan AS PAN,Mas_Exporter.GSTNo,Trs_ReadyToCut1.remark,EwayBillNo,EwayBillDt, Mas_User.Username,
Mas_Dept.DCFormat,Mas_Design.DesignDesc,Trs_ReadyToCut2.mtr
                     
 FROM Trs_ReadyToCut1 
inner join Trs_ReadyToCut2 on  Trs_ReadyToCut1.ID = Trs_ReadyToCut2.ID 
  inner join OrderMas on  Trs_ReadyToCut2.OrdId = OrderMas.OrdId 
 inner join Mas_Dept on  Trs_ReadyToCut1.Prs_Dept = Mas_Dept.DeptID 
 inner join StockTable on  Trs_ReadyToCut2.TranID = StockTable.StockID 
 INNER JOIN Mas_Exporter  ON Trs_ReadyToCut1.Coycode = Mas_Exporter.ExpID
 left join Mas_Design on Mas_Design.DesignId=StockTable.PRINT_DESIGNID
 left join Mas_Color on Mas_Color.ColID=StockTable.ColID
 left join Mas_Count on Mas_Count.CountID=StockTable.CntID
 left join Mas_Fabric on Mas_Fabric.FabID=StockTable.FabID
 left join Mas_Dia on Mas_Dia.DiaID=StockTable.DiaID
 left join Mas_Dia Mas_Dia1 on Mas_Dia1.DiaID=StockTable.FinDiaID 
 LEFT  JOIN Mas_User ON Trs_ReadyToCut1.PreparedBy = Mas_User.UserCode 
 
  where Trs_ReadyToCut1.ID=?
  ORDER BY Mas_Fabric.Fabdesc + '/' + Mas_Count.CountName + '/' + Mas_Color.ColorDesc, StockTable.Gsm, StockTable.GG, StockTable.ll, Mas_Dia.Dia, Mas_Dia1.Dia

</SqlCommand>
      </READYTOCUT>
