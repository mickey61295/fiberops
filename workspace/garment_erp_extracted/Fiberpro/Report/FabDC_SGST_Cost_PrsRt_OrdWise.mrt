        <Dictionary isRef="1" />
        <Name>FabDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>Select * From VUE_DEL_PRSRT LEFT JOIN Vue_Tmp_DelPrs_Route On VUE_DEL_PRSRT.GrpHeader = Vue_Tmp_DelPrs_Route.GrpDesc And VUE_DEL_PRSRT.ID = Vue_Tmp_DelPrs_Route.ID And Vue_Tmp_DelPrs_Route.OrdId = VUE_DEL_PRSRT.OrdId WHERE VUE_DEL_PRSRT.Id = ? Order By ITEMDESC,Gsm,GG,ll,Dia,FDia</SqlCommand>
      </FabDC>
      <FabricSubReport Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabricSubReport</Alias>
        <Columns isList="true" count="14">
          <value>Clr,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>LL,System.String</value>
          <value>Prog,System.Decimal</value>
          <value>ProgMtr,System.Decimal</value>
          <value>Dia,System.String</value>
          <value>ItemDesc,System.String</value>
          <value>UOM,System.String</value>
          <value>GrpHeader,System.String</value>
          <value>Dcrate,System.Decimal</value>
          <value>Ratelbl,System.String</value>
          <value>DesignDesc,System.String</value>
          <value>Head,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabricSubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Trs_Del3.Clr, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, SUM(Trs_Del3.Prog) AS Prog, SUM(Trs_Del3.ProgMtr) AS ProgMtr, Mas_Dia.Dia, 
	CASE WHEN Trs_del3.clr &gt; 0 THEN Mas_Fabric.Fabdesc + '/' + CountName + '/' + Colordesc ELSE Mas_Fabric.Fabdesc + '/' + CountName END AS ItemDesc, 
                      CASE WHEN SUM(ProgMtr) &gt; 0 THEN Mas_Uom.Uom ELSE '' END AS UOM, 
                      CASE WHEN Trs_del3.clr &gt; 0 THEN CASE WHEN Trs_del3.Print_Designid &gt; 0 THEN Mas_Fabric.Fabdesc + CountName + Colordesc + Mas_design.Designdesc + RTRIM(CAST(trs_del3.Gsm
                       AS varchar)) + RTRIM(CAST(trs_del3.GG AS varchar)) + RTRIM(CAST(trs_del3.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) 
                      ELSE Mas_Fabric.Fabdesc + CountName + Colordesc + RTRIM(CAST(trs_del3.Gsm AS varchar)) + RTRIM(CAST(trs_del3.GG AS varchar)) 
                      + RTRIM(CAST(trs_del3.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) 
                      END ELSE CASE WHEN Trs_del3.Print_Designid &gt; 0 THEN Mas_Fabric.Fabdesc + CountName + Mas_design.Designdesc + RTRIM(CAST(trs_del3.Gsm AS varchar)) 
                      + RTRIM(CAST(trs_del3.GG AS varchar)) + RTRIM(CAST(trs_del3.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) 
                      ELSE Mas_Fabric.Fabdesc + CountName + RTRIM(CAST(trs_del3.Gsm AS varchar)) + RTRIM(CAST(trs_del3.GG AS varchar)) + RTRIM(CAST(trs_del3.ll AS varchar)) 
                      + RTRIM(CAST(Mas_Dia.Dia AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) END END AS GrpHeader, 
                      CASE PrePrint.DcRateReqd WHEN 1 THEN CASE Isnull(Trs_Del1.ProcessType, 'P') WHEN 'P' THEN CASE WHEN SUM(Jobno) 
                      &lt;&gt; 0 THEN CASE SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_Del3.Prog) WHEN 0 THEN SUM(Trs_Del3.Prog * isnull(Pro_ReqKnitt2.rate, 0)) / SUM(Trs_Del3.Prog) 
                      ELSE SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_Del3.Prog) END ELSE SUM(Trs_Del3.Prog * isnull(GeneralRate, 0)) / SUM(Trs_Del3.Prog) 
                      END ELSE 0 END ELSE 0 END AS Dcrate, 
                      CASE WHEN Preprint.DcRateReqd = 1 THEN CASE WHEN Trs_Del1.ProcessType = 'P' THEN 'Rate' ELSE '' END ELSE '' END AS Ratelbl, 
                      Mas_Design.DesignDesc, 'PROGRAM DETAILS' AS Head
FROM         Pro_ReqKnitt2 RIGHT OUTER JOIN
                      Trs_Del3 AS Trs_Del3 INNER JOIN
                      Mas_Fabric AS Mas_Fabric ON Trs_Del3.FabType = Mas_Fabric.FabID INNER JOIN
                      Mas_Dia AS Mas_Dia ON Trs_Del3.DiaID = Mas_Dia.DiaID INNER JOIN
                      Trs_Del1 ON Trs_Del3.ID = Trs_Del1.ID INNER JOIN
                      Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID ON Pro_ReqKnitt2.FinDiaId = Trs_Del3.FinDiaID AND 
                      Pro_ReqKnitt2.FinGSM = Trs_Del3.FinGSm AND Pro_ReqKnitt2.DesignID = Trs_Del3.Print_DesignId AND Pro_ReqKnitt2.ColId = Trs_Del3.Clr AND 
                      Pro_ReqKnitt2.CntID = Trs_Del3.Cnt AND Pro_ReqKnitt2.DiaID = Trs_Del3.DiaID AND Pro_ReqKnitt2.LL = Trs_Del3.LL AND 
                      Pro_ReqKnitt2.GG = Trs_Del3.GG AND Pro_ReqKnitt2.GSM = Trs_Del3.Gsm AND Pro_ReqKnitt2.FabId = Trs_Del3.FabType AND 
                      Pro_ReqKnitt2.OrdId = Trs_Del3.OrdId AND Pro_ReqKnitt2.DeptId = Trs_Del1.Prs_Dept LEFT OUTER JOIN
                      Mas_Design ON Trs_Del3.Print_DesignId = Mas_Design.DesignId LEFT OUTER JOIN
                      BudPodet INNER JOIN
                      BudPoMas ON BudPodet.Id = BudPoMas.Id ON Trs_Del3.DiaID = BudPodet.DiaId AND Trs_Del3.LL = BudPodet.LL AND 
                      Trs_Del3.GG = BudPodet.GG AND Trs_Del3.Gsm = BudPodet.GSM AND Trs_Del3.FabType = BudPodet.FabId AND Trs_Del3.Clr = BudPodet.ColId AND 
                      Trs_Del3.Cnt = BudPodet.CntId AND Trs_Del3.OrdId = BudPoMas.OrdId AND Trs_Del1.Prs_Dept = BudPoMas.DeptId AND 
                      Trs_Del1.Party = BudPoMas.PartyId LEFT OUTER JOIN
                      Mas_Count AS Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      Mas_Color AS Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID LEFT OUTER JOIN
                      Mas_Uom AS Mas_Uom ON Mas_Fabric.SecUomID = Mas_Uom.UomID LEFT OUTER JOIN
                      OrderMas ON OrderMas.OrdId = Trs_Del3.OrdId CROSS JOIN
                      PrePrint
WHERE     (Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.FabType &gt; 0) AND (Mas_Dept.Deptname &lt;&gt; 'DYEING') AND (Trs_Del3.ID = ?) AND (PrePrint.Slno = 2)
GROUP BY Trs_Del3.Clr, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, Mas_Dia.Dia, Mas_Fabric.Fabdesc, Mas_Count.CountName, Mas_Color.ColorDesc, Mas_Uom.Uom, 
                      PrePrint.DcRateReqd, Trs_Del1.ProcessType, Mas_Design.DesignDesc, Trs_Del3.Print_DesignId
ORDER BY Mas_Fabric.Fabdesc + '/' + Mas_Count.CountName + '/' + Mas_Color.ColorDesc, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, Mas_Dia.Dia
</SqlCommand>
      </FabricSubReport>
      <YarnSubReportDataSource Ref="6" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>YarnSubReportDataSource</Alias>
        <Columns isList="true" count="6">
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>Prog,System.Decimal</value>
          <value>Dcrate,System.Decimal</value>
          <value>Ratelbl,System.String</value>
          <value>head,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnSubReportDataSource</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Mas_Color.ColorDesc, Mas_Count.CountName, SUM(Trs_Del3.Prog) AS Prog,
	CASE WHEN Preprint.DcRateReqd = 1 THEN CASE WHEN Trs_Del1.ProcessType = 'P' THEN  CASE WHEN SUM(jobno) &lt;&gt; 0 THEN	
CASE SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_Del3.Prog)   WHEN  0 THEN SUM(Trs_Del3.Prog * isnull(Pro_ReqYarn2.rate, 0)) / SUM(Trs_Del3.Prog) else SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_Del3.Prog)  END   
 else 0 end 
else 0 end else 0 end  AS Dcrate
,CASE WHEN Preprint.DcRateReqd = 1 THEN CASE WHEN Trs_Del1.ProcessType = 'P' THEN   'Rate' ELSE  '' END  ELSE  '' END  AS Ratelbl,'PROGRAM DETAILS' AS head
	FROM        Pro_ReqYarn2 RIGHT OUTER JOIN
                      Trs_Del3 AS Trs_Del3 INNER JOIN
                      Trs_Del1 ON Trs_Del3.ID = Trs_Del1.ID INNER JOIN
                      Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID ON Pro_ReqYarn2.DeptId = Trs_Del1.Prs_Dept AND 
                      Pro_ReqYarn2.OrdId = Trs_Del3.OrdId AND Pro_ReqYarn2.CountId = Trs_Del3.Cnt AND 
                      Pro_ReqYarn2.ColId = Trs_Del3.Clr LEFT OUTER JOIN
                      BudPodet INNER JOIN
                      BudPoMas ON BudPodet.Id = BudPoMas.Id ON Trs_Del3.Clr = BudPodet.ColId AND Trs_Del3.Cnt = BudPodet.CntId AND 
                      Trs_Del3.OrdId = BudPoMas.OrdId AND Trs_Del1.Party = BudPoMas.PartyId AND Trs_Del1.Prs_Dept = BudPoMas.DeptId AND 
                      Trs_Del1.ID = BudPoMas.Id LEFT OUTER JOIN
                      Mas_Count AS Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      Mas_Color AS Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID Left Outer Join ordermas on ordermas.ordid=trs_del3.Ordid cross  join Preprint
WHERE     (Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.FabType = 0) and trs_del3.id=? and Preprint.Slno=2
GROUP BY  Mas_Count.CountName,Mas_Color.ColorDesc,Trs_Del1.ProcessType,Preprint.DcRateReqd
</SqlCommand>
      </YarnSubReportDataSource>
    </DataSources>
