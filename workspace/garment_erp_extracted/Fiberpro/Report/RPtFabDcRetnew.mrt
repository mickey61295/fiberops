    <DataSources isList="true" count="1">
      <FabRetDc Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabRetDc</Alias>
        <Columns isList="true" count="24">
          <value>Fabdesc,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>Gsm,System.Decimal</value>
          <value>ll,System.String</value>
          <value>GG,System.Int32</value>
          <value>fingsm,System.Decimal</value>
          <value>dia,System.String</value>
          <value>findia,System.String</value>
          <value>Uom,System.String</value>
          <value>Mtr,System.Decimal</value>
          <value>Rls,System.Int32</value>
          <value>Kg,System.Decimal</value>
          <value>OrderNo,System.String</value>
          <value>fabdesc1,System.String</value>
          <value>dt,System.DateTime</value>
          <value>docno,System.Int32</value>
          <value>finyear,System.String</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>DesignDesc,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabRetDc</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT dbo.Mas_Fabric.Fabdesc, dbo.Mas_Color.ColorDesc, dbo.Mas_Count.CountName,
	dbo.StockTable.Gsm, dbo.StockTable.ll, dbo.StockTable.GG,dbo.StockTable.fingsm, dbo.Mas_Dia.Dia as dia,d1.Dia as findia,
	dbo.Mas_Uom.Uom,  dbo.Trs_grn2.RecMtr Mtr,dbo.Trs_grn2.Rbag as Rls,dbo.Trs_grn2.RecKgs as Kg, CASE
    WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' +
    OrderMas.BuyOrdNo
    ELSE RTRIM(CAST(OrderMas.Jobno AS VARCHAR)) + '/' + OrderMas.Finyear +
    '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, dbo.Mas_Fabric.FABDESC + '/' +
    dbo.Mas_Count.COUNTNAME + '/' + dbo.Mas_Color.COLORDESC+'/'+ isnull(dbo.Mas_Design.DesignDesc,'') as fabdesc,
     dbo.Trs_grn1.dt,dbo.Trs_grn1.docno, Trs_grn1.finyear,
    dbo.Mas_Exporter.ExporterName, dbo.Mas_Exporter.ExporterAddress,
  dbo.Mas_Exporter.Phone, dbo.Mas_Exporter.TIN, dbo.Mas_Exporter.CST,
  dbo.Mas_Design.DesignDesc  
FROM dbo.StockTable INNER JOIN  dbo.Mas_Fabric ON dbo.StockTable.FabID = dbo.Mas_Fabric.FabID 
INNER JOIN  dbo.Mas_Count ON dbo.StockTable.CntID = dbo.Mas_Count.CountID 
INNER JOIN  dbo.Mas_Dia ON dbo.StockTable.DiaID = dbo.Mas_Dia.DiaID 
INNER JOIN  dbo.Mas_Dia  d1 ON dbo.StockTable.finDiaID = d1.DiaID 
INNER JOIN  dbo.Mas_Uom ON dbo.Mas_Fabric.PriUomID = dbo.Mas_Uom.UomID 
INNER JOIN  dbo.Trs_grn2 ON dbo.StockTable.StockID = dbo.Trs_grn2.StockId
INNER JOIN  dbo.Trs_grn1 ON dbo.Trs_grn2.Id = dbo.Trs_grn1.Id 
INNER JOIN  dbo.OrderMas ON dbo.Trs_grn2.OrdId = dbo.OrderMas.OrdId 
INNER JOIN  dbo.Mas_Color ON dbo.StockTable.ColID = dbo.Mas_Color.ColID 
INNER JOIN  dbo.Mas_Exporter ON dbo.Trs_grn1.Coycode = dbo.Mas_Exporter.ExpID
LEFT  JOIN  dbo.Mas_Design ON dbo.StockTable.PRINT_DESIGNID = dbo.Mas_Design.DesignId
WHERE Trs_grn1.id =? ORDER BY Mas_Fabric.Fabdesc</SqlCommand>
      </FabRetDc>
    </DataSources>
