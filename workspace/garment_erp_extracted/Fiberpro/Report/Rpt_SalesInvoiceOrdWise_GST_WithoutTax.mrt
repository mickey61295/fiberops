          <value>SuppNo,System.String</value>
          <value>Pname,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource3</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_ID,,5,0</value>
        </Parameters>
        <SqlCommand>

--select CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo 
--	ELSE RTRIM(CAST(OrderMas.Jobno AS varchar)) + '/' + OrderMas.Finyear end as supporderno,mas_buyer.buyername 
--from ordermas inner join mas_buyer on mas_buyer.buyerid=ordermas.buyerid where ordid in(select SuppOrdID from trs_Del1 inner join vue_salesinvoice on trs_del1.docno=vue_salesinvoice.docno  where vue_salesinvoice.Invno=?)







select  RTRIM(CAST(SuppOrdMas.SuppNo AS varchar)) + '/' + SuppOrdMas.SuppFyr as SuppNo,mas_party.Pname from ordermas inner join SuppOrdMas on SuppOrdMas.ordid=ordermas.ordid 
	inner join mas_party on Mas_Party.PID=SuppOrdMas.PId where ordermas.ordid in(select suppordid from  trs_Del1 
	inner join vue_salesinvoice on trs_del1.docno=vue_salesinvoice.docno   where vue_salesinvoice.Id=?)

</SqlCommand>
      </DataSource3>
