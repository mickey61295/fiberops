        <Name>DataSource2</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_ID,,5,0</value>
        </Parameters>
        <SqlCommand>--select Mas_AddDed.AddDedName,Trs_JWrkInvAddded.Amount from Trs_JobWrkInv inner join Trs_JWrkInvAddded on Trs_JobWrkInv.id=Trs_JWrkInvAddded.id
--inner join Mas_AddDed  on Mas_AddDed.AddDedCode=Trs_JWrkInvAddded.AddDedCode
 --where Trs_JobWrkInv.ID =? and grp=5  order by Mas_AddDed.indexcode

/*Select AddDedName,Amount,AddDedCode,id From ( select Mas_AddDed.AddDedName,Trs_JWrkInvAddded.Amount,Trs_JWrkInvAddded.AddDedCode,Trs_JobWrkInv.ID from Trs_JobWrkInv inner join Trs_JWrkInvAddded on Trs_JobWrkInv.id=Trs_JWrkInvAddded.id
inner join Mas_AddDed  on Mas_AddDed.AddDedCode=Trs_JWrkInvAddded.AddDedCode
 where  grp=5  
 union all
select Mas_AddDed.AddDedName,Trs_SalInvAddded.Amount,Trs_SalInvAddded.AddDedCode,Trs_SalInv.ID from Trs_SalInv inner join Trs_SalInvAddded on Trs_SalInv.id=Trs_SalInvAddded.id
inner join Mas_AddDed  on Mas_AddDed.AddDedCode=Trs_SalInvAddded.AddDedCode
 where grp=1 )X Where Id=?*/
 



/*Select AddDedName,Amount,AddDedCode,id ,indexcode From ( select Mas_AddDed.AddDedName,Trs_JWrkInvAddded.Amount,Trs_JWrkInvAddded.AddDedCode,Trs_JobWrkInv.ID,Mas_AddDed.indexcode from Trs_JobWrkInv 
inner join Trs_JWrkInvAddded on Trs_JobWrkInv.id=Trs_JWrkInvAddded.id inner join Mas_AddDed  on Mas_AddDed.AddDedCode=Trs_JWrkInvAddded.AddDedCode
where  grp=5  union all select Mas_AddDed.AddDedName,Trs_SalInvAddded.Amount,Trs_SalInvAddded.AddDedCode,Trs_SalInv.ID,Mas_AddDed.indexcode from Trs_SalInv inner join Trs_SalInvAddded on Trs_SalInv.id=Trs_SalInvAddded.id
inner join Mas_AddDed  on Mas_AddDed.AddDedCode=Trs_SalInvAddded.AddDedCode
 where grp=1 )X  Where Id= ? and x.AddDedName='Discount Amt' order by indexcode */

/*select * from Vue_OtherCharge Where Id= ? and AddDedName&lt;&gt;'Assessable Value' and AddDedCode&lt;&gt;2  and AddDedCode&lt;&gt;1 order by indexcode*/
	
select * from Vue_OtherCharge Where Id= ? and AddDedName&lt;&gt;'Assessable Value'  order by indexcode	
</SqlCommand>
      </DataSource2>
      <DataSource3 Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource3</Alias>
