          <value>ID,System.Int32</value>
          <value>PopNum,System.String</value>
          <value>ArticleNum,System.String</value>
          <value>StyleDesc,System.String</value>
          <value>HSCode,System.String</value>
          <value>PONO,System.String</value>
          <value>Qty,System.Decimal</value>
          <value>Rate,System.Decimal</value>
          <value>TotalAmount,System.Decimal</value>
          <value>Discount,System.Decimal</value>
          <value>Taxablevalue,System.Decimal</value>
          <value>ImpAddress,System.String</value>
          <value>ImpGSTno,System.String</value>
          <value>ExpState,System.String</value>
          <value>ExpStateid,System.Int32</value>
          <value>ImpStateid,System.String</value>
          <value>ImpStateName,System.String</value>
          <value>NoofCartons,System.String</value>
          <value>UOM,System.String</value>
          <value>TotalAmount1,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>Select Mas_Exporter.ExporterName, convert(varchar(200),Mas_Exporter.ExporterAddress) ExporterAddress,'TEL : ' + RTRIM(Mas_Exporter.Phone)  AS Phone,'TIN No : ' + RTRIM(Mas_Exporter.TIN) As Tin,'CST No : ' + RTRIM( Mas_Exporter.CST) As CST,'Excise regn No  : ' + RTRIM(isnull(Mas_Exporter.AEPCRegnNo,'')) As RegnNo, Mas_exporter.GSTNo,Mas_Importer.BuyerName AS ImpName,Mas_Importer.BuyerID AS ImpId,
Mas_Importer.BuyerAddress As ImpAddress,isnull(Mas_Importer.Gstno,'') AS ImpGSTno,Mas_State.StateName As ExpState,Mas_Exporter.Stateid As ExpStateid,isnull(Mas_State1.StateCode,'') AS ImpStateid,isnull(Mas_State1.StateName,'') AS ImpStateName,Mas_DelTo.BuyerName AS DelToName, Mas_DelTo.BuyerID AS DelToId, Mas_Consignee.BuyerName AS ConsName,Mas_Consignee.BuyerID AS ConsId,Mas_Consignee.BuyerAddress ConsigneeAdd,Trs_Inv_Domestic.InvId,Trs_Inv_Domestic.InvNo, Trs_Inv_Domestic.Finyear,Trs_Inv_Domestic.InvoicePrefix,Trs_Inv_Domestic.InvoicePostfix,
Trs_Inv_Domestic.InvDate,trs_Inv_DomesticDet.Styleno,Ship_StyledescMas.ID,trs_Inv_DomesticDet.PopNum,
trs_Inv_DomesticDet.ArticleNum,Ship_StyledescMas.StyleDesc,Ship_StyledescMas.HSCode,trs_Inv_DomesticDet.PONO,trs_Inv_DomesticDet.Qty,
trs_Inv_DomesticDet.Rate,Sum(Isnull(Qty,0)*Isnull(Rate,0)) As TotalAmount,trs_Inv_DomesticDet.Discount,Trs_Inv_Domestic.Taxablevalue,
trs_Inv_Domestic.NoofCartons,trs_Inv_DomesticDet.UOM,trs_Inv_DomesticDet.TotalAmount As TotalAmount1
From Mas_Exporter
INNER JOIN  Trs_Inv_Domestic ON Trs_Inv_Domestic.ExporterCode=Mas_Exporter.ExpID LEFT OUTER JOIN Mas_Buyer 
AS Mas_Importer ON Trs_Inv_Domestic.ImporterCode = Mas_Importer.BuyerID LEFT OUTER JOIN Mas_Buyer AS Mas_DelTo ON 
Trs_Inv_Domestic.DelTo = Mas_DelTo.BuyerID LEFT OUTER JOIN Mas_Buyer AS Mas_Consignee ON Trs_Inv_Domestic.Consignee = Mas_Consignee.BuyerID
INNER JOIN trs_Inv_DomesticDet ON trs_Inv_DomesticDet.InvId=Trs_Inv_Domestic.InvId INNER JOIN Ship_StyledescMas ON trs_Inv_DomesticDet.Description = Ship_StyledescMas.ID LEFT OUTER JOIN Mas_State ON Mas_State.StateCode=Mas_Exporter.Stateid LEFT OUTER JOIN Mas_State Mas_State1 ON Mas_State1.StateCode=Mas_Importer.Stateid 
Where Trs_Inv_Domestic.invid=3
Group By Mas_Exporter.ExporterName,Mas_Exporter.ExporterAddress ,Mas_Exporter.Phone ,Mas_Exporter.TIN , Mas_Exporter.CST,(isnull(Mas_Exporter.AEPCRegnNo,'')) , Mas_exporter.GSTNo,Mas_Importer.BuyerName,Mas_Importer.BuyerID ,Mas_DelTo.BuyerName, Mas_DelTo.BuyerID , Mas_Consignee.BuyerName,Mas_Consignee.BuyerID ,Mas_Consignee.BuyerAddress,Trs_Inv_Domestic.InvId,Trs_Inv_Domestic.InvNo, Trs_Inv_Domestic.Finyear,Trs_Inv_Domestic.InvoicePrefix,Trs_Inv_Domestic.InvoicePostfix,Trs_Inv_Domestic.InvDate,trs_Inv_DomesticDet.Styleno,
Ship_StyledescMas.ID,trs_Inv_DomesticDet.PopNum,trs_Inv_DomesticDet.ArticleNum,Ship_StyledescMas.StyleDesc,Ship_StyledescMas.HSCode,
trs_Inv_DomesticDet.PONO,trs_Inv_DomesticDet.Qty,trs_Inv_DomesticDet.Rate,trs_Inv_DomesticDet.Discount,Trs_Inv_Domestic.Taxablevalue ,
Mas_Importer.BuyerAddress,Mas_Importer.Gstno,Mas_State.StateName,Mas_Exporter.Stateid,isnull(Mas_State1.StateCode,'') ,isnull(Mas_State1.StateName,''),
trs_Inv_Domestic.NoofCartons,trs_Inv_DomesticDet.UOM,trs_Inv_DomesticDet.TotalAmount</SqlCommand>
      </DataSource1>
      <DataSource2 Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource2</Alias>
        <Columns isList="true" count="9">
          <value>InvId,System.Int32</value>
          <value>HSNCode,System.String</value>
          <value>TaxableAmt,System.Decimal</value>
          <value>CGSTPer,System.Decimal</value>
          <value>SGSTPer,System.Decimal</value>
          <value>IGSTPer,System.Decimal</value>
          <value>CGSTAmt,System.Decimal</value>
          <value>SGSTAmt,System.Decimal</value>
          <value>IGSTAmt,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource2</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>select trs_Inv_DomesticDet.InvId,IsNull(Mas_HSN.HSNCode,'') as HSNCode,Sum(trs_Inv_DomesticDet.TotalAmount) as TaxableAmt,
	Case When IsNull(Mas_Exporter.Stateid,1)=IsNull(Mas_Party.Stateid,1) Then IsNull(trs_Inv_DomesticDet.TaxPer,0)/2  End as CGSTPer,
Case When IsNull(Mas_Exporter.Stateid,1)=IsNull(Mas_Party.Stateid,1) Then IsNull(trs_Inv_DomesticDet.TaxPer,0)/2 End as SGSTPer,
Case When IsNull(Mas_Exporter.Stateid,1)&lt;&gt;IsNull(Mas_Party.Stateid,1) Then IsNull(trs_Inv_DomesticDet.TaxPer,0) End as IGSTPer,  
Case When IsNull(Mas_Exporter.Stateid,1)=IsNull(Mas_Party.Stateid,1) Then  ((IsNull(trs_Inv_DomesticDet.TaxPer,0)/2)*Sum(trs_Inv_DomesticDet.TotalAmount)/100) End   as CGSTAmt,
Case When IsNull(Mas_Exporter.Stateid,1)=IsNull(Mas_Party.Stateid,1) Then   ((IsNull(trs_Inv_DomesticDet.TaxPer,0)/2)*Sum(trs_Inv_DomesticDet.TotalAmount)/100)  End as SGSTAmt,
Case When IsNull(Mas_Exporter.Stateid,1)&lt;&gt;IsNull(Mas_Party.Stateid,1) Then  ((IsNull(trs_Inv_DomesticDet.TaxPer,0))*Sum(trs_Inv_DomesticDet.TotalAmount)/100) End as IGSTAmt 
From Ship_StyledescMas INNER JOIN trs_Inv_DomesticDet ON trs_Inv_DomesticDet.Description=Ship_StyledescMas.ID 
LEFT OUTER JOIN Mas_HSN ON trs_Inv_DomesticDet.HSNCode=Mas_HSN.Id INNER JOIN Trs_Inv_Domestic ON Trs_Inv_Domestic.InvId=trs_Inv_DomesticDet.InvId 
INNER JOIN Mas_Exporter ON Mas_Exporter.ExpID=trs_Inv_Domestic.ExporterCode INNER JOIN Mas_Buyer Mas_Party 
ON Mas_Party.BuyerID=Trs_Inv_Domestic.ImporterCode
Where Trs_Inv_Domestic.Invid=3
GROUP BY trs_Inv_DomesticDet.InvId,Mas_HSN.HSNCode,Mas_Exporter.Stateid,Mas_Party.Stateid,Mas_HSN.NBPercL,Mas_HSN.NBPercH,
trs_Inv_DomesticDet.TaxPer</SqlCommand>
      </DataSource2>
      <TaxDet Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>TaxDet</Alias>
        <Columns isList="true" count="4">
          <value>AddDedCode,System.Int32</value>
          <value>AddDedName,System.String</value>
          <value>Valu,System.Decimal</value>
          <value>amt,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>TaxDet</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>select Distinct indexcode,Mas_AddDed.AddDedCode,AddDedName,Valu,amt from Trs_InvAddDedDomestic inner join Mas_AddDed 
on Trs_InvAddDedDomestic.AddDedCode=Mas_AddDed.AddDedCode INNER JOIN Mas_Fgrp ON Mas_Fgrp.Grp_Code=Mas_AddDed.Grp 
where Trs_InvAddDedDomestic.ID=3 And Grp_Code=9 Order By indexcode</SqlCommand>
      </TaxDet>
    </DataSources>
