          <value>ConsId,System.Int32</value>
          <value>ConsigneeAdd,System.String</value>
          <value>InvId,System.Int32</value>
          <value>InvNo,System.Int32</value>
          <value>Finyear,System.String</value>
          <value>InvoicePrefix,System.String</value>
