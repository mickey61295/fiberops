    <Databases isList="true" count="1">
      <Connection Ref="2" type="Stimulsoft.Report.Dictionary.StiOleDbDatabase" isKey="true">
        <Alias>Connection</Alias>
        <ConnectionString>Provider=SQLOLEDB.1;Persist Security Info=False;User ID=sa;Initial Catalog=nivvi;Data Source=machine-15</ConnectionString>
        <Name>Connection</Name>
        <PromptUserNameAndPassword>False</PromptUserNameAndPassword>
      </Connection>
    </Databases>
    <DataSources isList="true" count="1">
      <DataSource1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="15">
          <value>exportername,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Expr1,System.String</value>
          <value>selection,System.String</value>
          <value>StyleNo,System.String</value>
          <value>Descr,System.String</value>
          <value>Remarks,System.String</value>
          <value>Amount,System.Decimal</value>
          <value>ExpDate,System.DateTime</value>
          <value>id,System.Int32</value>
          <value>Username,System.String</value>
          <value>Docno,System.Int32</value>
          <value>finyear,System.String</value>
          <value>Pname,System.String</value>
          <value>BillNo,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>select exportername,ExporterAddress,RTRIM(OrderMas.Jobno) + '/' + OrderMas.Finyear +'-&gt;'+ OrderMas.BuyOrdNo AS Expr1,case when Trs_Expenses.type='S' then 'SPECIFIC' else 'ALL' END AS selection,StyleNo,Mas_Commercial.Descr,Remarks,Amount,ExpDate,Trs_Expenses.id,isnull(Username,'') as Username,Docno,Trs_Expenses.finyear,Mas_Party.Pname AS Pname,Trs_Expenses.BillNo AS BillNo  from ordermas inner join Trs_Expenses on Trs_Expenses.ordid=ordermas.OrdId inner join Mas_Commercial on Mas_Commercial.id=Trs_Expenses.ExpId Left Join mas_user on mas_user.UserCode =Trs_Expenses.UserId inner join Mas_Exporter on Mas_Exporter.ExpID=Trs_Expenses.Coycode LEFT JOIN Mas_Party ON Mas_Party.PID = Trs_Expenses.PartyID where Trs_Expenses.id=?</SqlCommand>
      </DataSource1>
    </DataSources>
    <Relations isList="true" count="0" />
    <Report isRef="0" />
    <Variables isList="true" count="0" />
  </Dictionary>
