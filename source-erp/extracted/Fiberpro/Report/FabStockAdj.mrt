          <value>ExporterAddress,System.String</value>
          <value>ExpPhone,System.String</value>
          <value>ExpTIN,System.String</value>
          <value>ExpCST,System.String</value>
          <value>CntID,System.Int32</value>
          <value>ColID,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>ll,System.String</value>
          <value>Fabdesc,System.String</value>
          <value>Dia,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>UOM,System.String</value>
          <value>ITEMDESC,System.String</value>
          <value>StockAddLess,System.String</value>
          <value>UserName,System.String</value>
          <value>Remark,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Trs_Del1.ID, RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear AS DcNo, Trs_Del1.Dt, Trs_Del1.TrType, Trs_Del1.Prs_Dept, 
                      RTRIM(CAST(OrderMas.Jobno AS varchar)) + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo AS OrderNo, ORDERMAS2.StyleNo, Mas_Dept.Deptname, 
                      Mas_Dept.OutputType, Trs_Del2.BgRl, Trs_Del2.Kg, Trs_Del2.mtr, Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, 
                      Mas_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN, Mas_Exporter.CST AS ExpCST, StockTable.CntID, StockTable.ColID, 
                      StockTable.Gsm, StockTable.GG, StockTable.ll, Mas_Fabric.Fabdesc, Mas_Dia.Dia, Mas_Color.ColorDesc, Mas_Count.CountName, 
                      CASE WHEN TRS_DEL2.MTR &gt; 0 THEN Mas_Uom.Uom ELSE '' END AS UOM, 
                      CASE WHEN StockTable.ColID &gt; 0 THEN FABDESC + '/' + COUNTNAME + '/' + COLORDESC ELSE FABDESC + '/' + COUNTNAME END AS ITEMDESC, 
                      Trs_Del1.StockAddLess, Mas_User.UserName,Remark
FROM         dbo.Trs_Del1 AS Trs_Del1 INNER JOIN
                      dbo.Mas_Dept AS Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID INNER JOIN
                      dbo.Trs_Del2 AS Trs_Del2 ON Trs_Del1.ID = Trs_Del2.ID INNER JOIN
                      dbo.Mas_Exporter AS Mas_Exporter ON Trs_Del1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.OrderMas AS OrderMas ON Trs_Del2.OrdID = OrderMas.OrdId 
INNER JOIN ORDERMAS2 ON ORDERMAS.ORDID = ORDERMAS2.ORDID
INNER JOIN
                      dbo.StockTable AS StockTable ON Trs_Del2.StockID = StockTable.StockID INNER JOIN
                      dbo.Mas_Dia AS Mas_Dia ON StockTable.DiaID = Mas_Dia.DiaID INNER JOIN
                      dbo.Mas_Fabric AS Mas_Fabric ON StockTable.FabID = Mas_Fabric.FabID LEFT OUTER JOIN
                      dbo.Mas_Count AS Mas_Count ON StockTable.CntID = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN
                      dbo.Mas_Uom AS Mas_Uom ON Mas_Fabric.SecUomID = Mas_Uom.UomID  LEFT OUTER JOIN Mas_User On Trs_Del1.PreparedBy = Mas_User.UserCode  
where Trs_del1.id=?
ORDER BY FABDESC +'/'+COUNTNAME +'/'+COLORDESC,StockTable.GSM,StockTable.GG,StockTable.LL,Mas_Dia.DIA
</SqlCommand>
      </FabDC>
    </DataSources>
