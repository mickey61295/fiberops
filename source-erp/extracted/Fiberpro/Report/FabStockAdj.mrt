    <DataSources isList="true" count="1">
      <FabDC Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabDC</Alias>
        <Columns isList="true" count="31">
          <value>ID,System.Int32</value>
          <value>DcNo,System.String</value>
          <value>Dt,System.DateTime</value>
          <value>TrType,System.Int32</value>
          <value>Prs_Dept,System.Int32</value>
          <value>OrderNo,System.String</value>
