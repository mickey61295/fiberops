          <value>RefNoHeading,System.String</value>
          <value>LotNo,System.String</value>
          <value>UserName,System.String</value>
          <value>RejBag,System.Int32</value>
          <value>RejKgs,System.Decimal</value>
          <value>AccBag,System.Int32</value>
          <value>AccKgs,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnGRN</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     CASE WHEN len(rtrim(grnpre)) &lt; 1 THEN RTRIM(CAST(Trs_Grn1.DocNo AS varchar)) + '/' + Trs_Grn1.Finyear ELSE rtrim(grnpre) 
                      + '-' + RTRIM(CAST(Trs_Grn1.DocNo AS varchar)) + '/' + Trs_Grn1.Finyear END AS GrnNo, 
                      CASE Grntype WHEN 'Purchase' THEN 'GOODS RECEIVED NOTE' WHEN 'Process' THEN 'PROCESS RECEIPT' WHEN 'Process Return' THEN 'PROCESS RETURN'
                       END AS Heading, 
                      CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar))
                       + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, CASE WHEN trs_grn1.POId &gt; 0 THEN RTRIM(CAST(Trs_Po1.DocNo AS varchar))
                       + '/' + Trs_Po1.Finyear ELSE rtrim(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear END AS RefNo, Trs_Grn1.dt, Trs_Grn1.PartyDCref, 
                      RTRIM(CAST(Trs_Grn1.PartyDCref AS varchar)) + '-&gt;' + CONVERT(Varchar(8), Trs_Grn1.PartyDcDate, 3) AS ParDcRefDate, Trs_Grn1.PartyDcDate, 
                      Trs_Grn1.PoID, Trs_Grn1.GRNType, Trs_Grn1.remark, Trs_Grn1.grnwgt, Trs_GRN2.RBag, Trs_GRN2.RecKgs,X.RejBag,X.RejKgs,Isnull(Trs_Grn2.RBag,0)-Isnull(X.Rejbag,0) as AccBag,Isnull(Trs_Grn2.Reckgs,0)-Isnull(X.Rejkgs,0) as AccKgs, OrderMas2.StyleNo, 
                      CASE Grntype WHEN 'Purchase' THEN Mas_Dept.PurGrnFormat when 'Process' then Mas_Dept.GRNFormat end as GRNFormat, Mas_Party.Pname, Mas_Buyer.ShortBuyer, Mas_Party.Paddress, Mas_Party.Phone, Mas_Party.TIN, Mas_Party.CST, 
                      Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN, 
                      Mas_Exporter.CST AS ExpCST, Mas_Dept.Deptname, Mas_Dept.RecMethod, Mas_Grp.GRNPre, Mas_Mill.ShortMill, Mas_Count.CountName, 
                      Mas_Color.ColorDesc, CASE StockTable.ColID WHEN 0 THEN Countname ELSE Countname + '/' + colordesc END AS CountColor, 
                      CASE Grntype WHEN 'Purchase' THEN 'Our PO No' WHEN 'Process' THEN 'Our DC No' WHEN 'Process Return' THEN 'Our DC No' END AS RefNoHeading,StockTable.LotNo, Mas_User.UserName
FROM         dbo.Trs_Grn1 AS Trs_Grn1 INNER JOIN
                      dbo.Trs_GRN2 AS Trs_GRN2 ON Trs_Grn1.ID = Trs_GRN2.ID INNER JOIN
                      dbo.OrderMas AS OrderMas ON Trs_GRN2.ordid = OrderMas.OrdId 
INNER JOIN OrderMAs2 ON OrderMas.Ordid = OrderMAs2.ORdid
INNER JOIN
                      dbo.Mas_Party AS Mas_Party ON Trs_Grn1.SuppID = Mas_Party.PID INNER JOIN
                      dbo.StockTable AS StockTable ON Trs_GRN2.StockID = StockTable.StockID INNER JOIN
dbo.Mas_Count AS Mas_Count ON StockTable.CntID = Mas_Count.CountID Inner Join (Select Grnid,Ordid,Stockid,Sum(Rejkgs) as RejKgs,sum(Rejbag) as rejBag,Sum(Rejmtr) as rejMtr From Grn_Rejection group by  Grnid,Ordid,Stockid)X On X.stockid=Trs_Grn2.Stockid And X.Ordid=Trs_Grn2.Ordid and X.Grnid=Trs_Grn1.ID LEFT OUTER JOIN
                      dbo.Mas_Exporter AS Mas_Exporter ON Trs_Grn1.Coycode = Mas_Exporter.ExpID LEFT OUTER JOIN
                      dbo.Mas_Dept AS Mas_Dept ON Trs_Grn1.Dept = Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Trs_Del1 AS Trs_Del1 ON Trs_Grn1.DCID = Trs_Del1.ID LEFT OUTER JOIN
                      dbo.Trs_Po1 AS Trs_Po1 ON Trs_Grn1.PoID = Trs_Po1.ID LEFT OUTER JOIN
                      dbo.Mas_Grp AS Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo LEFT OUTER JOIN
                      dbo.Mas_Mill AS Mas_Mill ON StockTable.MillID = Mas_Mill.MillID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN
                      dbo.Mas_Buyer AS Mas_Buyer ON OrderMas.BuyerID = Mas_Buyer.BuyerID LEFT OUTER JOIN
Mas_User ON Trs_Grn1.PreparedBy = Mas_User.UserCode
WHERE     (Trs_Grn1.ID = ?)</SqlCommand>
      </YarnGRN>
    </DataSources>
