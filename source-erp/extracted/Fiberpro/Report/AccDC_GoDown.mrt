          <value>TGPhone,System.String</value>
          <value>TGAddress,System.String</value>
          <value>TGFax,System.String</value>
          <value>TGEMailid,System.String</value>
          <value>EMailid,System.String</value>
          <value>UserName,System.String</value>
          <value>GSTNo,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>AccDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     TOP 100 PERCENT CASE WHEN len(rtrim(dcpre)) &lt; 1 THEN RTRIM(CAST(Trs_Del1.DocNo AS VARCHAR)) + '/' + Trs_Del1.Finyear ELSE rtrim(dcpre) 
                      + '-' + RTRIM(CAST(Trs_Del1.DocNo AS VARCHAR)) + '/' + Trs_Del1.Finyear END AS DCNO, Trs_Del1.Dt, Trs_Del1.TrType, Trs_Del1.remark, 
                      Trs_Del1.delwgt, Trs_Del2.ID, Trs_Del2.StockID, Trs_Del2.Kg, Mas_Exporter.ExporterName, mas_buyer.BuyerName, Mas_Exporter.ExporterAddress, 
                      Mas_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN, Mas_Exporter.CST AS ExpCST, Mas_Dept.Deptname, Mas_Dept.DCFormat, 
                      CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' ELSE RTRIM(CAST(OrderMas.Jobno AS varchar)) 
                      + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, OrderMas2.StyleNo, Mas_Grp.DcPre, Mas_Color.ColorDesc, 
                      Mas_Acc.Acc_Descr, Mas_AccDes.AccDescription, OrdSizeMas.SNo, Mas_Size.SizeDesc, Mas_Uom.Uom, 
                      CASE WHEN isnull(Mas_AccDes.AccDescription, '') 
                      = '' THEN Mas_Acc.Acc_Descr ELSE Mas_Acc.Acc_Descr + '(' + Mas_AccDes.AccDescription + ')' END AS ItemDesc, 
                       CASE WHEN isnull(Trs_Del1.buyer, 0) &gt; 0 THEN '' ELSE 'TIN :' END AS LblTIN, CASE WHEN isnull(Trs_Del1.buyer, 0) 
                      &gt; 0 THEN '' ELSE 'CST :' END AS LblCST, Trs_Del1.GPNo, ISNULL(dbo.Options.GatePassFlg, 'N') AS GatePassFlg, Trs_Del1.TarDt, 
                      dbo.Mas_Godown.GodName, dbo.Mas_Godown.Address, dbo.Mas_Godown.Phone, dbo.Mas_Godown.Fax, ToGodown.GodName AS TGodName, 
                      ToGodown.Phone AS TGPhone, ToGodown.Address AS TGAddress, ToGodown.Fax AS TGFax, ToGodown.EMailid as TGEMailid, 
                      dbo.Mas_Godown.EMailid , Mas_User.UserName,ISNULL(Mas_Exporter.GSTNo,'')GSTNo
FROM         dbo.Trs_Del1 AS Trs_Del1 INNER JOIN
                      dbo.Mas_Exporter AS Mas_Exporter ON Trs_Del1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.Mas_Dept AS Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID INNER JOIN
                      dbo.Trs_Del2 AS Trs_Del2 ON Trs_Del1.ID = Trs_Del2.ID INNER JOIN
                      dbo.OrderMas AS OrderMas ON Trs_Del2.OrdId = OrderMas.OrdId INNER JOIN
					   dbo.OrderMas2 AS OrderMas2 on ordermas2.Ordid=ordermas.OrdId inner join  
                      dbo.StockTable AS StockTable ON Trs_Del2.StockID = StockTable.StockID INNER JOIN
                      dbo.Mas_Godown ON Trs_Del1.GodID = dbo.Mas_Godown.GodID INNER JOIN
                      dbo.Mas_Godown AS ToGodown ON Trs_Del1.Party = ToGodown.GodID LEFT OUTER JOIN
                      dbo.Mas_Grp AS Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo LEFT OUTER JOIN
                      dbo.Mas_Acc AS Mas_Acc ON StockTable.Atype = Mas_Acc.ID LEFT OUTER JOIN
                      dbo.Mas_AccDes AS Mas_AccDes ON StockTable.Ades = Mas_AccDes.ID LEFT OUTER JOIN
                      dbo.OrdSizeMas AS OrdSizeMas ON StockTable.OrdID = OrdSizeMas.OrdID AND StockTable.Siz = OrdSizeMas.SizeID and trs_del2.StyleNo  = OrdSizeMas.StyleNo  LEFT OUTER JOIN
                      dbo.Mas_Size AS Mas_Size ON StockTable.Siz = Mas_Size.SizeID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN
                      dbo.Mas_Uom AS Mas_Uom ON Mas_Acc.UomId = Mas_Uom.UomID LEFT OUTER JOIN

Mas_User On Mas_User.UserCode = Trs_Del1.PreparedBy  LEFT OUTER JOIN

                      dbo.Mas_Buyer AS mas_buyer ON OrderMas.BuyerID = mas_buyer.BuyerID CROSS JOIN
                      dbo.Options
WHERE     (Trs_Del1.ID = ?)
ORDER BY Mas_Acc.Acc_Descr, Mas_Color.ColorDesc, OrdSizeMas.SNo</SqlCommand>
      </AccDC>
    </DataSources>
