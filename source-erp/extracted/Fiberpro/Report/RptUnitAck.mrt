    <DataSources isList="true" count="2">
      <PcsDc Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>PcsDc</Alias>
        <Columns isList="true" count="20">
          <value>DCNo,System.String</value>
          <value>dt,System.DateTime</value>
          <value>NoBdl,System.Int32</value>
          <value>wgt,System.Decimal</value>
          <value>Remark,System.String</value>
          <value>OrderNo,System.String</value>
          <value>StyleNo,System.String</value>
          <value>ExporterName,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>sendername,System.String</value>
          <value>senderphone,System.String</value>
          <value>sendertin,System.String</value>
          <value>sendercst,System.String</value>
          <value>Pcs,System.Int32</value>
          <value>Panelname,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>StyleDesc,System.String</value>
          <value>PartName,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>PcsDc</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM(CAST(Trs_UnitAck1.DocNo AS VARCHAR)) + '/' + RTRIM(Trs_UnitAck1.Finyear) AS DCNo, Trs_UnitAck1.dt, isnull(Trs_UnitAck1.NoBdl,'') NoBdl,                       isnull(Trs_UnitAck1.Wgt,0) as wgt, Convert(Varchar,Trs_UnitAck1.Remark) As Remark, RTRIM(CAST(OrderMas.Jobno AS VARCHAR)) + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo AS OrderNo, 
                      Trs_UnitAck2.StyleNo, Mas_Exporter.ExporterName, Mas_Exporter.Phone, Mas_Exporter.TIN, Mas_Exporter.CST, 
 sender.ExporterName as sendername, sender.Phone senderphone, sender.TIN sendertin, sender.CST sendercst,
sum(Trs_UnitAck2.Pcs) as Pcs, isnull(Mas_Panel.PanelName,'') as Panelname, Mas_Color.ColorDesc,  Mas_StyleDesc.StyleDesc, Mas_Part.PartName  FROM         Trs_UnitAck1 AS Trs_UnitAck1 INNER JOIN  Mas_Exporter AS Mas_Exporter ON Trs_UnitAck1.Coycode = Mas_Exporter.ExpID INNER JOIN  Trs_UnitAck2 AS Trs_UnitAck2 ON Trs_UnitAck1.ID = Trs_UnitAck2.ID inner join trs_pcs2 on Trs_UnitAck2.transid=trs_pcs2.id and Trs_UnitAck2.styleno=trs_pcs2.styleno  and Trs_UnitAck2.styleid=trs_pcs2.styleid and Trs_UnitAck2.colid=trs_pcs2.colid  and Trs_UnitAck2.partid=trs_pcs2.partid  and Trs_UnitAck2.panelid=trs_pcs2.panelid 
and Trs_UnitAck2.sizeid=trs_pcs2.sizeid inner join trs_pcs1 on trs_pcs2.id=trs_pcs1.id INNER JOIN     OrderMas AS OrderMas ON Trs_Pcs1.Ordjobno = OrderMas.OrdId INNER JOIN         Mas_Color AS Mas_Color ON Trs_UnitAck2.ColID = Mas_Color.ColID  INNER JOIN  Mas_StyleDesc AS Mas_StyleDesc ON Trs_UnitAck2.StyleID = Mas_StyleDesc.StyleID  LEFT OUTER JOIN
                      Mas_Part ON Trs_UnitAck2.PartID = Mas_Part.PartID 
inner join MAs_exporter as sender on Trs_UnitAck1.sender=sender.expid
LEFT OUTER JOIN   Mas_Panel AS Mas_Panel ON Trs_UnitAck2.PanelID = Mas_Panel.PanelID  WHERE      (Trs_UnitAck1.ID =?) 

 group by RTRIM(CAST(Trs_UnitAck1.DocNo AS VARCHAR)) + '/' + RTRIM(Trs_UnitAck1.Finyear), Trs_UnitAck1.dt, Trs_UnitAck1.NoBdl, 
                      Trs_UnitAck1.Wgt, Convert(Varchar,Trs_UnitAck1.Remark), RTRIM(CAST(OrderMas.Jobno AS VARCHAR)) + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo , 
                      Trs_UnitAck2.StyleNo, Mas_Exporter.ExporterName, Mas_Exporter.Phone, Mas_Exporter.TIN, Mas_Exporter.CST,
 sender.ExporterName , sender.Phone , sender.TIN , sender.CST ,
 Mas_Panel.PanelName, Mas_Color.ColorDesc, 
                      Mas_StyleDesc.StyleDesc, Mas_Part.PartName
 order by  Trs_UnitAck2.StyleNo, Mas_Color.ColorDesc,Mas_Panel.PanelName, Mas_Part.PartName</SqlCommand>
      </PcsDc>
      <PcsExpAddress Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>PcsExpAddress</Alias>
        <Columns isList="true" count="2">
          <value>exporteraddress,System.String</value>
          <value>senderadd,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>PcsExpAddress</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>select isnull(Mas_Exporter.exporteraddress,'') as exporteraddress ,isnull(tocoycode.exporteraddress,'') as senderadd from Trs_UnitAck1 inner join Mas_exporter on 
Trs_UnitAck1.coycode=Mas_exporter.expid inner join Mas_exporter as Tocoycode on Trs_UnitAck1.sender=Tocoycode.expid  where id=?</SqlCommand>
      </PcsExpAddress>
    </DataSources>
