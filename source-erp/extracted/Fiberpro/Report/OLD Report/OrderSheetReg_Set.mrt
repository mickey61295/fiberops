    <DataSources isList="true" count="3">
      <ExcessQtySizewiseDet Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>ExcessQtySizewiseDet</Alias>
        <Columns isList="true" count="10">
          <value>OrdID,System.Int32</value>
          <value>OrderQty,System.Int32</value>
          <value>StyleNo,System.String</value>
          <value>Exs_Per,System.Int32</value>
          <value>SlNo,System.Int32</value>
          <value>StyleDesc,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>SNo,System.Int32</value>
          <value>SizeDesc,System.String</value>
          <value>ExcessQty,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>ExcessQtySizewiseDet</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     OrdQtyClrDtl.OrdID, OrdQtyClrDtl.SizeQty as OrderQty, OrdQtyClrDtl.StyleNo,  CAST(OrdQtyClrDtl.Exs_Per AS int) AS Exs_Per, OrdQtyClrDtl.grdslno as SlNo, Mas_StyleDesc.StyleDesc, 	Mas_Color.ColorDesc, OrdSizeMas.SNo, Mas_Size.SizeDesc,cast((OrdQtyClrDtl.SizeQty)+((OrdQtyClrDtl.SizeQty)*(OrdQtyClrDtl.Exs_Per)/100) as int) as ExcessQty
	FROM         dbo.OrdQtyClrDtl AS OrdQtyClrDtl INNER JOIN
	dbo.Mas_Color AS Mas_Color ON OrdQtyClrDtl.CmbClrID = Mas_Color.ColID INNER JOIN
                      dbo.OrdSizeMas AS OrdSizeMas ON OrdQtyClrDtl.OrdID = OrdSizeMas.OrdID AND OrdQtyClrDtl.SizeId = OrdSizeMas.SizeID INNER JOIN
                      dbo.Mas_Size AS Mas_Size ON OrdQtyClrDtl.SizeId = Mas_Size.SizeID INNER JOIN
                      dbo.Mas_StyleDesc AS Mas_StyleDesc ON OrdQtyClrDtl.StyleID = Mas_StyleDesc.StyleID
WHERE     (OrdQtyClrDtl.OrdID = ?) AND (OrdQtyClrDtl.Exs_Per &gt; 0)
order by OrdSizeMas.SNo,OrdQtyClrDtl.grdslno</SqlCommand>
      </ExcessQtySizewiseDet>
      <OrderQtySizewiseDet Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>OrderQtySizewiseDet</Alias>
        <Columns isList="true" count="8">
          <value>OrdID,System.Int32</value>
          <value>SNo,System.Int32</value>
          <value>OrderQty,System.Int32</value>
          <value>StyleNo,System.String</value>
          <value>SlNo,System.Int32</value>
          <value>SizeDesc,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>StyleDesc,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>OrderQtySizewiseDet</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     OrdSizeMas.OrdID, OrdSizeMas.SNo, OrdQtyClrDtl.SizeQty as OrderQty, OrdQtyClrDtl.StyleNo, OrdQtyClrDtl.GRdSlno as SlNo, Mas_Size.SizeDesc, Mas_Color.ColorDesc as ColorDesc, 
	Mas_StyleDesc.StyleDesc FROM  dbo.OrdSizeMas AS OrdSizeMas INNER JOIN
	dbo.OrdQtyClrDtl AS OrdQtyClrDtl ON OrdSizeMas.OrdID = OrdQtyClrDtl.OrdID AND OrdSizeMas.SizeID = OrdQtyClrDtl.SizeId INNER JOIN dbo.Mas_Color AS Mas_Color ON OrdQtyClrDtl.CmbClrID = Mas_Color.ColID INNER JOIN dbo.Mas_StyleDesc AS Mas_StyleDesc ON OrdQtyClrDtl.StyleID = Mas_StyleDesc.StyleID INNER JOIN dbo.Mas_Size AS Mas_Size ON OrdQtyClrDtl.SizeId = Mas_Size.SizeID 
WHERE     (OrdSizeMas.OrdID = ?) 
ORder by OrdSizeMas.SNo, OrdQtyClrDtl.grdslNo
</SqlCommand>
      </OrderQtySizewiseDet>
      <OrderSheet Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>OrderSheet</Alias>
        <Columns isList="true" count="17">
          <value>JobNo,System.String</value>
          <value>BuyOrdNo,System.String</value>
          <value>BuyordDt,System.DateTime</value>
          <value>DelDt,System.DateTime</value>
          <value>OrderQty,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>StyleNo,System.String</value>
          <value>OrderType,System.String</value>
          <value>uom,System.String</value>
          <value>ActDelDt,System.DateTime</value>
          <value>BuyerName,System.String</value>
          <value>ExporterName,System.String</value>
          <value>MerchName,System.String</value>
          <value>SeasDesc,System.String</value>
          <value>FcyName,System.String</value>
          <value>remarks,System.String</value>
          <value>UserName,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>OrderSheet</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM(CAST(OrderMas.Jobno AS varchar)) + '/' + OrderMas.Finyear AS JobNo, OrderMas.BuyOrdNo, OrderMas.BuyordDt, OrderMas.DelDt, 
                      OrderMas.OrderQty, OrderMas.Gsm, OrderMas.StyleNo, OrderMas.OrderType, OrderMas.uom, OrderMas.ActDelDt, Mas_Buyer.BuyerName, 
                      Mas_Exporter.ExporterName, Mas_Merchandiser.MerchName, Mas_Season.SeasDesc, Mas_Fcy.FcyName,ordermas.remarks, Mas_User.UserName
FROM         JOMS.dbo.OrderMas AS OrderMas INNER JOIN
                      JOMS.dbo.Mas_Exporter AS Mas_Exporter ON OrderMas.ExpID = Mas_Exporter.ExpID LEFT OUTER JOIN
                      JOMS.dbo.Mas_Merchandiser AS Mas_Merchandiser ON OrderMas.MerchID = Mas_Merchandiser.MerchID LEFT OUTER JOIN
                      JOMS.dbo.Mas_Season AS Mas_Season ON OrderMas.Season = Mas_Season.SeasID LEFT OUTER JOIN
                      JOMS.dbo.Mas_Fcy AS Mas_Fcy ON OrderMas.Fcy = Mas_Fcy.ID LEFT OUTER JOIN
                      JOMS.dbo.Mas_Buyer AS Mas_Buyer ON OrderMas.BuyerID = Mas_Buyer.BuyerID LEFT OUTER JOIN Mas_User On OrderMas.PreparedBy = Mas_User.UserCode

where Ordermas.OrdId=?
</SqlCommand>
      </OrderSheet>
    </DataSources>
