    <DataSources isList="true" count="2">
      <PcsDc Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>PcsDc</Alias>
        <Columns isList="true" count="28">
          <value>DCNo,System.String</value>
          <value>dtDCDate,System.DateTime</value>
          <value>DelType,System.String</value>
          <value>NoBdl,System.Int32</value>
          <value>Wgt,System.Decimal</value>
          <value>Remark,System.String</value>
          <value>OrderNo,System.String</value>
          <value>StyleNo,System.String</value>
          <value>ExporterName,System.String</value>
          <value>dcformat,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>Pname,System.String</value>
          <value>Paddress,System.String</value>
          <value>Expr2,System.String</value>
          <value>Expr3,System.String</value>
          <value>Expr4,System.String</value>
          <value>Pcs,System.Int32</value>
          <value>Deptname,System.String</value>
          <value>SNo,System.Int32</value>
          <value>WorkComplDet,System.String</value>
          <value>PanelName,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>SizeDesc,System.String</value>
          <value>StyleDesc,System.String</value>
          <value>username,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>PcsDc</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM(CAST(Trs_Pcs1.DocNo AS varchar)) + '/' + Trs_Pcs1.Finyear AS DCNo, Trs_Pcs1.dtDCDate, Trs_Pcs1.DelType, Trs_Pcs1.NoBdl, Trs_Pcs1.Wgt, 
                      Trs_Pcs1.Remark, RTRIM(CAST(OrderMas.Jobno AS varchar)) + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo AS OrderNo, Trs_Pcs2.StyleNo, 
                      Mas_Exporter.ExporterName,  Mas_Dept.dcformat,Mas_Exporter.ExporterAddress, Mas_Exporter.Phone, Mas_Exporter.TIN, Mas_Exporter.CST, Mas_Party.Pname, 
                      Mas_Party.Paddress, Mas_Party.Phone AS Expr2, Mas_Party.TIN AS Expr3, Mas_Party.CST AS Expr4, Trs_Pcs2.Pcs, Mas_Dept.Deptname, 
                      OrdSizeMas.SNo, Mas_JobWrkComp.WorkComplDet, Mas_Panel.PanelName, Mas_Color.ColorDesc, Mas_Size.SizeDesc, 
                      Mas_StyleDesc.StyleDesc, mas_user.username
FROM         dbo.Trs_Pcs1 Trs_Pcs1 INNER JOIN
                      dbo.Mas_Exporter Mas_Exporter ON Trs_Pcs1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.Mas_Party Mas_Party ON Trs_Pcs1.Party = Mas_Party.PID INNER JOIN
                      dbo.Trs_Pcs2 Trs_Pcs2 ON Trs_Pcs1.ID = Trs_Pcs2.ID INNER JOIN
                      dbo.OrderMas OrderMas ON Trs_Pcs1.Ordjobno = OrderMas.OrdId INNER JOIN
                      dbo.OrdSizeMas OrdSizeMas ON Trs_Pcs1.Ordjobno = OrdSizeMas.OrdID AND Trs_Pcs2.SizeID = OrdSizeMas.SizeID LEFT OUTER JOIN
                      dbo.Mas_JobWrkComp Mas_JobWrkComp ON Trs_Pcs1.Dept = Mas_JobWrkComp.Id LEFT OUTER JOIN
                      dbo.Mas_Dept Mas_Dept ON Trs_Pcs1.Dept = Mas_Dept.DeptID INNER JOIN
                      dbo.Mas_Color Mas_Color ON Trs_Pcs2.ColID = Mas_Color.ColID INNER JOIN
                      dbo.Mas_Size Mas_Size ON Trs_Pcs2.SizeID = Mas_Size.SizeID INNER JOIN
                      dbo.Mas_StyleDesc Mas_StyleDesc ON Trs_Pcs2.StyleID = Mas_StyleDesc.StyleID LEFT OUTER JOIN
                      dbo.Mas_Panel Mas_Panel ON Trs_Pcs2.PanelID = Mas_Panel.PanelID
LEFT OUTER JOIN mas_user on  Trs_Pcs1.preparedby=mas_user.usercode 
where Trs_Pcs1.id=?
 Order by sno</SqlCommand>
      </PcsDc>
      <PCSDC_Acc Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>PCSDC_Acc</Alias>
        <Columns isList="true" count="6">
