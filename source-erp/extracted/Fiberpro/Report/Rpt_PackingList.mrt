<StiSerializer version="1.0" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <Databases isList="true" count="1">
      <Connection Ref="2" type="Stimulsoft.Report.Dictionary.StiOleDbDatabase" isKey="true">
        <Alias>Connection</Alias>
        <ConnectionString>Provider=SQLOLEDB.1;Persist Security Info=False;User ID=sa;Initial Catalog=majestic;Data Source=MACHINE-29\MSSQL2012</ConnectionString>
        <Name>Connection</Name>
        <PromptUserNameAndPassword>False</PromptUserNameAndPassword>
      </Connection>
    </Databases>
    <DataSources isList="true" count="3">
      <DataSource1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="8">
          <value>CTNNo,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>SizeDesc,System.String</value>
          <value>Pcs,System.Int32</value>
          <value>Noofcartons,System.Int32</value>
          <value>Totpcs,System.Int32</value>
          <value>netwt,System.Decimal</value>
          <value>grosswt,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>select Rtrim(Trs_Packinglist_Det.ctn_From)+'-'+Rtrim(Trs_Packinglist_Det.ctn_To) As CTNNo,Mas_Color.ColorDesc,Mas_Size.SizeDesc,Trs_Packinglist_Det.Pcs,Trs_Packinglist_Det.Noofcartons,Trs_Packinglist_Det.Totpcs,Trs_Packinglist_Det.netwt,Trs_Packinglist_Det.grosswt  From Trs_Packinglist_Mas 
	INNER JOIN Trs_Packinglist_Det ON Trs_Packinglist_Det.Id=Trs_Packinglist_Mas.Id INNER JOIN Mas_Color ON Mas_Color.ColID=Trs_Packinglist_Det.Colorid 
INNER JOIN Mas_Size ON Mas_Size.SizeID=Trs_Packinglist_Det.Sizeid  Where Trs_Packinglist_Mas.Id=?</SqlCommand>
      </DataSource1>
      <Details Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>Details</Alias>
        <Columns isList="true" count="13">
          <value>IONo,System.Int32</value>
          <value>Buyername,System.String</value>
          <value>id,System.Int32</value>
          <value>ordid,System.Int32</value>
          <value>styleno,System.String</value>
          <value>OrderQty,System.Decimal</value>
          <value>DelQty,System.Decimal</value>
          <value>NettWt,System.Decimal</value>
          <value>GrossWt,System.Decimal</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>CTNNo,System.Int32</value>
          <value>OrderNo,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>Details</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>select RTRIM(ordermas.Jobno) + '/' + RTrim(Trs_Packinglist_Mas.Finyear) As IONo,Ordermas.Jobno As OrderNo,Mas_Buyer.Buyername, Trs_Packinglist_Mas.id,Trs_Packinglist_Mas.ordid,Trs_Packinglist_Mas.styleno,Trs_Packinglist_Mas.OrderQty,Trs_Packinglist_Mas.DelQty,
	Sum(Trs_Packinglist_Det.NetWt) As NettWt,Sum(Trs_Packinglist_Det.GrossWt) As GrossWt,Mas_Exporter.ExporterName,ExporterAddress,Sum(Trs_Packinglist_Det.Noofcartons) As CTNNo  
	from Trs_Packinglist_Mas INNER JOIN Trs_Packinglist_Det ON Trs_Packinglist_Det.Id=Trs_Packinglist_Mas.Id INNER JOIN Mas_Buyer 
ON Mas_Buyer.Buyerid=Trs_Packinglist_Mas.Buyer INNER JOIN ordermas On Ordermas.OrdId=Trs_Packinglist_Mas.Ordid INNER JOIN OrderStyleDtl 
ON OrderStyleDtl.ordid=Trs_Packinglist_Mas.ordid AND Orderstyledtl.StyleNo=Trs_Packinglist_Mas.Styleno INNER JOIN Mas_Exporter 
ON Mas_Exporter.Expid=Trs_Packinglist_Mas.Coycode Where Trs_Packinglist_Mas.Id=? Group By Ordermas.Jobno,Mas_Buyer.Buyername, Trs_Packinglist_Mas.id,Trs_Packinglist_Mas.ordid,Trs_Packinglist_Mas.styleno,Trs_Packinglist_Mas.OrderQty,Trs_Packinglist_Mas.DelQty,Mas_Exporter.ExporterName,ExporterAddress ,Trs_Packinglist_Mas.finyear</SqlCommand>
      </Details>
      <ColorDetails Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>ColorDetails</Alias>
        <Columns isList="true" count="4">
          <value>ColorDesc,System.String</value>
          <value>SizeDesc,System.String</value>
          <value>Pcs,System.Int32</value>
          <value>totPcs,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>ColorDetails</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>select Mas_Color.ColorDesc,Mas_Size.SizeDesc,Trs_Packinglist_Det.Pcs,Trs_Packinglist_Det.totPcs From Trs_Packinglist_Det 
INNER JOIN Mas_Color On Mas_Color.COlid=Trs_Packinglist_Det.Colorid INNER JOIN Mas_Size ON Mas_Size.Sizeid=Trs_Packinglist_Det.Sizeid 
Where Trs_Packinglist_Det.Id=?</SqlCommand>
      </ColorDetails>
