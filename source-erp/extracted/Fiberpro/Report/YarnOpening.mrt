    <DataSources isList="true" count="1">
      <YarnOpening Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>YarnOpening</Alias>
        <Columns isList="true" count="13">
          <value>OrderNo,System.String</value>
          <value>Deptname,System.String</value>
          <value>RlsBg,System.Int32</value>
          <value>Kgs,System.Decimal</value>
          <value>OpenDt,System.DateTime</value>
          <value>ExporterName,System.String</value>
          <value>CountName,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>ShortMill,System.String</value>
          <value>rate,System.Decimal</value>
          <value>LotNo,System.String</value>
          <value>UserName,System.String</value>
          <value>Remarks,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnOpening</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="3">
          <value>_x0040_OpeningDate,_x0022_09.09.2009_x0022_,7,0</value>
          <value>_x0040_DeptId,_x0030_,3,0</value>
          <value>_x0040_Ordid,_x0030_,3,0</value>
        </Parameters>
        <SqlCommand>SELECT CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar))
                       + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, dbo.Mas_Dept.Deptname,
  dbo.Trs_Opening.RlsBg, dbo.Trs_Opening.Kgs, dbo.Trs_Opening.OpenDt,
  dbo.Mas_Exporter.ExporterName, dbo.Mas_Count.CountName,
  dbo.Mas_Color.ColorDesc, dbo.Mas_Mill.ShortMill, dbo.Trs_Opening.rate,StockTable.LotNo, Mas_User.UserName,isnull(Trs_opening.Remarks,'') as Remarks
FROM dbo.Trs_Opening INNER JOIN
  dbo.OrderMas ON dbo.Trs_Opening.OrdID = dbo.OrderMas.OrdId INNER JOIN
  dbo.Mas_Dept ON dbo.Trs_Opening.Dept = dbo.Mas_Dept.DeptID INNER JOIN
  dbo.StockTable ON dbo.Trs_Opening.StockID = dbo.StockTable.StockID LEFT OUTER JOIN
  dbo.Mas_Mill ON dbo.StockTable.MillID = dbo.Mas_Mill.MillID INNER JOIN
  dbo.Mas_Exporter ON dbo.Trs_Opening.Coycode = dbo.Mas_Exporter.ExpID
  LEFT OUTER JOIN
  dbo.Mas_Count ON dbo.StockTable.CntID = dbo.Mas_Count.CountID LEFT OUTER JOIN
  dbo.Mas_Color ON dbo.StockTable.ColID = dbo.Mas_Color.ColID LEFT OUTER JOIN
Mas_User On Trs_Opening.PreparedBy = Mas_User.UserCode
WHERE Trs_Opening.OpenDt = convert(datetime,?,102) and Trs_Opening.Dept=? and Trs_opening.ordid=?
</SqlCommand>
      </YarnOpening>
    </DataSources>
