    <DataSources isList="true" count="1">
      <DataSource1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="12">
          <value>InvNo,System.String</value>
          <value>Dt,System.DateTime</value>
          <value>OrdConformationNo,System.String</value>
          <value>Bags,System.Int32</value>
          <value>kg,System.Int32</value>
          <value>ExporterName,System.String</value>
          <value>CountName,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>RATE,System.Decimal</value>
          <value>ExporterAddress,System.String</value>
          <value>Amount,System.Decimal</value>
          <value>Pname,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>select Rtrim(InvNo)+'/'+Trs_TradeInwardMas.Finyear InvNo,Trs_TradeInwardMas.Dt,Rtrim(OrdConformationNo)+'/'+Trs_TradeInwardMas.Finyear OrdConformationNo,Bags,kg,Mas_Exporter.ExporterName,Mas_Count.CountName,isnull(Mas_Color.ColorDesc,'') as ColorDesc,Trs_TradeOrdConFirmationDet.RATE,Mas_Exporter.ExporterAddress,Trs_TradeInwardDet.Amount,mas_party.Pname from Trs_TradeInwardMas inner join Trs_TradeOrdConFirmationMas on Trs_TradeOrdConFirmationMas.ID=Trs_TradeInwardMas.OrdConformationId inner join Mas_Exporter on Mas_Exporter.ExpID=Trs_TradeInwardMas.Coycode inner join Trs_TradeOrdConFirmationDet on Trs_TradeOrdConFirmationDet.Id=Trs_TradeInwardMas.OrdConformationId INNER JOIN Trs_TradeInwardDet ON Trs_TradeInwardDet.Invid=Trs_TradeInwardMas.Invid
inner join mas_count on Mas_Count.CountID= Trs_TradeOrdConFirmationDet.CountID and Trs_TradeInwardDet.Countid=Mas_Count.CountID left outer join mas_color on Mas_Color.ColID=Trs_TradeOrdConFirmationDet.ColorID and Trs_TradeInwardDet.Colid=Mas_Color.ColID
inner join mas_party on mas_party.pid=Trs_TradeInwardMas.partyid
where Trs_TradeInwardMas.Invid=?</SqlCommand>
      </DataSource1>
    </DataSources>
    <Relations isList="true" count="0" />
    <Report isRef="0" />
    <Variables isList="true" count="0" />
