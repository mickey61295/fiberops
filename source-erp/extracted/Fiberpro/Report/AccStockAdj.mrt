<StiSerializer version="1.0" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <Databases isList="true" count="1">
      <Connection Ref="2" type="Stimulsoft.Report.Dictionary.StiOleDbDatabase" isKey="true">
        <Alias>Connection</Alias>
        <ConnectionString>Provider=SQLOLEDB.1;Persist Security Info=False;User ID=sa;Initial Catalog=JOMS;Data Source=MACHINE-14</ConnectionString>
        <Name>Connection</Name>
        <PromptUserNameAndPassword>False</PromptUserNameAndPassword>
      </Connection>
    </Databases>
    <DataSources isList="true" count="1">
      <AccDC Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>AccDC</Alias>
        <Columns isList="true" count="24">
          <value>DCNO,System.String</value>
          <value>Dt,System.DateTime</value>
          <value>TrType,System.Int32</value>
          <value>ID,System.Int32</value>
          <value>StockID,System.Int32</value>
          <value>Kg,System.Decimal</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>ExpPhone,System.String</value>
          <value>ExpTIN,System.String</value>
          <value>ExpCST,System.String</value>
          <value>Deptname,System.String</value>
          <value>ORDERNO,System.String</value>
          <value>StyleNo,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>Acc_Descr,System.String</value>
          <value>AccDescription,System.String</value>
          <value>SNo,System.Int32</value>
          <value>SizeDesc,System.String</value>
          <value>Uom,System.String</value>
          <value>AccDesc,System.String</value>
          <value>StockAddLess,System.String</value>
          <value>UserName,System.String</value>
          <value>remark,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>AccDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear AS DCNO, Trs_Del1.Dt, Trs_Del1.TrType, Trs_Del2.ID, Trs_Del2.StockID, 
                      Trs_Del2.Kg, Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN, 
                      Mas_Exporter.CST AS ExpCST, Mas_Dept.Deptname, RTRIM(CAST(OrderMas.Jobno AS varchar)) 
                      + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo AS ORDERNO, Ordermas2.StyleNo, Mas_Color.ColorDesc, Mas_Acc.Acc_Descr, 
                      Mas_AccDes.AccDescription, OrdSizeMas.SNo, Mas_Size.SizeDesc, Mas_Uom.Uom, CASE WHEN isnull(Mas_AccDes.AccDescription, '') 
                      = '' THEN Mas_Acc.Acc_Descr ELSE Mas_Acc.Acc_Descr + '(' + Mas_AccDes.AccDescription + ')' END AS AccDesc, Trs_Del1.StockAddLess,case when trs_del1.PreparedBy = 100 then 'Global' else  Mas_User.UserName end as UserName, Trs_del1.remark
FROM         dbo.Trs_Del1 AS Trs_Del1 INNER JOIN
                      dbo.Mas_Exporter AS Mas_Exporter ON Trs_Del1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.Mas_Dept AS Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID INNER JOIN
                      dbo.Trs_Del2 AS Trs_Del2 ON Trs_Del1.ID = Trs_Del2.ID INNER JOIN
                      dbo.OrderMas AS OrderMas ON Trs_Del2.OrdID = OrderMas.OrdId 
inner join ordermas2 on Ordermas.Ordid = Ordermas2.Ordid
INNER JOIN
                      dbo.StockTable AS StockTable ON Trs_Del2.StockID = StockTable.StockID LEFT OUTER JOIN
                      dbo.Mas_Acc AS Mas_Acc ON StockTable.Atype = Mas_Acc.ID LEFT OUTER JOIN
                      dbo.Mas_AccDes AS Mas_AccDes ON StockTable.Ades = Mas_AccDes.ID LEFT OUTER JOIN
                      dbo.OrdSizeMas AS OrdSizeMas ON StockTable.OrdID = OrdSizeMas.OrdID AND StockTable.Siz = OrdSizeMas.SizeID LEFT OUTER JOIN
                      dbo.Mas_Size AS Mas_Size ON StockTable.Siz = Mas_Size.SizeID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN
						Mas_User On Trs_Del1.PreparedBy = Mas_User.UserCode  LEFT OUTER JOIN 
                      dbo.Mas_Uom AS Mas_Uom ON Mas_Acc.UomId = Mas_Uom.UomID
where Trs_Del1.id=?
ORDER BY Mas_Acc.Acc_Descr, Mas_Color.ColorDesc, OrdSizeMas.SNo</SqlCommand>
      </AccDC>
    </DataSources>
