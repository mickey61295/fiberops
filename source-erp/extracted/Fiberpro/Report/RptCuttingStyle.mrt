        public void GetDyeingsubReport_SqlCommand(object sender, System.EventArgs e)
        {
            this.DyeingsubReport.SqlCommand = "SELECT DISTINCT \t\r\n\r\n\tTrs_Del3.ID, case when isnull(ShadeEntry.ShadeNo,\'\')=\'\'then" +
" Mas_Color.ColorDesc else RTRIM(Mas_Color.ColorDesc)+\'/\'+(ShadeEntry.ShadeNo) en" +
"d as  ColorDesc,  Trs_Del3.LotNo, case Preprint.DcRateReqd when 1 then case Isnu" +
"ll(Trs_Del1.ProcessType,\'P\') when \'P\' then \r\n\r\ncase MIN(BudPodet.Rate) when 0 th" +
"en MIN(Pro_ReqKnitt2.Rate + ISNULL(Pro_ReqKnitt2.AddRate, 0)) else  MIN(BudPodet" +
".Rate) end \r\n\r\n else 0 end \r\n\r\n else 0 end  AS ConfirmedRate, Mas_Dept.ProgReqPr" +
"n,\'PROGRAM DETAILS\' as Head,\r\n                      case isnull( MIN(BudPodet.Ra" +
"te),0) when 0 then MIN(Pro_ReqKnitt2.Rate + ISNULL(Pro_ReqKnitt2.AddRate, 0)) el" +
"se  MIN(BudPodet.Rate) end As BudjetRate,CASE WHEN Preprint.DcRateReqd = 1 THEN " +
"CASE WHEN Trs_Del1.ProcessType = \'P\' THEN   \'RATE :\' ELSE  \'\' END  ELSE  \'\' END " +
" AS Ratelbl\r\nFROM         BudPodet INNER JOIN\r\n                      BudPoMas ON" +
" BudPodet.Id = BudPoMas.Id RIGHT OUTER JOIN\r\n                      Mas_Color AS " +
"Mas_Color RIGHT OUTER JOIN\r\n                      Trs_Del3 AS Trs_Del3 INNER JOI" +
"N\r\n                      Trs_Del1 ON Trs_Del3.ID = Trs_Del1.ID INNER JOIN\r\n     " +
"                 Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID LEFT OUTER JOIN" +
"\r\n                      Pro_ReqKnitt2 ON Trs_Del3.DiaID = Pro_ReqKnitt2.DiaID AN" +
"D Trs_Del3.LL = Pro_ReqKnitt2.LL AND \r\n                      Trs_Del3.GG = Pro_R" +
"eqKnitt2.GG AND Trs_Del3.Gsm = Pro_ReqKnitt2.GSM AND Trs_Del3.Cnt = Pro_ReqKnitt" +
"2.CntID AND \r\n                      Trs_Del3.Clr = Pro_ReqKnitt2.ColId AND Trs_D" +
"el3.FabType = Pro_ReqKnitt2.FabId AND \r\n                      Trs_Del1.Prs_Dept " +
"= Pro_ReqKnitt2.DeptId AND Trs_Del3.OrdId = Pro_ReqKnitt2.OrdId ON Mas_Color.Col" +
"ID = Trs_Del3.Clr ON \r\n                      BudPoMas.OrdId = Trs_Del3.OrdId AND" +
" BudPoMas.PartyId = Trs_Del1.Party AND BudPoMas.DeptId = Trs_Del1.Prs_Dept AND \r" +
"\n                      BudPodet.DiaId = Trs_Del3.DiaID AND BudPodet.LL = Trs_Del" +
"3.LL AND BudPodet.GG = Trs_Del3.GG AND \r\n                      BudPodet.GSM = Tr" +
"s_Del3.Gsm AND BudPodet.FabId = Trs_Del3.FabType AND BudPodet.ColId = Trs_Del3.C" +
"lr AND \r\n                      BudPodet.CntId = Trs_Del3.Cnt CROSS JOIN\r\n       " +
"               PrePrint\r\n\t\t\t\tleft join ShadeEntry on ShadeEntry.OrdId=trs_del3.O" +
"rdId and ShadeEntry.ColId=Trs_Del3.Clr and ShadeEntry.DeptId=Trs_Del1.Prs_Dept\r\n" +
"\t\t\t\t\r\nWHERE     (Trs_Del3.ID = ?) and (Mas_Dept.Deptname = \'DYEING\' or IsNull(Ma" +
"s_Dept.DeptGrpCode,0) = 8 ) and    (Mas_Dept.ProgReqPrn = \'Y\') and PrePrint.slno" +
"=2\r\nGROUP BY Trs_Del3.ID, Mas_Color.ColorDesc, Trs_Del3.LotNo,Preprint.DcRateReq" +
"d,Trs_Del1.ProcessType,Mas_Dept.ProgFrm_Issue,Mas_Dept.ProgReqPrn,ShadeNo\r\n";
        }
        
        public void GetFabDC_SqlCommand(object sender, System.EventArgs e)
        {
            this.FabDC.SqlCommand = "SELECT    Trs_Del1.ID, CASE WHEN len(rtrim(dcpre)) &lt; 1 or isnull(len(rtrim(dcpre)" +
"),\'\')=\'\'  THEN RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + \'/\' + Trs_Del1.Finyear E" +
"LSE rtrim(dcpre) + \'-\' + RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + \'/\' + Trs_Del1" +
".Finyear END AS DcNo, Trs_Del1.Dt, Trs_Del1.TrType, Trs_Del1.Prs_Dept, Trs_Del1." +
"delwgt, CASE WHEN ordermas.jobno = 0 THEN \'&lt;General&gt;\' + \'/\' + OrderMas.Finyear +" +
" \'-&gt;\' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar)) + \'/\' + Or" +
"derMas.Finyear + \'-&gt;\' + OrderMas.BuyOrdNo END AS OrderNo,Rtrim(Cutting_Job.JobNo" +
") +\'/\' + Rtrim(Cutting_Job.finyear) + \'-&gt;\'+trs_del2.StyleNo as Styleno, \r\n\r\n\r\n M" +
"as_Dept.Deptname, Mas_Dept.OutputType, Trs_Del2.BgRl, Trs_Del2.Kg, Trs_Del2.mtr," +
" CASE WHEN Trs_Del1.PartyUnit = \'P\' THEN Mas_Party.Pname ELSE Mas_Unit.ExporterN" +
"ame END AS Pname, CASE WHEN Trs_Del1.PartyUnit = \'P\' THEN Mas_Party.Paddress ELS" +
"E Mas_Unit.ExporterAddress END AS Paddress, CASE WHEN Trs_Del1.PartyUnit = \'P\' T" +
"HEN Mas_Party.Phone ELSE Mas_Unit.Phone END AS Phone, CASE WHEN Trs_Del1.PartyUn" +
"it = \'P\' THEN Mas_Party.TIN ELSE Mas_Unit.TIN END AS TIN, CASE WHEN Trs_Del1.Par" +
"tyUnit = \'P\' THEN Mas_Party.CST ELSE Mas_Unit.CST END AS CST, Mas_Exporter.Expor" +
"terName, Mas_Dept.DCFormat, Mas_Buyer.BuyerName, Mas_Exporter.ExporterAddress, M" +
"as_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN, Mas_Exporter.CST AS E" +
"xpCST,Mas_Exporter.pan AS PAN,Trs_Grn1.PartyDCref, StockTable.CntID, StockTable." +
"ColID, Case When IsNull(Mas_Dept.DeptType,\'G\')=\'G\' Then StockTable.Gsm Else Stoc" +
"kTable.FinGsm End As Gsm, StockTable.GG, StockTable.ll, Mas_Grp.DcPre, Mas_Fabri" +
"c.Fabdesc, Mas_Dia.Dia, Mas_Dia_2.Dia as FDia,Mas_Color.ColorDesc, Mas_Count.Cou" +
"ntName, Trs_Del1.remark, Trs_Del1.ProcessType, Trs_Del1.LotNo, StockTable.LotNo " +
"AS StkLotno, CASE WHEN TRS_DEL2.MTR &gt; 0 THEN Mas_Uom.Uom ELSE \'\' END AS UOM, CAS" +
"E WHEN StockTable.ColID &gt; 0 THEN FABDESC + \'/\' + COUNTNAME + \'/\' + COLORDESC ELS" +
"E FABDESC + \'/\' + COUNTNAME END AS ITEMDESC, CASE Trtype WHEN 1 THEN \'DELIVERY C" +
"HALLAN\' WHEN 4 THEN \'PURCHASE RETURN\' WHEN 13 THEN \'PARTY REJECTION RETURN\' END " +
"AS Heading, Mas_Vehicle.VName, Mas_Terms.Terms, CASE WHEN StockTable.ColID &gt; 0 T" +
"HEN  case when  StockTable.Print_designid&gt;0 then  fabdesc + Countname + COLORDES" +
"C + RTRIM(CAST(StockTable.ColID AS varchar))+ RTRIM(CAST(StockTable.Gsm AS varch" +
"ar)) + RTRIM(CAST(StockTable.GG AS varchar)) + RTRIM(CAST(StockTable.ll AS varch" +
"ar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) + RTRIM(CAST(Mas_Dia_2.Dia AS varchar" +
")) + Mas_design.designdesc else fabdesc + Countname + COLORDESC + RTRIM(CAST(Sto" +
"ckTable.ColID AS varchar))+ RTRIM(CAST(StockTable.Gsm AS varchar)) + RTRIM(CAST(" +
"StockTable.GG AS varchar)) + RTRIM(CAST(StockTable.ll AS varchar)) + RTRIM(CAST(" +
"Mas_Dia.Dia AS varchar)) + RTRIM(CAST(Mas_Dia_2.Dia AS varchar))\r\nend ELSE case " +
"when  StockTable.Print_designid&gt;0 then fabdesc + Countname + RTRIM(CAST(StockTab" +
"le.ColID AS varchar)) + RTRIM(CAST(StockTable.Gsm AS varchar)) + RTRIM(CAST(Stoc" +
"kTable.GG AS varchar)) + RTRIM(CAST(StockTable.ll AS varchar)) + RTRIM(CAST(Mas_" +
"Dia.Dia AS varchar))+Mas_design.designdesc+ RTRIM(CAST(Mas_Dia_2.Dia AS varchar)" +
")else fabdesc + Countname + RTRIM(CAST(StockTable.ColID AS varchar)) + RTRIM(CAS" +
"T(StockTable.Gsm AS varchar)) \r\n                      + RTRIM(CAST(StockTable.GG" +
" AS varchar)) + RTRIM(CAST(StockTable.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia A" +
"S varchar)) + RTRIM(CAST(Mas_Dia_2.Dia AS varchar)) end \r\n END AS GrpHeader, Trs" +
"_Del1.GPNo, \r\n                      ISNULL(Mas_Dept.ProgReqPrn, \'N\') AS ProgReqP" +
"rn, ISNULL(Options.GatePassFlg, \'N\') AS GatePassFlg, ISNULL(Mas_Design.DesignDes" +
"c, \'\') AS DesignDesc, \r\n                      Trs_Del1.TarDt, Mas_User.Username," +
" \r\n                      CASE WHEN Preprint.DcRateReqd = 1 THEN CASE WHEN Trs_De" +
"l1.ProcessType = \'P\' THEN CASE Ordermas.Jobno WHEN 0 THEN Trs_Del3.GeneralRate E" +
"LSE CASE Isnull(Mas_Dept.ProgFrm_Issue,\r\n                       \'N\') WHEN \'Y\' TH" +
"EN CASE Isnull(BudPodet.Rate, 0) WHEN 0 THEN Pro_ReqKnitt2.Rate ELSE BudPodet.Ra" +
"te END ELSE 0 END END ELSE 0 END ELSE 0 END AS Rate,\r\n                       CAS" +
"E WHEN Preprint.DcRateReqd = 1 THEN CASE WHEN Trs_Del1.ProcessType = \'P\' THEN CA" +
"SE Isnull(Mas_Dept.ProgFrm_Issue, \'N\') \r\n                      WHEN \'Y\' THEN \'Ra" +
"te\' ELSE \'\' END ELSE \'\' END ELSE \'\' END AS Ratelbl,\r\n\t\t\t\t\t  CASE  Mas_Design.Des" +
"ignDesc WHEN NULL THEN \'\' ELSE \'DESIGN\' END AS DesignLbL,\r\n\t\t\t\t\t  case when Trs_" +
"del1.Prs_dept =10 then Mas_design_1.designdesc else mas_design.DesignDesc end as" +
"  Deldesign,\r\nCASE WHEN Trs_Del1.PartyUnit = \'U\' then cuttingunit.exportername e" +
"lse \'\' end as cuttingunit,GodName,mas_exporter.IoNoCaption,Mas_Party.PAN As PPAN" +
",IsNull(Mas_Dept.DeptType,\'G\') As DeptType\r\n,IsNull(Mas_Exporter.GSTNo,\'\') As GS" +
"TNo,\r\nCASE WHEN Trs_Del1.PartyUnit = \'P\' THEN Mas_Party.GSTNo ELSE Mas_Unit.GSTN" +
"o END AS PGSTNo, \r\n\r\nIsNull(Mas_HSN.HSNCode,\'\') As HSNCode,EwayBillNo,EwayBillDt" +
",(Trs_Del2.Kg*Pro_ReqKnitt2_2.Cost) As Amount \r\nFROM         Mas_Terms AS Mas_Te" +
"rms RIGHT OUTER JOIN\r\n                      Trs_Del1 AS Trs_Del1 INNER JOIN\r\n   " +
"                   Mas_Dept AS Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID I" +
"NNER JOIN\r\n                      Trs_Del2 AS Trs_Del2 ON Trs_Del1.ID = Trs_Del2." +
"ID LEFT OUTER JOIN\r\n                      Mas_Party AS Mas_Party ON Trs_Del1.Par" +
"ty = Mas_Party.PID INNER JOIN\r\n                      Mas_Exporter AS Mas_Exporte" +
"r ON Trs_Del1.Coycode = Mas_Exporter.ExpID INNER JOIN\r\n                      Ord" +
"erMas AS OrderMas ON Trs_Del2.OrdId = OrderMas.OrdId \r\nLEFT OUTER JOIN\r\n        " +
"              Trs_Grn1 AS Trs_Grn1 ON Trs_Del1.OurGRNID = Trs_Grn1.ID INNER JOIN" +
"\r\n                      StockTable AS StockTable ON Trs_Del2.StockID = StockTabl" +
"e.StockID LEFT OUTER JOIN\r\n                      Mas_Grp AS Mas_Grp ON Mas_Dept." +
"Grp = Mas_Grp.GrpNo LEFT OUTER JOIN\r\n                      Mas_Buyer ON OrderMas" +
".BuyerID = Mas_Buyer.BuyerID INNER JOIN\r\n                      Mas_Dia AS Mas_Di" +
"a ON StockTable.DiaID = Mas_Dia.DiaID INNER JOIN\r\n                      Mas_Dia " +
"AS Mas_Dia_2 ON StockTable.FinDiaID = Mas_Dia_2.DiaID\r\n                      INN" +
"ER JOIN\r\n                      Mas_Fabric AS Mas_Fabric ON StockTable.FabID = Ma" +
"s_Fabric.FabID LEFT OUTER JOIN\r\n                      Mas_Design AS Mas_Design O" +
"N StockTable.PRINT_DESIGNID = Mas_Design.DesignId LEFT OUTER JOIN\r\n             " +
"         Trs_Del3 ON StockTable.Gsm = Trs_Del3.Gsm AND StockTable.DiaID = Trs_De" +
"l3.DiaID AND StockTable.FinGsm = Trs_Del3.GeneralRate AND \r\n                    " +
"  StockTable.FinDiaID = Trs_Del3.FinDiaID AND StockTable.PrgKnitGsm = Trs_Del3.P" +
"rgKnitGSM AND StockTable.PrgKnitDiaId = Trs_Del3.PrgKnitDiaId AND \r\n            " +
"          StockTable.PRINT_DESIGNID = Trs_Del3.Print_DesignId AND StockTable.ll " +
"= Trs_Del3.LL AND StockTable.GG = Trs_Del3.GG AND \r\n                      StockT" +
"able.FabID = Trs_Del3.FabType AND StockTable.LotNo = Trs_Del3.LotNo AND Trs_Del1" +
".ID = Trs_Del3.ID AND Trs_Del2.OrdId = Trs_Del3.OrdId AND \r\n                    " +
"  StockTable.CntID = Trs_Del3.Cnt AND StockTable.ColID = Trs_Del3.Clr LEFT OUTER" +
" JOIN\r\n                      Pro_ReqKnitt2 ON Trs_Del2.OrdId = Pro_ReqKnitt2.Ord" +
"Id AND Trs_Del1.Prs_Dept = Pro_ReqKnitt2.DeptId AND \r\n                      Stoc" +
"kTable.CntID = Pro_ReqKnitt2.CntID AND StockTable.ColID = Pro_ReqKnitt2.ColId AN" +
"D StockTable.FabID = Pro_ReqKnitt2.FabId AND \r\n                      StockTable." +
"Gsm = Pro_ReqKnitt2.GSM AND StockTable.GG = Pro_ReqKnitt2.GG AND StockTable.ll =" +
" Pro_ReqKnitt2.LL AND \r\n                      StockTable.FinGsm = Pro_ReqKnitt2." +
"FinGSM AND StockTable.FinDiaID = Pro_ReqKnitt2.FinDiaId AND StockTable.PrgKnitGs" +
"m = Pro_ReqKnitt2.GSM AND \r\n                      StockTable.PrgKnitDiaId = Pro_" +
"ReqKnitt2.DiaID AND StockTable.PRINT_DESIGNID = Pro_ReqKnitt2.DesignID \r\n\t\t\t\t\t  " +
"\t\t\t\t\t  LEFT OUTER JOIN\r\n                      Pro_ReqKnitt2 Pro_ReqKnitt2_2 ON T" +
"rs_Del2.OrdId = Pro_ReqKnitt2_2.OrdId AND StockTable.Dept = Pro_ReqKnitt2_2.Dept" +
"Id AND \r\n                      StockTable.CntID = Pro_ReqKnitt2_2.CntID AND Stoc" +
"kTable.ColID = Pro_ReqKnitt2_2.ColId AND StockTable.FabID = Pro_ReqKnitt2_2.FabI" +
"d AND \r\n                      StockTable.Gsm = Pro_ReqKnitt2_2.GSM AND StockTabl" +
"e.GG = Pro_ReqKnitt2_2.GG AND StockTable.ll = Pro_ReqKnitt2_2.LL AND \r\n         " +
"             StockTable.FinGsm = Pro_ReqKnitt2_2.FinGSM AND StockTable.FinDiaID " +
"= Pro_ReqKnitt2_2.FinDiaId AND StockTable.PrgKnitGsm = Pro_ReqKnitt2_2.GSM AND \r" +
"\n                      StockTable.PrgKnitDiaId = Pro_ReqKnitt2_2.DiaID AND Stock" +
"Table.PRINT_DESIGNID = Pro_ReqKnitt2_2.DesignID\r\nLEFT OUTER JOIN\r\n              " +
"        BudPodet INNER JOIN\r\n                      BudPoMas ON BudPodet.Id = Bud" +
"PoMas.Id ON StockTable.PRINT_DESIGNID = BudPodet.DesignID AND \r\n                " +
"      StockTable.PrgKnitDiaId = BudPodet.DiaId AND StockTable.PrgKnitGsm = BudPo" +
"det.GSM AND StockTable.FinDiaID = BudPodet.FinDiaId AND \r\n                      " +
"StockTable.FinGsm = BudPodet.FinGSM AND StockTable.ll = BudPodet.LL AND StockTab" +
"le.GG = BudPodet.GG AND \r\n                      StockTable.ColID = BudPodet.ColI" +
"d AND StockTable.CntID = BudPodet.CntId AND StockTable.FabID = BudPodet.FabId AN" +
"D \r\n                      Trs_Del2.OrdId = BudPoMas.OrdId AND Trs_Del1.Prs_Dept " +
"= BudPoMas.DeptId AND Trs_Del1.Party = BudPoMas.PartyId LEFT OUTER JOIN\r\n       " +
"               Mas_Vehicle ON Trs_Del1.VehicleCode = Mas_Vehicle.Code LEFT OUTER" +
" JOIN\r\n                      Mas_Count AS Mas_Count ON StockTable.CntID = Mas_Co" +
"unt.CountID LEFT OUTER JOIN\r\n                     Mas_design as Mas_design_1 on " +
"Trs_del1.DESIGNID = Mas_Design_1.DesignId left outer join\r\n                     " +
" Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN\r\n " +
"                     Mas_Uom AS Mas_Uom ON Mas_Fabric.PriUomID = Mas_Uom.UomID O" +
"N Mas_Terms.ID = Mas_Dept.DC_TermCode LEFT OUTER JOIN\r\n                      Mas" +
"_Exporter AS Mas_Unit ON Trs_Del1.Party = Mas_Unit.ExpID LEFT OUTER JOIN\r\n      " +
"                Mas_User ON Trs_Del1.PreparedBy = Mas_User.UserCode \r\nleft outer" +
" join cutting_job on Trs_Del2.jobordid= cutting_job.id\r\nleft outer join Mas_expo" +
"rter as cuttingunit on cutting_job.partyid=cuttingunit.expid  \r\nLEFT OUTER JOIN " +
"Mas_Godown ON Trs_Del1.GodID = Mas_Godown.GodID\r\nLeft Join Mas_HSN On Pro_ReqKni" +
"tt2_2.HSNId=Mas_HSN.Id\r\nCROSS JOIN\r\n                      Options CROSS JOIN\r\n  " +
"                    PrePrint\r\nWHERE     (PrePrint.Slno = 2) AND (Trs_Del1.ID =?)" +
"\r\n\r\nORDER BY Mas_Fabric.Fabdesc + \'/\' + Mas_Count.CountName + \'/\' + Mas_Color.Co" +
"lorDesc, StockTable.Gsm, StockTable.GG, StockTable.ll, Mas_Dia.Dia,Mas_Dia_2.Dia" +
"";
        }
        
        public void GetFabricSubReport_SqlCommand(object sender, System.EventArgs e)
        {
            this.FabricSubReport.SqlCommand = "SELECT     Trs_Del3.Clr, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, SUM(Trs_Del3.Pro" +
"g) AS Prog, SUM(Trs_Del3.ProgMtr) AS ProgMtr, Mas_Dia.Dia, \r\n\tCASE WHEN Trs_del3" +
".clr &gt; 0 THEN Mas_Fabric.Fabdesc + \'/\' + CountName + \'/\' + Colordesc ELSE Mas_Fa" +
"bric.Fabdesc + \'/\' + CountName END AS ItemDesc, \r\n                      CASE WHE" +
"N SUM(ProgMtr) &gt; 0 THEN Mas_Uom.Uom ELSE \'\' END AS UOM, \r\n                      " +
"CASE WHEN Trs_del3.clr &gt; 0 THEN CASE WHEN Trs_del3.Print_Designid &gt; 0 THEN Mas_F" +
"abric.Fabdesc + CountName + Colordesc + Mas_design.Designdesc + RTRIM(CAST(trs_d" +
"el3.Gsm\r\n                       AS varchar)) + RTRIM(CAST(trs_del3.GG AS varchar" +
")) + RTRIM(CAST(trs_del3.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) \r" +
"\n                      ELSE Mas_Fabric.Fabdesc + CountName + Colordesc + RTRIM(C" +
"AST(trs_del3.Gsm AS varchar)) + RTRIM(CAST(trs_del3.GG AS varchar)) \r\n          " +
"            + RTRIM(CAST(trs_del3.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS va" +
"rchar)) \r\n                      END ELSE CASE WHEN Trs_del3.Print_Designid &gt; 0 T" +
"HEN Mas_Fabric.Fabdesc + CountName + Mas_design.Designdesc + RTRIM(CAST(trs_del3" +
".Gsm AS varchar)) \r\n                      + RTRIM(CAST(trs_del3.GG AS varchar)) " +
"+ RTRIM(CAST(trs_del3.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) + RT" +
"RIM(CAST(Mas_Dia.Dia AS varchar)) \r\n                      ELSE Mas_Fabric.Fabdes" +
"c + CountName + RTRIM(CAST(trs_del3.Gsm AS varchar)) + RTRIM(CAST(trs_del3.GG AS" +
" varchar)) + RTRIM(CAST(trs_del3.ll AS varchar)) \r\n                      + RTRIM" +
"(CAST(Mas_Dia.Dia AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) END END AS " +
"GrpHeader, \r\n                      CASE PrePrint.DcRateReqd WHEN 1 THEN CASE Isn" +
"ull(Trs_Del1.ProcessType, \'P\') WHEN \'P\' THEN CASE WHEN SUM(Jobno) \r\n            " +
"          &lt;&gt; 0 THEN CASE SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_Del3.Prog)" +
" WHEN 0 THEN SUM(Trs_Del3.Prog * isnull(Pro_ReqKnitt2.rate, 0)) / SUM(Trs_Del3.P" +
"rog) \r\n                      ELSE SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_D" +
"el3.Prog) END ELSE SUM(Trs_Del3.Prog * isnull(GeneralRate, 0)) / SUM(Trs_Del3.Pr" +
"og) \r\n                      END ELSE 0 END ELSE 0 END AS Dcrate, \r\n             " +
"         CASE WHEN Preprint.DcRateReqd = 1 THEN CASE WHEN Trs_Del1.ProcessType =" +
" \'P\' THEN \'Rate\' ELSE \'\' END ELSE \'\' END AS Ratelbl, \r\n                      Mas" +
"_Design.DesignDesc, \'PROGRAM DETAILS\' AS Head\r\nFROM         Pro_ReqKnitt2 RIGHT " +
"OUTER JOIN\r\n                      Trs_Del3 AS Trs_Del3 INNER JOIN\r\n             " +
"         Mas_Fabric AS Mas_Fabric ON Trs_Del3.FabType = Mas_Fabric.FabID INNER J" +
"OIN\r\n                      Mas_Dia AS Mas_Dia ON Trs_Del3.DiaID = Mas_Dia.DiaID " +
"INNER JOIN\r\n                      Trs_Del1 ON Trs_Del3.ID = Trs_Del1.ID INNER JO" +
"IN\r\n                      Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID ON Pro" +
"_ReqKnitt2.FinDiaId = Trs_Del3.FinDiaID AND \r\n                      Pro_ReqKnitt" +
"2.FinGSM = Trs_Del3.FinGSm AND Pro_ReqKnitt2.DesignID = Trs_Del3.Print_DesignId " +
"AND Pro_ReqKnitt2.ColId = Trs_Del3.Clr AND \r\n                      Pro_ReqKnitt2" +
".CntID = Trs_Del3.Cnt AND Pro_ReqKnitt2.DiaID = Trs_Del3.DiaID AND Pro_ReqKnitt2" +
".LL = Trs_Del3.LL AND \r\n                      Pro_ReqKnitt2.GG = Trs_Del3.GG AND" +
" Pro_ReqKnitt2.GSM = Trs_Del3.Gsm AND Pro_ReqKnitt2.FabId = Trs_Del3.FabType AND" +
" \r\n                      Pro_ReqKnitt2.OrdId = Trs_Del3.OrdId AND Pro_ReqKnitt2." +
"DeptId = Trs_Del1.Prs_Dept LEFT OUTER JOIN\r\n                      Mas_Design ON " +
"Trs_Del3.Print_DesignId = Mas_Design.DesignId LEFT OUTER JOIN\r\n                 " +
"     BudPodet INNER JOIN\r\n                      BudPoMas ON BudPodet.Id = BudPoM" +
"as.Id ON Trs_Del3.DiaID = BudPodet.DiaId AND Trs_Del3.LL = BudPodet.LL AND \r\n   " +
"                   Trs_Del3.GG = BudPodet.GG AND Trs_Del3.Gsm = BudPodet.GSM AND" +
" Trs_Del3.FabType = BudPodet.FabId AND Trs_Del3.Clr = BudPodet.ColId AND \r\n     " +
"                 Trs_Del3.Cnt = BudPodet.CntId AND Trs_Del3.OrdId = BudPoMas.Ord" +
"Id AND Trs_Del1.Prs_Dept = BudPoMas.DeptId AND \r\n                      Trs_Del1." +
"Party = BudPoMas.PartyId LEFT OUTER JOIN\r\n                      Mas_Count AS Mas" +
"_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN\r\n                    " +
"  Mas_Color AS Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID LEFT OUTER JOIN\r\n    " +
"                  Mas_Uom AS Mas_Uom ON Mas_Fabric.SecUomID = Mas_Uom.UomID LEFT" +
" OUTER JOIN\r\n                      OrderMas ON OrderMas.OrdId = Trs_Del3.OrdId C" +
"ROSS JOIN\r\n                      PrePrint\r\nWHERE     (Mas_Dept.ProgReqPrn = \'Y\')" +
" AND (Trs_Del3.FabType &gt; 0) AND (Mas_Dept.Deptname &lt;&gt; \'DYEING\') AND (Trs_Del3.ID" +
" = ?) AND (PrePrint.Slno = 2)\r\nGROUP BY Trs_Del3.Clr, Trs_Del3.Gsm, Trs_Del3.GG," +
" Trs_Del3.LL, Mas_Dia.Dia, Mas_Fabric.Fabdesc, Mas_Count.CountName, Mas_Color.Co" +
"lorDesc, Mas_Uom.Uom, \r\n                      PrePrint.DcRateReqd, Trs_Del1.Proc" +
"essType, Mas_Design.DesignDesc, Trs_Del3.Print_DesignId\r\nORDER BY Mas_Fabric.Fab" +
"desc + \'/\' + Mas_Count.CountName + \'/\' + Mas_Color.ColorDesc, Trs_Del3.Gsm, Trs_" +
"Del3.GG, Trs_Del3.LL, Mas_Dia.Dia\r\n";
        }
        
        public void GetYarnSubReportDataSource_SqlCommand(object sender, System.EventArgs e)
        {
            this.YarnSubReportDataSource.SqlCommand = "SELECT     Mas_Color.ColorDesc, Mas_Count.CountName, SUM(Trs_Del3.Prog) AS Prog,\r" +
"\n\tCASE WHEN Preprint.DcRateReqd = 1 THEN CASE WHEN Trs_Del1.ProcessType = \'P\' TH" +
"EN  CASE WHEN SUM(jobno) &lt;&gt; 0 THEN\t\r\nCASE SUM(Trs_Del3.Prog * BudPoDet.rate) / S" +
"UM(Trs_Del3.Prog)   WHEN  0 THEN SUM(Trs_Del3.Prog * isnull(Pro_ReqYarn2.rate, 0" +
")) / SUM(Trs_Del3.Prog) else SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_Del3.P" +
"rog)  END   \r\n else 0 end \r\nelse 0 end else 0 end  AS Dcrate\r\n,CASE WHEN Preprin" +
"t.DcRateReqd = 1 THEN CASE WHEN Trs_Del1.ProcessType = \'P\' THEN   \'Rate\' ELSE  \'" +
"\' END  ELSE  \'\' END  AS Ratelbl,\'PROGRAM DETAILS\' AS head\r\n\tFROM        Pro_ReqY" +
"arn2 RIGHT OUTER JOIN\r\n                      Trs_Del3 AS Trs_Del3 INNER JOIN\r\n  " +
"                    Trs_Del1 ON Trs_Del3.ID = Trs_Del1.ID INNER JOIN\r\n          " +
"            Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID ON Pro_ReqYarn2.Dept" +
"Id = Trs_Del1.Prs_Dept AND \r\n                      Pro_ReqYarn2.OrdId = Trs_Del3" +
".OrdId AND Pro_ReqYarn2.CountId = Trs_Del3.Cnt AND \r\n                      Pro_R" +
"eqYarn2.ColId = Trs_Del3.Clr LEFT OUTER JOIN\r\n                      BudPodet INN" +
"ER JOIN\r\n                      BudPoMas ON BudPodet.Id = BudPoMas.Id ON Trs_Del3" +
".Clr = BudPodet.ColId AND Trs_Del3.Cnt = BudPodet.CntId AND \r\n                  " +
"    Trs_Del3.OrdId = BudPoMas.OrdId AND Trs_Del1.Party = BudPoMas.PartyId AND Tr" +
"s_Del1.Prs_Dept = BudPoMas.DeptId AND \r\n                      Trs_Del1.ID = BudP" +
"oMas.Id LEFT OUTER JOIN\r\n                      Mas_Count AS Mas_Count ON Trs_Del" +
"3.Cnt = Mas_Count.CountID LEFT OUTER JOIN\r\n                      Mas_Color AS Ma" +
"s_Color ON Trs_Del3.Clr = Mas_Color.ColID Left Outer Join ordermas on ordermas.o" +
"rdid=trs_del3.Ordid cross  join Preprint\r\nWHERE     (Mas_Dept.ProgReqPrn = \'Y\') " +
"AND (Trs_Del3.FabType = 0) and trs_del3.id=? and Preprint.Slno=2\r\nGROUP BY  Mas_" +
"Count.CountName,Mas_Color.ColorDesc,Trs_Del1.ProcessType,Preprint.DcRateReqd\r\n";
        }
        
        #region DataSource DyeingsubReport
        public class DyeingsubReportDataSource : Stimulsoft.Report.Dictionary.StiOleDbSource
        {
            
            public DyeingsubReportDataSource() : 
                    base("Connection", "DyeingsubReport", "DyeingsubReport", "", true, false, 30)
            {
            }
            
            public virtual int ID
            {
                get
                {
                    return ((int)(StiReport.ChangeType(this["ID"], typeof(int), true)));
                }
            }
            
            public virtual string ColorDesc
            {
                get
                {
                    return ((string)(StiReport.ChangeType(this["ColorDesc"], typeof(string), true)));
                }
            }
            
            public virtual string LotNo
            {
                get
                {
                    return ((string)(StiReport.ChangeType(this["LotNo"], typeof(string), true)));
                }
            }
            
            public virtual decimal ConfirmedRate
            {
                get
                {
                    return ((decimal)(StiReport.ChangeType(this["ConfirmedRate"], typeof(decimal), true)));
                }
            }
            
            public virtual string ProgReqPrn
            {
                get
                {
                    return ((string)(StiReport.ChangeType(this["ProgReqPrn"], typeof(string), true)));
                }
            }
            
            public virtual string Head
            {
                get
                {
                    return ((string)(StiReport.ChangeType(this["Head"], typeof(string), true)));
                }
            }
            
            public virtual decimal BudjetRate
            {
                get
                {
                    return ((decimal)(StiReport.ChangeType(this["BudjetRate"], typeof(decimal), true)));
                }
            }
            
            public virtual string Ratelbl
            {
                get
                {
