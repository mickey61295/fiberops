    <DataSources isList="true" count="1">
      <CutBundleIssue Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>CutBundleIssue</Alias>
        <Columns isList="true" count="15">
          <value>DocNo,System.String</value>
          <value>IssDt,System.DateTime</value>
          <value>OrdId,System.Int32</value>
          <value>OrdNo,System.String</value>
          <value>Styleno,System.String</value>
          <value>ExpID,System.Int32</value>
          <value>ExporterName,System.String</value>
          <value>SizeID,System.Int32</value>
          <value>SizeDesc,System.String</value>
          <value>ColID,System.Int32</value>
          <value>ColorDesc,System.String</value>
          <value>PartID,System.Int32</value>
          <value>PartName,System.String</value>
          <value>BundleNo,System.Int32</value>
          <value>Pcs,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>CutBundleIssue</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,3,0</value>
        </Parameters>
        <SqlCommand>Select Rtrim(cast(DocNo as varchar)) + '/' + a.Finyear as DocNo,IssDt,OrderMas.OrdId,  CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE  RTRIM(CAST(OrderMas.Jobno AS varchar)) + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END as OrdNo,Styleno,Mas_Exporter.ExpID,Mas_Exporter.ExporterName,
Mas_Size.SizeID,Mas_Size.SizeDesc,Mas_Color.ColID,Mas_Color.ColorDesc,Mas_Part.PartID,Mas_Part.PartName,D.BundleNo,D.Pcs from Pay_Bundle_Despatch A INNER JOIN Pay_Bundle_Despatch_det B ON  A.Id = B.ID INNER JOIN Pay_CuttProdMas c on b.BundleMasId = c.id
INNER JOIN Pay_CuttProd_Bundle D ON C.ID = D.ID AND B.BundleID = D.BundleId INNER JOIN OrderMas on Ordermas.OrdId=c.OrdID INNER JOIN Mas_Part ON C.PartId=Mas_Part.PartID INNER JOIN Mas_Color ON Mas_Color.ColID=C.Colid INNER JOIN Mas_Size ON Mas_Size.SizeID=D.SizeID INNER JOIN Mas_Exporter ON Mas_Exporter.ExpID=A.Coycode where A.Id=?</SqlCommand>
      </CutBundleIssue>
    </DataSources>
    <Relations isList="true" count="0" />
    <Report isRef="0" />
