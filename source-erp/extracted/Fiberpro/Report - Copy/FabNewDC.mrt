    <DataSources isList="true" count="4">
      <DyeingsubReport Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DyeingsubReport</Alias>
        <Columns isList="true" count="3">
          <value>ID,System.Int32</value>
          <value>ColorDesc,System.String</value>
          <value>LotNo,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DyeingsubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT DISTINCT TOP 100 PERCENT Trs_Del3.ID, Mas_Color.ColorDesc, Trs_Del3.LotNo
FROM         dbo.Trs_Del3 Trs_Del3 INNER JOIN
                      dbo.Trs_Del1 ON Trs_Del3.ID = dbo.Trs_Del1.ID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Mas_Color Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID
WHERE     (Trs_Del3.ID = ?) and (dbo.Mas_Dept.Deptname = 'DYEING') and    (dbo.Mas_Dept.ProgReqPrn = 'Y')</SqlCommand>
      </DyeingsubReport>
      <FabDC Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabDC</Alias>
        <Columns isList="true" count="48">
          <value>ID,System.Int32</value>
          <value>DcNo,System.String</value>
          <value>Dt,System.DateTime</value>
          <value>TrType,System.Int32</value>
          <value>Prs_Dept,System.Int32</value>
          <value>delwgt,System.Decimal</value>
          <value>OrderNo,System.String</value>
          <value>StyleNo,System.String</value>
          <value>Deptname,System.String</value>
          <value>OutputType,System.String</value>
          <value>BgRl,System.Int32</value>
          <value>Kg,System.Decimal</value>
          <value>mtr,System.Decimal</value>
          <value>Pname,System.String</value>
          <value>Paddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>ExporterName,System.String</value>
          <value>DCFormat,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>ExpPhone,System.String</value>
          <value>ExpTIN,System.String</value>
          <value>ExpCST,System.String</value>
          <value>PartyDCref,System.String</value>
          <value>CntID,System.Int32</value>
          <value>ColID,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>ll,System.String</value>
          <value>DcPre,System.String</value>
          <value>Fabdesc,System.String</value>
          <value>Dia,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>remark,System.String</value>
          <value>UOM,System.String</value>
          <value>ITEMDESC,System.String</value>
          <value>Heading,System.String</value>
          <value>VName,System.String</value>
          <value>Terms,System.String</value>
          <value>GrpHeader,System.String</value>
          <value>GPNo,System.Int32</value>
          <value>GatePassFlg,System.String</value>
          <value>Username,System.String</value>
          <value>DesignDesc,System.String</value>
          <value>GSTNo,System.String</value>
          <value>ExpGST,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>

SELECT     TOP 100 PERCENT Trs_Del1.ID,CASE WHEN len(rtrim(dcpre)) &lt; 1 THEN RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear ELSE CASE WHEN  len(rtrim(isnull(dcpre,0))) = 0 THEN RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear ELSE rtrim(dcpre)  + '-' + RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear END END AS DcNo, Trs_Del1.Dt, Trs_Del1.TrType, Trs_Del1.Prs_Dept, Trs_Del1.delwgt, 
                      CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar)) 
                      + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, OrderMas2.StyleNo, Mas_Dept.Deptname, Mas_Dept.OutputType, Trs_Del2.BgRl, Trs_Del2.Kg, 
                      Trs_Del2.mtr, Mas_Party.Pname, Mas_Party.Paddress, Mas_Party.Phone, Mas_Party.TIN, Mas_Party.CST,Mas_Party.GSTNo, Mas_Exporter.ExporterName, Mas_Dept.DCFormat, 
                      Mas_Exporter.ExporterAddress, Mas_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN, Mas_Exporter.CST AS ExpCST,Mas_Exporter.GSTNo AS ExpGST, Trs_Grn1.PartyDCref, 
                      StockTable.CntID, StockTable.ColID, StockTable.Gsm, StockTable.GG, StockTable.ll, Mas_Grp.DcPre, Mas_Fabric.Fabdesc, Mas_Dia.Dia, Mas_Color.ColorDesc, 
                      Mas_Count.CountName, Trs_Del1.remark, CASE WHEN TRS_DEL2.MTR &gt; 0 THEN Mas_Uom.Uom ELSE '' END AS UOM, 
                      CASE WHEN StockTable.ColID &gt; 0 THEN FABDESC + '/' + COUNTNAME + '/' + COLORDESC ELSE FABDESC + '/' + COUNTNAME END AS ITEMDESC, 
                      CASE Trtype WHEN 1 THEN 'PROCESS DELIVERY' WHEN 4 THEN 'PURCHASE RETURN' WHEN 13 THEN 'PARTY REJECTION RETURN' END AS Heading, 
                      dbo.Mas_Vehicle.VName, Mas_Terms.Terms, 
                      CASE WHEN StockTable.ColID &gt; 0 THEN fabdesc + Countname + COLORDESC + RTRIM(CAST(StockTable.ColID AS varchar)) 
                      + RTRIM(CAST(StockTable.Gsm AS varchar)) + RTRIM(CAST(StockTable.GG AS varchar)) + RTRIM(CAST(StockTable.ll AS varchar)) 
                      + RTRIM(CAST(Mas_Dia.Dia AS varchar)) ELSE fabdesc + Countname + RTRIM(CAST(StockTable.ColID AS varchar)) + RTRIM(CAST(StockTable.Gsm AS varchar)) 
                      + RTRIM(CAST(StockTable.GG AS varchar)) + RTRIM(CAST(StockTable.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) END AS GrpHeader, Trs_Del1.GPNo, 
                      ISNULL(dbo.Options.GatePassFlg, 'N') AS GatePassFlg, dbo.Mas_User.Username, dbo.Mas_Design.DesignDesc
FROM         dbo.Trs_Del1 AS Trs_Del1 INNER JOIN
                      dbo.Mas_Dept AS Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID INNER JOIN
                      dbo.Trs_Del2 AS Trs_Del2 ON Trs_Del1.ID = Trs_Del2.ID INNER JOIN
                      dbo.Mas_Party AS Mas_Party ON Trs_Del1.Party = Mas_Party.PID INNER JOIN
                      dbo.Mas_Exporter AS Mas_Exporter ON Trs_Del1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.OrderMas AS OrderMas ON Trs_Del2.OrdId = OrderMas.OrdId 
INNER JOIN OrderMas2 ON OrderMas.ORdid  = OrderMas2.Ordid 
LEFT OUTER JOIN
                      dbo.Trs_Grn1 AS Trs_Grn1 ON Trs_Del1.OurGRNID = Trs_Grn1.ID INNER JOIN
                      dbo.StockTable AS StockTable ON Trs_Del2.StockID = StockTable.StockID LEFT OUTER JOIN
                      dbo.Mas_Grp AS Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo INNER JOIN
                      dbo.Mas_Dia AS Mas_Dia ON StockTable.DiaID = Mas_Dia.DiaID INNER JOIN
                      dbo.Mas_Fabric AS Mas_Fabric ON StockTable.FabID = Mas_Fabric.FabID LEFT OUTER JOIN
                      dbo.Mas_Design ON StockTable.PRINT_DESIGNID = dbo.Mas_Design.DesignId LEFT OUTER JOIN
                      dbo.Mas_Vehicle ON Trs_Del1.VehicleCode = dbo.Mas_Vehicle.Code LEFT OUTER JOIN
                      dbo.Mas_Count AS Mas_Count ON StockTable.CntID = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN
                      dbo.Mas_Uom AS Mas_Uom ON Mas_Fabric.SecUomID = Mas_Uom.UomID LEFT OUTER JOIN
                      dbo.Mas_User ON Trs_Del1.PreparedBy = dbo.Mas_User.UserCode LEFT OUTER JOIN
                      dbo.Mas_Terms AS Mas_Terms ON Mas_Dept.DC_TermCode = Mas_Terms.ID CROSS JOIN
                      dbo.Options
WHERE     (Trs_Del1.ID = ?)
ORDER BY Mas_Fabric.Fabdesc + '/' + Mas_Count.CountName + '/' + Mas_Color.ColorDesc, StockTable.Gsm, StockTable.GG, StockTable.ll, Mas_Dia.Dia</SqlCommand>
      </FabDC>
      <FabricSubReport Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabricSubReport</Alias>
        <Columns isList="true" count="11">
          <value>ID,System.Int32</value>
          <value>Clr,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>LL,System.String</value>
          <value>Prog,System.Decimal</value>
          <value>ProgMtr,System.Decimal</value>
          <value>Dia,System.String</value>
          <value>ItemDesc,System.String</value>
          <value>UOM,System.String</value>
          <value>GrpHeader,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabricSubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     TOP 100 PERCENT Trs_Del3.ID, Trs_Del3.Clr, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, (Trs_Del3.Prog) AS Prog, (Trs_Del3.ProgMtr) AS ProgMtr, 
                      Mas_Dia.Dia, 
                      ItemDesc = CASE WHEN Trs_del3.clr &gt; 0 THEN Mas_Fabric.Fabdesc + '/' + CountName + '/' + Colordesc ELSE Mas_Fabric.Fabdesc + '/' + CountName END,
                       UOM = CASE WHEN (ProgMtr) &gt; 0 THEN Mas_Uom.Uom ELSE '' END, 
                      GrpHeader = CASE WHEN Trs_del3.clr &gt; 0 THEN Mas_Fabric.Fabdesc + CountName + Colordesc + RTRIM(CAST(trs_del3.Gsm AS varchar)) 
                      + RTRIM(CAST(trs_del3.GG AS varchar)) + RTRIM(CAST(trs_del3.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) 
                      ELSE Mas_Fabric.Fabdesc + CountName + RTRIM(CAST(trs_del3.Gsm AS varchar)) + RTRIM(CAST(trs_del3.GG AS varchar)) 
                      + RTRIM(CAST(trs_del3.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) END
FROM         dbo.Trs_Del3 Trs_Del3 INNER JOIN
                      dbo.Mas_Fabric Mas_Fabric ON Trs_Del3.FabType = Mas_Fabric.FabID INNER JOIN
                      dbo.Mas_Dia Mas_Dia ON Trs_Del3.DiaID = Mas_Dia.DiaID INNER JOIN
                      dbo.Trs_Del1 ON Trs_Del3.ID = dbo.Trs_Del1.ID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Mas_Count Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID LEFT OUTER JOIN
                      dbo.Mas_Uom Mas_Uom ON Mas_Fabric.SecUomID = Mas_Uom.UomID
WHERE     (dbo.Mas_Dept.ProgReqPrn = 'Y') AND (dbo.Mas_Dept.Deptname &lt;&gt; 'DYEING') AND (Trs_Del3.FabType &gt; 0) and trs_del3.id=?
ORDER BY Mas_Fabric.Fabdesc + '/' + Mas_Count.CountName + '/' + Mas_Color.ColorDesc, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, Mas_Dia.Dia
</SqlCommand>
      </FabricSubReport>
      <YarnSubReportDataSource Ref="6" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>YarnSubReportDataSource</Alias>
        <Columns isList="true" count="3">
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>Prog,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnSubReportDataSource</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Mas_Color.ColorDesc, Mas_Count.CountName, SUM(Trs_Del3.Prog) AS Prog
	FROM         dbo.Trs_Del3 Trs_Del3 INNER JOIN
                      dbo.Trs_Del1 ON Trs_Del3.ID = dbo.Trs_Del1.ID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Mas_Count Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID
WHERE     (dbo.Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.FabType = 0) and trs_del3.id=?
GROUP BY  Mas_Count.CountName,Mas_Color.ColorDesc</SqlCommand>
      </YarnSubReportDataSource>
    </DataSources>
