          <value>WorkComplDet,System.String</value>
          <value>PanelName,System.String</value>
          <value>BuyerName,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>SizeDesc,System.String</value>
          <value>StyleDesc,System.String</value>
          <value>PartName,System.String</value>
          <value>Terms,System.String</value>
          <value>Gpno,System.Int32</value>
          <value>GatePassFlg,System.String</value>
          <value>ProcessType,System.String</value>
          <value>Tardt,System.DateTime</value>
          <value>IoNoCaption,System.String</value>
          <value>UserName,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>PcsDc</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM(CAST(Trs_Pcs1.DocNo AS varchar)) + '/' + Trs_Pcs1.Finyear AS DCNo, Trs_Pcs1.dtDCDate, Trs_Pcs1.DelType, 
                      Trs_Pcs1.NoBdl, Trs_Pcs1.Wgt, Trs_Pcs1.Remark, RTRIM(CAST(OrderMas.Jobno AS varchar)) 
                      + '/' + OrderMas.Finyear as Iono,OrderMas.BuyOrdNo AS OrderNo, Trs_Pcs2.StyleNo, Mas_Exporter.ExporterName, Mas_Dept.DCFormat, 
                      Mas_Exporter.ExporterAddress, Mas_Exporter.Phone, Mas_Exporter.TIN, Mas_Exporter.CST, Case When Trs_Pcs1.DelType = 'Unit Transfer' Then Mas_Unit.ExporterName Else Mas_Party.Pname END as Pname,  Case When Trs_Pcs1.DelType = 'Unit Transfer' Then Mas_Unit.ExporterAddress Else Mas_Party.Paddress End as Paddress, 
                       Case When Trs_Pcs1.DelType = 'Unit Transfer' Then Mas_Unit.Phone Else  Mas_Party.Phone END AS PPhone,  Case When Trs_Pcs1.DelType = 'Unit Transfer' Then Mas_Unit.TIN Else Mas_Party.TIN End as PTIN,  Case When Trs_Pcs1.DelType = 'Unit Transfer' Then Mas_Unit.CST Else  Mas_Party.CST END AS PCST, Trs_Pcs2.Pcs, Mas_Dept.Deptname, OrdSizeMas.SNo, 
                      Mas_JobWrkComp.WorkComplDet, Mas_Panel.PanelName, Mas_Buyer.ShortBuyer as BuyerName, Mas_Color.ColorDesc, Mas_Size.SizeDesc, Mas_StyleDesc.StyleDesc, 
                      dbo.Mas_Part.PartName, dbo.Mas_Terms.Terms,Gpno,isnull(options.GatePassFlg,'N') as GatePassFlg,case when isnull(Trs_Pcs1.ProcessType,'P')='P' then 'PROCESS' else 'RE-PROCESS' end AS ProcessType,Tardt,Mas_Exporter.IoNoCaption, Mas_User.UserName
FROM         dbo.Trs_Pcs1 Trs_Pcs1 INNER JOIN
                      dbo.Mas_Exporter Mas_Exporter ON Trs_Pcs1.Coycode = Mas_Exporter.ExpID LEFT OUTER JOIN
                      dbo.Mas_Party Mas_Party ON Trs_Pcs1.Party = Mas_Party.PID INNER JOIN
                      dbo.Trs_Pcs2 Trs_Pcs2 ON Trs_Pcs1.ID = Trs_Pcs2.ID INNER JOIN
                      dbo.OrderMas OrderMas ON Trs_Pcs1.Ordjobno = OrderMas.OrdId LEFT OUTER JOIN
					  dbo.Mas_Buyer Mas_Buyer ON OrderMas.BuyerID = Mas_Buyer.BuyerID INNER JOIN
                      dbo.OrdSizeMas OrdSizeMas ON Trs_Pcs1.Ordjobno = OrdSizeMas.OrdID AND Trs_Pcs2.SizeID = OrdSizeMas.SizeID LEFT OUTER JOIN
                      dbo.Mas_JobWrkComp Mas_JobWrkComp ON Trs_Pcs1.Dept = Mas_JobWrkComp.Id LEFT OUTER JOIN
                      dbo.Mas_Dept Mas_Dept ON Trs_Pcs1.Dept = Mas_Dept.DeptID INNER JOIN
                      dbo.Mas_Color Mas_Color ON Trs_Pcs2.ColID = Mas_Color.ColID INNER JOIN
                      dbo.Mas_Size Mas_Size ON Trs_Pcs2.SizeID = Mas_Size.SizeID INNER JOIN
                      dbo.Mas_StyleDesc Mas_StyleDesc ON Trs_Pcs2.StyleID = Mas_StyleDesc.StyleID LEFT OUTER JOIN
                      dbo.Mas_Terms ON Mas_Dept.DC_TermCode = dbo.Mas_Terms.ID LEFT OUTER JOIN
                      dbo.Mas_Part ON Trs_Pcs2.PartID = dbo.Mas_Part.PartID LEFT OUTER JOIN
                      dbo.Mas_Panel Mas_Panel ON Trs_Pcs2.PanelID = Mas_Panel.PanelID LEFT OUTER JOIN
                      dbo.Mas_Exporter Mas_Unit ON Trs_Pcs1.ToCoyCode = Mas_Unit.ExpID LEFT OUTER JOIN Mas_User ON Trs_Pcs1.PreparedBy = Mas_User.UserCode cross join Options
where Trs_Pcs1.id=?
 Order by sno</SqlCommand>
      </PcsDc>
      <Vue_Pcs2_Acc Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>Vue_Pcs2_Acc</Alias>
        <Columns isList="true" count="9">
          <value>Acc_Descr,System.String</value>
          <value>AccDescription,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>SizeDesc,System.String</value>
          <value>AQty,System.Decimal</value>
          <value>OrdID,System.Int32</value>
          <value>ID,System.Int32</value>
          <value>Uom,System.String</value>
          <value>SNo,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>Vue_Pcs2_Acc</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     dbo.Mas_Acc.Acc_Descr, dbo.Mas_AccDes.AccDescription, dbo.Mas_Color.ColorDesc, dbo.Mas_Size.SizeDesc, dbo.Trs_Pcs2_Acc.AQty, dbo.Trs_Pcs2_Acc.OrdID, 
	dbo.Trs_Pcs2_Acc.ID, dbo.Mas_Uom.Uom, dbo.OrdSizeMas.SNo
	FROM         dbo.Trs_Pcs2_Acc INNER JOIN
	dbo.Mas_Color ON dbo.Trs_Pcs2_Acc.ColID = dbo.Mas_Color.ColID INNER JOIN
                      dbo.Mas_Size ON dbo.Trs_Pcs2_Acc.SizeID = dbo.Mas_Size.SizeID INNER JOIN
                      dbo.Mas_Acc ON dbo.Trs_Pcs2_Acc.Acc_Type = dbo.Mas_Acc.ID INNER JOIN
                      dbo.Mas_AccDes ON dbo.Trs_Pcs2_Acc.Acc_Desc = dbo.Mas_AccDes.ID INNER JOIN
                      dbo.Mas_Uom ON dbo.Mas_Acc.UomId = dbo.Mas_Uom.UomID INNER JOIN
                      dbo.OrdSizeMas ON dbo.Trs_Pcs2_Acc.OrdID = dbo.OrdSizeMas.OrdID AND
 dbo.OrdSizeMas.StyleNo = Trs_Pcs2_Acc.StyleNo 
 AND dbo.Trs_Pcs2_Acc.SizeID = dbo.OrdSizeMas.SizeID
WHERE Trs_Pcs2_Acc.AQty &gt; 0 and Trs_Pcs2_Acc.ID = ? 
ORDER BY OrdSizeMas.SNo,Mas_AccDes.AccDescription</SqlCommand>
      </Vue_Pcs2_Acc>
    </DataSources>
