    <DataSources isList="true" count="1">
      <LinePcs Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>LinePcs</Alias>
        <Columns isList="true" count="15">
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>phone,System.String</value>
          <value>GSTNo,System.String</value>
          <value>EMailid,System.String</value>
          <value>LineName,System.String</value>
          <value>IssDt,System.DateTime</value>
          <value>JobNo,System.String</value>
          <value>StyleNo,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>Part,System.String</value>
          <value>SizeDesc,System.String</value>
          <value>Pcs,System.Int32</value>
          <value>BundleNo,System.Int32</value>
          <value>Barcode,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>LinePcs</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>Select ExporterName,ExporterAddress, phone,GSTNo,EMailid, Mas_Emp.EmpName as LineName, A.IssDt,Rtrim(O.Jobno ) + '/' + O.Finyear  as JobNo,B.StyleNo,B.ColorDesc,B.Part,B.SizeDesc,B.Pcs,B.BundleNo,B.Barcode  from Pay_Bundle_IsstoLine A INNER JOIN Pay_BarcodeGeneration B ON A.BundleMasId = B.BundleMasID And A.BundleID = B.BundleID
And A.LineId = B.LineID 
INNER JOIN OrderMas O ON B.OrdId = O.OrdId 
INNER JOIN Mas_Emp ON A.LineId = Mas_Emp.Id  
INNER JOIN Mas_Exporter ON B.Coycode = Mas_Exporter.ExpID 
where A.ID= ?</SqlCommand>
      </LinePcs>
    </DataSources>
    <Relations isList="true" count="0" />
    <Report isRef="0" />
