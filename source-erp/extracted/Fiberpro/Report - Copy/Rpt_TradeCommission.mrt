    <DataSources isList="true" count="3">
      <DataSource1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="18">
          <value>invno,System.String</value>
          <value>CountName,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>BilledKg,System.Decimal</value>
          <value>BillAmount,System.Decimal</value>
          <value>Billno,System.String</value>
          <value>BillDt,System.DateTime</value>
          <value>Pname,System.String</value>
          <value>ComPer,System.Decimal</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>GSTNo,System.String</value>
          <value>pan,System.String</value>
          <value>PGSTNO,System.String</value>
          <value>Paddress,System.String</value>
          <value>PPan,System.String</value>
          <value>PLname,System.String</value>
          <value>descption,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>select rtrim(Trs_TradeInwardMas.InvNo)+'/'+Trs_TradeInwardMas.Finyear as InvNo, Mas_Count.CountName,Mas_Color.ColorDesc,Trs_TradeCommissionDet.BilledKg,Trs_TradeCommissionDet.Billamount,Trs_TradeCommission.Billno,Trs_TradeCommission.BillDt,Mas_Party.Pname,Trs_TradeCommission.ComPer,Mas_Exporter.ExporterName,Mas_Exporter.ExporterAddress,Mas_Exporter.GSTNo,Mas_Exporter.pan,Mas_Party.GSTNo as PGSTNO,Mas_Party.Paddress,Mas_Party.Pan as PPan,Mas_Party.LName as PLname,Trs_TradeOrdConFirmationDet.Description as descption from Trs_TradeCommission inner join Trs_TradeInwardMas on Trs_TradeCommission.OrderconfromationNo=Trs_TradeInwardMas.OrdConformationNo
inner join Trs_TradeInwardDet on Trs_TradeInwardDet.Invid=Trs_TradeInwardMas.Invid
inner join Trs_TradeCommissionDet on Trs_TradeCommissionDet.Id=Trs_TradeCommission.Id and Trs_TradeCommissionDet.Invid=Trs_TradeInwardMas.Invid inner join Mas_Count on Mas_Count.CountID=Trs_TradeCommissionDet.cntid and mas_count.CountID=Trs_TradeInwardDet.Countid left outer join mas_color on Mas_Color.ColID=Trs_TradeCommissionDet.Colid and Mas_Color.ColID=Trs_TradeInwardDet.Colid 
 inner join Mas_Exporter on Mas_Exporter.ExpID=Trs_TradeCommission.Coycode 
 inner join Mas_Party on Mas_Party.PID=Trs_TradeCommission.Partyid
  inner join Trs_TradeOrdConFirmationMas on Trs_TradeOrdConFirmationMas.ID=Trs_TradeInwardMas.OrdConformationId inner join Trs_TradeOrdConFirmationDet on Trs_TradeOrdConFirmationDet.Id=Trs_TradeOrdConFirmationMas.ID and Trs_TradeOrdConFirmationDet.CountID=Trs_TradeInwardDet.Countid
where     Trs_TradeCommission.Id=?
</SqlCommand>
      </DataSource1>
      <DataSource2 Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource2</Alias>
        <Columns isList="true" count="9">
          <value>Id,System.Int32</value>
          <value>HSNCode,System.String</value>
          <value>CGSTPer,System.Decimal</value>
          <value>SGSTPer,System.Decimal</value>
          <value>IGSTPer,System.Decimal</value>
          <value>CGSTAmt,System.Decimal</value>
          <value>SGSTAmt,System.Decimal</value>
          <value>IGSTAmt,System.Decimal</value>
          <value>PartyAmount,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource2</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>
Select   Trs_TradeCommission.Id,IsNull(HSNCode,'') as HSNCode,Case When IsNull(Mas_Exporter.Stateid,1)=IsNull(Mas_Party.Stateid,1) Then IsNull(Trs_TradeCommission.HsnPerc,0)/2  End as CGSTPer,Case When IsNull(Mas_Exporter.Stateid,1)=IsNull(Mas_Party.Stateid,1) Then IsNull(Trs_TradeCommission.HsnPerc,0)/2 End as SGSTPer
,Case When IsNull(Mas_Exporter.Stateid,1)&lt;&gt;IsNull(Mas_Party.Stateid,1) Then IsNull(Trs_TradeCommission.HsnPerc,0) End as IGSTPer,  Case When IsNull(Mas_Exporter.Stateid,1)=IsNull(Mas_Party.Stateid,1) Then  ((IsNull(Trs_TradeCommission.HsnPerc,0)/2)*Sum(IsNull(Trs_TradeBillAddded.Amount,0)
)/100) End   as CGSTAmt,Case When IsNull(Mas_Exporter.Stateid,1)=IsNull(Mas_Party.Stateid,1) Then   ((IsNull(Trs_TradeCommission.HsnPerc,0)/2)*Sum(IsNull(Trs_TradeBillAddded.Amount,0))/100)   End as SGSTAmt,Case When IsNull(Mas_Exporter.Stateid,1)&lt;&gt;IsNull(Mas_Party.Stateid,1)
 Then   ((IsNull(Trs_TradeCommission.HsnPerc,0))*Sum(IsNull(Trs_TradeBillAddded.Amount,0))/100) End   as IGSTAmt,Trs_TradeBillAddded.PartyAmount from Trs_TradeCommission inner join mas_exporter	on Mas_Exporter.ExpID=Trs_TradeCommission.Coycode    inner join Mas_Party on Mas_Party.PID=Trs_TradeCommission.Partyid left outer join Mas_HSN on Mas_HSN.Id=Trs_TradeCommission.hsnid inner join Trs_TradeBillAddded on Trs_TradeBillAddded.Id=Trs_TradeCommission.Id where Trs_TradeCommission.Id=? and Trs_TradeBillAddded.Adddedcode =1 group by  Trs_TradeCommission.Id,Mas_HSN.HSNCode,Mas_Party.Stateid,Mas_Exporter.Stateid,Trs_TradeCommission.HsnPerc,Trs_TradeBillAddded.Amount,Trs_TradeBillAddded.PartyAmount
</SqlCommand>
      </DataSource2>
      <DataSource3 Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource3</Alias>
        <Columns isList="true" count="1">
