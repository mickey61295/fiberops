        <Name>DataSource3</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>select Value FROM Trs_TradeBillAddded where  id=? and Adddedcode=25 
</SqlCommand>
      </DataSource3>
