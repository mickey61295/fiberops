    <Databases isList="true" count="1">
      <Connection Ref="2" type="Stimulsoft.Report.Dictionary.StiOleDbDatabase" isKey="true">
        <Alias>Connection</Alias>
        <ConnectionString>Provider=SQLOLEDB.1;Persist Security Info=False;User ID=sa;Initial Catalog=JOMS;Data Source=MACHINE-14</ConnectionString>
        <Name>Connection</Name>
        <PromptUserNameAndPassword>False</PromptUserNameAndPassword>
      </Connection>
    </Databases>
    <DataSources isList="true" count="1">
      <AccOpening Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>AccOpening</Alias>
        <Columns isList="true" count="12">
          <value>OpenDt,System.DateTime</value>
          <value>ExporterName,System.String</value>
          <value>OrderNo,System.String</value>
          <value>MtrPc,System.Decimal</value>
          <value>rate,System.Decimal</value>
          <value>AccDesc,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>SizeDesc,System.String</value>
          <value>Uom,System.String</value>
          <value>Kgs,System.Decimal</value>
          <value>UserName,System.String</value>
          <value>Remarks,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>AccOpening</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="3">
          <value>_x0040_OpeningDate,_x0022_09.09.2009_x0022_,7,0</value>
          <value>_x0040_DeptId,_x0030_,3,0</value>
          <value>_x0040_Ordid,,3,0</value>
        </Parameters>
        <SqlCommand>SELECT     dbo.Trs_Opening.OpenDt, dbo.Mas_Exporter.ExporterName, CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar))
                       + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, 
	dbo.Trs_Opening.MtrPc, dbo.Trs_Opening.rate, dbo.Mas_Acc.Acc_Descr + '/' + dbo.Mas_AccDes.AccDescription AS AccDesc, 
	dbo.Mas_Color.ColorDesc, dbo.Mas_Size.SizeDesc, dbo.Mas_Uom.Uom, dbo.Trs_Opening.Kgs, Mas_User.UserName,isnull(Trs_opening.Remarks,'') as Remarks
	FROM    dbo.Mas_AccDes RIGHT OUTER JOIN
                      dbo.Mas_Acc INNER JOIN
                      dbo.Trs_Opening INNER JOIN
                      dbo.Mas_Exporter ON dbo.Trs_Opening.Coycode = dbo.Mas_Exporter.ExpID INNER JOIN
                      dbo.StockTable ON dbo.Trs_Opening.StockID = dbo.StockTable.StockID INNER JOIN
                      dbo.OrderMas ON dbo.Trs_Opening.OrdID = dbo.OrderMas.OrdId ON dbo.Mas_Acc.ID = dbo.StockTable.Atype INNER JOIN
                      dbo.Mas_Uom ON dbo.Mas_Acc.UomId = dbo.Mas_Uom.UomID LEFT OUTER JOIN
                      dbo.Mas_Color ON dbo.StockTable.ColID = dbo.Mas_Color.ColID LEFT OUTER JOIN
                      dbo.Mas_Size ON dbo.StockTable.Siz = dbo.Mas_Size.SizeID ON dbo.Mas_AccDes.AccTypeID = dbo.Mas_Acc.ID AND 
                      dbo.Mas_AccDes.ID = dbo.StockTable.Ades LEFT OUTER JOIN Mas_User ON Trs_Opening.PreparedBy = Mas_User.UserCode
WHERE Trs_Opening.OpenDt = convert(datetime,?,102) and Trs_Opening.Dept=? and Trs_opening.Ordid=?</SqlCommand>
      </AccOpening>
    </DataSources>
    <Relations isList="true" count="0" />
    <Report isRef="0" />
    <Variables isList="true" count="0" />
  </Dictionary>
