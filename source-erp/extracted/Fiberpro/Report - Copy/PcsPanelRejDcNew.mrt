        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>PcsDc</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM(CAST(Trs_RejGodTran1.DocNo AS varchar)) + '/' + Trs_RejGodTran1.Finyear AS DCNo, Trs_RejGodTran1.dtDCDate, Trs_RejGodTran1.DelType, 
                      Trs_RejGodTran1.NoBdl, Trs_RejGodTran1.Wgt, Trs_RejGodTran1.Remark, RTRIM(CAST(OrderMas.Jobno AS varchar)) 
                      + '/' + OrderMas.Finyear as Iono,OrderMas.BuyOrdNo AS OrderNo, Trs_RejGodTran2.StyleNo, Mas_Exporter.ExporterName, Mas_Dept.DCFormat, 
                      Mas_Exporter.ExporterAddress, Mas_Exporter.Phone, Mas_Exporter.TIN, Mas_Exporter.CST,Mas_Exporter.pan AS PAN, 
					 Mas_Godown_2.GodName AS ToGoDownName, REPLACE(CAST(Mas_Godown_2.Address AS varchar(400)), CHAR(10), '') AS GodownAdd, 
                      REPLACE(CAST(Mas_Godown_2.Address AS varchar(400)), CHAR(10), '') AS ToGoDownAdd, Mas_Godown_2.Phone AS ToGoDownPh, dbo.Mas_Godown.GodName, REPLACE(CAST(dbo.Mas_Godown.Address AS varchar(400)), CHAR(10), '') 
                      AS GAddress, dbo.Mas_Godown.Phone as GPhone, Trs_RejGodTran2.Pcs, Mas_Dept.Deptname, OrdSizeMas.SNo, Mas_JobWrkComp.WorkComplDet,
					  Mas_Panel.PanelName, Mas_Buyer.ShortBuyer as BuyerName,Mas_Color.ColorDesc, Mas_Size.SizeDesc, Mas_StyleDesc.StyleDesc, dbo.Mas_Part.PartName, dbo.Mas_Terms.Terms,Gpno,isnull(options.GatePassFlg,'N') as
						 GatePassFlg,
						 
						


						 case when Trs_RejGodTran1.DelType = 'godown transfer' then 'GODOWN TRANSFER'
						 else  case when isnull(Trs_RejGodTran1.ProcessType,'P')='P' then 'PROCESS'
						 else 'REPROCESS' end end 
						  
						   AS ProcessType ,
						   Tardt,Mas_Exporter.IoNoCaption,
						  Mas_User.UserName,Ordermas.ordertype
FROM         dbo.Trs_RejGodTran1 Trs_RejGodTran1 INNER JOIN
                      dbo.Mas_Exporter Mas_Exporter ON Trs_RejGodTran1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.Trs_RejGodTran2 Trs_RejGodTran2 ON Trs_RejGodTran1.ID = Trs_RejGodTran2.ID INNER JOIN
                      dbo.OrderMas OrderMas ON Trs_RejGodTran1.Ordjobno = OrderMas.OrdId INNER JOIN
                      dbo.Mas_Godown AS Mas_Godown_2 ON Trs_RejGodTran1.ToGodId  = Mas_Godown_2.GodID   

/*					  dbo.OrderQtyDtl OrderQtyDtl ON OrderQtyDtl.OrdID = OrderMas.OrdId  and										OrderQtyDtl.PartID=Trs_RejGodTran2.PartID and OrderQtyDtl.LotNo=Trs_RejGodTran2.LotNo 
					  and OrderQtyDtl.StyleNo = Trs_RejGodTran2.StyleNo  and OrderQtyDtl.ColID = Trs_RejGodTran2.ColID and Trs_RejGodTran2.SizeID = OrderQtyDtl.SizeId
	*/				  
					  					  LEFT OUTER JOIN
					  dbo.Mas_Buyer Mas_Buyer ON OrderMas.BuyerID = Mas_Buyer.BuyerID INNER JOIN
                      dbo.OrdSizeMas OrdSizeMas ON Trs_RejGodTran1.Ordjobno = OrdSizeMas.OrdID AND Trs_RejGodTran2.SizeID = OrdSizeMas.SizeID and									  Trs_RejGodTran2.StyleNo = OrdSizeMas.StyleNo LEFT OUTER JOIN
                      dbo.Mas_JobWrkComp Mas_JobWrkComp ON Trs_RejGodTran1.Dept = Mas_JobWrkComp.Id LEFT OUTER JOIN
                      dbo.Mas_Dept Mas_Dept ON Trs_RejGodTran1.Dept = Mas_Dept.DeptID INNER JOIN
                      dbo.Mas_Color Mas_Color ON Trs_RejGodTran2.ColID = Mas_Color.ColID INNER JOIN
                      dbo.Mas_Size Mas_Size ON Trs_RejGodTran2.SizeID = Mas_Size.SizeID  INNER JOIN
                      dbo.Mas_Godown ON Trs_RejGodTran1.GodID = dbo.Mas_Godown.GodID INNER JOIN
                      dbo.Mas_StyleDesc Mas_StyleDesc ON Trs_RejGodTran2.StyleID = Mas_StyleDesc.StyleID LEFT OUTER JOIN
                      dbo.Mas_Terms ON Mas_Dept.DC_TermCode = dbo.Mas_Terms.ID LEFT OUTER JOIN
                      dbo.Mas_Part ON Trs_RejGodTran2.PartID = dbo.Mas_Part.PartID LEFT OUTER JOIN
                      dbo.Mas_Panel Mas_Panel ON Trs_RejGodTran2.PanelID = Mas_Panel.PanelID LEFT OUTER JOIN Mas_User ON Trs_RejGodTran1.PreparedBy = Mas_User.UserCode cross join Options
where Trs_RejGodTran1.id=?
 Order by OrdSizeMas.SNo,Trs_RejGodTran2.StyleNo, 
 Mas_StyleDesc.StyleDesc, Mas_Color.ColorDesc, 
 ISNULL(Mas_Part.PartName, 'Top')
</SqlCommand>
      </PcsDc>
    </DataSources>
