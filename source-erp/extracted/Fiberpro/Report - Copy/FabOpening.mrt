<StiSerializer version="1.0" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <Databases isList="true" count="1">
      <Connection Ref="2" type="Stimulsoft.Report.Dictionary.StiOleDbDatabase" isKey="true">
        <Alias>Connection</Alias>
        <ConnectionString>Provider=SQLOLEDB.1;Persist Security Info=False;User ID=sa;Initial Catalog=JOMS;Data Source=MACHINE-18\SQL</ConnectionString>
        <Name>Connection</Name>
        <PromptUserNameAndPassword>False</PromptUserNameAndPassword>
      </Connection>
    </Databases>
    <DataSources isList="true" count="1">
      <FabOpening Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabOpening</Alias>
        <Columns isList="true" count="16">
          <value>OpenDt,System.DateTime</value>
          <value>OrderNo,System.String</value>
          <value>ExporterName,System.String</value>
          <value>Deptname,System.String</value>
          <value>ItemDesc,System.String</value>
          <value>Dia,System.String</value>
          <value>Uom,System.String</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>ll,System.String</value>
          <value>RlsBg,System.Int32</value>
          <value>Kgs,System.Decimal</value>
          <value>MtrPc,System.Decimal</value>
          <value>rate,System.Decimal</value>
          <value>UserName,System.String</value>
          <value>remarks,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabOpening</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="3">
          <value>_x0040_OpeningDate,,7,0</value>
          <value>_x0040_DeptId,,3,0</value>
          <value>_x0040_Ordid,,3,0</value>
        </Parameters>
        <SqlCommand>SELECT     dbo.Trs_Opening.OpenDt, CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar))
                       + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, 
                      dbo.Mas_Exporter.ExporterName, dbo.Mas_Dept.Deptname, 
                      CASE WHEN Stocktable.ColId &gt; 0 THEN dbo.Mas_Fabric.Fabdesc + '/' + dbo.Mas_Count.CountName + '/' + dbo.Mas_Color.ColorDesc ELSE dbo.Mas_Fabric.Fabdesc
                       + '/' + dbo.Mas_Count.CountName END AS ItemDesc, dbo.Mas_Dia.Dia, dbo.Mas_Uom.Uom, dbo.StockTable.Gsm, dbo.StockTable.GG, dbo.StockTable.ll, 
                      dbo.Trs_Opening.RlsBg, dbo.Trs_Opening.Kgs, dbo.Trs_Opening.MtrPc, dbo.Trs_Opening.rate, Mas_User.UserName,isnull(TRs_opening.remarks,'') as  remarks
FROM         dbo.Trs_Opening INNER JOIN
                      dbo.Mas_Exporter ON dbo.Trs_Opening.Coycode = dbo.Mas_Exporter.ExpID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Opening.Dept = dbo.Mas_Dept.DeptID INNER JOIN
                      dbo.StockTable ON dbo.Trs_Opening.StockID = dbo.StockTable.StockID INNER JOIN
                      dbo.Mas_Fabric ON dbo.StockTable.FabID = dbo.Mas_Fabric.FabID INNER JOIN
                      dbo.Mas_Count ON dbo.StockTable.CntID = dbo.Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color ON dbo.StockTable.ColID = dbo.Mas_Color.ColID INNER JOIN
                      dbo.Mas_Dia ON dbo.StockTable.DiaID = dbo.Mas_Dia.DiaID INNER JOIN
                      dbo.Mas_Uom ON dbo.Mas_Fabric.SecUomID = dbo.Mas_Uom.UomID INNER JOIN

                      dbo.OrderMas ON dbo.Trs_Opening.OrdID = dbo.OrderMas.OrdId LEFT OUTER JOIN
Mas_User ON Mas_User.UserCode = Trs_Opening.PreparedBy
WHERE  Trs_Opening.OpenDt = convert(datetime,?,102) and Trs_Opening.Dept=? and Trs_Opening.ordid=? </SqlCommand>
      </FabOpening>
    </DataSources>
    <Relations isList="true" count="0" />
    <Report isRef="0" />
    <Variables isList="true" count="0" />
