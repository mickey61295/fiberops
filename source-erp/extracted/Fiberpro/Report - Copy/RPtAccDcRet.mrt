    <DataSources isList="true" count="2">
      <AccRetDc Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>AccRetDc</Alias>
        <Columns isList="true" count="22">
          <value>Acc_Descr,System.String</value>
          <value>AccDescription,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>Uom,System.String</value>
          <value>Kg,System.Decimal</value>
          <value>OrderNo,System.String</value>
          <value>ITEMDESC,System.String</value>
          <value>DelType,System.String</value>
          <value>Dt,System.DateTime</value>
          <value>DocNo,System.Int32</value>
          <value>Finyear,System.String</value>
          <value>Delto,System.String</value>
          <value>remark,System.String</value>
          <value>Username,System.String</value>
          <value>SizeDesc,System.String</value>
          <value>empname,System.String</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Phone,System.String</value>
          <value>CST,System.String</value>
          <value>TIN,System.String</value>
          <value>GSTNo,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>AccRetDc</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     dbo.Mas_Acc.Acc_Descr, dbo.Mas_AccDes.AccDescription, dbo.Mas_Color.ColorDesc, dbo.Mas_Uom.Uom, dbo.Trs_Del2.Kg, 
	CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar))
                       + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, 
                      CASE WHEN StockTable.ColID &gt; 0 THEN Acc_Descr + '/' + AccDescription + '/' + COLORDESC ELSE Acc_Descr + '/' + AccDescription END AS ITEMDESC,
                       dbo.Trs_Del1.DelType, dbo.Trs_Del1.Dt, dbo.Trs_Del1.DocNo, dbo.Trs_Del1.Finyear,
                      CASE WHEN DelType = 'P' THEN 'Production' ELSE 'Return To Store' END AS Delto,  dbo.Trs_Del1.remark, dbo.Mas_User.Username, 
                      dbo.Mas_Size.SizeDesc,MaS_emp.empname,Mas_Exporter.ExporterName,Mas_Exporter.ExporterAddress,Mas_Exporter.Phone,Mas_Exporter.TIN,Mas_Exporter.CST,
Mas_Exporter.GSTNo
FROM         dbo.Mas_Acc INNER JOIN
                      dbo.Mas_Uom ON dbo.Mas_Acc.UomId = dbo.Mas_Uom.UomID INNER JOIN
                      dbo.StockTable INNER JOIN
                      dbo.Trs_Del2 ON dbo.StockTable.StockID = dbo.Trs_Del2.StockId INNER JOIN
                      dbo.Trs_Del1 ON dbo.Trs_Del2.Id = dbo.Trs_Del1.Id INNER JOIN
                      dbo.Mas_Exporter ON dbo.Trs_Del1.Coycode = dbo.Mas_Exporter.ExpID INNER JOIN
                      dbo.OrderMas ON dbo.Trs_Del2.OrdId = dbo.OrderMas.OrdId ON dbo.Mas_Acc.ID = dbo.StockTable.Atype INNER JOIN
                      dbo.Mas_AccDes ON dbo.StockTable.Ades = dbo.Mas_AccDes.ID LEFT OUTER JOIN
                      dbo.Mas_Size ON dbo.StockTable.Siz = dbo.Mas_Size.SizeID LEFT OUTER JOIN
                      dbo.Mas_User ON dbo.Trs_Del1.PreparedBy = dbo.Mas_User.UserCode LEFT OUTER JOIN
                      dbo.Mas_Color ON dbo.StockTable.ColID = dbo.Mas_Color.ColID
Left outer join Mas_emp on Trs_del1.empid=Mas_emp.id 

WHERE     (dbo.Trs_Del1.Id =?) and trs_del1.trtype=-1</SqlCommand>
      </AccRetDc>
      <DataSource1 Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="7">
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Phone,System.String</value>
          <value>CST,System.String</value>
          <value>pan,System.String</value>
          <value>GSTNo,System.String</value>
          <value>TIN,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_id,,5,0</value>
        </Parameters>
        <SqlCommand>
select distinct Mas_Exporter.ExporterName,Mas_Exporter.ExporterAddress,Mas_Exporter.Phone,Mas_Exporter.GSTNo,Mas_Exporter.CST,Mas_Exporter.pan,Mas_Exporter.TIN  from Trs_Del1  INNER JOIN  Trs_Del2 ON Trs_Del1.Id = Trs_Del2.Id INNER JOIN  OrderMas ON Trs_Del2.OrdId = OrderMas.OrdId INNER JOIN  Mas_Exporter  on OrderMas.ExpID=Mas_Exporter.ExpID where  (Trs_Del1.Id =?) and trs_del1.trtype=-1
</SqlCommand>
      </DataSource1>
    </DataSources>
