      <DtYarn Ref="4" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DtYarn</Alias>
        <Columns isList="true" count="8">
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>OrdId,System.Decimal</value>
          <value>ReqKgs,System.Decimal</value>
          <value>DeptID,System.Int32</value>
          <value>Deptname,System.String</value>
          <value>StyleNo,System.String</value>
          <value>Ordersno,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DtYarn</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0032_2,8,0</value>
        </Parameters>
        <SqlCommand>SELECT Mas_Color.ColorDesc, Mas_Count.CountName, Pro_ReqYarn.OrdId,
  SUM(Pro_ReqYarn.ReqKgs) as ReqKgs, Mas_Dept.DeptID, Mas_Dept.Deptname,Mas_Dept.Ordersno
FROM Joms.dbo.Pro_ReqYarn Pro_ReqYarn INNER JOIN
  Joms.dbo.Mas_Count Mas_Count ON Pro_ReqYarn.CountId = Mas_Count.CountID
  INNER JOIN
  Joms.dbo.Mas_Dept Mas_Dept ON Pro_ReqYarn.DeptId = Mas_Dept.DeptID
  LEFT OUTER JOIN
  Joms.dbo.Mas_Color Mas_Color ON Pro_ReqYarn.ColId = Mas_Color.ColID
WHERE Pro_ReqYarn.OrdId = ? 
Group By Mas_Color.ColorDesc, Mas_Count.CountName, Pro_ReqYarn.OrdId,
  Mas_Dept.DeptID, Mas_Dept.Deptname,Mas_Dept.Ordersno</SqlCommand>
      </DtYarn>
      <DtFabric Ref="5" type="Stimulsoft.Report.Dictionary.StiOdbcSource" isKey="true">
        <Alias>DtFabric</Alias>
        <Columns isList="true" count="14">
          <value>OrdId,System.Decimal</value>
          <value>DeptId,System.Int32</value>
          <value>GSM,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>LL,System.String</value>
          <value>ReqKgs,System.Decimal</value>
          <value>Deptname,System.String</value>
          <value>Fabdesc,System.String</value>
          <value>CountName,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>Dia,System.String</value>
          <value>StyleNo,System.String</value>
          <value>ReqMtr,System.Decimal</value>
          <value>OrderSno,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DtFabric</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0032_2,8,0</value>
        </Parameters>
        <SqlCommand>SELECT Pro_ReqKnitt.OrdId, Pro_ReqKnitt.DeptId, Pro_ReqKnitt.GSM,
  Pro_ReqKnitt.GG, Pro_ReqKnitt.LL, Pro_ReqKnitt.ReqKgs, Mas_Dept.Deptname,
  Mas_Fabric.Fabdesc, Mas_Count.CountName, Mas_Color.ColorDesc, Mas_Dia.Dia,
  Pro_ReqKnitt.StyleNo, Pro_ReqKnitt.ReqMtr, Mas_Dept.OrderSno
FROM Pro_ReqKnitt INNER JOIN
  Mas_Dept ON Pro_ReqKnitt.DeptId = Mas_Dept.DeptID INNER JOIN
  Mas_Fabric ON Pro_ReqKnitt.FabId = Mas_Fabric.FabID INNER JOIN
  Mas_Dia Mas_Dia ON Pro_ReqKnitt.DiaID = Mas_Dia.DiaID LEFT OUTER JOIN
  Mas_Color ON Pro_ReqKnitt.ColId = Mas_Color.ColID LEFT OUTER JOIN
  Mas_Count ON Pro_ReqKnitt.CntID = Mas_Count.CountID
WHERE Pro_ReqKnitt.OrdId = ? and (Mas_Dept.ColEntryMust='No' or Mas_Dept.ColEntryMust='N')</SqlCommand>
      </DtFabric>
