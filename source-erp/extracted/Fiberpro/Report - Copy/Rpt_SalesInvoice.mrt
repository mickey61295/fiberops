        <Parameters isList="true" count="1">
          <value>_x0040_ID,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT "Mas_AddDed"."AddDedName", "Trs_SalInvAddded"."Valu", "Trs_SalInvAddded"."Amount", "Mas_AddDed"."Grp", "Trs_SalInvAddded"."ID"
	FROM   "JOMS"."dbo"."Trs_SalInvAddded" "Trs_SalInvAddded" INNER JOIN "JOMS"."dbo"."Mas_AddDed" "Mas_AddDed" ON "Trs_SalInvAddded"."AddDedCode"="Mas_AddDed"."AddDedCode"
 WHERE  "Mas_AddDed"."Grp"=1 AND "Trs_SalInvAddded"."ID"=?</SqlCommand>
      </DataSource2>
