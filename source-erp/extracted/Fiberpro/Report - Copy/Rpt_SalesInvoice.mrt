          <value>Pname,System.String</value>
          <value>Expr2,System.String</value>
          <value>Expr3,System.String</value>
          <value>Expr4,System.String</value>
          <value>DesignDesc,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Paddress,System.String</value>
          <value>rr,System.String</value>
          <value>amount,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_ID,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT Mas_Exporter.ExporterName, Trs_Salinv.Invno, Trs_Salinv.Finyear,
	Trs_Salinv.Invdt, Trs_Del1.DocNo, StockTable.YF, Mas_Count.CountName,
	Mas_Color.ColorDesc, Mas_Fabric.Fabdesc, Trs_Del2.BgRl, Trs_Del2.Kg,
	Trs_Del2.rate, Trs_Del1.Finyear AS Expr1, Trs_Del1.Dt, Trs_Salinv.ID,
	Mas_Exporter.CST, Mas_Exporter.TIN, Mas_Exporter.Phone, Mas_Party.Pname,
	Mas_Party.Phone AS Expr2, Mas_Party.CST AS Expr3, Mas_Party.TIN AS Expr4,
	Mas_Design.DesignDesc, Mas_Exporter.ExporterAddress, Mas_Party.Paddress, CASE
    WHEN StockTable.YF = 'y' THEN rtrim(Mas_Count.CountName) + '/ ' +
    rtrim(Isnull(Mas_Color.ColorDesc, ''))
    ELSE Isnull(Mas_Fabric.Fabdesc, '') + '/' + ISnull(Mas_Count.CountName, '')
    + '/' + Isnull(Mas_Color.ColorDesc, '') + '/' +
    isnull(Mas_Design.DesignDesc, '')
  END AS rr, Trs_Del2.Kg * Trs_Del2.rate AS amount
FROM dbo.Trs_Salinv AS Trs_Salinv INNER JOIN
  dbo.Trs_Del1 AS Trs_Del1 ON Trs_Salinv.ID = Trs_Del1.InvId INNER JOIN
  dbo.Mas_Exporter AS Mas_Exporter ON Trs_Salinv.Coycode = Mas_Exporter.ExpID
  INNER JOIN
  dbo.Trs_Del2 AS Trs_Del2 ON Trs_Del1.ID = Trs_Del2.ID INNER JOIN
  dbo.Mas_Party AS Mas_Party ON Trs_Del1.Party = Mas_Party.PID INNER JOIN
  dbo.StockTable AS StockTable ON Trs_Del2.StockID = StockTable.StockID
  LEFT OUTER JOIN
  dbo.Mas_Fabric AS Mas_Fabric ON StockTable.FabID = Mas_Fabric.FabID
  LEFT OUTER JOIN
  dbo.Mas_Count AS Mas_Count ON StockTable.CntID = Mas_Count.CountID
  LEFT OUTER JOIN
  dbo.Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID
  LEFT OUTER JOIN
  dbo.Mas_Design AS Mas_Design ON StockTable.PRINT_DESIGNID =
    Mas_Design.DesignId
WHERE Trs_Salinv.ID = ?
ORDER BY Expr1 DESC, Trs_Del1.DocNo DESC</SqlCommand>
      </DataSource1>
      <DataSource2 Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
