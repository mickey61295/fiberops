    <DataSources isList="true" count="1">
      <YarnDC Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>YarnDC</Alias>
        <Columns isList="true" count="27">
          <value>DcNO,System.String</value>
          <value>Dt,System.DateTime</value>
          <value>Deptname,System.String</value>
          <value>ONo,System.String</value>
          <value>remark,System.String</value>
          <value>ShortBuyer,System.String</value>
          <value>VName,System.String</value>
          <value>GpNo,System.Int32</value>
          <value>GoDownName,System.String</value>
          <value>ToGoDownName,System.String</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>GodownAdd,System.String</value>
          <value>Phone,System.String</value>
          <value>ToGoDownAdd,System.String</value>
          <value>ToGoDownPh,System.String</value>
          <value>CountName,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>ShortMill,System.String</value>
          <value>LotNo,System.String</value>
          <value>EPhone,System.String</value>
          <value>ETIN,System.String</value>
          <value>ECST,System.String</value>
          <value>BgRl,System.Int32</value>
          <value>Kg,System.Decimal</value>
          <value>GatePassFlg1,System.String</value>
          <value>UserName,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT  Rtrim(dbo.Trs_Del1.DocNo)+'/'+dbo.Trs_Del1.Finyear as  DcNO, dbo.Trs_Del1.Dt, dbo.Mas_Dept.Deptname,

	Case dbo.OrderMas.Jobno when 0 then case dbo.OrderMas.BuyOrdNo when  ''  then 'GENERAL' else 'GENERAL-&gt;'+dbo.OrderMas.BuyOrdNo end 
else
 RTRIM(dbo.OrderMas.Jobno) + '/' + RTRIM(dbo.OrderMas.Finyear) + '-&gt;' + RTRIM(dbo.OrderMas.BuyOrdNo) end AS ONo, dbo.Trs_Del1.remark, dbo.Mas_Buyer.ShortBuyer, 
                      dbo.Mas_Vehicle.VName, ISNULL(dbo.Trs_Del1.GPNo, 0) AS GpNo, dbo.Mas_Godown.GodName AS GoDownName, 
                      Mas_Godown_2.GodName AS ToGoDownName, dbo.Mas_Exporter.ExporterName, dbo.Mas_Exporter.ExporterAddress , Replace(cast(dbo.Mas_Godown.Address as varchar(400)),char(10),'') GodownAdd, 
                      dbo.Mas_Godown.Phone, Replace(cast(Mas_Godown_2.Address as varchar(400)),char(10),'') AS ToGoDownAdd, Mas_Godown_2.Phone AS ToGoDownPh,Dbo.Mas_Count.CountName,Dbo.Mas_Color.ColorDesc,Dbo.Mas_Mill.ShortMill,
                      dbo.StockTable.LotNo,Dbo.Mas_Exporter.Phone as EPhone,Dbo.Mas_Exporter.TIN as ETIN,Dbo.Mas_Exporter.CST as ECST,Dbo.TRs_Del2.BgRl,Dbo.TRs_Del2.Kg,isnull(Options.GatePassFlg,'N') as GatePassFlg1, Mas_User.UserName
FROM         dbo.Trs_Del1 INNER JOIN
                      dbo.Trs_Del2 ON dbo.Trs_Del1.ID = dbo.Trs_Del2.ID LEFT OUTER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Mas_Vehicle ON dbo.Trs_Del1.VehicleCode = dbo.Mas_Vehicle.Code INNER JOIN
                      dbo.OrderMas ON dbo.Trs_Del2.OrdId = dbo.OrderMas.OrdId INNER JOIN
                      dbo.Mas_Godown ON dbo.Trs_Del1.GodID = dbo.Mas_Godown.GodID INNER JOIN
                      dbo.Mas_Godown AS Mas_Godown_2 ON dbo.Trs_Del1.Party = Mas_Godown_2.GodID INNER JOIN
                      dbo.Mas_Exporter ON dbo.Trs_Del1.Coycode = dbo.Mas_Exporter.ExpID  LEFT OUTER JOIN
                      dbo.Mas_Buyer ON dbo.OrderMas.BuyerID = dbo.Mas_Buyer.BuyerID INNER JOIN
                      dbo.StockTable ON dbo.Trs_Del2.StockID = dbo.StockTable.StockID INNER JOIN
                      dbo.Mas_Count ON dbo.StockTable.CntID = dbo.Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Mill ON dbo.StockTable.MillID = dbo.Mas_Mill.MillID LEFT OUTER JOIN
Mas_User On Trs_Del1.PreparedBy = Mas_User.UserCode LEFT OUTER JOIN
                      dbo.Mas_Color ON dbo.StockTable.ColID = dbo.Mas_Color.ColID  Cross join Options
where trs_del1.id=?
</SqlCommand>
      </YarnDC>
    </DataSources>
