    <DataSources isList="true" count="2">
      <commercial Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>commercial</Alias>
        <Columns isList="true" count="24">
          <value>Coycode,System.Int32</value>
          <value>Finyear,System.Int32</value>
          <value>ExporterName,System.String</value>
          <value>Brno,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Billno,System.String</value>
          <value>Id,System.Int32</value>
          <value>Brdt,System.DateTime</value>
          <value>BillDt,System.DateTime</value>
          <value>Remarks,System.String</value>
          <value>OrdId,System.Double</value>
          <value>OrderNo,System.String</value>
          <value>Descr,System.String</value>
          <value>Commid,System.Int32</value>
          <value>BillAmount,System.Double</value>
          <value>GST,System.Double</value>
          <value>TaxAmt,System.Double</value>
          <value>BalAmt,System.Double</value>
          <value>BilldAmt,System.Double</value>
          <value>BudAmt,System.Double</value>
          <value>Pname,System.String</value>
          <value>ID1,System.Int32</value>
          <value>Username,System.String</value>
          <value>BillRefNo,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>commercial</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>select ShippingBill.Coycode,ShippingBill.Finyear,Mas_Exporter.ExporterName,Mas_Exporter.ExporterAddress,Mas_Party.Pname,
	ShippingBill.Brno,ShippingBill.Billno,ShippingBill.Id,ShippingBill.Brdt,ShippingBill.BillDt,ShippingBill.Remarks,OrderMas.OrdId,
	CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar)) + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo,
Mas_Commercial.Descr,Mas_Commercial.ID,ShippingBill_Det.BillAmount,ShippingBill_Det.GST,ShippingBill_Det.TaxAmt,temp_commercialbilldt.BalAmt,
temp_commercialbilldt.BilldAmt,temp_commercialbilldt.BudAmt,Mas_User.Username,temp_commercialbilldt.BillRefNo from ShippingBill 
inner join ShippingBill_Det on ShippingBill_Det.cid=ShippingBill.Id 
inner join OrderMas on ordermas.ordid=ShippingBill_Det.OrdID 
inner join Mas_Commercial on Mas_Commercial.ID=ShippingBill_Det.Commid 
inner join Mas_Exporter on Mas_Exporter.ExpID=ShippingBill.Coycode 
inner join Mas_Party on mas_party.PID=ShippingBill.Party 
inner join temp_commercialbilldt on temp_commercialbilldt.OrdNo=OrderMas.OrdId and temp_commercialbilldt.ExpenseId=Mas_Commercial.ID and temp_commercialbilldt.id=  ShippingBill.id left outer join Mas_User on Mas_User.UserCode  = ShippingBill_Det.PreparedBy
where ShippingBill.id=?</SqlCommand>
      </commercial>
      <DataSource1 Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="6">
          <value>AddDedName,System.String</value>
          <value>valu,System.Decimal</value>
          <value>amt,System.Decimal</value>
          <value>partyamt,System.Decimal</value>
          <value>IndexCode,System.Int32</value>
          <value>taxperc,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>select distinct AddDedName,case when isnull(taxperc,0) &gt;0 then isnull(taxperc,0) ELSE valu END as Valu,amt,partyamt,IndexCode,isnull(taxperc,0) as taxperc from ShippingBill_taxdet inner join Mas_AddDed on Mas_AddDed.AddDedCode=ShippingBill_taxdet.adddedcode INNER JOIN Mas_Fgrp ON Mas_Fgrp.Grp_Code=Mas_AddDed.Grp Where id=? and Mas_Fgrp.Grp_Name='COM'   Order By indexcode 
</SqlCommand>
      </DataSource1>
    </DataSources>
