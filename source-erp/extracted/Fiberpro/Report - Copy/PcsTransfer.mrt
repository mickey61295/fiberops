          <value>ExporterAddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>Pcs,System.Int32</value>
          <value>Deptname,System.String</value>
          <value>SNo,System.Int32</value>
          <value>PanelName,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>SizeDesc,System.String</value>
          <value>StyleDesc,System.String</value>
          <value>PartName,System.String</value>
          <value>ToDepartment,System.String</value>
          <value>ShortBuyer,System.String</value>
          <value>ToLine,System.String</value>
          <value>FromLine,System.String</value>
          <value>UserName,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>PcsDc</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0037_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM(CAST(Trs_Pcs1.DocNo AS VARCHAR)) + '/' + Trs_Pcs1.Finyear AS DCNo, Trs_Pcs1.dtDCDate, Trs_Pcs1.DelType, Trs_Pcs1.NoBdl, 
                      Trs_Pcs1.Wgt, Trs_Pcs1.Remark, RTRIM(CAST(OrderMas.Jobno AS VARCHAR)) + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo AS OrderNo, 
                      Trs_Pcs2.StyleNo, Mas_Exporter.ExporterName, Mas_Dept.DCFormat, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone, Mas_Exporter.TIN, 
                      Mas_Exporter.CST, Trs_Pcs2.Pcs, Mas_Dept.Deptname, OrdSizeMas.SNo, Mas_Panel.PanelName, Mas_Color.ColorDesc, Mas_Size.SizeDesc, 
                      Mas_StyleDesc.StyleDesc, Mas_Part.PartName, Mas_Dept_1.Deptname AS ToDepartment, Mas_Buyer.ShortBuyer, 
                      Mas_Emp_1.EmpName AS ToLine, Mas_Emp.EmpName AS FromLine, Mas_User.UserName
FROM         Trs_Pcs1 AS Trs_Pcs1 INNER JOIN
                      Mas_Exporter AS Mas_Exporter ON Trs_Pcs1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      Trs_Pcs2 AS Trs_Pcs2 ON Trs_Pcs1.ID = Trs_Pcs2.ID INNER JOIN
                      OrderMas AS OrderMas ON Trs_Pcs1.Ordjobno = OrderMas.OrdId INNER JOIN
                      OrdSizeMas AS OrdSizeMas ON Trs_Pcs1.Ordjobno = OrdSizeMas.OrdID AND Trs_Pcs2.SizeID = OrdSizeMas.SizeID LEFT OUTER JOIN
                      Mas_Dept AS Mas_Dept ON Trs_Pcs1.Dept = Mas_Dept.DeptID INNER JOIN
                      Mas_Color AS Mas_Color ON Trs_Pcs2.ColID = Mas_Color.ColID INNER JOIN
                      Mas_Size AS Mas_Size ON Trs_Pcs2.SizeID = Mas_Size.SizeID INNER JOIN
                      Mas_StyleDesc AS Mas_StyleDesc ON Trs_Pcs2.StyleID = Mas_StyleDesc.StyleID LEFT OUTER JOIN
                      Mas_Emp AS Mas_Emp_1 ON Trs_Pcs1.ToEmpId = Mas_Emp_1.ID LEFT OUTER JOIN
                      Mas_Emp ON Trs_Pcs1.FromEmpId = Mas_Emp.ID LEFT OUTER JOIN
                      Mas_Part ON Trs_Pcs2.PartID = Mas_Part.PartID LEFT OUTER JOIN
                      Mas_Panel AS Mas_Panel ON Trs_Pcs2.PanelID = Mas_Panel.PanelID LEFT OUTER JOIN
                      Mas_Dept AS Mas_Dept_1 ON Trs_Pcs1.TO_DEPT = Mas_Dept_1.DeptID LEFT OUTER JOIN
                      Mas_Buyer AS Mas_Buyer ON Mas_Buyer.BuyerID = OrderMas.BuyerID LEFT OUTER JOIN
Mas_User On Trs_Pcs1.PreparedBy = Mas_User.UserCode
WHERE     (Trs_Pcs1.DelType = 'Piece Transfer') AND (Trs_Pcs1.ID = ?)
ORDER BY OrdSizeMas.SNo</SqlCommand>
      </PcsDc>
    </DataSources>
