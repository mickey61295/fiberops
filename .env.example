# FiberOps — environment sample.
# Copy to .env and fill in real values:  cp .env.example .env
# (.env is gitignored; this file is the committed documentation of every
#  supported var, so a fresh clone boots with zero guesswork.)

# --- Database (Prisma / SQLite) ---
# Absolute or repo-relative path; the parent directory must exist.
DATABASE_URL=file:./db/custom.db

# --- Agent brain LLM endpoint (OMNI-1, omniroute integration) ---
# OpenAI-compatible endpoint for the ERP agent (streaming + function calling
# required). SERVER-ONLY config: never shown in the UI, never
# customer-configurable, changed ONLY through env + restart.
#
# Leave ALL THREE unset to use the built-in gateway with its default model.
#
# AGENT_LLM_BASE_URL — gateway root INCLUDING the /v1 suffix, no trailing slash.
#   The gateway must expose POST /v1/chat/completions and GET /v1/models.
#   Example format: https://<your-gateway-host>/v1
AGENT_LLM_BASE_URL=http://localhost:20128/v1
# AGENT_LLM_MODEL — the model id EXACTLY as the gateway lists it in /v1/models.
#   Must support tool/function calling. Example: opencode-go/deepseek-v4.1-flash
AGENT_LLM_MODEL=opencode-go/deepseek-v4.1-flash
# AGENT_LLM_API_KEY — omit (leave empty) for keyless gateways; a harmless
#   placeholder is sent automatically.
AGENT_LLM_API_KEY=

# ── SPEC-M61 H2 (E-1.5) — agent tool tiering rollback lever ─────────────
# The agent manifest is TIERED (core + current-screen family; everything
# else discoverable via the agent's list_tools). Set to 1 to restore the
# ALL-tools manifest wholesale for one deploy — the ops escape hatch if
# tiering ever hides a tool the workflow needs. Leave unset for tiering.
# AGENT_TOOLS_FULL=1
