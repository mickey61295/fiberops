      <DebitAddDed Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DebitAddDed</Alias>
        <Columns isList="true" count="4">
          <value>indexcode,System.Int32</value>
          <value>AddDedName,System.String</value>
          <value>Valu,System.Decimal</value>
          <value>Amt,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DebitAddDed</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>--SELECT DISTINCT indexcode, Mas_AddDed.AddDedName, Format(Trs_DirectDebAddDed.Valu,'#0.00') As Valu, Trs_DirectDebAddDed.Amt
--	FROM Trs_DirectDebAddDed INNER JOIN
--	Mas_AddDed ON Trs_DirectDebAddDed.AddDedCode = Mas_AddDed.AddDedCode 
--INNER JOIN trs_directdeb1 On Trs_DirectDebAddDed.ID = trs_directdeb1.ID
--WHERE Trs_DirectDebAddDed.ID = ?
--AND ((Mas_AddDed.Grp =4 AND trs_directdeb1.Type = 'D') AND Trs_DirectDebAddDed.amt&gt;0) 
--AND ((Mas_AddDed.Grp =4 ) AND Trs_DirectDebAddDed.amt&gt;0) 
--order by indexcode


SELECT DISTINCT indexcode, Mas_AddDed.AddDedName, format(Trs_DirectDebAddDed.Valu ,'N2') As Valu, Trs_DirectDebAddDed.Amt
	FROM Trs_DirectDebAddDed INNER JOIN
	Mas_AddDed ON Trs_DirectDebAddDed.AddDedCode = Mas_AddDed.AddDedCode 
INNER JOIN trs_directdeb1 On Trs_DirectDebAddDed.ID = trs_directdeb1.ID
WHERE Trs_DirectDebAddDed.ID = ?
AND ((Mas_AddDed.Grp =7 ) AND Trs_DirectDebAddDed.amt&gt;0) 
--AND ((Mas_AddDed.Grp =4 ) AND Trs_DirectDebAddDed.amt&gt;0) 
order by indexcode




</SqlCommand>
      </DebitAddDed>
      <DebitYarn Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DebitYarn</Alias>
        <Columns isList="true" count="28">
          <value>Dno,System.String</value>
          <value>dt,System.DateTime</value>
          <value>remark,System.String</value>
          <value>Debqty,System.Decimal</value>
          <value>Rate,System.Decimal</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>Pname,System.String</value>
          <value>Paddress,System.String</value>
          <value>PPhone,System.String</value>
          <value>PTIN,System.String</value>
          <value>PCST,System.String</value>
          <value>Deptname,System.String</value>
          <value>OrderNo,System.String</value>
          <value>StyleNo,System.String</value>
          <value>ItemDesc,System.String</value>
          <value>Amount,System.Decimal</value>
          <value>uom,System.String</value>
          <value>Type,System.String</value>
          <value>Heading,System.String</value>
          <value>Heading1,System.String</value>
          <value>Username,System.String</value>
          <value>CGSTNo,System.String</value>
          <value>PGSTNo,System.String</value>
          <value>DirectDebPrefix,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DebitYarn</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM( CAST(Trs_DirectDeb1.DNo AS varchar)) + '/' + Trs_DirectDeb1.Finyear AS Dno, Trs_DirectDeb1.dt,Trs_DirectDeb1.remark, Trs_DirectDeb2.Debqty,
Trs_DirectDeb2.Rate, Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone, Mas_Exporter.TIN, Mas_Exporter.CST,ISNULL(Mas_Exporter.GstNo,'') as CGSTNo, 
Mas_Party.Pname, Mas_Party.Paddress, Mas_Party.Phone AS PPhone, Mas_Party.TIN AS PTIN, Mas_Party.CST AS PCST, ISNULL(Mas_Party.GSTNo,'') as PGSTNo,
Mas_Dept.Deptname,case when jobno=0 then 'GENERAL/-&gt;' else RTRIM(CAST(OrderMas.Jobno AS varchar)) + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo end  AS OrderNo, Trs_DirectDeb2.ItemDesc, Trs_DirectDeb2.Debqty*Trs_DirectDeb2.Rate as Amount,Mas_uom.uom,Type,
Case When Type='D' then 'DIRECT DEBIT NOTE' Else 'CREDIT NOTE' End Heading,Case When Type='D' then 'Debit No:' Else 'Credit No:' End Heading1,Mas_user.Username,isnull(Mas_Exporter.DirectDebPrefix,'') As DirectDebPrefix
FROM         dbo.Trs_DirectDeb1 AS Trs_DirectDeb1
INNER JOIN dbo.Trs_DirectDeb2 AS Trs_DirectDeb2 ON Trs_DirectDeb1.ID = Trs_DirectDeb2.ID INNER JOIN
                      dbo.OrderMas AS OrderMas ON Trs_DirectDeb2.OrdId = OrderMas.OrdId 
                        INNER JOIN
                      dbo.Mas_Exporter AS Mas_Exporter ON Trs_DirectDeb1.Coycode = Mas_Exporter.ExpID  left outer JOIN
                      dbo.Mas_Party AS Mas_Party ON Trs_DirectDeb1.Party = Mas_Party.PID left outer join
                      dbo.Mas_Dept AS Mas_Dept ON Trs_DirectDeb1.Dept = Mas_Dept.DeptID 
left outer join Mas_uom on Trs_DirectDeb2.UOMID=Mas_uom.uomid  
left outer join Mas_user on Trs_DirectDeb1.Preparedby=Mas_user.usercode
WHERE Trs_DirectDeb1.Id=?
</SqlCommand>
      </DebitYarn>
    </DataSources>
