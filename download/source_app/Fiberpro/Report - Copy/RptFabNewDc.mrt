    <DataSources isList="true" count="4">
      <DyeingsubReport Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DyeingsubReport</Alias>
        <Columns isList="true" count="9">
          <value>ID,System.Int32</value>
          <value>ColorDesc,System.String</value>
          <value>LotNo,System.String</value>
          <value>ConfirmedRate,System.Decimal</value>
          <value>ProgReqPrn,System.String</value>
          <value>Head,System.String</value>
          <value>BudjetRate,System.Decimal</value>
          <value>Ratelbl,System.String</value>
          <value>Column,_x0040_Id,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DyeingsubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT DISTINCT 	

	Trs_Del3.ID, case when isnull(ShadeEntry.ShadeNo,'')=''then Mas_Color.ColorDesc else RTRIM(Mas_Color.ColorDesc)+'/'+(ShadeEntry.ShadeNo) end as  ColorDesc,  Trs_Del3.LotNo, case Preprint.DcRateReqd when 1 then case Isnull(Trs_Del1.ProcessType,'P') when 'P' then 

case MIN(dbo.BudPodet.Rate) when 0 then MIN(dbo.Pro_ReqKnitt2.Rate + ISNULL(dbo.Pro_ReqKnitt2.AddRate, 0)) else  MIN(dbo.BudPodet.Rate) end 

 else 0 end 

 else 0 end  AS ConfirmedRate, Mas_Dept.ProgReqPrn,'PROGRAM DETAILS' as Head,
                      case MIN(dbo.BudPodet.Rate) when 0 then MIN(dbo.Pro_ReqKnitt2.Rate + ISNULL(dbo.Pro_ReqKnitt2.AddRate, 0)) else  MIN(dbo.BudPodet.Rate) end As BudjetRate,CASE WHEN Preprint.DcRateReqd = 1 THEN CASE WHEN Trs_Del1.ProcessType = 'P' THEN   'RATE :' ELSE  '' END  ELSE  '' END  AS Ratelbl
FROM         dbo.BudPodet INNER JOIN
                      dbo.BudPoMas ON dbo.BudPodet.Id = dbo.BudPoMas.Id RIGHT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color RIGHT OUTER JOIN
                      dbo.Trs_Del3 AS Trs_Del3 INNER JOIN
                      dbo.Trs_Del1 ON Trs_Del3.ID = dbo.Trs_Del1.ID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Pro_ReqKnitt2 ON Trs_Del3.DiaID = dbo.Pro_ReqKnitt2.DiaID AND Trs_Del3.LL = dbo.Pro_ReqKnitt2.LL AND 
                      Trs_Del3.GG = dbo.Pro_ReqKnitt2.GG AND Trs_Del3.Gsm = dbo.Pro_ReqKnitt2.GSM AND Trs_Del3.Cnt = dbo.Pro_ReqKnitt2.CntID AND 
                      Trs_Del3.Clr = dbo.Pro_ReqKnitt2.ColId AND Trs_Del3.FabType = dbo.Pro_ReqKnitt2.FabId AND 
                      dbo.Trs_Del1.Prs_Dept = dbo.Pro_ReqKnitt2.DeptId AND Trs_Del3.OrdId = dbo.Pro_ReqKnitt2.OrdId ON Mas_Color.ColID = Trs_Del3.Clr ON 
                      dbo.BudPoMas.OrdId = Trs_Del3.OrdId AND dbo.BudPoMas.PartyId = dbo.Trs_Del1.Party AND dbo.BudPoMas.DeptId = dbo.Trs_Del1.Prs_Dept AND 
                      dbo.BudPodet.DiaId = Trs_Del3.DiaID AND dbo.BudPodet.LL = Trs_Del3.LL AND dbo.BudPodet.GG = Trs_Del3.GG AND 
                      dbo.BudPodet.GSM = Trs_Del3.Gsm AND dbo.BudPodet.FabId = Trs_Del3.FabType AND dbo.BudPodet.ColId = Trs_Del3.Clr AND 
                      dbo.BudPodet.CntId = Trs_Del3.Cnt CROSS JOIN
                      dbo.PrePrint
				left join ShadeEntry on ShadeEntry.OrdId=trs_del3.OrdId and ShadeEntry.ColId=Trs_Del3.Clr and ShadeEntry.DeptId=Trs_Del1.Prs_Dept
				
WHERE     (Trs_Del3.ID = ?) and (dbo.Mas_Dept.Deptname = 'DYEING' or IsNull(dbo.Mas_Dept.DeptGrpCode,0) = 8 ) and    (dbo.Mas_Dept.ProgReqPrn = 'Y') and PrePrint.slno=2
GROUP BY Trs_Del3.ID, Mas_Color.ColorDesc, Trs_Del3.LotNo,Preprint.DcRateReqd,Trs_Del1.ProcessType,Mas_Dept.ProgFrm_Issue,Mas_Dept.ProgReqPrn,ShadeNo

</SqlCommand>
      </DyeingsubReport>
      <FabDC Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabDC</Alias>
        <Columns isList="true" count="69">
          <value>ID,System.Int32</value>
          <value>DcNo,System.String</value>
          <value>Dt,System.DateTime</value>
          <value>TrType,System.Int32</value>
          <value>Prs_Dept,System.Int32</value>
          <value>delwgt,System.Decimal</value>
          <value>OrderNo,System.String</value>
          <value>StyleNo,System.String</value>
          <value>Deptname,System.String</value>
          <value>OutputType,System.String</value>
          <value>BgRl,System.Int32</value>
          <value>Kg,System.Decimal</value>
          <value>mtr,System.Decimal</value>
          <value>Pname,System.String</value>
          <value>Paddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>ExporterName,System.String</value>
          <value>DCFormat,System.String</value>
          <value>BuyerName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>ExpPhone,System.String</value>
          <value>ExpTIN,System.String</value>
          <value>ExpCST,System.String</value>
          <value>PAN,System.String</value>
          <value>PartyDCref,System.String</value>
          <value>CntID,System.Int32</value>
          <value>ColID,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>ll,System.String</value>
          <value>DcPre,System.String</value>
          <value>Fabdesc,System.String</value>
          <value>Dia,System.String</value>
          <value>FDia,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>remark,System.String</value>
          <value>ProcessType,System.String</value>
          <value>LotNo,System.String</value>
          <value>StkLotno,System.String</value>
          <value>UOM,System.String</value>
          <value>ITEMDESC,System.String</value>
          <value>Heading,System.String</value>
          <value>VName,System.String</value>
          <value>Terms,System.String</value>
          <value>GrpHeader,System.String</value>
          <value>GPNo,System.Int32</value>
          <value>ProgReqPrn,System.String</value>
          <value>GatePassFlg,System.String</value>
          <value>DesignDesc,System.String</value>
          <value>TarDt,System.DateTime</value>
          <value>Username,System.String</value>
          <value>Rate,System.Decimal</value>
          <value>Ratelbl,System.String</value>
          <value>DesignLbL,System.String</value>
          <value>Deldesign,System.String</value>
          <value>cuttingunit,System.String</value>
          <value>GodName,System.String</value>
          <value>IoNoCaption,System.String</value>
          <value>PPAN,System.String</value>
          <value>DeptType,System.String</value>
          <value>GSTNo,System.String</value>
          <value>PGSTNo,System.String</value>
          <value>HSNCode,System.String</value>
          <value>EwayBillNo,System.String</value>
          <value>EwayBillDt,System.DateTime</value>
          <value>Column,_x0040_Id,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT    Trs_Del1.ID, CASE WHEN len(rtrim(dcpre)) &lt; 1 THEN RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear ELSE rtrim(dcpre)  + '-' + RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear END AS DcNo, Trs_Del1.Dt, Trs_Del1.TrType, Trs_Del1.Prs_Dept, Trs_Del1.delwgt,CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar)) + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, OrderMas2.StyleNo, Mas_Dept.Deptname, Mas_Dept.OutputType, Trs_Del2.BgRl, Trs_Del2.Kg,Trs_Del2.mtr, CASE WHEN Trs_Del1.PartyUnit = 'P' THEN Mas_Party.Pname ELSE Mas_Unit.ExporterName END AS Pname,CASE WHEN Trs_Del1.PartyUnit = 'P' THEN Mas_Party.Paddress ELSE Mas_Unit.ExporterAddress END AS Paddress,CASE WHEN Trs_Del1.PartyUnit = 'P' THEN Mas_Party.Phone ELSE Mas_Unit.Phone END AS Phone,CASE WHEN Trs_Del1.PartyUnit = 'P' THEN Mas_Party.TIN ELSE Mas_Unit.TIN END AS TIN,CASE WHEN Trs_Del1.PartyUnit = 'P' THEN Mas_Party.CST ELSE Mas_Unit.CST END AS CST, Mas_Exporter.ExporterName, Mas_Dept.DCFormat,dbo.Mas_Buyer.BuyerName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN, Mas_Exporter.CST AS ExpCST,Mas_Exporter.pan AS PAN,Trs_Grn1.PartyDCref, StockTable.CntID, StockTable.ColID, Case When IsNull(Mas_Dept.DeptType,'G')='G' Then StockTable.Gsm Else StockTable.FinGsm End As Gsm, StockTable.GG, StockTable.ll, Mas_Grp.DcPre, Mas_Fabric.Fabdesc, Mas_Dia.Dia, Mas_Dia_2.Dia as FDia,
                      Mas_Color.ColorDesc, Mas_Count.CountName, Trs_Del1.remark, Trs_Del1.ProcessType, Trs_Del1.LotNo, StockTable.LotNo AS StkLotno, 
                      CASE WHEN TRS_DEL2.MTR &gt; 0 THEN Mas_Uom.Uom ELSE '' END AS UOM, 
                      CASE WHEN StockTable.ColID &gt; 0 THEN FABDESC + '/' + COUNTNAME + '/' + COLORDESC ELSE FABDESC + '/' + COUNTNAME END AS ITEMDESC, 
                      CASE Trtype WHEN 1 THEN 'DELIVERY CHALLAN' WHEN 4 THEN 'PURCHASE RETURN' WHEN 13 THEN 'PARTY REJECTION RETURN' END AS Heading, 
                      dbo.Mas_Vehicle.VName, Mas_Terms.Terms, CASE WHEN StockTable.ColID &gt; 0 THEN  case when  StockTable.Print_designid&gt;0 then  fabdesc + Countname + COLORDESC + RTRIM(CAST(StockTable.ColID AS varchar))+ RTRIM(CAST(StockTable.Gsm AS varchar)) + RTRIM(CAST(StockTable.GG AS varchar)) + RTRIM(CAST(StockTable.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) + RTRIM(CAST(Mas_Dia_2.Dia AS varchar)) + Mas_design.designdesc
else fabdesc + Countname + COLORDESC + RTRIM(CAST(StockTable.ColID AS varchar))+ RTRIM(CAST(StockTable.Gsm AS varchar)) + RTRIM(CAST(StockTable.GG AS varchar)) + RTRIM(CAST(StockTable.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) + RTRIM(CAST(Mas_Dia_2.Dia AS varchar))end ELSE case when  StockTable.Print_designid&gt;0 then fabdesc + Countname + RTRIM(CAST(StockTable.ColID AS varchar)) + RTRIM(CAST(StockTable.Gsm AS varchar)) 
                      + RTRIM(CAST(StockTable.GG AS varchar)) + RTRIM(CAST(StockTable.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar))+Mas_design.designdesc+ RTRIM(CAST(Mas_Dia_2.Dia AS varchar))else fabdesc + Countname + RTRIM(CAST(StockTable.ColID AS varchar)) + RTRIM(CAST(StockTable.Gsm AS varchar)) + RTRIM(CAST(StockTable.GG AS varchar)) + RTRIM(CAST(StockTable.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) + RTRIM(CAST(Mas_Dia_2.Dia AS varchar)) end END AS GrpHeader, Trs_Del1.GPNo,ISNULL(Mas_Dept.ProgReqPrn, 'N') AS ProgReqPrn, ISNULL(dbo.Options.GatePassFlg, 'N') AS GatePassFlg, ISNULL(Mas_Design.DesignDesc, '') AS DesignDesc,Trs_Del1.TarDt, dbo.Mas_User.Username,CASE WHEN Preprint.DcRateReqd = 1 THEN CASE WHEN Trs_Del1.ProcessType = 'P' THEN CASE Ordermas.Jobno WHEN 0 THEN Trs_Del3.GeneralRate ELSE CASE Isnull(Mas_Dept.ProgFrm_Issue,'N') WHEN 'Y' THEN CASE Isnull(BudPodet.Rate, 0) WHEN 0 THEN Pro_ReqKnitt2.Rate ELSE BudPodet.Rate END ELSE 0 END END ELSE 0 END ELSE 0 END AS Rate,CASE WHEN Preprint.DcRateReqd = 1 THEN CASE WHEN Trs_Del1.ProcessType = 'P' THEN CASE Isnull(Mas_Dept.ProgFrm_Issue, 'N') WHEN 'Y' THEN 'Rate' ELSE '' END ELSE '' END ELSE '' END AS Ratelbl,CASE  Mas_Design.DesignDesc WHEN NULL THEN '' ELSE 'DESIGN' END AS DesignLbL,Mas_design_1.designdesc as Deldesign,CASE WHEN Trs_Del1.PartyUnit = 'U' then cuttingunit.exportername else '' end as cuttingunit,GodName,mas_exporter.IoNoCaption,Mas_Party.PAN As PPAN,IsNull(Mas_Dept.DeptType,'G') As DeptType,IsNull(Mas_Exporter.GSTNo,'') As GSTNo,IsNull(Mas_Party.GSTNo,'') As PGSTNo,IsNull(Mas_HSN.HSNCode,'') As HSNCode,EwayBillNo,EwayBillDt
FROM dbo.Mas_Terms AS Mas_Terms RIGHT OUTER JOIN
                      dbo.Trs_Del1 AS Trs_Del1 INNER JOIN
                      dbo.Mas_Dept AS Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID INNER JOIN
                      dbo.Trs_Del2 AS Trs_Del2 ON Trs_Del1.ID = Trs_Del2.ID LEFT OUTER JOIN
                      dbo.Mas_Party AS Mas_Party ON Trs_Del1.Party = Mas_Party.PID INNER JOIN
                      dbo.Mas_Exporter AS Mas_Exporter ON Trs_Del1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.OrderMas AS OrderMas ON Trs_Del2.OrdId = OrderMas.OrdId INNER JOIN 
					  OrderMas2 on OrderMas2.Ordid=OrderMas.OrdId LEFT OUTER JOIN
                      dbo.Trs_Grn1 AS Trs_Grn1 ON Trs_Del1.OurGRNID = Trs_Grn1.ID INNER JOIN
                      dbo.StockTable AS StockTable ON Trs_Del2.StockID = StockTable.StockID LEFT OUTER JOIN
                      dbo.Mas_Grp AS Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo LEFT OUTER JOIN
                      dbo.Mas_Buyer ON OrderMas.BuyerID = dbo.Mas_Buyer.BuyerID INNER JOIN
                      dbo.Mas_Dia AS Mas_Dia ON StockTable.DiaID = Mas_Dia.DiaID INNER JOIN
                      dbo.Mas_Dia AS Mas_Dia_2 ON StockTable.FinDiaID = Mas_Dia_2.DiaID
                      INNER JOIN dbo.Mas_Fabric AS Mas_Fabric ON StockTable.FabID = Mas_Fabric.FabID LEFT OUTER JOIN
                      dbo.Mas_Design AS Mas_Design ON StockTable.PRINT_DESIGNID = Mas_Design.DesignId LEFT OUTER JOIN
                      dbo.Trs_Del3 ON StockTable.Gsm = dbo.Trs_Del3.Gsm AND StockTable.DiaID = dbo.Trs_Del3.DiaID 
					  AND StockTable.FinGsm = dbo.Trs_Del3.GeneralRate AND StockTable.FinDiaID = dbo.Trs_Del3.FinDiaID 
					  AND StockTable.PrgKnitGsm = dbo.Trs_Del3.PrgKnitGSM AND StockTable.PrgKnitDiaId = dbo.Trs_Del3.PrgKnitDiaId 
					  AND StockTable.PRINT_DESIGNID = dbo.Trs_Del3.Print_DesignId AND StockTable.ll = dbo.Trs_Del3.LL AND StockTable.GG = dbo.Trs_Del3.GG 
					  AND StockTable.FabID = dbo.Trs_Del3.FabType AND StockTable.LotNo = Trs_Del3.LotNo AND Trs_Del1.ID = dbo.Trs_Del3.ID 
					  AND Trs_Del2.OrdId = dbo.Trs_Del3.OrdId AND StockTable.CntID = dbo.Trs_Del3.Cnt AND StockTable.ColID = dbo.Trs_Del3.Clr 
					  LEFT OUTER JOIN dbo.Pro_ReqKnitt2 ON Trs_Del2.OrdId = dbo.Pro_ReqKnitt2.OrdId AND Trs_Del1.Prs_Dept = dbo.Pro_ReqKnitt2.DeptId 
					  AND StockTable.CntID = dbo.Pro_ReqKnitt2.CntID AND StockTable.ColID = dbo.Pro_ReqKnitt2.ColId 
					  AND StockTable.FabID = dbo.Pro_ReqKnitt2.FabId AND StockTable.Gsm = dbo.Pro_ReqKnitt2.GSM AND StockTable.GG = dbo.Pro_ReqKnitt2.GG 
					  AND StockTable.ll = dbo.Pro_ReqKnitt2.LL AND StockTable.FinGsm = dbo.Pro_ReqKnitt2.FinGSM 
					  AND StockTable.FinDiaID = dbo.Pro_ReqKnitt2.FinDiaId AND StockTable.PrgKnitGsm = dbo.Pro_ReqKnitt2.GSM 
					  AND StockTable.PrgKnitDiaId = dbo.Pro_ReqKnitt2.DiaID AND StockTable.PRINT_DESIGNID = dbo.Pro_ReqKnitt2.DesignID 
					  LEFT OUTER JOIN dbo.Pro_ReqKnitt2 Pro_ReqKnitt2_2 ON Trs_Del2.OrdId = Pro_ReqKnitt2_2.OrdId 
					  AND StockTable.Dept = Pro_ReqKnitt2_2.DeptId AND StockTable.CntID = Pro_ReqKnitt2_2.CntID 
					  AND StockTable.ColID = Pro_ReqKnitt2_2.ColId AND StockTable.FabID = Pro_ReqKnitt2_2.FabId 
					  AND StockTable.Gsm = Pro_ReqKnitt2_2.GSM AND StockTable.GG = Pro_ReqKnitt2_2.GG AND StockTable.ll = Pro_ReqKnitt2_2.LL 
					  AND StockTable.FinGsm = Pro_ReqKnitt2_2.FinGSM AND StockTable.FinDiaID = Pro_ReqKnitt2_2.FinDiaId 
					  AND StockTable.PrgKnitGsm = Pro_ReqKnitt2_2.GSM AND StockTable.PrgKnitDiaId = Pro_ReqKnitt2_2.DiaID 
					  AND StockTable.PRINT_DESIGNID = Pro_ReqKnitt2_2.DesignID LEFT OUTER JOIN dbo.BudPodet INNER JOIN
                      dbo.BudPoMas ON dbo.BudPodet.Id = dbo.BudPoMas.Id ON StockTable.PRINT_DESIGNID = dbo.BudPodet.DesignID 
					  AND StockTable.PrgKnitDiaId = dbo.BudPodet.DiaId AND StockTable.PrgKnitGsm = dbo.BudPodet.GSM 
					  AND StockTable.FinDiaID = dbo.BudPodet.FinDiaId AND StockTable.FinGsm = dbo.BudPodet.FinGSM AND StockTable.ll = dbo.BudPodet.LL 
					  AND StockTable.GG = dbo.BudPodet.GG AND StockTable.ColID = dbo.BudPodet.ColId AND StockTable.CntID = dbo.BudPodet.CntId 
					  AND StockTable.FabID = dbo.BudPodet.FabId AND Trs_Del2.OrdId = dbo.BudPoMas.OrdId AND Trs_Del1.Prs_Dept = dbo.BudPoMas.DeptId 
					  AND Trs_Del1.Party = dbo.BudPoMas.PartyId LEFT OUTER JOIN dbo.Mas_Vehicle ON Trs_Del1.VehicleCode = dbo.Mas_Vehicle.Code 
					  LEFT OUTER JOIN dbo.Mas_Count AS Mas_Count ON StockTable.CntID = Mas_Count.CountID LEFT OUTER JOIN
                      Mas_design as Mas_design_1 on Trs_del1.DESIGNID = Mas_Design_1.DesignId left outer join dbo.Mas_Color AS Mas_Color 
					  ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN dbo.Mas_Uom AS Mas_Uom ON Mas_Fabric.PriUomID = Mas_Uom.UomID 
					  ON Mas_Terms.ID = Mas_Dept.DC_TermCode LEFT OUTER JOIN dbo.Mas_Exporter AS Mas_Unit ON Trs_Del1.Party = Mas_Unit.ExpID 
					  LEFT OUTER JOIN dbo.Mas_User ON Trs_Del1.PreparedBy = dbo.Mas_User.UserCode left outer join cutting_job 
					  on Trs_Del2.jobordid= cutting_job.id left outer join Mas_exporter as cuttingunit on cutting_job.partyid=cuttingunit.expid  
                      LEFT OUTER JOIN Mas_Godown ON Trs_Del1.GodID = Mas_Godown.GodID Left Join Mas_HSN On Pro_ReqKnitt2_2.HSNId=Mas_HSN.Id CROSS JOIN
                      dbo.Options CROSS JOIN dbo.PrePrint
WHERE (dbo.PrePrint.Slno = 2) AND (Trs_Del1.ID = ?)
ORDER BY Mas_Fabric.Fabdesc + '/' + Mas_Count.CountName + '/' + Mas_Color.ColorDesc, StockTable.Gsm, StockTable.GG, StockTable.ll, Mas_Dia.Dia,Mas_Dia_2.Dia</SqlCommand>
      </FabDC>
      <FabricSubReport Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabricSubReport</Alias>
        <Columns isList="true" count="15">
          <value>Clr,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>LL,System.String</value>
          <value>Prog,System.Decimal</value>
          <value>ProgMtr,System.Decimal</value>
          <value>Dia,System.String</value>
          <value>ItemDesc,System.String</value>
          <value>UOM,System.String</value>
          <value>GrpHeader,System.String</value>
          <value>Dcrate,System.Decimal</value>
          <value>Ratelbl,System.String</value>
          <value>DesignDesc,System.String</value>
          <value>Head,System.String</value>
          <value>Column,_x0040_Id,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabricSubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Trs_Del3.Clr, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, SUM(Trs_Del3.Prog) AS Prog, SUM(Trs_Del3.ProgMtr) AS ProgMtr, Mas_Dia.Dia, 
	CASE WHEN Trs_del3.clr &gt; 0 THEN Mas_Fabric.Fabdesc + '/' + CountName + '/' + Colordesc ELSE Mas_Fabric.Fabdesc + '/' + CountName END AS ItemDesc, 
                      CASE WHEN SUM(ProgMtr) &gt; 0 THEN Mas_Uom.Uom ELSE '' END AS UOM, 
                      CASE WHEN Trs_del3.clr &gt; 0 THEN CASE WHEN Trs_del3.Print_Designid &gt; 0 THEN Mas_Fabric.Fabdesc + CountName + Colordesc + Mas_design.Designdesc + RTRIM(CAST(trs_del3.Gsm
                       AS varchar)) + RTRIM(CAST(trs_del3.GG AS varchar)) + RTRIM(CAST(trs_del3.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) 
                      ELSE Mas_Fabric.Fabdesc + CountName + Colordesc + RTRIM(CAST(trs_del3.Gsm AS varchar)) + RTRIM(CAST(trs_del3.GG AS varchar)) 
                      + RTRIM(CAST(trs_del3.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) 
                      END ELSE CASE WHEN Trs_del3.Print_Designid &gt; 0 THEN Mas_Fabric.Fabdesc + CountName + Mas_design.Designdesc + RTRIM(CAST(trs_del3.Gsm AS varchar)) 
                      + RTRIM(CAST(trs_del3.GG AS varchar)) + RTRIM(CAST(trs_del3.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) 
                      ELSE Mas_Fabric.Fabdesc + CountName + RTRIM(CAST(trs_del3.Gsm AS varchar)) + RTRIM(CAST(trs_del3.GG AS varchar)) + RTRIM(CAST(trs_del3.ll AS varchar)) 
                      + RTRIM(CAST(Mas_Dia.Dia AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) END END AS GrpHeader, 
                      CASE PrePrint.DcRateReqd WHEN 1 THEN CASE Isnull(Trs_Del1.ProcessType, 'P') WHEN 'P' THEN CASE WHEN SUM(Jobno) 
                      &lt;&gt; 0 THEN CASE SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_Del3.Prog) WHEN 0 THEN SUM(Trs_Del3.Prog * isnull(Pro_ReqKnitt2.rate, 0)) / SUM(Trs_Del3.Prog) 
                      ELSE SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_Del3.Prog) END ELSE SUM(Trs_Del3.Prog * isnull(GeneralRate, 0)) / SUM(Trs_Del3.Prog) 
                      END ELSE 0 END ELSE 0 END AS Dcrate, 
                      CASE WHEN Preprint.DcRateReqd = 1 THEN CASE WHEN Trs_Del1.ProcessType = 'P' THEN 'Rate' ELSE '' END ELSE '' END AS Ratelbl, 
                      dbo.Mas_Design.DesignDesc, 'PROGRAM DETAILS' AS Head
FROM         dbo.Pro_ReqKnitt2 RIGHT OUTER JOIN
                      dbo.Trs_Del3 AS Trs_Del3 INNER JOIN
                      dbo.Mas_Fabric AS Mas_Fabric ON Trs_Del3.FabType = Mas_Fabric.FabID INNER JOIN
                      dbo.Mas_Dia AS Mas_Dia ON Trs_Del3.DiaID = Mas_Dia.DiaID INNER JOIN
                      dbo.Trs_Del1 ON Trs_Del3.ID = dbo.Trs_Del1.ID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID ON dbo.Pro_ReqKnitt2.FinDiaId = Trs_Del3.FinDiaID AND 
                      dbo.Pro_ReqKnitt2.FinGSM = Trs_Del3.FinGSm AND dbo.Pro_ReqKnitt2.DesignID = Trs_Del3.Print_DesignId AND dbo.Pro_ReqKnitt2.ColId = Trs_Del3.Clr AND 
                      dbo.Pro_ReqKnitt2.CntID = Trs_Del3.Cnt AND dbo.Pro_ReqKnitt2.DiaID = Trs_Del3.DiaID AND dbo.Pro_ReqKnitt2.LL = Trs_Del3.LL AND 
                      dbo.Pro_ReqKnitt2.GG = Trs_Del3.GG AND dbo.Pro_ReqKnitt2.GSM = Trs_Del3.Gsm AND dbo.Pro_ReqKnitt2.FabId = Trs_Del3.FabType AND 
                      dbo.Pro_ReqKnitt2.OrdId = Trs_Del3.OrdId AND dbo.Pro_ReqKnitt2.DeptId = dbo.Trs_Del1.Prs_Dept LEFT OUTER JOIN
                      dbo.Mas_Design ON Trs_Del3.Print_DesignId = dbo.Mas_Design.DesignId LEFT OUTER JOIN
                      dbo.BudPodet INNER JOIN
                      dbo.BudPoMas ON dbo.BudPodet.Id = dbo.BudPoMas.Id ON Trs_Del3.DiaID = dbo.BudPodet.DiaId AND Trs_Del3.LL = dbo.BudPodet.LL AND 
                      Trs_Del3.GG = dbo.BudPodet.GG AND Trs_Del3.Gsm = dbo.BudPodet.GSM AND Trs_Del3.FabType = dbo.BudPodet.FabId AND Trs_Del3.Clr = dbo.BudPodet.ColId AND 
                      Trs_Del3.Cnt = dbo.BudPodet.CntId AND Trs_Del3.OrdId = dbo.BudPoMas.OrdId AND dbo.Trs_Del1.Prs_Dept = dbo.BudPoMas.DeptId AND 
                      dbo.Trs_Del1.Party = dbo.BudPoMas.PartyId LEFT OUTER JOIN
                      dbo.Mas_Count AS Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID LEFT OUTER JOIN
                      dbo.Mas_Uom AS Mas_Uom ON Mas_Fabric.SecUomID = Mas_Uom.UomID LEFT OUTER JOIN
                      dbo.OrderMas ON dbo.OrderMas.OrdId = Trs_Del3.OrdId CROSS JOIN
                      dbo.PrePrint
WHERE     (dbo.Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.FabType &gt; 0) AND (dbo.Mas_Dept.Deptname &lt;&gt; 'DYEING') AND (Trs_Del3.ID = ?) AND (dbo.PrePrint.Slno = 2)
GROUP BY Trs_Del3.Clr, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, Mas_Dia.Dia, Mas_Fabric.Fabdesc, Mas_Count.CountName, Mas_Color.ColorDesc, Mas_Uom.Uom, 
                      dbo.PrePrint.DcRateReqd, dbo.Trs_Del1.ProcessType, dbo.Mas_Design.DesignDesc, Trs_Del3.Print_DesignId
ORDER BY Mas_Fabric.Fabdesc + '/' + Mas_Count.CountName + '/' + Mas_Color.ColorDesc, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, Mas_Dia.Dia</SqlCommand>
      </FabricSubReport>
      <YarnSubReportDataSource Ref="6" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>YarnSubReportDataSource</Alias>
        <Columns isList="true" count="7">
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>Prog,System.Decimal</value>
          <value>Dcrate,System.Decimal</value>
          <value>Ratelbl,System.String</value>
          <value>head,System.String</value>
          <value>Column,_x0040_Id,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnSubReportDataSource</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Mas_Color.ColorDesc, Mas_Count.CountName, SUM(Trs_Del3.Prog) AS Prog,
	CASE WHEN Preprint.DcRateReqd = 1 THEN CASE WHEN Trs_Del1.ProcessType = 'P' THEN  CASE WHEN SUM(jobno) &lt;&gt; 0 THEN	
CASE SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_Del3.Prog)   WHEN  0 THEN SUM(Trs_Del3.Prog * isnull(Pro_ReqYarn2.rate, 0)) / SUM(Trs_Del3.Prog) else SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_Del3.Prog)  END   
 else 0 end 
else 0 end else 0 end  AS Dcrate
,CASE WHEN Preprint.DcRateReqd = 1 THEN CASE WHEN Trs_Del1.ProcessType = 'P' THEN   'Rate' ELSE  '' END  ELSE  '' END  AS Ratelbl,'PROGRAM DETAILS' AS head
	FROM        dbo.Pro_ReqYarn2 RIGHT OUTER JOIN
                      dbo.Trs_Del3 AS Trs_Del3 INNER JOIN
                      dbo.Trs_Del1 ON Trs_Del3.ID = dbo.Trs_Del1.ID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID ON dbo.Pro_ReqYarn2.DeptId = dbo.Trs_Del1.Prs_Dept AND 
                      dbo.Pro_ReqYarn2.OrdId = Trs_Del3.OrdId AND dbo.Pro_ReqYarn2.CountId = Trs_Del3.Cnt AND 
                      dbo.Pro_ReqYarn2.ColId = Trs_Del3.Clr LEFT OUTER JOIN
                      dbo.BudPodet INNER JOIN
                      dbo.BudPoMas ON dbo.BudPodet.Id = dbo.BudPoMas.Id ON Trs_Del3.Clr = dbo.BudPodet.ColId AND Trs_Del3.Cnt = dbo.BudPodet.CntId AND 
                      Trs_Del3.OrdId = dbo.BudPoMas.OrdId AND dbo.Trs_Del1.Party = dbo.BudPoMas.PartyId AND dbo.Trs_Del1.Prs_Dept = dbo.BudPoMas.DeptId AND 
                      dbo.Trs_Del1.ID = dbo.BudPoMas.Id LEFT OUTER JOIN
                      dbo.Mas_Count AS Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID Left Outer Join ordermas on ordermas.ordid=trs_del3.Ordid cross  join Preprint
WHERE     (dbo.Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.FabType = 0) and trs_del3.id=? and Preprint.Slno=2
GROUP BY  Mas_Count.CountName,Mas_Color.ColorDesc,Trs_Del1.ProcessType,Preprint.DcRateReqd</SqlCommand>
      </YarnSubReportDataSource>
    </DataSources>
