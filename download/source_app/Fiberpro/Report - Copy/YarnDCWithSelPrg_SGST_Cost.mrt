    <DataSources isList="true" count="3">
      <FabricsubReport Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabricsubReport</Alias>
        <Columns isList="true" count="13">
          <value>ID,System.Int32</value>
          <value>Clr,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>prog,System.Decimal</value>
          <value>progMtr,System.Decimal</value>
          <value>Dia,System.String</value>
          <value>ItemDesc,System.String</value>
          <value>Uom,System.String</value>
          <value>Dcrate,System.Decimal</value>
          <value>Ratelbl,System.String</value>
          <value>DesignDesc,System.String</value>
          <value>LL,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabricsubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Trs_Del3.ID, Trs_Del3.Clr, Trs_Del3.Gsm, Trs_Del3.GG, SUM(Trs_Del3.Prog) AS prog, SUM(Trs_Del3.ProgMtr) AS progMtr, Mas_Dia.Dia, 
	CASE WHEN Trs_Del3.Clr = 0 THEN Mas_Fabric.Fabdesc + '/' + Countname ELSE Mas_Fabric.Fabdesc + '/' + Countname + '/' + Mas_Color.ColorDesc END AS ItemDesc,
                       CASE WHEN SUM(Trs_Del3.ProgMtr) &gt; 0 THEN Mas_Uom.Uom ELSE '' END AS Uom, CASE Preprint.DcRateReqd WHEN 1 THEN CASE Isnull(Trs_Del1.processType, 
                      'P') WHEN 'P' THEN CASE WHEN SUM(jobno) &lt;&gt; 0 THEN CASE WHEN SUM(isnull(BudPodet.Rate, 0)) &lt;&gt; 0 THEN SUM(Trs_Del3.Prog * BudPoDet.rate) 
                      / SUM(Trs_Del3.Prog) ELSE SUM(Trs_Del3.Prog * isnull(Pro_ReqKnitt2.rate, 0)) / SUM(Trs_Del3.Prog) END ELSE SUM(Trs_Del3.Prog * isnull(Trs_del3.GeneralRate, 0)) 
                      / SUM(Trs_Del3.Prog) END ELSE 0 END ELSE 0 END AS Dcrate, CASE Preprint.DcRateReqd WHEN 1 THEN CASE Isnull(Trs_Del1.processType, 'P') 
                      WHEN 'P' THEN 'Rate' ELSE '' END ELSE '' END AS Ratelbl, dbo.Mas_Design.DesignDesc, Trs_Del3.LL
FROM         dbo.Mas_Design RIGHT OUTER JOIN
                      dbo.Tmp_KnitPrgDcDet INNER JOIN
                      dbo.Mas_Dept INNER JOIN
                      dbo.Trs_Del1 ON dbo.Mas_Dept.DeptID = dbo.Trs_Del1.Prs_Dept INNER JOIN
                      dbo.Trs_Del3 AS Trs_Del3 INNER JOIN
                      dbo.Mas_Fabric AS Mas_Fabric ON Trs_Del3.FabType = Mas_Fabric.FabID ON dbo.Trs_Del1.ID = Trs_Del3.ID ON dbo.Tmp_KnitPrgDcDet.Id = Trs_Del3.ID AND 
                      dbo.Tmp_KnitPrgDcDet.FabId = Trs_Del3.FabType AND dbo.Tmp_KnitPrgDcDet.CntId = Trs_Del3.Cnt AND dbo.Tmp_KnitPrgDcDet.Gsm = Trs_Del3.Gsm AND 
                      dbo.Tmp_KnitPrgDcDet.GG = Trs_Del3.GG AND dbo.Tmp_KnitPrgDcDet.LL = Trs_Del3.LL AND dbo.Tmp_KnitPrgDcDet.DiaId = Trs_Del3.DiaID ON 
                      dbo.Mas_Design.DesignId = Trs_Del3.Print_DesignId LEFT OUTER JOIN
                      dbo.BudPoMas INNER JOIN
                      dbo.BudPodet ON dbo.BudPoMas.Id = dbo.BudPodet.Id ON dbo.Trs_Del1.Prs_Dept = dbo.BudPoMas.DeptId AND dbo.Trs_Del1.Party = dbo.BudPoMas.PartyId AND 
                      Trs_Del3.OrdId = dbo.BudPoMas.OrdId AND Trs_Del3.DiaID = dbo.BudPodet.DiaId AND Trs_Del3.LL = dbo.BudPodet.LL AND Trs_Del3.GG = dbo.BudPodet.GG AND 
                      Trs_Del3.Gsm = dbo.BudPodet.GSM AND Trs_Del3.FabType = dbo.BudPodet.FabId AND Trs_Del3.Clr = dbo.BudPodet.ColId AND 
                      Trs_Del3.Cnt = dbo.BudPodet.CntId LEFT OUTER JOIN
                      dbo.Mas_Dia AS Mas_Dia ON Trs_Del3.DiaID = Mas_Dia.DiaID LEFT OUTER JOIN
                      dbo.Pro_ReqKnitt2 ON dbo.Trs_Del1.Prs_Dept = dbo.Pro_ReqKnitt2.DeptId AND Trs_Del3.OrdId = dbo.Pro_ReqKnitt2.OrdId AND 
                      Trs_Del3.FabType = dbo.Pro_ReqKnitt2.FabId AND Trs_Del3.Clr = dbo.Pro_ReqKnitt2.ColId AND Trs_Del3.Cnt = dbo.Pro_ReqKnitt2.CntID AND 
                      Trs_Del3.Gsm = dbo.Pro_ReqKnitt2.GSM AND Trs_Del3.GG = dbo.Pro_ReqKnitt2.GG AND Trs_Del3.LL = dbo.Pro_ReqKnitt2.LL AND 
                      Trs_Del3.DiaID = dbo.Pro_ReqKnitt2.DiaID AND Trs_Del3.FinDiaID = dbo.Pro_ReqKnitt2.FinDiaId AND Trs_Del3.FinGSm = dbo.Pro_ReqKnitt2.FinGSM AND 
                      Trs_Del3.DiaID = dbo.Pro_ReqKnitt2.DiaID LEFT OUTER JOIN
                      dbo.Mas_Count AS Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID LEFT OUTER JOIN
                      dbo.Mas_Uom AS Mas_Uom ON Mas_Fabric.PriUomID = Mas_Uom.UomID LEFT OUTER JOIN
                      dbo.OrderMas ON dbo.OrderMas.OrdId = Trs_Del3.OrdId CROSS JOIN
                      dbo.PrePrint
WHERE     (dbo.Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.FabType &gt; 0) AND (Trs_Del3.ID = ?) AND (dbo.PrePrint.Slno = 2)
GROUP BY Mas_Fabric.Fabdesc, Mas_Count.CountName, Mas_Color.ColorDesc, Trs_Del3.Gsm, Trs_Del3.GG, Mas_Dia.Dia, Trs_Del3.ID, Trs_Del3.Clr, Mas_Uom.Uom, 
                      dbo.PrePrint.DcRateReqd, dbo.Trs_Del1.ProcessType, dbo.Mas_Design.DesignDesc, Trs_Del3.LL
</SqlCommand>
      </FabricsubReport>
      <YarnDC Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>YarnDC</Alias>
        <Columns isList="true" count="43">
          <value>ID,System.Int32</value>
          <value>DcNo,System.String</value>
          <value>Dt,System.DateTime</value>
          <value>TrType,System.Int32</value>
          <value>remark,System.String</value>
          <value>delwgt,System.Decimal</value>
          <value>OrderNo,System.String</value>
          <value>StyleNo,System.String</value>
          <value>Deptname,System.String</value>
          <value>OutputType,System.String</value>
          <value>dcformat,System.String</value>
          <value>BgRl,System.Int32</value>
          <value>Kg,System.Decimal</value>
          <value>Pname,System.String</value>
          <value>Paddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Expr2,System.String</value>
          <value>Expr3,System.String</value>
          <value>Expr4,System.String</value>
          <value>PAN,System.String</value>
          <value>PartyDCref,System.String</value>
          <value>grnwgt,System.Decimal</value>
          <value>DcPre,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>Mill,System.String</value>
          <value>Heading,System.String</value>
          <value>VName,System.String</value>
          <value>Terms,System.String</value>
          <value>Item,System.String</value>
          <value>Gpno,System.Int32</value>
          <value>GatePassFlg,System.String</value>
          <value>UserName,System.String</value>
          <value>GSTNo,System.String</value>
          <value>PGSTNo,System.String</value>
          <value>HSNCode,System.String</value>
          <value>EwayBillNo,System.String</value>
          <value>EwayBillDt,System.DateTime</value>
          <value>amount,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Trs_Del1.ID, CASE WHEN len(rtrim(mas_grp.dcpre)) &lt; 1 THEN RTRIM(CAST(Trs_Del1.DocNo AS varchar)) 
                      + '/' + Trs_Del1.Finyear ELSE rtrim(mas_grp.dcpre) + '-' + RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear END AS DcNo, 
                      Trs_Del1.Dt, Trs_Del1.TrType, Trs_Del1.remark, Trs_Del1.delwgt, 
                      CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar))
                       + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, '' as StyleNo, Mas_Dept.Deptname, Mas_Dept.OutputType, 
                      Mas_Dept.dcformat, Trs_Del2.BgRl, Trs_Del2.Kg, Mas_Party.Pname, Mas_Party.Paddress, Mas_Party.Phone, Mas_Party.TIN, Mas_Party.CST, 
                      Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone AS Expr2, Mas_Exporter.TIN AS Expr3, 
                      Mas_Exporter.CST AS Expr4, Mas_Exporter.pan AS PAN, Trs_Grn1.PartyDCref, Trs_Grn1.grnwgt, Mas_Grp.DcPre, Mas_Color.ColorDesc, Mas_Count.CountName, Mas_Mill.Mill, 
                      CASE Trtype WHEN 1 THEN 'PROCESS DELIVERY' WHEN 4 THEN 'PURCHASE RETURN' WHEN 13 THEN 'PARTY REJECTION RETURN' END AS
                       Heading, Mas_Vehicle.VName, Mas_Terms.Terms, CASE WHEN Mas_Color.ColorDesc IS NOT NULL AND Mas_Mill.Mill IS NOT NULL 
                      THEN Mas_Count.CountName + Mas_Color.ColorDesc + Mas_Mill.Mill WHEN Mas_Color.ColorDesc IS NULL AND Mas_Mill.Mill IS NULL 
                      THEN Mas_Count.CountName WHEN Mas_Color.ColorDesc IS NULL AND Mas_Mill.Mill IS NOT NULL 
                      THEN Mas_Count.CountName + Mas_Mill.Mill WHEN Mas_Color.ColorDesc IS NOT NULL AND Mas_Mill.Mill IS NULL 
                      THEN Mas_Count.CountName + Mas_Color.ColorDesc END AS Item,Gpno,isnull(Options.GatePassFlg,'N') as GatePassFlg, Mas_User.UserName
,IsNull(Mas_Exporter.GSTNo,'') As GSTNo,IsNull(Mas_Party.GSTNo,'') As PGSTNo,IsNull(Mas_HSN.HSNCode,'') As HSNCode,EwayBillNo,EwayBillDt,(Trs_Del2.Kg*Pro_ReqYarn2_2.Cost) as amount
FROM         Trs_Del1 AS Trs_Del1 INNER JOIN
                      Mas_Dept AS Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID INNER JOIN
                      Trs_Del2 AS Trs_Del2 ON Trs_Del1.ID = Trs_Del2.ID INNER JOIN
                      Mas_Party AS Mas_Party ON Trs_Del1.Party = Mas_Party.PID INNER JOIN
                      Mas_Exporter AS Mas_Exporter ON Trs_Del1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      OrderMas AS OrderMas ON Trs_Del2.OrdID = OrderMas.OrdId LEFT OUTER JOIN
                      Trs_Grn1 AS Trs_Grn1 ON Trs_Del1.OurGRNID = Trs_Grn1.ID INNER JOIN
                      StockTable AS StockTable ON Trs_Del2.StockID = StockTable.StockID 
					  LEFT OUTER JOIN
                      dbo.Pro_ReqYarn2 Pro_ReqYarn2_2 ON Trs_Del2.OrdId = Pro_ReqYarn2_2.OrdId AND StockTable.Dept = Pro_ReqYarn2_2.DeptId AND 
                      StockTable.CntID = Pro_ReqYarn2_2.CountId AND StockTable.ColID = Pro_ReqYarn2_2.ColId 
LEFT OUTER JOIN
                      Mas_Grp AS Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo INNER JOIN
                      Mas_Count AS Mas_Count ON StockTable.CntID = Mas_Count.CountID LEFT OUTER JOIN
                      Mas_Mill AS Mas_Mill ON StockTable.MillID = Mas_Mill.MillID LEFT OUTER JOIN
                      Mas_Vehicle ON Trs_Del1.VehicleCode = Mas_Vehicle.Code LEFT OUTER JOIN
                      Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN
Mas_User On Mas_User.UserCode = Trs_Del1.PreparedBy  LEFT OUTER JOIN
                      Mas_Terms AS Mas_Terms ON Mas_Dept.Dc_TermCode = Mas_Terms.Id 
Left Join Mas_HSN On Pro_ReqYarn2_2.HSNId=Mas_HSN.Id
cross join Options
where trs_del1.id=?
</SqlCommand>
      </YarnDC>
      <YarnSubReport Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>YarnSubReport</Alias>
        <Columns isList="true" count="4">
          <value>Prog,System.Decimal</value>
          <value>ProgMtr,System.Decimal</value>
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnSubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     TOP 100 PERCENT SUM(Trs_Del3.Prog) AS Prog, SUM(Trs_Del3.ProgMtr) AS ProgMtr, Mas_Color.ColorDesc, Mas_Count.CountName
FROM         dbo.Trs_Del3 Trs_Del3 INNER JOIN
                      dbo.Trs_Del1 ON Trs_Del3.ID = dbo.Trs_Del1.ID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Mas_Count Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID
WHERE     (dbo.Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.ID = ?) AND (Trs_Del3.FabType = 0)
GROUP BY Mas_Count.CountName, Mas_Color.ColorDesc
ORDER BY Mas_Count.CountName, Mas_Color.ColorDesc
</SqlCommand>
      </YarnSubReport>
