<StiSerializer version="1.0" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <Databases isList="true" count="1">
      <Connection Ref="2" type="Stimulsoft.Report.Dictionary.StiOleDbDatabase" isKey="true">
        <Alias>Connection</Alias>
        <ConnectionString>Provider=SQLOLEDB.1;Persist Security Info=False;User ID=sa;Initial Catalog=Zeal;Data Source=MACHINE-14</ConnectionString>
        <Name>Connection</Name>
        <PromptUserNameAndPassword>False</PromptUserNameAndPassword>
      </Connection>
    </Databases>
    <DataSources isList="true" count="1">
      <GeneralDc Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>GeneralDc</Alias>
        <Columns isList="true" count="20">
          <value>DcNo,System.String</value>
          <value>Dt,System.DateTime</value>
          <value>party,System.String</value>
          <value>Paddress,System.String</value>
          <value>Phone,System.String</value>
          <value>CourierName,System.String</value>
          <value>sender,System.String</value>
          <value>OrdRef,System.String</value>
          <value>style,System.String</value>
          <value>ItemDesc,System.String</value>
          <value>deltype,System.String</value>
          <value>DelQty,System.Decimal</value>
          <value>Uom,System.String</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>ExpPhone,System.String</value>
          <value>ExpTIN,System.String</value>
          <value>ExpCST,System.String</value>
          <value>UserName,System.String</value>
          <value>remark,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>GeneralDc</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM(CAST(trs_courier1.Dcno AS varchar)) + '/' + trs_courier1.Finyear AS DcNo,trs_courier1.Dt,case when trs_courier1.BPflg='B' then MAs_buyer.BuyerName else Mas_Party.pname  end as party,case when trs_courier1.BPflg='B' then MAs_buyer.BuyerAddress else  Mas_Party.Paddress end as Paddress ,case when trs_courier1.BPflg='B' then   Mas_Buyer.Phone else  Mas_Party.Phone end as Phone,
Mas_courier.CourierName,trs_courier1.sender,Ordref,style,itemdesc,deltype,delqty,Uom,Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress,Mas_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN, Mas_Exporter.CST AS ExpCST,Mas_User.Username,Trs_courier1.remark    from trs_courier1 left outer join Mas_Party on Mas_Party.PID = trs_courier1.partyid left Outer join Mas_Buyer on Mas_Buyer.BuyerID  = trs_courier1.partyid  Left Outer join Mas_courier on Mas_courier.cid = trs_courier1.courier inner join trs_courier2 on trs_courier1.id = trs_courier2.id Left outer join Mas_uom on Mas_Uom.UomID = trs_courier2.uomid  left outer join  Mas_Exporter on  Mas_Exporter.ExpID =trs_courier1.coycode left outer join Mas_User on Mas_User.UserCode = trs_courier1.userid where trs_courier1.id=?</SqlCommand>
      </GeneralDc>
    </DataSources>
    <Relations isList="true" count="0" />
    <Report isRef="0" />
    <Variables isList="true" count="0" />
  </Dictionary>
