        <PromptUserNameAndPassword>False</PromptUserNameAndPassword>
      </Connection>
    </Databases>
    <DataSources isList="true" count="1">
      <AccGRN Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>AccGRN</Alias>
        <Columns isList="true" count="34">
          <value>GRNNo,System.String</value>
          <value>dt,System.DateTime</value>
          <value>PartyDCref,System.String</value>
          <value>GRNType,System.String</value>
          <value>remark,System.String</value>
          <value>grnwgt,System.Decimal</value>
