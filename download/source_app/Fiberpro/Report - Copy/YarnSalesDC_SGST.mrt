          <value>Mill,System.String</value>
          <value>VName,System.String</value>
          <value>LotNo,System.String</value>
          <value>UserName,System.String</value>
          <value>gstno,System.String</value>
          <value>PGstno,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;'  ELSE RTRIM(CAST(OrderMas.Jobno AS varchar))
+ '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, CASE WHEN len(rtrim(dcpre))&lt; 1 
THEN RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear ELSE rtrim(dcpre) + '-' + 
RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear END AS DcNo, Trs_Del1.ID, Trs_Del1.Dt, 
Trs_Del1.TrType,Replace(Trs_Del1.remark ,char(13) + Char(10),'') as remark, Trs_Del1.delwgt, Trs_Del1.StyleNo, Mas_Dept.Deptname, Mas_Dept.OutputType, 
Trs_Del2.BgRl, Trs_Del2.Kg, Trs_Del2.Rate,ISNULL(TRS_DEL1.dELADD,'A')
 as deladd, 
case when trs_del1.party=0 then Del_Buyer.buyername else Mas_Party.Pname end Pname ,
case when trs_del1.party=0 then Del_Buyer.buyeraddress else  Mas_Party.Paddress end Paddress,
case when trs_del1.party=0 then Del_Buyer.Phone else  Mas_Party.Phone end as Phone, Mas_Exporter.ExporterName, Mas_exporter.gstno, case when trs_del1.party=0 then Del_Buyer.gstno else Mas_Party.GSTNo end PGstno, isnull(Mas_Dept.DCFormat,'') as DCFormat, Mas_Exporter.ExporterAddress, 
Mas_Exporter.Phone AS Expr2, Mas_Exporter.TIN AS Expr3, Mas_Exporter.CST AS Expr4, Trs_Grn1.PartyDCref, 
Trs_Grn1.grnwgt, Mas_Grp.DcPre, Mas_Color.ColorDesc, Mas_Count.CountName,case when isnull(Options1.Buyer_reqd_Dc,'y') ='y'  then  Mas_Buyer.ShortBuyer else '' end As ShortBuyer ,Gpno,
isnull(Options.GatePassFlg,'N') as GatePassFlg, Mas_Mill.Mill, dbo.Mas_Vehicle.VName, 
isnull(StockTable.LotNo,'') as LotNo, Mas_User.UserName
FROM dbo.Trs_Del1 Trs_Del1 
INNER JOIN dbo.Trs_Del2 Trs_Del2 ON Trs_Del1.ID = Trs_Del2.ID 
left outer JOIN dbo.Mas_Party Mas_Party ON Trs_Del1.Party = Mas_Party.PID 
INNER JOIN dbo.Mas_Exporter Mas_Exporter ON Trs_Del1.Coycode = Mas_Exporter.ExpID 
INNER JOIN dbo.OrderMas OrderMas ON Trs_Del2.OrdID = OrderMas.OrdId 
LEFT OUTER JOIN dbo.Trs_Grn1 Trs_Grn1 ON Trs_Del1.OurGRNID = Trs_Grn1.ID 
LEFT OUTER JOIN dbo.Mas_Buyer Mas_Buyer ON OrderMas.BuyerID = Mas_Buyer.BuyerID 
INNER JOIN dbo.StockTable StockTable ON Trs_Del2.StockID = StockTable.StockID 
LEFT OUTER JOIN dbo.Mas_Dept Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID 
INNER JOIN dbo.Mas_Grp Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo 
INNER JOIN dbo.Mas_Count Mas_Count ON StockTable.CntID = Mas_Count.CountID 
LEFT OUTER JOIN dbo.Mas_Mill Mas_Mill ON StockTable.MillID = Mas_Mill.MillID 
LEFT OUTER JOIN dbo.Mas_Vehicle ON Trs_Del1.VehicleCode = dbo.Mas_Vehicle.Code 
LEFT OUTER JOIN Mas_User On Trs_Del1.PreparedBy = Mas_User.UserCode  
LEFT OUTER JOIN dbo.Mas_Color Mas_Color ON StockTable.ColID = Mas_Color.ColID
left outer join MAs_buyer as Del_Buyer on trs_del1.buyer=Del_Buyer.buyerid
cross join options
cross join options1
where Trs_del1.id=? </SqlCommand>
      </YarnDC>
    </DataSources>
