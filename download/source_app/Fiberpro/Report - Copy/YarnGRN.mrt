    <DataSources isList="true" count="1">
      <YarnGRN Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>YarnGRN</Alias>
        <Columns isList="true" count="37">
          <value>GrnNo,System.String</value>
          <value>Heading,System.String</value>
          <value>OrderNo,System.String</value>
          <value>RefNo,System.String</value>
