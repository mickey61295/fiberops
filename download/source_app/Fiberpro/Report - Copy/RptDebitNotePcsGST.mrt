    <DataSources isList="true" count="3">
      <DebitAddDed Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DebitAddDed</Alias>
        <Columns isList="true" count="4">
          <value>indexcode,System.Int32</value>
          <value>AddDedName,System.String</value>
          <value>Valu,System.Decimal</value>
          <value>Amt,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DebitAddDed</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT DISTINCT indexcode, Mas_AddDed.AddDedName, Trs_DebAddDed.Valu, Trs_DebAddDed.Amt
	FROM Trs_DebAddDed INNER JOIN
	Mas_AddDed ON Trs_DebAddDed.AddDedCode = Mas_AddDed.AddDedCode 
INNER JOIN Trs_Deb1 On Trs_DebAddDed.ID = Trs_Deb1.ID
WHERE Trs_DebAddDed.ID = ?
AND ((Mas_AddDed.Grp = 3 AND Trs_Deb1.Typ = '1.Purchase') OR (Mas_AddDed.Grp = 4 AND Trs_Deb1.Typ = '2.Process') OR (Mas_AddDed.Grp=4 AND trs_Deb1.typ='3.Reprocess') or (Mas_AddDed.Grp = 8 AND Trs_Deb1.Typ = '4.Production'))
order by indexcode
</SqlCommand>
      </DebitAddDed>
      <DebitNotePcs Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DebitNotePcs</Alias>
        <Columns isList="true" count="42">
          <value>ColorDesc,System.String</value>
          <value>ColID,System.Int32</value>
          <value>SizeID,System.Int32</value>
          <value>SizeDesc,System.String</value>
          <value>Expr1,System.Int32</value>
          <value>SizeID1,System.Int32</value>
          <value>DebQty,System.Decimal</value>
          <value>Expr2,System.Int32</value>
          <value>Party,System.Int32</value>
          <value>Pname,System.String</value>
          <value>Dept,System.Int32</value>
          <value>Deptname,System.String</value>
          <value>ID,System.Int32</value>
          <value>Typ,System.String</value>
          <value>Rate,System.Decimal</value>
          <value>Reason,System.String</value>
          <value>DebitValue,System.Decimal</value>
          <value>dt,System.DateTime</value>
          <value>Finyear,System.String</value>
          <value>Jobno,System.Int32</value>
          <value>BuyOrdNo,System.String</value>
          <value>Expr3,System.String</value>
          <value>ExporterName,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>PPhone,System.String</value>
          <value>PTIN,System.String</value>
          <value>PCST,System.String</value>
          <value>remark,System.String</value>
          <value>Debitno,System.String</value>
          <value>OrderNo,System.String</value>
          <value>BrNo,System.String</value>
          <value>PartyBillNo,System.String</value>
          <value>brno1,System.Int32</value>
          <value>IoNoCaption,System.String</value>
          <value>Amount,System.Decimal</value>
          <value>Username,System.String</value>
          <value>Expr4,System.Int32</value>
          <value>CGSTNo,System.String</value>
          <value>PGSTNo,System.String</value>
          <value>StyleNo,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DebitNotePcs</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>/*SELECT      dbo.Mas_Color.ColorDesc, dbo.Mas_Color.ColID, dbo.Mas_Size.SizeID, dbo.Mas_Size.SizeDesc, 
	dbo.Trs_deb3.ColdID AS Expr1, dbo.Trs_deb3.SizeID, dbo.Trs_deb3.DebQty, dbo.Trs_deb3.ID AS Expr2, dbo.Trs_Deb1.Party,Case When Typ='4.Production' Then Mas_Emp.EmpName Else dbo.Mas_Party.Pname End As Pname, 
	dbo.Trs_Deb1.Dept,Case When Typ='4.Production' Then Mas_JobWrkComp.WorkComplDet Else dbo.Mas_Dept.Deptname End As Deptname, dbo.Trs_Deb1.ID, dbo.Trs_Deb1.Typ, dbo.Trs_deb3.Rate, SUBSTRING(dbo.Trs_Deb1.Reason, 3, 50) AS Reason, 
	dbo.Trs_Deb1.DebitValue, dbo.Trs_Deb1.dt, dbo.Trs_Deb1.Finyear, dbo.OrderMas.Jobno, dbo.OrderMas.BuyOrdNo, dbo.OrderMas.Finyear AS Expr3, 
	dbo.Mas_Exporter.ExporterName, dbo.Mas_Exporter.Phone, dbo.Mas_Exporter.TIN, dbo.Mas_Exporter.CST, dbo.Mas_Party.Phone AS PPhone, 
	dbo.Mas_Party.TIN AS PTIN, dbo.Mas_Party.CST AS PCST, dbo.Trs_Deb1.remark, CAST(dbo.Trs_Deb1.DNo AS varchar) + '/' + dbo.Trs_Deb1.Finyear AS Debitno, 
                      RTRIM(CAST(dbo.OrderMas.Jobno AS varchar)) + '/' + dbo.OrderMas.Finyear + '-&gt;' + dbo.OrderMas.BuyOrdNo AS OrderNo, 'BrNo : ' + RTRIM(dbo.Trs_ProdBill.brno) 
                      + '/' + RTRIM(dbo.Trs_ProdBill.finyear) AS BrNo, 'Party Bill : ' + dbo.Trs_ProdBill.billno AS PartyBillNo,dbo.Trs_ProdBill.brno, dbo.Mas_Exporter.IoNoCaption, 
                      dbo.Trs_deb3.DebQty * dbo.Trs_deb3.Rate AS Amount, dbo.Mas_User.Username, dbo.Trs_ProdBill.ID AS Expr4,IsNull(Mas_Exporter.GSTNo,'')CGSTNo,IsNull(Mas_Party.GSTNo,'')PGSTNo,isnull(Trs_deb3.StyleNo,'')StyleNo
FROM        

Trs_Deb1 
inner join trs_deb3 on Trs_Deb1.id=trs_deb3.id 
left outer join  dbo.Trs_ProdBill   on Trs_Deb1.Brnid =Trs_ProdBill.id 
 iNNER JOIN     dbo.Mas_Color ON dbo.trs_deb3.ColdID = dbo.Mas_Color.ColID 
 INNER JOIN      dbo.OrderMas ON dbo.OrderMas.OrdId = dbo.Trs_Deb1.OrdId
 INNER JOIN     dbo.Mas_Exporter ON dbo.Mas_Exporter.ExpID = dbo.Trs_Deb1.Coycode
 INNER JOIN    dbo.Mas_Dept ON dbo.Trs_Deb1.Dept = dbo.Mas_Dept.DeptID 
 INNER JOIN    dbo.Mas_JobWrkComp ON dbo.Trs_Deb1.Dept = dbo.Mas_JobWrkComp.ID 
 LEFT JOIN   dbo.Mas_Party  ON dbo.Mas_Party.PID = dbo.Trs_Deb1.Party
 LEFT JOIN   dbo.Mas_Emp  ON dbo.Mas_Emp.ID = dbo.Trs_Deb1.Party
 LEFT OUTER JOIN   dbo.Mas_User ON dbo.Trs_Deb1.PreparedBy = dbo.Mas_User.UserCode
 INNER JOIN  dbo.Mas_Size ON dbo.trs_deb3.SizeID = dbo.Mas_Size.SizeID
 WHERE     (dbo.Trs_Deb1.ID = ? )
*/

SELECT   DISTINCT   dbo.Mas_Color.ColorDesc, dbo.Mas_Color.ColID, dbo.Mas_Size.SizeID, dbo.Mas_Size.SizeDesc, 
	dbo.Trs_deb3.ColdID AS Expr1, dbo.Trs_deb3.SizeID, dbo.Trs_deb3.DebQty, dbo.Trs_deb3.ID AS Expr2, dbo.Trs_Deb1.Party,Case When Typ='4.Production' Then Mas_Emp.EmpName Else dbo.Mas_Party.Pname End As Pname, 
	dbo.Trs_Deb1.Dept, Mas_JobWrkComp.WorkComplDet As Deptname, dbo.Trs_Deb1.ID, dbo.Trs_Deb1.Typ, dbo.Trs_deb3.Rate, SUBSTRING(dbo.Trs_Deb1.Reason, 3, 50) AS Reason, 
	dbo.Trs_Deb1.DebitValue, dbo.Trs_Deb1.dt, dbo.Trs_Deb1.Finyear, dbo.OrderMas.Jobno, dbo.OrderMas.BuyOrdNo, dbo.OrderMas.Finyear AS Expr3, 
	dbo.Mas_Exporter.ExporterName, dbo.Mas_Exporter.Phone, dbo.Mas_Exporter.TIN, dbo.Mas_Exporter.CST, Case When Typ='4.Production' Then '' Else dbo.Mas_Party.Phone End AS PPhone, 
	dbo.Mas_Party.TIN AS PTIN, dbo.Mas_Party.CST AS PCST, dbo.Trs_Deb1.remark, CAST(dbo.Trs_Deb1.DNo AS varchar) + '/' + dbo.Trs_Deb1.Finyear AS Debitno, 
                      RTRIM(CAST(dbo.OrderMas.Jobno AS varchar)) + '/' + dbo.OrderMas.Finyear + '-&gt;' + dbo.OrderMas.BuyOrdNo AS OrderNo, 'BrNo : ' + Case When Trs_ProdBill.Id &gt; 0 Then RTRIM(dbo.Trs_ProdBill.brno) 
                      + '/' + RTRIM(dbo.Trs_ProdBill.finyear) Else RTRIM(Trs_ProdBillMasNew.brno) +'/'+ RTRIM(Trs_ProdBillMasNew.finyear) End AS BrNo, 'Party Bill No : ' + Case When Trs_ProdBill.Id &gt; 0 Then dbo.Trs_ProdBill.billno Else Trs_ProdBillMasNew.billno End AS PartyBillNo,dbo.Trs_ProdBill.brno, dbo.Mas_Exporter.IoNoCaption, 
                      dbo.Trs_deb3.DebQty * dbo.Trs_deb3.Rate AS Amount, dbo.Mas_User.Username, dbo.Trs_ProdBill.ID AS Expr4,IsNull(Mas_Exporter.GSTNo,'')CGSTNo,  Case When Typ='4.Production' Then '' Else IsNull(Mas_Party.GSTNo,'') End AS PGSTNo,
                      isnull(Trs_deb3.StyleNo,'')StyleNo
FROM        

Trs_Deb1 
inner join trs_deb3 on Trs_Deb1.id=trs_deb3.id 
left outer join  dbo.Trs_ProdBill   on Trs_Deb1.Brnid =Trs_ProdBill.id 
 iNNER JOIN     dbo.Mas_Color ON dbo.trs_deb3.ColdID = dbo.Mas_Color.ColID 
 INNER JOIN      dbo.OrderMas ON dbo.OrderMas.OrdId = dbo.Trs_Deb3.OrdId
 INNER JOIN     dbo.Mas_Exporter ON dbo.Mas_Exporter.ExpID = dbo.Trs_Deb1.Coycode
 INNER JOIN   dbo.Mas_JobWrkComp ON dbo.Trs_Deb1.Dept = dbo.Mas_JobWrkComp.Id 
  LEFT JOIN   dbo.Mas_Party  ON dbo.Mas_Party.PID = dbo.Trs_Deb1.Party
 LEFT JOIN   dbo.Mas_Emp  ON dbo.Mas_Emp.ID = dbo.Trs_Deb1.Party
 LEFT OUTER JOIN   dbo.Mas_User ON dbo.Trs_Deb1.PreparedBy = dbo.Mas_User.UserCode
 INNER JOIN  dbo.Mas_Size ON dbo.trs_deb3.SizeID = dbo.Mas_Size.SizeID
LEFT JOIN Trs_ProdBillMasNew On Trs_ProdBillMasNew.ID = Trs_Deb1.Brnid
 WHERE     (dbo.Trs_Deb1.ID = ? )</SqlCommand>
      </DebitNotePcs>
      <DataSource1 Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="1">
          <value>IONO,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>select isNull(stuff(( select ',' + x.IONO	from (Select  Distinct Rtrim(Isnull(Jobno,''))+'/'+Rtrim(Isnull(Ordermas.Finyear,''))  IONO From Trs_Deb1  INNER JOIN dbo.Trs_Deb3 AS Trs_Deb2 ON Trs_Deb1.ID = Trs_Deb2.ID INNER JOIN dbo.OrderMas AS OrderMas ON Trs_Deb2.OrdId = OrderMas.OrdId where Trs_Deb1.Id=?) x for xml path('')),1,1,''),'') IONO</SqlCommand>
      </DataSource1>
    </DataSources>
