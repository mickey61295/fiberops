<StiSerializer version="1.0" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <Databases isList="true" count="1">
      <Connection Ref="2" type="Stimulsoft.Report.Dictionary.StiOleDbDatabase" isKey="true">
        <Alias>Connection</Alias>
        <ConnectionString>Provider=SQLOLEDB.1;Persist Security Info=False;User ID=sa;Initial Catalog=JOMS;Data Source=MACHINE-14</ConnectionString>
        <Name>Connection</Name>
        <PromptUserNameAndPassword>False</PromptUserNameAndPassword>
      </Connection>
    </Databases>
    <DataSources isList="true" count="2">
      <DataSource1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="22">
          <value>SAmt,System.Decimal</value>
          <value>Descr,System.String</value>
          <value>BQty,System.Decimal</value>
          <value>BRate,System.Decimal</value>
          <value>Ex_Rate,System.Decimal</value>
          <value>DescrID,System.Int32</value>
          <value>ID,System.Int32</value>
          <value>ExporterName,System.String</value>
          <value>Pname,System.String</value>
          <value>Deptname,System.String</value>
          <value>OrdId,System.Int32</value>
          <value>billamt,System.Decimal</value>
          <value>BillType,System.String</value>
          <value>billno,System.String</value>
          <value>BillPassDt,System.DateTime</value>
          <value>billdt,System.DateTime</value>
          <value>Amt,System.Decimal</value>
          <value>PCSRate,System.Decimal</value>
          <value>BR,System.String</value>
          <value>brdt,System.DateTime</value>
          <value>S_Ord,System.String</value>
          <value>Ordno,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="2">
          <value>_x0040_id,,3,0</value>
          <value>_x0040_Gbl_order_x0020_,,200,100</value>
        </Parameters>
        <SqlCommand>SELECT    Supp_Process_Bill_Dtl.BQty * Supp_Process_Bill_Dtl.BRate as SAmt, dbo.Supp_Process_Bill_Dtl.Descr, dbo.Supp_Process_Bill_Dtl.BQty, dbo.Supp_Process_Bill_Dtl.BRate, dbo.Supp_Process_Bill_Dtl.Ex_Rate, 
	dbo.Supp_Process_Bill_Dtl.DescrID, dbo.Supp_Process_Bill_Dtl.ID, dbo.Mas_Exporter.ExporterName, dbo.Mas_Party.Pname, dbo.Mas_Dept.Deptname, 
	dbo.SuppOrdMas.OrdId, dbo.Supp_Process_Bill.billamt, dbo.Supp_Process_Bill.BillType, dbo.Supp_Process_Bill.billno, dbo.Supp_Process_Bill.BillPassDt, 
	dbo.Supp_Process_Bill.billdt, dbo.Supp_Process_Bill_Dtl.BRate + dbo.Supp_Process_Bill_Dtl.Ex_Rate * dbo.Supp_Process_Bill_Dtl.BQty AS Amt, 
	dbo.Supp_Process_Plan.PCSRate, RTRIM(dbo.Supp_Process_Bill.brno) + '/' + dbo.Supp_Process_Bill.finyear AS BR, dbo.Supp_Process_Bill.brdt, 
	RTRIM(dbo.SuppOrdMas.SuppNo) + '/' + dbo.SuppOrdMas.SuppFyr + ' -&gt; ' + dbo.SuppOrdMas.StyleNo AS S_Ord, RTRIM(dbo.OrderMas.Jobno) 
	+ '/' + dbo.OrderMas.Finyear + '-&gt;' + dbo.OrderMas.BuyOrdNo AS Ordno
	FROM         dbo.Mas_Dept INNER JOIN
	dbo.Supp_Process_Bill INNER JOIN
                      dbo.Supp_Process_Bill_Dtl ON dbo.Supp_Process_Bill.ID = dbo.Supp_Process_Bill_Dtl.ID ON dbo.Mas_Dept.DeptID = dbo.Supp_Process_Bill.deptID INNER JOIN
                      dbo.Supp_Process_Plan ON dbo.Supp_Process_Bill_Dtl.DescrID = dbo.Supp_Process_Plan.ID AND 
                      dbo.Supp_Process_Bill_Dtl.S_OrdID = dbo.Supp_Process_Plan.S_OrdId INNER JOIN
                      dbo.Mas_Party ON dbo.Supp_Process_Bill.Pid = dbo.Mas_Party.PID INNER JOIN
                      dbo.Mas_Exporter INNER JOIN
                      dbo.SuppOrdMas ON dbo.Mas_Exporter.ExpID = dbo.SuppOrdMas.ExpID ON dbo.Supp_Process_Bill_Dtl.S_OrdID = dbo.SuppOrdMas.SuppOrdId INNER JOIN
                      dbo.OrderMas ON dbo.SuppOrdMas.OrdId = dbo.OrderMas.OrdId
where dbo.Supp_Process_Bill.ID =?</SqlCommand>
      </DataSource1>
      <DataSource2 Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource2</Alias>
        <Columns isList="true" count="12">
          <value>AddDedName,System.String</value>
          <value>AddDedCode,System.Int32</value>
          <value>ValType,System.String</value>
          <value>ValTypeValue,System.Decimal</value>
          <value>CalcMethod,System.String</value>
          <value>Formula1,System.String</value>
          <value>AddSub,System.String</value>
          <value>indexcode,System.Int32</value>
          <value>formula2,System.String</value>
          <value>Valu,System.Decimal</value>
          <value>amt,System.Decimal</value>
          <value>ID,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource2</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_id,,3,0</value>
        </Parameters>
        <SqlCommand>SELECT dbo.Mas_AddDed.AddDedName, dbo.Mas_AddDed.AddDedCode,
	dbo.Mas_AddDed.ValType, dbo.Mas_AddDed.ValTypeValue,
	dbo.Mas_AddDed.CalcMethod, dbo.Mas_AddDed.Formula1, dbo.Mas_AddDed.AddSub,
	dbo.Mas_AddDed.indexcode, dbo.Mas_AddDed.formula2,
	dbo.Supp_process_BillDed.Valu, dbo.Supp_process_BillDed.amt,
	dbo.Supp_process_BillDed.ID
	FROM dbo.Mas_Fgrp INNER JOIN
	dbo.Mas_AddDed ON dbo.Mas_Fgrp.Grp_Code = dbo.Mas_AddDed.Grp INNER JOIN
  dbo.Supp_process_BillDed ON dbo.Mas_AddDed.AddDedCode =
    dbo.Supp_process_BillDed.AdddedCode
WHERE dbo.Supp_process_BillDed.ID =? AND dbo.Mas_Fgrp.Grp_Name = 'PRIN'
ORDER BY dbo.Mas_AddDed.indexcode, dbo.Mas_AddDed.AddDedCode DESC</SqlCommand>
      </DataSource2>
    </DataSources>
