    <DataSources isList="true" count="4">
      <DyeingsubReport Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DyeingsubReport</Alias>
        <Columns isList="true" count="5">
          <value>ID,System.Int32</value>
          <value>ColorDesc,System.String</value>
          <value>LotNo,System.String</value>
          <value>ConfirmedRate,System.Decimal</value>
          <value>BudjetRate,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DyeingsubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT DISTINCT 
	TOP 100 PERCENT Trs_Del3.ID, Mas_Color.ColorDesc, Trs_Del3.LotNo, min(dbo.BudPodet.Rate) AS ConfirmedRate, min(dbo.Pro_ReqKnitt2.Rate 
                      + ISNULL(dbo.Pro_ReqKnitt2.AddRate, 0)) AS BudjetRate
FROM         dbo.BudPodet INNER JOIN
                      dbo.BudPoMas ON dbo.BudPodet.Id = dbo.BudPoMas.Id RIGHT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color RIGHT OUTER JOIN
                      dbo.Trs_Del3 AS Trs_Del3 INNER JOIN
                      dbo.Trs_Del1 ON Trs_Del3.ID = dbo.Trs_Del1.ID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Pro_ReqKnitt2 ON Trs_Del3.DiaID = dbo.Pro_ReqKnitt2.DiaID AND Trs_Del3.LL = dbo.Pro_ReqKnitt2.LL AND 
                      Trs_Del3.GG = dbo.Pro_ReqKnitt2.GG AND Trs_Del3.Gsm = dbo.Pro_ReqKnitt2.GSM AND Trs_Del3.Cnt = dbo.Pro_ReqKnitt2.CntID AND 
                      Trs_Del3.Clr = dbo.Pro_ReqKnitt2.ColId AND Trs_Del3.FabType = dbo.Pro_ReqKnitt2.FabId AND 
                      dbo.Trs_Del1.Prs_Dept = dbo.Pro_ReqKnitt2.DeptId AND Trs_Del3.OrdId = dbo.Pro_ReqKnitt2.OrdId ON Mas_Color.ColID = Trs_Del3.Clr ON 
                      dbo.BudPoMas.OrdId = Trs_Del3.OrdId AND dbo.BudPoMas.PartyId = dbo.Trs_Del1.Party AND dbo.BudPoMas.DeptId = dbo.Trs_Del1.Prs_Dept AND 
                      dbo.BudPodet.DiaId = Trs_Del3.DiaID AND dbo.BudPodet.LL = Trs_Del3.LL AND dbo.BudPodet.GG = Trs_Del3.GG AND 
                      dbo.BudPodet.GSM = Trs_Del3.Gsm AND dbo.BudPodet.FabId = Trs_Del3.FabType AND dbo.BudPodet.ColId = Trs_Del3.Clr AND 
                      dbo.BudPodet.CntId = Trs_Del3.Cnt
WHERE     (Trs_Del3.ID = ?) and (dbo.Mas_Dept.Deptname = 'DYEING') and    (dbo.Mas_Dept.ProgReqPrn = 'Y')
group by Trs_Del3.ID, Mas_Color.ColorDesc, Trs_Del3.LotNo</SqlCommand>
      </DyeingsubReport>
      <FabDC Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabDC</Alias>
        <Columns isList="true" count="53">
          <value>ID,System.Int32</value>
          <value>RollNo,System.Int32</value>
          <value>DcNo,System.String</value>
          <value>Dt,System.DateTime</value>
          <value>TrType,System.Int32</value>
          <value>Prs_Dept,System.Int32</value>
          <value>delwgt,System.Decimal</value>
          <value>OrderNo,System.String</value>
          <value>StyleNo,System.String</value>
          <value>Deptname,System.String</value>
          <value>OutputType,System.String</value>
          <value>BgRl,System.Int32</value>
          <value>Kg,System.Decimal</value>
          <value>mtr,System.Decimal</value>
          <value>Pname,System.String</value>
          <value>Paddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>ExporterName,System.String</value>
          <value>dcformat,System.String</value>
          <value>BuyerName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>ExpPhone,System.String</value>
          <value>ExpTIN,System.String</value>
          <value>ExpCST,System.String</value>
          <value>PartyDCref,System.String</value>
          <value>CntID,System.Int32</value>
          <value>ColID,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>ll,System.String</value>
          <value>DcPre,System.String</value>
          <value>Fabdesc,System.String</value>
          <value>Dia,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>remark,System.String</value>
          <value>ProcessType,System.String</value>
          <value>LotNo,System.String</value>
          <value>StkLotno,System.String</value>
          <value>UOM,System.String</value>
          <value>ITEMDESC,System.String</value>
          <value>Heading,System.String</value>
          <value>VName,System.String</value>
          <value>Terms,System.String</value>
          <value>GrpHeader,System.String</value>
          <value>Gpno,System.Int32</value>
          <value>ProgReqPrn,System.String</value>
          <value>GatePassFlg,System.String</value>
          <value>DesignDesc,System.String</value>
          <value>TarDt,System.DateTime</value>
          <value>UserName,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Trs_Del1.ID, RollNo,CASE WHEN len(rtrim(dcpre)) &lt; 1 THEN RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear ELSE rtrim(dcpre) 
                      + '-' + RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear END AS DcNo, Trs_Del1.Dt, Trs_Del1.TrType, Trs_Del1.Prs_Dept, 
                      Trs_Del1.delwgt, 
                      CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar))
                       + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, OrderMas2.StyleNo, Mas_Dept.Deptname, Mas_Dept.OutputType, 
                      1 as BgRl, isnull(RollKgs,0) as Kg, IsNUll(RollMtrs,0) as mtr, Case When Trs_Del1.PartyUnit = 'P' Then Mas_Party.Pname Else Mas_Unit.ExporterName End as Pname,  Case When Trs_Del1.PartyUnit = 'P' Then Mas_Party.Paddress Else Mas_Unit.ExporterAddress End as Paddress, Case When Trs_Del1.PartyUnit = 'P' Then Mas_Party.Phone Else Mas_Unit.Phone End as Phone, Case When Trs_Del1.PartyUnit = 'P' Then Mas_Party.TIN Else Mas_Unit.TIN End as TIN, Case When Trs_Del1.PartyUnit = 'P' Then Mas_Party.CST Else Mas_Unit.CST End as CST, 
                      Mas_Exporter.ExporterName, Mas_Dept.dcformat, Mas_Buyer.BuyerName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN, 
                      Mas_Exporter.CST AS ExpCST, Trs_Grn1.PartyDCref, StockTable.CntID, StockTable.ColID, StockTable.Gsm, StockTable.GG, StockTable.ll, 
                      Mas_Grp.DcPre, Mas_Fabric.Fabdesc, Mas_Dia.Dia, Mas_Color.ColorDesc, Mas_Count.CountName, Trs_Del1.remark, Trs_Del1.ProcessType, Trs_Del1.LotNo, StockTable.LotNo as StkLotno, 
                      CASE WHEN TRS_DEL2.MTR &gt; 0 THEN Mas_Uom.Uom ELSE '' END AS UOM, 
                      CASE WHEN StockTable.ColID &gt; 0 THEN FABDESC + '/' + COUNTNAME + '/' + COLORDESC ELSE FABDESC + '/' + COUNTNAME END AS ITEMDESC, 
                      'PACKING LIST' as
                       Heading, Mas_Vehicle.VName, Mas_Terms.Terms, 
                      GrpHeader = CASE WHEN StockTable.ColID &gt; 0 THEN fabdesc + Countname + COLORDESC + RTRIM(CAST(StockTable.ColID AS varchar)) 
                      + RTRIM(CAST(StockTable.Gsm AS varchar)) + RTRIM(CAST(StockTable.GG AS varchar)) + RTRIM(CAST(StockTable.ll AS varchar)) 
                      + RTRIM(CAST(Mas_Dia.Dia AS varchar)) ELSE fabdesc + Countname + RTRIM(CAST(StockTable.ColID AS varchar)) 
                      + RTRIM(CAST(StockTable.Gsm AS varchar)) + RTRIM(CAST(StockTable.GG AS varchar)) + RTRIM(CAST(StockTable.ll AS varchar)) 
                      + RTRIM(CAST(Mas_Dia.Dia AS varchar)) END,Gpno, isnull(ProgReqPrn,'N') as ProgReqPrn,isnull(Options.GatePassFlg,'N') as GatePassFlg,
					  isnull(Mas_Design.DesignDesc,'') AS DesignDesc,TarDt, Mas_User.UserName
FROM         Trs_Del1 AS Trs_Del1 INNER JOIN
                      Mas_Dept AS Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID INNER JOIN
                      Trs_Del2 AS Trs_Del2 ON Trs_Del1.ID = Trs_Del2.ID LEFT OUTER JOIN
                      Mas_Party AS Mas_Party ON Trs_Del1.Party = Mas_Party.PID INNER JOIN
                      Mas_Exporter AS Mas_Exporter ON Trs_Del1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      OrderMas AS OrderMas ON Trs_Del2.OrdID = OrderMas.OrdId 
INNER JOIN OrderMas2 ON OrderMas2.Ordid = OrderMas.Ordid 
LEFT OUTER JOIN
                      Trs_Grn1 AS Trs_Grn1 ON Trs_Del1.OurGRNID = Trs_Grn1.ID INNER JOIN
                      StockTable AS StockTable ON Trs_Del2.StockID = StockTable.StockID LEFT OUTER JOIN
                      Mas_Grp AS Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo LEFT OUTER JOIN
                      Mas_Buyer ON OrderMas.BuyerID = Mas_Buyer.BuyerID INNER JOIN
                      Mas_Dia AS Mas_Dia ON StockTable.DiaID = Mas_Dia.DiaID INNER JOIN
                      Mas_Fabric AS Mas_Fabric ON StockTable.FabID = Mas_Fabric.FabID LEFT OUTER JOIN
                      Mas_Vehicle ON Trs_Del1.VehicleCode = Mas_Vehicle.Code LEFT OUTER JOIN
                      Mas_Count AS Mas_Count ON StockTable.CntID = Mas_Count.CountID LEFT OUTER JOIN
                      Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN
					  Mas_Design AS Mas_Design ON Trs_Del1.DesignID = Mas_Design.DesignID LEFT OUTER JOIN
                      Mas_Uom AS Mas_Uom ON Mas_Fabric.priUomID = Mas_Uom.UomID LEFT OUTER JOIN

                      Mas_Terms AS Mas_Terms ON Mas_Dept.DC_TermCode = Mas_Terms.Id  LEFT OUTER JOIN
                      Mas_Exporter AS Mas_Unit ON Trs_Del1.Party = Mas_Unit.ExpID 
LEFT OUTER JOIN Trs_RollNo_Delivery ON Trs_Del1.ID = Trs_RollNo_Delivery.Id ANd  StockTable.StockID = Trs_RollNo_Delivery.StockId
 LEFT OUTER JOIN Mas_User On Trs_Del1.PreparedBy = Mas_User.UserCode 

cross join options 
where trs_del1.id=?
ORDER BY Trs_RollNo_Delivery.Slno,Trs_RollNo_Delivery.RollNo,FABDESC + '/' + COUNTNAME + '/' + COLORDESC, StockTable.GSM, StockTable.GG, StockTable.LL, Mas_Dia.DIA</SqlCommand>
      </FabDC>
      <FabricSubReport Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabricSubReport</Alias>
        <Columns isList="true" count="11">
          <value>Clr,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>LL,System.String</value>
          <value>Prog,System.Decimal</value>
          <value>ProgMtr,System.Decimal</value>
          <value>Dia,System.String</value>
          <value>ItemDesc,System.String</value>
          <value>UOM,System.String</value>
          <value>GrpHeader,System.String</value>
          <value>Dcrate,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabricSubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     TOP 100 PERCENT Trs_Del3.Clr, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, SUM(Trs_Del3.Prog) AS Prog, SUM(Trs_Del3.ProgMtr) AS ProgMtr, 
                      Mas_Dia.Dia, 
                      CASE WHEN Trs_del3.clr &gt; 0 THEN Mas_Fabric.Fabdesc + '/' + CountName + '/' + Colordesc ELSE Mas_Fabric.Fabdesc + '/' + CountName END AS ItemDesc,
                       CASE WHEN SUM(ProgMtr) &gt; 0 THEN Mas_Uom.Uom ELSE '' END AS UOM, 
                      CASE WHEN Trs_del3.clr &gt; 0 THEN Mas_Fabric.Fabdesc + CountName + Colordesc + RTRIM(CAST(trs_del3.Gsm AS varchar)) 
                      + RTRIM(CAST(trs_del3.GG AS varchar)) + RTRIM(CAST(trs_del3.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) 
                      ELSE Mas_Fabric.Fabdesc + CountName + RTRIM(CAST(trs_del3.Gsm AS varchar)) + RTRIM(CAST(trs_del3.GG AS varchar)) 
                      + RTRIM(CAST(trs_del3.ll AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) + RTRIM(CAST(Mas_Dia.Dia AS varchar)) END AS GrpHeader, 
                 CASE WHEN SUM(Jobno) &lt;&gt; 0 THEN      CASE WHEN SUM(isnull(BudPodet.Rate, 0)) &lt;&gt; 0 THEN SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_Del3.Prog) 
                      ELSE SUM(Trs_Del3.Prog * isnull(Pro_ReqKnitt2.rate, 0)) / SUM(Trs_Del3.Prog) END ELSE SUM(Trs_Del3.Prog * isnull(GeneralRate, 0)) / SUM(Trs_Del3.Prog) END AS Dcrate
FROM         dbo.BudPodet INNER JOIN
                      dbo.BudPoMas ON dbo.BudPodet.Id = dbo.BudPoMas.Id RIGHT OUTER JOIN
                      dbo.Trs_Del3 AS Trs_Del3 INNER JOIN
                      dbo.Mas_Fabric AS Mas_Fabric ON Trs_Del3.FabType = Mas_Fabric.FabID INNER JOIN
                      dbo.Mas_Dia AS Mas_Dia ON Trs_Del3.DiaID = Mas_Dia.DiaID INNER JOIN
                      dbo.Trs_Del1 ON Trs_Del3.ID = dbo.Trs_Del1.ID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID ON dbo.BudPodet.DiaId = Trs_Del3.DiaID AND dbo.BudPodet.LL = Trs_Del3.LL AND 
                      dbo.BudPodet.GG = Trs_Del3.GG AND dbo.BudPodet.GSM = Trs_Del3.Gsm AND dbo.BudPodet.FabId = Trs_Del3.FabType AND 
                      dbo.BudPodet.ColId = Trs_Del3.Clr AND dbo.BudPodet.CntId = Trs_Del3.Cnt AND dbo.BudPoMas.OrdId = Trs_Del3.OrdId AND 
                      dbo.BudPoMas.DeptId = dbo.Trs_Del1.Prs_Dept AND dbo.BudPoMas.PartyId = dbo.Trs_Del1.Party LEFT OUTER JOIN
                      dbo.Pro_ReqKnitt2 ON Trs_Del3.Clr = dbo.Pro_ReqKnitt2.ColId AND Trs_Del3.DiaID = dbo.Pro_ReqKnitt2.DiaID AND 
                      Trs_Del3.LL = dbo.Pro_ReqKnitt2.LL AND Trs_Del3.GG = dbo.Pro_ReqKnitt2.GG AND Trs_Del3.Gsm = dbo.Pro_ReqKnitt2.GSM AND 
                      Trs_Del3.FabType = dbo.Pro_ReqKnitt2.FabId AND Trs_Del3.OrdId = dbo.Pro_ReqKnitt2.OrdId AND 
                      dbo.Trs_Del1.Prs_Dept = dbo.Pro_ReqKnitt2.DeptId LEFT OUTER JOIN
                      dbo.Mas_Count AS Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID LEFT OUTER JOIN
                      dbo.Mas_Uom AS Mas_Uom ON Mas_Fabric.SecUomID = Mas_Uom.UomID left outer join ordermas on ordermas.ordid=trs_del3.ordid
WHERE     (dbo.Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.FabType &gt; 0) AND (dbo.Mas_Dept.Deptname &lt;&gt; 'DYEING') AND (Trs_Del3.ID = ?)
GROUP BY Trs_Del3.Clr, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, Mas_Dia.Dia, Mas_Fabric.Fabdesc, Mas_Count.CountName, Mas_Color.ColorDesc, 
                      Mas_Uom.Uom
ORDER BY Mas_Fabric.Fabdesc + '/' + Mas_Count.CountName + '/' + Mas_Color.ColorDesc, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, Mas_Dia.Dia
</SqlCommand>
      </FabricSubReport>
      <YarnSubReportDataSource Ref="6" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>YarnSubReportDataSource</Alias>
        <Columns isList="true" count="4">
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>Prog,System.Decimal</value>
          <value>Dcrate,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnSubReportDataSource</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Mas_Color.ColorDesc, Mas_Count.CountName, SUM(Trs_Del3.Prog) AS Prog,
	CASE WHEN SUM(jobno) &lt;&gt; 0 THEN	CASE WHEN SUM(isnull(BudPodet.Rate, 0)) &lt;&gt; 0 THEN SUM(Trs_Del3.Prog * BudPoDet.rate) / SUM(Trs_Del3.Prog) 
                      ELSE SUM(Trs_Del3.Prog * isnull(Pro_ReqYarn2.rate, 0)) / SUM(Trs_Del3.Prog) END   ELSE SUM(Trs_Del3.Prog * isnull(GeneralRate, 0)) / SUM(Trs_Del3.Prog) END AS Dcrate
	FROM        dbo.Pro_ReqYarn2 RIGHT OUTER JOIN
                      dbo.Trs_Del3 AS Trs_Del3 INNER JOIN
                      dbo.Trs_Del1 ON Trs_Del3.ID = dbo.Trs_Del1.ID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID ON dbo.Pro_ReqYarn2.DeptId = dbo.Trs_Del1.Prs_Dept AND 
                      dbo.Pro_ReqYarn2.OrdId = Trs_Del3.OrdId AND dbo.Pro_ReqYarn2.CountId = Trs_Del3.Cnt AND 
                      dbo.Pro_ReqYarn2.ColId = Trs_Del3.Clr LEFT OUTER JOIN
                      dbo.BudPodet INNER JOIN
                      dbo.BudPoMas ON dbo.BudPodet.Id = dbo.BudPoMas.Id ON Trs_Del3.Clr = dbo.BudPodet.ColId AND Trs_Del3.Cnt = dbo.BudPodet.CntId AND 
                      Trs_Del3.OrdId = dbo.BudPoMas.OrdId AND dbo.Trs_Del1.Party = dbo.BudPoMas.PartyId AND dbo.Trs_Del1.Prs_Dept = dbo.BudPoMas.DeptId AND 
                      dbo.Trs_Del1.ID = dbo.BudPoMas.Id LEFT OUTER JOIN
                      dbo.Mas_Count AS Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID Left Outer Join ordermas on ordermas.ordid=trs_del3.Ordid
WHERE     (dbo.Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.FabType = 0) and trs_del3.id=?
GROUP BY  Mas_Count.CountName,Mas_Color.ColorDesc</SqlCommand>
      </YarnSubReportDataSource>
    </DataSources>
