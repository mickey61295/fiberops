      </Connection>
    </Databases>
    <DataSources isList="true" count="1">
      <AccGRN Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>AccGRN</Alias>
        <Columns isList="true" count="38">
          <value>GRNNo,System.String</value>
          <value>dt,System.DateTime</value>
          <value>PartyDCref,System.String</value>
          <value>PartyDcDate,System.DateTime</value>
          <value>GRNType,System.String</value>
          <value>remark,System.String</value>
          <value>grnwgt,System.Decimal</value>
          <value>Buyer,System.Int32</value>
          <value>RecKgs,System.Decimal</value>
          <value>OrderNo,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>ExpPhone,System.String</value>
          <value>ExpTIN,System.String</value>
          <value>ExpCST,System.String</value>
          <value>Deptname,System.String</value>
          <value>GRNPre,System.String</value>
          <value>BuyerName,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>SizeDesc,System.String</value>
          <value>SNo,System.Int32</value>
          <value>Acc_Descr,System.String</value>
          <value>AccDescription,System.String</value>
          <value>Uom,System.String</value>
          <value>RefNo,System.String</value>
          <value>Pname,System.String</value>
          <value>Padd,System.String</value>
          <value>PPhone,System.String</value>
          <value>LblTIN,System.String</value>
          <value>LblCST,System.String</value>
          <value>GRNFormat,System.String</value>
          <value>Heading,System.String</value>
          <value>ItemDesc,System.String</value>
          <value>UserName,System.String</value>
          <value>ProcessType,System.String</value>
          <value>GatePass_SNo,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>AccGRN</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT CASE
    WHEN len(rtrim(Mas_Grp.grnpre)) &lt; 1 or isnull(len(rtrim(Mas_Grp.grnpre)),'')=''  THEN RTRIM(CAST(Trs_Grn1.DocNo
    AS VARCHAR)) + '/' + Trs_Grn1.Finyear
    ELSE rtrim(Mas_Grp.grnpre) + '-' + RTRIM(CAST(Trs_Grn1.DocNo AS VARCHAR)) +
    '/' + Trs_Grn1.Finyear
  END AS GRNNo, Trs_Grn1.dt, Trs_Grn1.PartyDCref, Trs_Grn1.PartyDcDate,
  Trs_Grn1.GRNType, Trs_Grn1.remark, Trs_Grn1.grnwgt, Trs_Grn1.Buyer,
  Trs_GRN2.RecKgs, CASE WHEN OrderMas.jobno = 0 THEN '&lt;General&gt;'
    ELSE RTRIM(CAST(OrderMas.Jobno AS VARCHAR)) + '/' + OrderMas.Finyear +
    '-&gt;' + OrderMas.BuyOrdNo
  END AS OrderNo, Mas_Party.TIN, Mas_Party.CST,
  Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress,
  Mas_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN,
  Mas_Exporter.CST AS ExpCST, Mas_Dept.Deptname, Mas_Grp.GRNPre,
  Mas_Buyer.BuyerName, Mas_Color.ColorDesc, Mas_Size.SizeDesc, OrdSizeMas.SNo,
  Mas_Acc.Acc_Descr, Mas_AccDes.AccDescription, Mas_Uom.Uom, RefNo = CASE
    WHEN Trs_Grn1.PoID &gt; 0 THEN rtrim(CAST(Trs_Po1.DocNo AS VARCHAR)) + '/' +
    Trs_Po1.Finyear
    ELSE rtrim(CAST(Trs_Del1.DocNo AS VARCHAR)) + '/' + Trs_Del1.Finyear
  END, Pname = CASE WHEN isnull(Trs_Grn1.buyer, 0) &gt; 0 THEN Mas_Buyer_1.BuyerName
    ELSE Mas_Party.Pname END, Padd = CASE
    WHEN isnull(Trs_Grn1.buyer, 0) &gt; 0 THEN Mas_Buyer_1.BuyerAddress
    ELSE Mas_Party.Paddress END, PPhone = CASE
    WHEN isnull(Trs_Grn1.buyer, 0) &gt; 0 THEN Mas_Buyer_1.Phone ELSE Mas_Party.Phone
  END, LblTIN = CASE WHEN isnull(Trs_Grn1.buyer, 0) &gt; 0 THEN '' ELSE 'TIN:'
  END, LblCST = CASE WHEN isnull(Trs_Grn1.buyer, 0) &gt; 0 THEN '' ELSE 'CST:'
  END, CASE Trs_Grn1.Grntype WHEN 'Acc.Purch' THEN Mas_Dept.PurGrnFormat
    WHEN 'Acc.Proc.Receipt' THEN Mas_Dept.GRNFormat
  END AS GRNFormat, CASE Trs_Grn1.grntype
    WHEN 'Acc.Purch' THEN 'GOODS RECEIVED NOTE'
    WHEN 'Acc.Direct' THEN 'DIRECT GOODS RECEIVED NOTE'
    WHEN 'Acc.Iss.Ret' THEN 'ISSUE RETURN'
    WHEN 'Acc.Proc.Receipt'then case Trs_Del1.ProcessType when'P' THEN 'PROCESS GOODS RECEIPT NOTE' else 'REPROCESS GOODS RECEIPT NOTE'End
    WHEN 'Acc.Proc.Return' THEN 'PROCESS RETURN' 
 END as Heading , ItemDesc = CASE
    WHEN isnull(Mas_AccDes.AccDescription, '') = '' THEN Mas_Acc.Acc_Descr
    ELSE Mas_Acc.Acc_Descr + '(' + Mas_AccDes.AccDescription + ')'
  END, Mas_User.UserName,  Trs_Del1.ProcessType, CASE WHEN GrnType = 'Acc.Proc.Receipt' THEN ISNULL(GatePass_SNo,'') ELSE '' END AS GatePass_SNo
FROM dbo.Trs_Grn1 Trs_Grn1 INNER JOIN
  dbo.Trs_GRN2 Trs_GRN2 ON Trs_Grn1.ID = Trs_GRN2.ID INNER JOIN
  dbo.OrderMas OrderMas ON Trs_GRN2.OrdID = OrderMas.OrdId INNER JOIN
  dbo.Mas_Exporter Mas_Exporter ON Trs_Grn1.Coycode = Mas_Exporter.ExpID
  INNER JOIN
  dbo.Mas_Dept Mas_Dept ON Trs_Grn1.Dept = Mas_Dept.DeptID LEFT OUTER JOIN
  dbo.Trs_Del1 Trs_Del1 ON Trs_Grn1.DCID = Trs_Del1.ID LEFT OUTER JOIN
  dbo.Trs_Po1 Trs_Po1 ON Trs_Grn1.PoID = Trs_Po1.ID LEFT OUTER JOIN
  dbo.Mas_Buyer Mas_Buyer ON OrderMas.BuyerID = Mas_Buyer.BuyerID
  LEFT OUTER JOIN
  dbo.Mas_Party Mas_Party ON Trs_Grn1.SuppID = Mas_Party.PID INNER JOIN
  dbo.StockTable StockTable ON Trs_GRN2.StockID = StockTable.StockID
  LEFT OUTER JOIN
  dbo.Mas_Grp Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo LEFT OUTER JOIN
  dbo.Mas_Size Mas_Size ON StockTable.Siz = Mas_Size.SizeID LEFT OUTER JOIN
  dbo.OrdSizeMas OrdSizeMas ON StockTable.OrdID = OrdSizeMas.OrdID AND
    StockTable.Siz = OrdSizeMas.SizeID 
	and OrdSizeMas.StyleNo=Trs_GRN2.StyleNo
	LEFT OUTER JOIN
  dbo.Mas_Acc Mas_Acc ON StockTable.Atype = Mas_Acc.ID LEFT OUTER JOIN
  dbo.Mas_AccDes Mas_AccDes ON StockTable.Ades = Mas_AccDes.ID LEFT OUTER JOIN
  dbo.Mas_Color Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN
  Mas_User ON Trs_Grn1.PreparedBy = Mas_User.UserCode LEFT OUTER JOIN
  dbo.Mas_Uom Mas_Uom ON Mas_Acc.UomId = Mas_Uom.UomID
 LEFT OUTER JOIN
  dbo.Mas_Buyer Mas_Buyer_1 ON Trs_Grn1.Buyer = Mas_Buyer_1.BuyerID
WHERE Trs_Grn1.id = ?
ORDER BY Mas_Acc.Acc_Descr</SqlCommand>
      </AccGRN>
    </DataSources>
