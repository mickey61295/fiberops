    <DataSources isList="true" count="1">
      <GenGRN Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>GenGRN</Alias>
        <Columns isList="true" count="23">
          <value>GrnNo,System.String</value>
          <value>GRNdt,System.DateTime</value>
          <value>Cat,System.Byte</value>
          <value>Orderref,System.String</value>
          <value>PartyDcref,System.String</value>
          <value>Remark,System.String</value>
          <value>DcNo,System.String</value>
          <value>Itemdes,System.String</value>
          <value>RecdQty,System.Decimal</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>Pname,System.String</value>
          <value>Paddress,System.String</value>
          <value>PartyPhone,System.String</value>
          <value>PartyTIN,System.String</value>
          <value>PartyCst,System.String</value>
          <value>Uom,System.String</value>
          <value>HEADING,System.String</value>
          <value>UserName,System.String</value>
          <value>GatePass_SNo,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>GenGRN</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>
SELECT     RTRIM(CAST(Trs_GenGrn1.GrnNo AS varchar)) + '/' + Trs_GenGrn1.Finyear AS GrnNo, Trs_GenGrn1.GRNdt, Trs_GenGrn1.Cat, Trs_GenGrn1.Orderref, 
                      Trs_GenGrn1.PartyDcref, Trs_GenGrn1.Remark, RTRIM(CAST(Trs_Gen1.Dcno AS varchar)) + '/' + Trs_Gen1.Finyear AS DcNo, Trs_Gengrn2.Itemdes, 
                      Trs_Gengrn2.RecdQty, Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone, Mas_Exporter.TIN, Mas_Exporter.CST, 
                      Mas_Party.Pname, Mas_Party.Paddress, Mas_Party.Phone AS PartyPhone, Mas_Party.TIN AS PartyTIN, Mas_Party.CST AS PartyCst, Mas_Uom.Uom, 
                      HEADING = CASE cat WHEN 1 THEN 'GENERAL RECEIPT - DELIVERED GOODS' WHEN 2 THEN 'GENERAL RECEIPT - DIRECT GOODS' ELSE 'GENERAL RECEIPT - RETURNABLE GOODS' END, Mas_User.UserName, ISNULL(GatePass_SNo,'') As GatePass_SNo
FROM         dbo.Trs_GenGrn1 Trs_GenGrn1 INNER JOIN
                      dbo.Trs_Gengrn2 Trs_Gengrn2 ON Trs_GenGrn1.ID = Trs_Gengrn2.ID INNER JOIN
                      dbo.Mas_Exporter Mas_Exporter ON Trs_GenGrn1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.Mas_Party Mas_Party ON Trs_GenGrn1.PartyID = Mas_Party.PID LEFT OUTER JOIN
                      dbo.Trs_Gen1 Trs_Gen1 ON Trs_GenGrn1.OurDCref = Trs_Gen1.ID LEFT OUTER JOIN
                      dbo.Mas_Uom Mas_Uom ON Trs_Gengrn2.UomId = Mas_Uom.UomID  LEFT OUTER JOIN Mas_User On Trs_GenGrn1.PreparedBy = Mas_User.UserCode  
where Trs_GenGrn1.Id=?
order by Trs_Gengrn2.slno</SqlCommand>
      </GenGRN>
    </DataSources>
