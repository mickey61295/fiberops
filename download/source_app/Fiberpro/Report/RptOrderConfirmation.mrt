    <DataSources isList="true" count="1">
      <DataSource1 Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="25">
          <value>OrdNo,System.String</value>
          <value>Dt,System.DateTime</value>
          <value>OrdNo1,System.Int32</value>
          <value>Mill,System.String</value>
          <value>Pname,System.String</value>
          <value>Paddress,System.String</value>
          <value>CST,System.String</value>
          <value>TIN,System.String</value>
          <value>Delivery,System.String</value>
          <value>CountName,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>Terms,System.String</value>
          <value>Qty,System.Decimal</value>
          <value>Rate,System.Decimal</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Phone,System.String</value>
          <value>EMailid,System.String</value>
          <value>RateFor,System.String</value>
          <value>Amount,System.Decimal</value>
          <value>Description,System.String</value>
          <value>PartyOrdRef,System.String</value>
          <value>GSTNo,System.String</value>
          <value>Remarks,System.String</value>
          <value>MillAddress,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DataSource1</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_ID,,3,0</value>
        </Parameters>
        <SqlCommand>Select Mas_Exporter.ExporterName,Mas_Exporter.ExporterAddress,Mas_Exporter.Phone,Mas_Exporter.EMailid, Rtrim(OrdNo)+'/'+Finyear OrdNo,Dt,
 OrdNo,Mill.PName as Mill,Mas_Party.Pname,Mas_Party.Paddress,Mas_Party.CST,Mas_Party.TIN,Delivery,CountName,ColorDesc,Terms,Case When  RateFor='B'  Then   Trs_TradeOrdConFirmationDet.NoofBags Else  Trs_TradeOrdConFirmationDet.Qty End as Qty,Trs_TradeOrdConFirmationDet.Rate ,RateFor,Case When RateFor='B' Then Trs_TradeOrdConFirmationDet.NoofBags*Trs_TradeOrdConFirmationDet.Rate 
Else Trs_TradeOrdConFirmationDet.Qty*Trs_TradeOrdConFirmationDet.Rate End as Amount,IsNull(Trs_TradeOrdConFirmationDet.description,'') as Description,Trs_TradeOrdConFirmationMas.PartyOrdRef
,ISNULL(Mas_Party.GSTNo,'') as GSTNo,IsNull(Trs_TradeOrdConFirmationMas.Remarks,'') as Remarks,Mill.Paddress as MillAddress
From Trs_TradeOrdConFirmationMas INNER JOIN  Trs_TradeOrdConFirmationDet ON  Trs_TradeOrdConFirmationMas.Id = Trs_TradeOrdConFirmationDet.Id 
INNER JOIN Mas_Party as  Mill on Mill.PId = Trs_TradeOrdConFirmationMas.MillID INNER JOIN  Mas_Party	 on Mas_Party.PID = Trs_TradeOrdConFirmationMas.PartyID 
INNER JOIN  Mas_Count on Mas_Count.CountID = Trs_TradeOrdConFirmationDet.CountID LEFT OUTER JOIN  Mas_Color on Mas_Color.ColID = Trs_TradeOrdConFirmationDet.ColorID 
INNER JOIN  Mas_Exporter on Mas_Exporter.ExpID = Trs_TradeOrdConFirmationMas.Coycode Where Trs_TradeOrdConFirmationMas.ID = ?</SqlCommand>
      </DataSource1>
    </DataSources>
