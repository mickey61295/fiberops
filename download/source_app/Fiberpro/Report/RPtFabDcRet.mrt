          <value>Rls,System.Int32</value>
          <value>Kg,System.Decimal</value>
          <value>Mtr,System.Decimal</value>
          <value>OrderNo,System.String</value>
          <value>ITEMDESC,System.String</value>
          <value>DelType,System.String</value>
          <value>dt,System.DateTime</value>
          <value>docno,System.Int32</value>
          <value>finyear,System.String</value>
          <value>Delto,System.String</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>DesignDesc,System.String</value>
          <value>remark,System.String</value>
          <value>Party,System.String</value>
          <value>PAddress,System.String</value>
          <value>PTIN,System.String</value>
          <value>ExporterName1,System.String</value>
          <value>ExporterAddress1,System.String</value>
          <value>Phone1,System.String</value>
          <value>TIN1,System.String</value>
          <value>CST1,System.String</value>
          <value>PartyName,System.String</value>
          <value>PartyAddress,System.String</value>
          <value>PPhone,System.String</value>
          <value>PCST,System.String</value>
          <value>PartyPhone,System.String</value>
          <value>PartyTIN,System.String</value>
          <value>PartyCST,System.String</value>
          <value>Party1,System.String</value>
          <value>PAddress1,System.String</value>
          <value>ExpName1,System.String</value>
          <value>ExpAdd1,System.String</value>
          <value>ExpPhone1,System.String</value>
          <value>ExpTIN1,System.String</value>
          <value>ExpCST1,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabRetDc</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="2">
          <value>_x0040_id,,5,0</value>
          <value>_x0040_coycode,,5,0</value>
        </Parameters>
        <SqlCommand>
SELECT dbo.Mas_Fabric.Fabdesc, dbo.Mas_Color.ColorDesc, dbo.Mas_Count.CountName,
	dbo.StockTable.Gsm, dbo.StockTable.ll, dbo.StockTable.GG, dbo.Mas_Dia.Dia,dbo.stocktable.lotno,
	dbo.Mas_Uom.Uom, dbo.Trs_Del2.BgRl as Rls, dbo.Trs_del2.Kg,
	dbo.Trs_Del2.Mtr, CASE
    WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' +
    OrderMas.BuyOrdNo
    ELSE RTRIM(CAST(OrderMas.Jobno AS VARCHAR)) + '/' + OrderMas.Finyear +
    '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, CASE
    WHEN StockTable.ColID &gt; 0  THEN dbo.Mas_Fabric.FABDESC + '/' +
    dbo.Mas_Count.COUNTNAME + '/' + dbo.Mas_Color.COLORDESC+'/'+ isnull(dbo.Mas_Design.DesignDesc,'')+isnull(trs_del2.styleno,'')
    else dbo.Mas_Fabric.FABDESC + '/' + dbo.Mas_Count.COUNTNAME+'/'+ isnull(dbo.Mas_Design.DesignDesc,'')

  END AS ITEMDESC, dbo.Trs_Del1.DelType, dbo.Trs_Del1.dt,
  dbo.Trs_Del1.docno, Trs_Del1.finyear, CASE when trtype=-2 then case
    WHEN dbo.Trs_Del1.DelType = 'P' THEN 'Production' When dbo.Trs_Del1.DelType = 'S' THEN 'Issue to Sewing' ELSE  'Return To Lot'
  END 
else
unit.exportername end 
AS Delto, dbo.Mas_Exporter.ExporterName, dbo.Mas_Exporter.ExporterAddress,
  dbo.Mas_Exporter.Phone, dbo.Mas_Exporter.TIN, dbo.Mas_Exporter.CST,
  dbo.Mas_Design.DesignDesc  ,isnull(trs_del1.remark,'') as remark,IsNull(PName,'') As Party ,Mas_Party.PAddress,Mas_Party.Phone as PPhone,Mas_Party.TIN as PTIN,Mas_Party.CST as PCST
,Mas_Exporter1.ExporterName as ExpName1,Mas_Exporter1.ExporterAddress as ExpAdd1,Mas_Exporter1.Phone as ExpPhone1,Mas_Exporter1.TIN as ExpTIN1,Mas_Exporter1.CST as ExpCST1,

 CASE when trtype=-2 then
  case    WHEN dbo.Trs_Del1.DelType = 'P' THEN 
  case when isnull(Trs_Del1.Party,0)&lt;&gt;0 then  IsNull(PName,'') 
  else Mas_Exporter.ExporterName end  
   When dbo.Trs_Del1.DelType = 'S' THEN 
   case when isnull(Trs_Del1.Party,0)&lt;&gt;0 then  IsNull(PName,'') else 
   Mas_Exporter.ExporterName end  
      When dbo.Trs_Del1.DelType = 'R' THEN 
   case when isnull(Trs_Del1.Party,0)&lt;&gt;0 then  IsNull(PName,'') else 
   Mas_Exporter1.ExporterName end  END
   ELSE
    CASE when trtype=17 then  Mas_Exporter2.ExporterName  Else IsNull(PName,'')end end AS PartyName,IsNull(PName,'') As Party,
		

  CASE when trtype=-2 then case    WHEN dbo.Trs_Del1.DelType = 'P' THEN case when isnull(Trs_Del1.Party,0)&lt;&gt;0 then   Mas_Party.PAddress else  Mas_Exporter.ExporterAddress end  When dbo.Trs_Del1.DelType = 'S' THEN case when isnull(Trs_Del1.Party,0)&lt;&gt;0 then   Mas_Party.PAddress else  Mas_Exporter.ExporterAddress end  When dbo.Trs_Del1.DelType = 'R' THEN case when isnull(Trs_Del1.Party,0)&lt;&gt;0 then   Mas_Party.PAddress else  Mas_Exporter1.ExporterAddress end  END
    ELSE
    CASE when trtype=17 then  Mas_Exporter2.ExporterAddress  Else  Mas_Party.PAddress end end AS PartyAddress, Mas_Party.PAddress,


   CASE when trtype=-2 then case    WHEN dbo.Trs_Del1.DelType = 'P' THEN case when isnull(Trs_Del1.Party,0)&lt;&gt;0 then  Mas_Party.Phone else Mas_Exporter1.Phone end When dbo.Trs_Del1.DelType = 'S' THEN  case when isnull(Trs_Del1.Party,0)&lt;&gt;0 then  Mas_Party.Phone else Mas_Exporter.Phone end  
   
    When dbo.Trs_Del1.DelType = 'R' THEN case when isnull(Trs_Del1.Party,0)&lt;&gt;0 then   Mas_Party.Phone else  Mas_Exporter1.Phone end  END
    ELSE
    CASE when trtype=17 then  Mas_Exporter2.Phone  Else  Mas_Party.Phone end end AS PartyPhone, Mas_Party.Phone,

    

   CASE when trtype=-2 then case    WHEN dbo.Trs_Del1.DelType = 'P' THEN case  when isnull(Trs_Del1.Party,0)&lt;&gt;0 then  Mas_Party.TIN else Mas_Exporter.TIN end When dbo.Trs_Del1.DelType = 'S' THEN case  when isnull(Trs_Del1.Party,0)&lt;&gt;0 then  Mas_Party.TIN else Mas_Exporter1.TIN end  When dbo.Trs_Del1.DelType = 'R' THEN case when isnull(Trs_Del1.Party,0)&lt;&gt;0 then   Mas_Party.TIN else  Mas_Exporter1.TIN end  END
    ELSE
    CASE when trtype=17 then  Mas_Exporter2.TIN  Else  Mas_Party.TIN end end AS PartyTIN,Mas_Party.TIN,

      

   CASE when trtype=-2 then case    WHEN dbo.Trs_Del1.DelType = 'P' THEN case when isnull(Trs_Del1.Party,0)&lt;&gt;0 then Mas_Party.CST else Mas_Exporter.CST end   When dbo.Trs_Del1.DelType = 'S' THEN case when isnull(Trs_Del1.Party,0)&lt;&gt;0 then Mas_Party.CST else Mas_Exporter.CST end
   END     ELSE
    CASE when trtype=17 then  Mas_Exporter2.CST  Else  Mas_Party.CST end end AS PartyCST,Mas_Party.CST
	      	 				  
FROM dbo.StockTable INNER JOIN
  dbo.Mas_Fabric ON dbo.StockTable.FabID = dbo.Mas_Fabric.FabID INNER JOIN
  dbo.Mas_Count ON dbo.StockTable.CntID = dbo.Mas_Count.CountID INNER JOIN
  dbo.Mas_Dia ON dbo.StockTable.DiaID = dbo.Mas_Dia.DiaID INNER JOIN
  dbo.Mas_Uom ON dbo.Mas_Fabric.PriUomID = dbo.Mas_Uom.UomID INNER JOIN
  dbo.Trs_Del2 ON dbo.StockTable.StockID = dbo.Trs_Del2.StockId
inner JOIN
  dbo.Trs_Del1 ON dbo.Trs_Del2.Id = dbo.Trs_Del1.Id INNER JOIN
  dbo.OrderMas ON dbo.Trs_Del2.OrdId = dbo.OrderMas.OrdId INNER JOIN
  dbo.Mas_Color ON dbo.StockTable.ColID = dbo.Mas_Color.ColID INNER JOIN
  dbo.Mas_Exporter ON dbo.Trs_Del1.Coycode = dbo.Mas_Exporter.ExpID
LEFT JOIN dbo.Mas_Exporter Mas_Exporter1 ON OrderMas.ExpId = Mas_Exporter1.ExpID
left  JOIN
  dbo.Mas_Design ON dbo.StockTable.PRINT_DESIGNID = dbo.Mas_Design.DesignId
left outer  JOIN
  dbo.Mas_Exporter as unit  ON dbo.Trs_Del1.party = unit.ExpID
Left Join Mas_Party On Trs_Del1.Party=Mas_Party.PId
left join Mas_Exporter as Mas_Exporter2 on Mas_Exporter2.ExpID=Trs_Del1.Party
WHERE Trs_Del1.id = ? and stocktable.coycode=?


</SqlCommand>
      </FabRetDc>
    </DataSources>
