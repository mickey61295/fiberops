          <value>Paddress,System.String</value>
          <value>PPhone,System.String</value>
          <value>PTIN,System.String</value>
          <value>PCST,System.String</value>
          <value>Ppan,System.String</value>
          <value>PStateName,System.String</value>
          <value>PstateCode,System.String</value>
          <value>Pgstno,System.String</value>
