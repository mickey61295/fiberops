    <DataSources isList="true" count="3">
      <FabricsubReport Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabricsubReport</Alias>
        <Columns isList="true" count="15">
          <value>ID,System.Int32</value>
          <value>Clr,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>LL,System.String</value>
          <value>prog,System.Decimal</value>
          <value>progMtr,System.Decimal</value>
          <value>Dia,System.String</value>
          <value>FinDiaID,System.Int32</value>
          <value>ItemDesc,System.String</value>
          <value>Uom,System.String</value>
          <value>Dcrate,System.Decimal</value>
          <value>Ratelbl,System.String</value>
          <value>DesignDesc,System.String</value>
          <value>Head,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabricsubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id_x0020_,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Trs_Del3.ID, Trs_Del3.Clr, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, SUM(Trs_Del3.Prog) AS prog, SUM(Trs_Del3.ProgMtr) AS progMtr, Mas_Dia.Dia, Trs_Del3.FinDiaID,
	CASE WHEN Trs_Del3.Clr = 0 THEN Mas_Fabric.Fabdesc + '/' + Countname ELSE Mas_Fabric.Fabdesc + '/' + Countname + '/' + Mas_Color.ColorDesc END AS ItemDesc,
                       CASE WHEN SUM(Trs_Del3.ProgMtr) &gt; 0 THEN Mas_Uom.Uom ELSE '' END AS Uom, CASE Preprint.DcRateReqd WHEN 1 THEN CASE Isnull(Trs_Del1.processType, 
                      'P') WHEN 'P' THEN CASE WHEN SUM(jobno) &lt;&gt; 0 THEN CASE WHEN SUM(isnull(BudPodet.Rate, 0)) &lt;&gt; 0 THEN SUM(Trs_Del3.Prog * BudPoDet.rate) 
                      / SUM(Trs_Del3.Prog) ELSE SUM(Trs_Del3.Prog * isnull(Pro_ReqKnitt2.rate, 0)) / SUM(Trs_Del3.Prog) END ELSE SUM(Trs_Del3.Prog * isnull(Trs_del3.GeneralRate, 0)) 
                      / SUM(Trs_Del3.Prog) END ELSE 0 END ELSE 0 END AS Dcrate, CASE Preprint.DcRateReqd WHEN 1 THEN CASE Isnull(Trs_Del1.processType, 'P') 
                      WHEN 'P' THEN 'Rate' ELSE '' END ELSE '' END AS Ratelbl, dbo.Mas_Design.DesignDesc,'PROGRAM DETAILS' as Head
FROM         dbo.BudPoMas INNER JOIN
                      dbo.BudPodet ON dbo.BudPoMas.Id = dbo.BudPodet.Id RIGHT OUTER JOIN
                      dbo.Mas_Design RIGHT OUTER JOIN
                      dbo.Mas_Dept INNER JOIN
                      dbo.Trs_Del1 ON dbo.Mas_Dept.DeptID = dbo.Trs_Del1.Prs_Dept INNER JOIN
                      dbo.Trs_Del3 AS Trs_Del3 INNER JOIN
                      dbo.Mas_Fabric AS Mas_Fabric ON Trs_Del3.FabType = Mas_Fabric.FabID ON dbo.Trs_Del1.ID = Trs_Del3.ID ON 
                      dbo.Mas_Design.DesignId = Trs_Del3.Print_DesignId ON dbo.BudPoMas.DeptId = dbo.Trs_Del1.Prs_Dept AND dbo.BudPoMas.PartyId = dbo.Trs_Del1.Party AND 
                      dbo.BudPoMas.OrdId = Trs_Del3.OrdId AND dbo.BudPodet.DiaId = Trs_Del3.DiaID AND dbo.BudPodet.LL = Trs_Del3.LL AND dbo.BudPodet.GG = Trs_Del3.GG AND 
                      dbo.BudPodet.GSM = Trs_Del3.Gsm AND dbo.BudPodet.FabId = Trs_Del3.FabType AND dbo.BudPodet.ColId = Trs_Del3.Clr AND 
                      dbo.BudPodet.CntId = Trs_Del3.Cnt AND 
                      dbo.BudPodet.Findiaid = Trs_Del3.Findiaid AND 
                      dbo.BudPodet.fingsm= Trs_Del3.fingsm LEFT OUTER JOIN
                      dbo.Mas_Dia AS Mas_Dia ON Trs_Del3.DiaID = Mas_Dia.DiaID LEFT OUTER JOIN
                      dbo.Pro_ReqKnitt2 ON dbo.Trs_Del1.Prs_Dept = dbo.Pro_ReqKnitt2.DeptId AND Trs_Del3.OrdId = dbo.Pro_ReqKnitt2.OrdId AND 
                      Trs_Del3.FabType = dbo.Pro_ReqKnitt2.FabId AND Trs_Del3.Clr = dbo.Pro_ReqKnitt2.ColId AND Trs_Del3.Cnt = dbo.Pro_ReqKnitt2.CntID AND 
                      Trs_Del3.Gsm = dbo.Pro_ReqKnitt2.GSM AND Trs_Del3.GG = dbo.Pro_ReqKnitt2.GG AND Trs_Del3.LL = dbo.Pro_ReqKnitt2.LL AND 
                      Trs_Del3.DiaID = dbo.Pro_ReqKnitt2.DiaID AND Trs_Del3.FinDiaID = dbo.Pro_ReqKnitt2.FinDiaId AND Trs_Del3.FinGSm = dbo.Pro_ReqKnitt2.FinGSM AND 
                      Trs_Del3.DiaID = dbo.Pro_ReqKnitt2.DiaID LEFT OUTER JOIN
                      dbo.Mas_Count AS Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID LEFT OUTER JOIN
                      dbo.Mas_Uom AS Mas_Uom ON Mas_Fabric.PriUomID = Mas_Uom.UomID LEFT OUTER JOIN
                      dbo.OrderMas ON dbo.OrderMas.OrdId = Trs_Del3.OrdId CROSS JOIN
                      dbo.PrePrint
WHERE     (dbo.Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.FabType &gt; 0) AND (Trs_Del3.ID =?) AND (dbo.PrePrint.Slno = 2)
GROUP BY Mas_Fabric.Fabdesc, Mas_Count.CountName, Mas_Color.ColorDesc, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, Mas_Dia.Dia,Trs_Del3.FinDiaID, Trs_Del3.ID, Trs_Del3.Clr, 
                      Mas_Uom.Uom, dbo.PrePrint.DcRateReqd, dbo.Trs_Del1.ProcessType, dbo.Mas_Design.DesignDesc
                      </SqlCommand>
      </FabricsubReport>
      <YarnDC Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
