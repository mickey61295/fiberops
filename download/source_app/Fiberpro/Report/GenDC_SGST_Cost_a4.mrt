          <value>ExpCST,System.String</value>
          <value>Uom,System.String</value>
          <value>Heading,System.String</value>
          <value>Gpno,System.Int32</value>
          <value>GatePassFlg,System.String</value>
          <value>UserName,System.String</value>
          <value>GSTNo,System.String</value>
          <value>PGSTNo,System.String</value>
          <value>HSNCode,System.String</value>
          <value>EwayBillNo,System.String</value>
          <value>EwayBillDt,System.DateTime</value>
          <value>amount,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>GeneralDc</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>
SELECT     RTRIM(CAST(Trs_Gen1.Dcno AS varchar)) + '/' + Trs_Gen1.Finyear AS DcNo, Trs_Gen1.Dt, Trs_Gen1.Partyref, Trs_Gen1.dctype, Trs_Gen1.vechno, 
                      Trs_Gen1.deltime, Trs_Gen1.issby, Trs_Gen1.recby, Trs_Gen1.remark, Trs_Gen1.OrdRef, Mas_Party.Pname, Mas_Party.Paddress, Mas_Party.Phone, 
                      Mas_Party.TIN, Mas_Party.CST, Trs_Gen2.UomID, Trs_Gen2.DelQty, Trs_Gen2.ItemDesc, Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, 
                      Mas_Exporter.Phone AS ExpPhone, Mas_Exporter.TIN AS ExpTIN, Mas_Exporter.CST AS ExpCST, Mas_Uom.Uom, 
                      Heading = CASE dctype WHEN 'R' THEN 'DELIVERY CHALLAN - GENERAL (RETURNABLE)' WHEN 'N' THEN 'DELIVERY CHALLAN - GENERAL (NON RETURNABLE)' WHEN 'I' THEN 'DELIVERY CHALLAN - GENERAL (RECEIVED GOODS)'
                       END,Gpno,isnull(GatePassFlg,'N') as GatePassFlg, Mas_User.UserName
,Mas_Exporter.GSTNo,Mas_Party.GSTNo As PGSTNo,HSNCode,EwayBillNo,EwayBillDt,(Trs_Gen2.DelQty*Trs_Gen2.Cost) as amount
FROM         dbo.Trs_Gen1 Trs_Gen1 INNER JOIN
                      dbo.Trs_Gen2 Trs_Gen2 ON Trs_Gen1.ID = Trs_Gen2.Id INNER JOIN
                      dbo.Mas_Exporter Mas_Exporter ON Trs_Gen1.coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.Mas_Party Mas_Party ON Trs_Gen1.PartyID = Mas_Party.PID INNER JOIN
                      dbo.Mas_Uom Mas_Uom ON Trs_Gen2.UomID = Mas_Uom.UomID  
LEFT OUTER JOIN Mas_User On Trs_Gen1.PreparedBy = Mas_User.UserCode  
left join mas_hsn on trs_gen2.HSNId=mas_hsn.id
CROSS JOIN
                      dbo.Options
where Trs_Gen1.id=?
order by uom</SqlCommand>
      </GeneralDc>
