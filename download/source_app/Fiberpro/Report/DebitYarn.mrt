<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<StiSerializer version="1.0" application="StiReport">
  <Dictionary Ref="1" type="Dictionary" isKey="true">
    <Databases isList="true" count="1">
      <Connection Ref="2" type="Stimulsoft.Report.Dictionary.StiOleDbDatabase" isKey="true">
        <Alias>Connection</Alias>
        <ConnectionString>Provider=SQLOLEDB.1;Persist Security Info=False;User ID=sa;Initial Catalog=JOMS;Data Source=MACHINE-25</ConnectionString>
        <Name>Connection</Name>
        <PromptUserNameAndPassword>False</PromptUserNameAndPassword>
      </Connection>
    </Databases>
    <DataSources isList="true" count="2">
      <DebitAddDed Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DebitAddDed</Alias>
        <Columns isList="true" count="4">
          <value>indexcode,System.Int32</value>
          <value>AddDedName,System.String</value>
          <value>Valu,System.Decimal</value>
          <value>Amt,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DebitAddDed</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT DISTINCT indexcode, Mas_AddDed.AddDedName, Trs_DebAddDed.Valu, Trs_DebAddDed.Amt
	FROM Trs_DebAddDed INNER JOIN
	Mas_AddDed ON Trs_DebAddDed.AddDedCode = Mas_AddDed.AddDedCode 
INNER JOIN Trs_Deb1 On Trs_DebAddDed.ID = Trs_Deb1.ID
WHERE Trs_DebAddDed.ID = ? 
AND ((Mas_AddDed.Grp = 3 AND Trs_Deb1.Typ = '1.Purchase') OR (Mas_AddDed.Grp = 4 AND Trs_Deb1.Typ = '2.Process'))
order by indexcode</SqlCommand>
      </DebitAddDed>
      <DebitYarn Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>DebitYarn</Alias>
        <Columns isList="true" count="27">
          <value>Dno,System.String</value>
          <value>dt,System.DateTime</value>
          <value>Typ,System.String</value>
          <value>Reason,System.String</value>
          <value>remark,System.String</value>
          <value>DebKg,System.Decimal</value>
          <value>Rate,System.Decimal</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>Pname,System.String</value>
          <value>Paddress,System.String</value>
          <value>PPhone,System.String</value>
          <value>PTIN,System.String</value>
          <value>PCST,System.String</value>
          <value>Deptname,System.String</value>
          <value>OrderNo,System.String</value>
          <value>StyleNo,System.String</value>
          <value>ItemDesc,System.String</value>
          <value>Heading,System.String</value>
          <value>BrNo,System.String</value>
          <value>PartyBillNo,System.String</value>
          <value>IoNoCaption,System.String</value>
          <value>Amount,System.Decimal</value>
          <value>UserName,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>DebitYarn</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM(CAST(Trs_Deb1.DNo AS varchar)) + '/' + Trs_Deb1.Finyear AS Dno, Trs_Deb1.dt, Trs_Deb1.Typ, SUBSTRING(Reason,3,20) as Reason, Trs_Deb1.remark, 
                      Trs_Deb2.DebKg, Trs_Deb2.Rate, Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone, Mas_Exporter.TIN, 
                      Mas_Exporter.CST, Mas_Party.Pname, Mas_Party.Paddress, Mas_Party.Phone AS PPhone, Mas_Party.TIN AS PTIN, Mas_Party.CST AS PCST, 
                      Mas_Dept.Deptname, RTRIM(CAST(OrderMas.Jobno AS varchar)) + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo AS OrderNo, 
                      CASE WHEN stocktable.colid = 0 THEN Mas_Count.CountName + '/' + Mas_Mill.Mill ELSE Mas_Count.CountName + '/' + Mas_Color.ColorDesc + '/' + Mas_Mill.Mill
                       END AS ItemDesc, Mas_Dept.Deptname + ' (' + SUBSTRING(Trs_Deb1.Typ, 3, LEN(Trs_Deb1.Typ) - 1) + ')' AS Heading,'Br No: '+ RTRIM(dbo.Trs_Bills.brno) 
                      + '/' + RTRIM(dbo.Trs_Bills.finyear) AS BrNo, 'Party Bill No: '+dbo.Trs_Bills.billno AS PartyBillNo,IoNoCaption,Trs_Deb2.DebKg*Trs_Deb2.Rate as Amount, Mas_User.UserName
FROM         dbo.Trs_Deb1 AS Trs_Deb1 INNER JOIN
                      dbo.Mas_Exporter AS Mas_Exporter ON Trs_Deb1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.Mas_Party AS Mas_Party ON Trs_Deb1.Party = Mas_Party.PID INNER JOIN
                      dbo.Mas_Dept AS Mas_Dept ON Trs_Deb1.Dept = Mas_Dept.DeptID INNER JOIN
                      dbo.OrderMas AS OrderMas ON Trs_Deb1.OrdId = OrderMas.OrdId INNER JOIN
                      dbo.Trs_Deb2 AS Trs_Deb2 ON Trs_Deb1.ID = Trs_Deb2.ID INNER JOIN
                      dbo.StockTable AS StockTable ON Trs_Deb2.StockID = StockTable.StockID LEFT OUTER JOIN
                      dbo.Mas_Mill AS Mas_Mill ON StockTable.MillID = Mas_Mill.MillID INNER JOIN
                      dbo.Mas_Count AS Mas_Count ON StockTable.CntID = Mas_Count.CountID  LEFT OUTER  JOIN
                      dbo.Trs_Bills ON Trs_Deb1.Brnid = dbo.Trs_Bills.ID LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN
Mas_User ON Trs_Deb1.PreparedBy = Mas_User.UserCode
WHERE Trs_Deb1.Id=?</SqlCommand>
      </DebitYarn>
    </DataSources>
