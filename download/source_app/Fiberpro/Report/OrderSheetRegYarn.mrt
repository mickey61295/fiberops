    <DataSources isList="true" count="4">
      <ExcessQtySizewiseDet Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>ExcessQtySizewiseDet</Alias>
        <Columns isList="true" count="10">
          <value>OrdID,System.Int32</value>
          <value>OrderQty,System.Decimal</value>
          <value>StyleNo,System.String</value>
          <value>Exs_Per,System.Int32</value>
          <value>SlNo,System.Int32</value>
          <value>StyleDesc,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>SNo,System.Int32</value>
          <value>SizeDesc,System.String</value>
          <value>ExcessQty,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>ExcessQtySizewiseDet</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT OrderQtyDtl.OrdID, OrderQtyDtl.OrderQty, OrderQtyDtl.StyleNo,  CAST(OrderQtyDtl.Exs_Per AS int) AS Exs_Per, OrderQtyDtl.SlNo, Mas_StyleDesc.StyleDesc,Mas_Color.ColorDesc, OrdSizeMas.SNo, Mas_Size.SizeDesc,cast((OrderQtyDtl.OrderQty)+((OrderQtyDtl.OrderQty)*(OrderQtyDtl.Exs_Per)/100) as int) as ExcessQty
FROM dbo.OrderQtyDtl AS OrderQtyDtl 
INNER JOIN dbo.Mas_Color AS Mas_Color ON OrderQtyDtl.ColID = Mas_Color.ColID 
INNER JOIN dbo.OrdSizeMas AS OrdSizeMas ON OrderQtyDtl.OrdID = OrdSizeMas.OrdID AND OrderQtyDtl.SizeId = OrdSizeMas.SizeID and OrderQtyDtl.StyleNo=OrdSizeMas.StyleNo INNER JOIN dbo.Mas_Size AS Mas_Size ON OrderQtyDtl.SizeId = Mas_Size.SizeID 
INNER JOIN dbo.Mas_StyleDesc AS Mas_StyleDesc ON OrderQtyDtl.StyleID = Mas_StyleDesc.StyleID
WHERE (OrderQtyDtl.OrdID = ?) AND (OrderQtyDtl.Exs_Per &gt; 0)
order by OrdSizeMas.SNo,OrderQtyDtl.SlNo</SqlCommand>
      </ExcessQtySizewiseDet>
      <Fabric_x0020_Rate Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>Fabric Rate</Alias>
        <Columns isList="true" count="9">
          <value>kgs,System.Decimal</value>
          <value>sno,System.Int32</value>
          <value>Countdesc,System.String</value>
          <value>colordesc,System.String</value>
          <value>colid,System.Int32</value>
          <value>cntid,System.Int32</value>
          <value>Rate,System.Decimal</value>
          <value>Amount,System.Decimal</value>
          <value>fabricrateflg,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>Fabric Rate</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,3,0</value>
        </Parameters>
        <SqlCommand>Select kgs,sno, isnull(countname,'')  as Countdesc,isnull(colordesc,'') as 
colordesc,isnull(OrderSheet_YarnDet.colid,0) as colid,
isnull(OrderSheet_YarnDet.cntid,0) as cntid ,isnull(OrderSheet_YarnDet.Rate,0) as Rate,isnull(OrderSheet_YarnDet.Rate,0)* isnull(OrderSheet_YarnDet.kgs,0) as Amount,'' as fabricrateflg  From OrderSheet_YarnDet 
INNER JOIN  OrderMas2 ON OrderMas2.OrdId=OrderSheet_YarnDet.OrdId
INNER JOIN  MAs_count on OrderSheet_YarnDet.cntid=Mas_count.countid 
LEFT OUTER JOIN  Mas_color on  OrderSheet_YarnDet.Colid = Mas_color.ColId

RIGHT OUTER JOIN  ordermas on  OrderSheet_YarnDet.ordid=ordermas.ordid
WHERE OrderSheet_YarnDet.OrdId= ? ORDER BY Sno
</SqlCommand>
      </Fabric_x0020_Rate>
      <OrderQtySizewiseDet Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>OrderQtySizewiseDet</Alias>
        <Columns isList="true" count="8">
          <value>OrdID,System.Int32</value>
          <value>SNo,System.Int32</value>
          <value>OrderQty,System.Decimal</value>
          <value>StyleNo,System.String</value>
          <value>SlNo,System.Int32</value>
          <value>SizeDesc,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>StyleDesc,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>OrderQtySizewiseDet</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT OrdSizeMas.OrdID, OrdSizeMas.SNo, OrderQtyDtl.OrderQty, OrderQtyDtl.StyleNo, OrderQtyDtl.SlNo, Mas_Size.SizeDesc, Mas_Color.ColorDesc, Mas_StyleDesc.StyleDesc FROM dbo.OrdSizeMas AS OrdSizeMas INNER JOIN dbo.OrderQtyDtl AS OrderQtyDtl ON OrdSizeMas.OrdID = OrderQtyDtl.OrdID AND OrdSizeMas.SizeID = OrderQtyDtl.SizeId and OrderQtyDtl.StyleNo=OrdSizeMas.StyleNo
INNER JOIN dbo.Mas_Color AS Mas_Color ON OrderQtyDtl.ColID = Mas_Color.ColID INNER JOIN dbo.Mas_StyleDesc AS Mas_StyleDesc ON OrderQtyDtl.StyleID = Mas_StyleDesc.StyleID INNER JOIN dbo.Mas_Size AS Mas_Size ON OrderQtyDtl.SizeId = Mas_Size.SizeID
WHERE (OrdSizeMas.OrdID = ?) ORder by OrdSizeMas.SNo, OrderQtyDtl.SlNo</SqlCommand>
      </OrderQtySizewiseDet>
      <OrderSheet Ref="6" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>OrderSheet</Alias>
        <Columns isList="true" count="16">
          <value>JobNo,System.String</value>
          <value>BuyOrdNo,System.String</value>
          <value>BuyordDt,System.DateTime</value>
          <value>DelDt,System.DateTime</value>
          <value>OrderQty,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>StyleNo,System.String</value>
          <value>OrderType,System.String</value>
          <value>uom,System.String</value>
          <value>ActDelDt,System.DateTime</value>
          <value>BuyerName,System.String</value>
          <value>ExporterName,System.String</value>
          <value>MerchName,System.String</value>
          <value>SeasDesc,System.String</value>
          <value>FcyName,System.String</value>
          <value>remarks,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>OrderSheet</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     RTRIM(CAST(OrderMas.Jobno AS varchar)) + '/' + OrderMas.Finyear AS JobNo, OrderMas.BuyOrdNo, OrderMas.BuyordDt, 
OrderMas2.DelDt, 
                      OrderMas.OrderQty, OrderMas2.Gsm, OrderMas2.StyleNo, OrderMas.OrderType, OrderMas.uom, OrderMas2.ActDelDt, Mas_Buyer.BuyerName, 
                      Mas_Exporter.ExporterName, Mas_Merchandiser.MerchName, Mas_Season.SeasDesc, Mas_Fcy.FcyName,ordermas2.remarks
FROM        OrderMas AS OrderMas INNER JOIN OrderMas2 ON OrderMas.OrdId=OrderMas2.OrdId INNER JOIN 
                     Mas_Exporter AS Mas_Exporter ON OrderMas.ExpID = Mas_Exporter.ExpID LEFT OUTER JOIN
                     Mas_Merchandiser AS Mas_Merchandiser ON OrderMas.MerchID = Mas_Merchandiser.MerchID LEFT OUTER JOIN
                     Mas_Season AS Mas_Season ON OrderMas.Season = Mas_Season.SeasID LEFT OUTER JOIN
                     Mas_Fcy AS Mas_Fcy ON OrderMas.Fcy = Mas_Fcy.ID LEFT OUTER JOIN
                     Mas_Buyer AS Mas_Buyer ON OrderMas.BuyerID = Mas_Buyer.BuyerID
where Ordermas.OrdId=?</SqlCommand>
      </OrderSheet>
    </DataSources>
