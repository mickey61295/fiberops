    <DataSources isList="true" count="3">
      <FabricsubReport Ref="3" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>FabricsubReport</Alias>
        <Columns isList="true" count="10">
          <value>ID,System.Int32</value>
          <value>Clr,System.Int32</value>
          <value>Gsm,System.Decimal</value>
          <value>GG,System.Int32</value>
          <value>LL,System.String</value>
          <value>prog,System.Decimal</value>
          <value>progMtr,System.Decimal</value>
          <value>Dia,System.String</value>
          <value>ItemDesc,System.String</value>
          <value>Uom,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>FabricsubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,_x0030_,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Trs_Del3.ID, Trs_Del3.Clr, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, SUM(Trs_Del3.Prog) AS prog, SUM(Trs_Del3.ProgMtr) AS progMtr, Mas_Dia.Dia, 
	ItemDesc = CASE WHEN Trs_Del3.Clr = 0 THEN Mas_Fabric.Fabdesc + '/' + Countname ELSE Mas_Fabric.Fabdesc + '/' + Countname + '/' + Mas_Color.ColorDesc
                       END, Uom = CASE WHEN SUM(Trs_Del3.ProgMtr) &gt; 0 THEN Mas_Uom.Uom ELSE '' END
FROM         dbo.Trs_Del3 Trs_Del3 INNER JOIN
                      dbo.Mas_Fabric Mas_Fabric ON Trs_Del3.FabType = Mas_Fabric.FabID INNER JOIN
                      dbo.Mas_Dia Mas_Dia ON Trs_Del3.DiaID = Mas_Dia.DiaID INNER JOIN
                      dbo.Trs_Del1 ON Trs_Del3.ID = dbo.Trs_Del1.ID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Mas_Count Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID LEFT OUTER JOIN
                      dbo.Mas_Uom Mas_Uom ON Mas_Fabric.SecUomID = Mas_Uom.UomID
WHERE     (dbo.Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.FabType &gt; 0) AND trs_del3.id = ?
GROUP BY Mas_Fabric.Fabdesc, Countname, Mas_Color.ColorDesc, Trs_Del3.Gsm, Trs_Del3.GG, Trs_Del3.LL, Mas_Dia.Dia, Trs_Del3.ID, Trs_Del3.Clr, 
                      Mas_Uom.Uom</SqlCommand>
      </FabricsubReport>
      <YarnDC Ref="4" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>YarnDC</Alias>
        <Columns isList="true" count="38">
          <value>ID,System.Int32</value>
          <value>DcNo,System.String</value>
          <value>Dt,System.DateTime</value>
          <value>TrType,System.Int32</value>
          <value>remark,System.String</value>
          <value>delwgt,System.Decimal</value>
          <value>OrderNo,System.String</value>
          <value>StyleNo,System.String</value>
          <value>Deptname,System.String</value>
          <value>OutputType,System.String</value>
          <value>DCFormat,System.String</value>
          <value>BgRl,System.Int32</value>
          <value>Kg,System.Decimal</value>
          <value>Pname,System.String</value>
          <value>Paddress,System.String</value>
          <value>Phone,System.String</value>
          <value>TIN,System.String</value>
          <value>CST,System.String</value>
          <value>ExporterName,System.String</value>
          <value>ExporterAddress,System.String</value>
          <value>Expr2,System.String</value>
          <value>Expr3,System.String</value>
          <value>Expr4,System.String</value>
          <value>PartyDCref,System.String</value>
          <value>grnwgt,System.Decimal</value>
          <value>DcPre,System.String</value>
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
          <value>ShortMill,System.String</value>
          <value>Heading,System.String</value>
          <value>VName,System.String</value>
          <value>Terms,System.String</value>
          <value>Item,System.String</value>
          <value>ShortBuyer,System.String</value>
          <value>Gpno,System.Int32</value>
          <value>GatePassFlg,System.String</value>
          <value>LotNo,System.String</value>
          <value>UserName,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnDC</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     Trs_Del1.ID, CASE WHEN len(rtrim(mas_grp.dcpre)) &lt; 1 THEN RTRIM(CAST(Trs_Del1.DocNo AS varchar)) 
                      + '/' + Trs_Del1.Finyear ELSE rtrim(mas_grp.dcpre) + '-' + RTRIM(CAST(Trs_Del1.DocNo AS varchar)) + '/' + Trs_Del1.Finyear END AS DcNo, 
                      Trs_Del1.Dt, Trs_Del1.TrType, Trs_Del1.remark, Trs_Del1.delwgt, 
                      CASE WHEN ordermas.jobno = 0 THEN '&lt;General&gt;' + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo ELSE RTRIM(CAST(OrderMas.Jobno AS varchar))
                       + '/' + OrderMas.Finyear + '-&gt;' + OrderMas.BuyOrdNo END AS OrderNo, OrderMas2.StyleNo, Mas_Dept.Deptname, Mas_Dept.OutputType, 
                      Mas_Dept.DCFormat, Trs_Del2.BgRl, Trs_Del2.Kg, Mas_Party.Pname, Mas_Party.Paddress, Mas_Party.Phone, Mas_Party.TIN, Mas_Party.CST, 
                      Mas_Exporter.ExporterName, Mas_Exporter.ExporterAddress, Mas_Exporter.Phone AS Expr2, Mas_Exporter.TIN AS Expr3, 
                      Mas_Exporter.CST AS Expr4, Trs_Grn1.PartyDCref, Trs_Grn1.grnwgt, Mas_Grp.DcPre, Mas_Color.ColorDesc, Mas_Count.CountName, 
                      Mas_Mill.ShortMill, 
                      CASE Trtype WHEN 1 THEN 'PROCESS DELIVERY' WHEN 4 THEN 'PURCHASE RETURN' WHEN 13 THEN 'PARTY REJECTION RETURN' END AS Heading,
                       dbo.Mas_Vehicle.VName, Mas_Terms.Terms, CASE WHEN Mas_Color.ColorDesc IS NOT NULL AND Mas_Mill.Mill IS NOT NULL 
                      THEN Mas_Count.CountName + Mas_Color.ColorDesc + Mas_Mill.Mill WHEN Mas_Color.ColorDesc IS NULL AND Mas_Mill.Mill IS NULL 
                      THEN Mas_Count.CountName WHEN Mas_Color.ColorDesc IS NULL AND Mas_Mill.Mill IS NOT NULL 
                      THEN Mas_Count.CountName + Mas_Mill.Mill WHEN Mas_Color.ColorDesc IS NOT NULL AND Mas_Mill.Mill IS NULL 
                      THEN Mas_Count.CountName + Mas_Color.ColorDesc END AS Item, case when OrderMas.jobno = 0 then  ''else  dbo.Mas_Buyer.ShortBuyer end as ShortBuyer ,Gpno,isnull(Options.GatePassFlg,'N') as GatePassFlg,StockTable.LotNo, Mas_User.UserName
FROM         dbo.Trs_Del1 AS Trs_Del1 INNER JOIN
                      dbo.Mas_Dept AS Mas_Dept ON Trs_Del1.Prs_Dept = Mas_Dept.DeptID INNER JOIN
                      dbo.Trs_Del2 AS Trs_Del2 ON Trs_Del1.ID = Trs_Del2.ID INNER JOIN
                      dbo.Mas_Party AS Mas_Party ON Trs_Del1.Party = Mas_Party.PID INNER JOIN
                      dbo.Mas_Exporter AS Mas_Exporter ON Trs_Del1.Coycode = Mas_Exporter.ExpID INNER JOIN
                      dbo.OrderMas AS OrderMas ON Trs_Del2.OrdId = OrderMas.OrdId 
INNER JOIN OrderMas2 ON OrderMAs2.Ordid = OrderMas.Ordid 
LEFT OUTER JOIN
                      dbo.Trs_Grn1 AS Trs_Grn1 ON Trs_Del1.OurGRNID = Trs_Grn1.ID INNER JOIN
                      dbo.StockTable AS StockTable ON Trs_Del2.StockID = StockTable.StockID LEFT OUTER JOIN
                      dbo.Mas_Grp AS Mas_Grp ON Mas_Dept.Grp = Mas_Grp.GrpNo INNER JOIN
                      dbo.Mas_Count AS Mas_Count ON StockTable.CntID = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Buyer ON OrderMas.BuyerID = dbo.Mas_Buyer.BuyerID LEFT OUTER JOIN
                      dbo.Mas_Mill AS Mas_Mill ON StockTable.MillID = Mas_Mill.MillID LEFT OUTER JOIN
                      dbo.Mas_Vehicle ON Trs_Del1.VehicleCode = dbo.Mas_Vehicle.Code LEFT OUTER JOIN
                      dbo.Mas_Color AS Mas_Color ON StockTable.ColID = Mas_Color.ColID LEFT OUTER JOIN
Mas_User ON Trs_Del1.PreparedBy = Mas_User.UserCode  LEFT OUTER JOIN
                      dbo.Mas_Terms AS Mas_Terms ON Mas_Dept.DC_TermCode = Mas_Terms.ID cross join options
WHERE     (Trs_Del1.ID = ?)</SqlCommand>
      </YarnDC>
      <YarnSubReport Ref="5" type="Stimulsoft.Report.Dictionary.StiOleDbSource" isKey="true">
        <Alias>YarnSubReport</Alias>
        <Columns isList="true" count="4">
          <value>Prog,System.Decimal</value>
          <value>ProgMtr,System.Decimal</value>
          <value>ColorDesc,System.String</value>
          <value>CountName,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>YarnSubReport</Name>
        <NameInSource>Connection</NameInSource>
        <Parameters isList="true" count="1">
          <value>_x0040_Id,,5,0</value>
        </Parameters>
        <SqlCommand>SELECT     TOP 100 PERCENT SUM(Trs_Del3.Prog) AS Prog, SUM(Trs_Del3.ProgMtr) AS ProgMtr, Mas_Color.ColorDesc, Mas_Count.CountName
FROM         dbo.Trs_Del3 Trs_Del3 INNER JOIN
                      dbo.Trs_Del1 ON Trs_Del3.ID = dbo.Trs_Del1.ID INNER JOIN
                      dbo.Mas_Dept ON dbo.Trs_Del1.Prs_Dept = dbo.Mas_Dept.DeptID LEFT OUTER JOIN
                      dbo.Mas_Count Mas_Count ON Trs_Del3.Cnt = Mas_Count.CountID LEFT OUTER JOIN
                      dbo.Mas_Color Mas_Color ON Trs_Del3.Clr = Mas_Color.ColID
WHERE     (dbo.Mas_Dept.ProgReqPrn = 'Y') AND (Trs_Del3.ID = ?) AND (Trs_Del3.FabType = 0)
GROUP BY Mas_Count.CountName, Mas_Color.ColorDesc
ORDER BY Mas_Count.CountName, Mas_Color.ColorDesc</SqlCommand>
      </YarnSubReport>
    </DataSources>
